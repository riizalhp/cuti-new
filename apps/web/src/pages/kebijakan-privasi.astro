  <script>
    // Progres baca + TOC aktif + kembali ke atas
    const bar = document.getElementById('pp-progress-bar');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.pp-section'));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const topBtn = document.querySelector<HTMLAnchorElement>('.pp-top');

    const onScroll = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (bar) bar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;

      // Sorot bagian yang sedang dibaca di TOC
      let current = '';
      for (const s of sections) {
        if (s.getBoundingClientRect().top <= 120) current = s.id;
      }
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === current));

      if (topBtn) topBtn.classList.toggle('is-visible', window.scrollY > 600);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
