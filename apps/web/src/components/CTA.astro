---
// Final CTA section before footer
---

<section class="section-container py-20 lg:py-32">
  <div class="relative overflow-hidden rounded-3xl">
    <!-- Background with gradient mesh -->
    <div class="absolute inset-0 bg-gradient-to-br from-accent-indigo via-accent-violet to-accent-indigo opacity-90"></div>

    <!-- Glass overlay -->
    <div class="relative glass-heavy p-12 lg:p-20 text-center space-y-8">
      <h2 class="text-4xl lg:text-6xl font-bold text-white">
        Siap Mendapatkan Pekerjaan Impian?
      </h2>

      <p class="text-xl lg:text-2xl text-white/90 max-w-3xl mx-auto">
        Join 1,000+ pencari kerja yang sudah berhasil dengan CUTI
      </p>

      <!-- CTA Button -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/register"
          class="px-8 py-4 rounded-full font-bold text-accent-indigo bg-white hover:bg-gray-50 transition-all hover:scale-105 shadow-lg"
        >
          Mulai Gratis Sekarang
        </a>
        <p class="text-sm text-white/80">
          No credit card required • 2 minutes setup
        </p>
      </div>

      <!-- Social Proof -->
      <div class="flex flex-wrap justify-center items-center gap-8 pt-8 text-white/70 text-sm">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
          <span>4.9/5 Rating</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <span>1,000+ Users</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>ATS Optimized</span>
        </div>
      </div>
    </div>
  </div>
</section>
