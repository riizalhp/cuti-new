  (function() {
    const typeTabs = document.querySelectorAll('#event-type-tabs .event-filter-btn');
    const formatFilter = document.getElementById('event-format-filter');
    const cityFilter = document.getElementById('event-city-filter');
    const cards = document.querySelectorAll('.event-card-item');
    const noMsg = document.getElementById('no-events-message');

    let currentType = 'all';
    let currentFormat = 'all';
    let currentCity = 'all';

    function applyEventFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const type = card.getAttribute('data-type') || '';
        const format = card.getAttribute('data-format') || '';
        const loc = card.getAttribute('data-location') || '';

        const matchType = currentType === 'all' || type.includes(currentType);
        const matchFormat = currentFormat === 'all' || format.includes(currentFormat);
        const matchCity = currentCity === 'all' || loc.includes(currentCity);

        if (matchType && matchFormat && matchCity) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noMsg) {
        if (visibleCount === 0) noMsg.classList.remove('hidden');
        else noMsg.classList.add('hidden');
      }
    }

    typeTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        typeTabs.forEach((t) => {
          t.classList.remove('bg-[#1738D1]', 'text-white');
          t.classList.add('bg-white', 'text-[#101010]', 'border', 'border-[#d7d6cf]');
        });
        tab.classList.remove('bg-white', 'text-[#101010]', 'border', 'border-[#d7d6cf]');
        tab.classList.add('bg-[#1738D1]', 'text-white');

        currentType = tab.getAttribute('data-type') || 'all';
        applyEventFilters();
      });
    });

    formatFilter?.addEventListener('change', (e) => {
      currentFormat = e.target.value;
      applyEventFilters();
    });

    cityFilter?.addEventListener('change', (e) => {
      currentCity = e.target.value;
      applyEventFilters();
    });
  })();
