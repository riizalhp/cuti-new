---
// TrendingSection.astro - "Paling Banyak Dibaca" / Top Stories
import { artikelList, trendingTopics, ensureData } from '../data/mock';

await ensureData();
const artikelSnapshot = [...artikelList];

const featured = artikelSnapshot[0];
const subArticles = artikelSnapshot.slice(2, 6);

const popularTags = [
  { name: "BUMN 2026", count: "1.2k" },
  { name: "Interview ATS", count: "980" },
  { name: "Gaji IT", count: "840" },
  { name: "Remote Work", count: "720" },
  { name: "Sertifikasi BNSP", count: "650" },
  { name: "Fresh Graduate", count: "1.5k" },
];
---

<section class="py-12 bg-slate-50/50 border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header with handwriting accent -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#1738d1]">Tren & Berita Dunia Kerja</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight">Paling Banyak Dibaca</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1.5 leading-relaxed">
          Artikel, insight, dan isu ketenagakerjaan yang sedang jadi perhatian para pencari kerja di Indonesia.
        </p>
      </div>

      <div class="flex items-center gap-4">
        <div class="hidden sm:block text-right">
          <span class="font-doodle text-2xl sm:text-3xl font-bold text-slate-800 rotate-[-3deg] block leading-tight">
            Same People Brighter Opportunities
          </span>
        </div>
        <a
          href="/career"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#1738d1] hover:text-[#132ea8] transition shrink-0 group"
        >
          <span>Semua Berita</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-8 no-scrollbar">
      <button class="px-4 py-1.5 rounded-full bg-[#1738d1] text-white text-xs font-bold shrink-0">Semua</button>
      <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold shrink-0">Karier</button>
      <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold shrink-0">CV & Interview</button>
      <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold shrink-0">Dunia Kerja</button>
      <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold shrink-0">Industri</button>
      <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold shrink-0">Pengembangan Diri</button>
      <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold shrink-0">Lifestyle</button>
    </div>

    <!-- 3-Column Content Grid: Perfectly Balanced Heights -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- Col 1: Big Featured Card (5 cols) -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between h-full">
        <div>
          <div class="relative aspect-[16/11] overflow-hidden bg-slate-100">
            <img
              src={featured.image}
              alt={featured.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#1738d1] text-white shadow-sm">
              {featured.category}
            </span>
            <button type="button" aria-label="Simpan artikel" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center text-slate-600 hover:text-[#1738d1] shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
              </svg>
            </button>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
              <span class="font-semibold text-slate-800">{featured.author}</span>
              <span>·</span>
              <span>{featured.date}</span>
              <span>·</span>
              <span>{featured.readTime}</span>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-slate-900 leading-snug mb-3 hover:text-[#1738d1] transition">
              <a href={"/career/" + featured.slug}>{featured.title}</a>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
              {featured.excerpt}
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-0 border-t border-slate-100 mt-2 flex items-center justify-between text-xs text-slate-500">
          <span class="text-[11px] text-slate-400">14.8k pembaca</span>
          <a href={"/career/" + featured.slug} class="font-semibold text-[#1738d1] hover:underline flex items-center gap-1">
            <span>Baca Selengkapnya</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: List Items (4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        {subArticles.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden flex items-center gap-3 hover:border-blue-300 transition shadow-sm group p-1.5">
            <!-- Thumbnail (Rounded Edge Inside Card) -->
            <div class="w-28 sm:w-32 h-24 rounded-xl overflow-hidden bg-slate-100 shrink-0 relative">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              <span class="absolute bottom-1.5 left-1.5 text-[8px] font-bold uppercase tracking-wider text-white bg-slate-900/80 px-1.5 py-0.5 rounded">
                {item.readTime}
              </span>
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0 py-1 pr-2">
              <span class="inline-block text-[9px] font-bold uppercase tracking-wider text-[#1738d1] bg-blue-50 px-2 py-0.5 rounded mb-1">
                {item.category}
              </span>
              <h4 class="text-xs sm:text-[13px] font-semibold text-slate-900 group-hover:text-[#1738d1] transition line-clamp-2 leading-snug">
                <a href={"/career/" + item.slug}>{item.title}</a>
              </h4>
              <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-1.5">
                <span>{item.date}</span>
                <span>·</span>
                <span>{item.author}</span>
              </div>
            </div>

            <!-- Bookmark Button -->
            <button type="button" aria-label="Simpan" class="text-slate-300 hover:text-slate-600 shrink-0 pr-2 self-start pt-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
              </svg>
            </button>
          </div>
        ))}
      </div>

      <!-- Col 3: Trending Topics Sidebar + Tag Cloud (3 cols) -->
      <div class="lg:col-span-3 flex flex-col gap-4">
        <!-- Topik Lagi Trending Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4.5 shadow-sm">
          <div class="flex items-center justify-between mb-3.5 pb-2.5 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="text-amber-500">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.474.966-.567 1.344-.197.802-.13 1.49.014 1.968.04.13.086.241.133.334.02.04.041.077.062.112A6.002 6.002 0 006 12a6 6 0 1012 0c0-1.85-.838-3.504-2.164-4.606-.062-.052-.128-.1-.197-.145-.19-.125-.401-.22-.619-.3-.591-.219-1.294-.378-1.92-.85a8.77 8.77 0 01-.705-.546zM10 16a4 4 0 100-8 4 4 0 000 8z" clip-rule="evenodd"></path>
                </svg>
              </span>
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900">Topik Lagi Trending</h3>
            </div>
            <a href="/career" class="text-xs text-[#1738d1] font-bold hover:underline">Semua →</a>
          </div>

          <div class="space-y-2.5">
            {trendingTopics.map((topic) => (
              <a href={"/career?q=" + topic.slug} class="flex items-center justify-between group py-1">
                <div class="flex items-center gap-2.5">
                  <span class="w-5 text-xs font-bold text-slate-400 group-hover:text-[#1738d1]">{topic.rank}</span>
                  <div>
                    <div class="text-xs font-semibold text-slate-800 group-hover:text-[#1738d1] transition">{topic.name}</div>
                    <div class="text-[10px] text-slate-400">{topic.reads} dibaca</div>
                  </div>
                </div>
                <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-[#1738d1] group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- Tag Cloud Box (Fills Space Perfectly) -->
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
          <div class="flex items-center gap-1.5 mb-2.5 text-xs font-semibold uppercase tracking-wider text-slate-700">
            <svg class="w-3.5 h-3.5 text-[#1738d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
            <span>Tag Populer</span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {popularTags.map((tag) => (
              <a
                href={`/career?tag=${tag.name}`}
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-[#1738d1] text-[11px] font-medium transition flex items-center gap-1"
              >
                <span>#{tag.name}</span>
                <span class="text-[9px] text-slate-400">({tag.count})</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Punya Topik Menarik Card -->
        <div class="bg-gradient-to-br from-blue-50/90 to-indigo-50/60 rounded-2xl border border-blue-100 p-4 shadow-sm">
          <div class="flex items-center gap-2 mb-1.5 text-[#1738d1]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
            </svg>
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">Tulis Artikel Karier</h4>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed mb-3">
            Bagikan cerita lolos interview atau tips kerja dan bantu ribuan pencari kerja lainnya.
          </p>
          <a
            href="/artikel"
            class="w-full py-2 px-3 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-semibold text-center transition flex items-center justify-center gap-1 shadow-xs"
          >
            <span>Kirim Tulisan</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Mini Banner -->
    <div class="mt-8 bg-gradient-to-r from-blue-50/90 via-white to-blue-50/70 border border-slate-200 rounded-2xl p-5 sm:p-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-base font-semibold text-slate-900 leading-tight">Terus Update dengan Insight Terbaru</h4>
        <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
          Jangan lewatkan artikel, tips, event, dan peluang karier terbaru langsung di inbox kamu.
        </p>
      </div>

      <form class="flex w-full md:w-auto items-center gap-2" onsubmit="alert('Terima kasih! Email Anda telah terdaftar.'); return false;">
        <input
          type="email"
          placeholder="Masukkan email kamu"
          required
          class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-white outline-none focus:border-[#1738d1] w-full md:w-64"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs sm:text-sm font-semibold shrink-0 transition"
        >
          Langganan Gratis →
        </button>
      </form>
    </div>
  </div>
</section>

