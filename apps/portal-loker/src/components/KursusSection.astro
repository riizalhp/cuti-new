---
// KursusSection.astro - Course & Pelatihan Karier with Cult UI Cutout Cards
import { courseList, ensureData } from '../data/mock';
import OrganicCardSmall from './common/OrganicCardSmall.astro';

await ensureData();
const topCourses = [...courseList].slice(0, 4);
---

<section id="course" class="py-8 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <div class="section-label mb-2.5">
          <span>03</span>
          <i></i>
          <span>PELATIHAN &amp; SKILL DIGITAL</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight">
          Tingkatkan keahlianmu,<br class="hidden sm:inline" />
          <em>dengan pelatihan terarah.</em>
        </h2>
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-3.5 leading-relaxed font-medium max-w-xl">
          Kuasai keahlian praktis yang dicari industri: data analytics, programming, UI/UX design, dan digital marketing.
        </p>
      </div>

      <a
        href="/course"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start sm:self-auto group"
      >
        <span>Lihat Semua Pelatihan</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 4 Course Cards (Horizontal Snap Carousel di Mobile, Grid di Tablet/Desktop) -->
    <div class="flex overflow-x-auto snap-x snap-mandatory sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-7 pb-4 sm:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar">
      {topCourses.length === 0 ? (
        <div class="col-span-full text-center py-12 text-sm text-[#6e6d68] bg-white rounded-[28px] border border-[#d7d6cf]">
          Belum ada pelatihan aktif yang tersedia saat ini.
        </div>
      ) : (
        topCourses.map((crs) => (
          <OrganicCardSmall
            className="shrink-0 w-[275px] sm:w-auto snap-start"
            category={crs.provider}
            date={crs.duration}
            title={crs.title}
            href={`/course/${crs.slug}`}
            description={crs.description}
            price={crs.price}
            badge={crs.level}
            actionText="Lihat Materi"
          />
        ))
      )}
    </div>
  </div>
</section>
