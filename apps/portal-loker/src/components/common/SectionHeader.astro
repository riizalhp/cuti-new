---
// SectionHeader.astro - Consistent section heading component for homepage sections (Port 4321 Style)
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  eyebrowColor?: string;
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  className = ''
} = Astro.props;
---

<div class={`section-header ${className}`}>
  <div class="section-label mb-2">
    <span>{eyebrow}</span>
    <i></i>
  </div>
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight leading-tight" set:html={title} />
  {description && (
    <p class="text-xs sm:text-sm text-[#6e6d68] mt-2 leading-relaxed max-w-2xl font-medium">
      {description}
    </p>
  )}
</div>
