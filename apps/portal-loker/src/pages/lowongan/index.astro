                <span class="text-[9.5px] font-bold uppercase tracking-wider bg-emerald-50 text-[#047857] border border-emerald-200 px-2 py-0.5 rounded-md">
                  FITUR GRATIS PELAMAR
                </span>
                <span class="text-[10.5px] font-bold text-[#52514c]">Employr OS</span>
              </div>

              <h4 class="text-xs sm:text-sm font-bold text-[#101010] leading-snug">
                Lamar Banyak Posisi? Pantau Statusnya di Papan Tracker
              </h4>
              <p class="text-[11px] text-[#52514c] leading-relaxed font-medium">
                Catat setiap perusahaan yang sudah kamu lamar, jadwal psikotes, dan tahapan wawancara agar rapi tanpa tercecer.
              </p>

              <!-- Quick Tool Links -->
              <div class="grid grid-cols-1 gap-2 pt-1">
                <a
                  href={TRACKER_URL}
                  class="min-h-[44px] px-3.5 py-2 rounded-xl bg-[#f4f3ee] hover:bg-blue-50 border border-[#c8c7be] hover:border-[#1738D1] text-xs font-bold text-[#101010] hover:text-[#1738D1] transition flex items-center justify-between focus-visible:outline-2 focus-visible:outline-[#1738D1]"
                >
                  <span>Papan Job Tracker Lamaran</span>
                  <span class="text-[11px] font-extrabold text-[#1738D1]">Buka</span>
                </a>
                <a
                  href="/kalkulator-gaji"
                  class="min-h-[44px] px-3.5 py-2 rounded-xl bg-[#f4f3ee] hover:bg-blue-50 border border-[#c8c7be] hover:border-[#1738D1] text-xs font-bold text-[#101010] hover:text-[#1738D1] transition flex items-center justify-between focus-visible:outline-2 focus-visible:outline-[#1738D1]"
                >
                  <span>Kalkulator Gaji &amp; Take-Home Pay</span>
                  <span class="text-[11px] font-extrabold text-[#047857]">Hitung</span>
                </a>
              </div>
            </div>

            <!-- Recruitment Safety Notice anchored at the very bottom -->
            <div class="p-3 rounded-xl bg-amber-50/90 border border-amber-200 text-[11px] text-amber-950 leading-relaxed mt-auto">
              <strong class="font-bold block mb-0.5">Info Keamanan Pelamar</strong>
              Seluruh lowongan terverifikasi di Employr 100% bebas biaya apapun (tanpa tiket, pelatihan paksa, atau deposit).
            </div>
          </div>

        </aside>

      </div>

      <!-- =====================================================================
           BAGIAN BAWAH (FULL WIDTH): BACA JUGA ARTIKEL, SERTIFIKASI, COURSE & EVENT
           ===================================================================== -->
      <div class="mt-14 pt-10 border-t border-[#d7d6cf] space-y-10">

        <!-- Section Header Eksplorasi Baca Juga -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <div class="section-label mb-2">
              <span>EKSPLORASI KARIER</span>
              <i></i>
              <span>BACA JUGA</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#101010] tracking-tight">
              Bekal persiapan karier, <em>sertifikasi, &amp; panduan lolos seleksi.</em>
            </h2>
            <p class="text-xs sm:text-sm text-[#52514c] mt-1.5 max-w-2xl font-medium leading-relaxed">
              Tingkatkan daya saing lamaranmu melalui panduan menyusun CV, sertifikasi profesi resmi, pelatihan praktis, serta bursa kerja terdekat.
            </p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <a href="/career" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-white hover:bg-[#101010] hover:text-white text-[#101010] border border-[#c8c7be] text-xs font-bold transition">
              Artikel Karier
            </a>
            <a href="/sertifikasi" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-white hover:bg-[#101010] hover:text-white text-[#101010] border border-[#c8c7be] text-xs font-bold transition">
              Sertifikasi
            </a>
            <a href="/course" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-white hover:bg-[#101010] hover:text-white text-[#101010] border border-[#c8c7be] text-xs font-bold transition">
              Pelatihan
            </a>
            <a href="/event" class="min-h-[44px] inline-flex items-center px-4 py-2 rounded-full bg-white hover:bg-[#101010] hover:text-white text-[#101010] border border-[#c8c7be] text-xs font-bold transition">
              Job Fair
            </a>
          </div>
        </div>

        <!-- 1. Baca Juga: Artikel & Panduan Lolos Kerja Terbaru -->
        <section aria-labelledby="heading-article-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8 shadow-xs">
          <div class="mb-6 pb-3 border-b border-[#d7d6cf]">
            <SubsectionHeader
              title="Baca Juga: Panduan Karier &amp; Tips Lolos Seleksi"
              level={2}
              eyebrow="Wawasan & Strategi Melamar"
              eyebrowColor="text-[#1738D1]"
              rightContent={true}
            >
              <a slot="right" href="/career" class="min-h-[44px] inline-flex items-center text-xs font-bold text-[#1738D1] hover:underline shrink-0">
                Lihat Semua Artikel
              </a>
            </SubsectionHeader>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {topArticles.map((art) => (
              <OrganicCardSmall
                image={art.image}
                imageAlt={art.title}
                category={art.category}
                date={art.date ? `${art.date} · ${art.readTime}` : art.readTime}
                title={art.title}
                href={`/career/${art.slug}`}
                description={art.excerpt}
                actionText="Baca Artikel"
                surfaceColor="#f4f3ee"
              />
            ))}
          </div>
        </section>

        <!-- 2. Baca Juga: Sertifikasi Resmi yang Sedang Membuka Pendaftaran -->
        <section aria-labelledby="heading-sertifikasi-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8 shadow-xs">
          <div class="mb-6 pb-3 border-b border-[#d7d6cf]">
            <SubsectionHeader
              title="Sertifikasi Resmi yang Sedang Buka"
              level={2}
              eyebrow="Peningkatan Kualifikasi CV"
              eyebrowColor="text-[#047857]"
              rightContent={true}
            >
              <a slot="right" href="/sertifikasi" class="min-h-[44px] inline-flex items-center text-xs font-bold text-[#1738D1] hover:underline shrink-0">
                Lihat Semua Sertifikasi
              </a>
            </SubsectionHeader>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {topSertifikasi.map((sert) => (
              <OrganicCardSmall
                image={sert.image}
                imageAlt={sert.title}
                category={sert.issuer}
                date={sert.duration}
                title={sert.title}
                href={`/sertifikasi/${sert.slug}`}
                description={sert.description}
                price={sert.price}
                actionText="Daftar Ujian"
                surfaceColor="#f4f3ee"
              />
            ))}
          </div>
        </section>

        <!-- Mid-Bottom Leaderboard Ad Slot -->
        <AdSlot
          type="leaderboard"
          className="!px-0 !my-2"
          badge="SKILL"
          tagText="REKOMENDASI KELAS"
          title="Kuasai Keterampilan Digital Praktis Bersama Mentor Industri"
          note="Ikuti kelas persiapan kerja berbasis studi kasus nyata untuk memperkuat portofolio lamaranmu."
          ctaText="Eksplor Kelas"
          ctaHref="/course"
        />

        <!-- 3. Baca Juga: Course & Pelatihan Skill Digital Pilihan -->
        <section aria-labelledby="heading-course-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8 shadow-xs">
          <div class="mb-6 pb-3 border-b border-[#d7d6cf]">
            <SubsectionHeader
              title="Course &amp; Pelatihan Kerja Terbuka"
              level={2}
              eyebrow="Kuasai Keterampilan yang Dicari HRD"
              eyebrowColor="text-[#1738D1]"
              rightContent={true}
            >
              <a slot="right" href="/course" class="min-h-[44px] inline-flex items-center text-xs font-bold text-[#1738D1] hover:underline shrink-0">
                Lihat Semua Pelatihan
              </a>
            </SubsectionHeader>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {topCourses.map((crs) => (
              <OrganicCardSmall
                image={crs.image}
                imageAlt={crs.title}
                category={`${crs.level} · ${crs.provider}`}
                date={crs.duration}
                title={crs.title}
                href={`/course/${crs.slug}`}
                description={crs.description}
                price={crs.price}
                actionText="Lihat Kelas"
                surfaceColor="#f4f3ee"
              />
            ))}
          </div>
        </section>

        <!-- 4. Baca Juga: Event & Job Fair Terdekat -->
        <section aria-labelledby="heading-event-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8 shadow-xs">
          <div class="mb-6 pb-3 border-b border-[#d7d6cf]">
            <SubsectionHeader
              title="Event &amp; Job Fair Terdekat"
              level={2}
              eyebrow="Networking & Walk-In Interview"
              eyebrowColor="text-[#047857]"
              rightContent={true}
            >
              <a slot="right" href="/event" class="min-h-[44px] inline-flex items-center text-xs font-bold text-[#1738D1] hover:underline shrink-0">
                Lihat Semua Event
              </a>
            </SubsectionHeader>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {topEvents.map((evt) => (
              <OrganicCardSmall
                image={evt.image}
                imageAlt={evt.title}
                category={`${evt.format} · ${evt.type}`}
                date={`${evt.day} ${evt.month} 2026`}
                title={evt.title}
                href={`/event/${evt.slug}`}
                location={evt.location}
                price={evt.price}
                actionText="Daftar Hadir"
                surfaceColor="#f4f3ee"
              />
            ))}
          </div>
        </section>

      </div>
    </div>
  </main>

  <FooterPortal />
  <SearchModal />
</BaseLayout>
