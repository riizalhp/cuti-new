---
// CareerTipsSection.astro - Career Tips & Articles + Career Tools Sidebar
import { artikelList, ensureData } from '../data/mock';

await ensureData();
const artikelSnapshot = [...artikelList];

const featured = artikelSnapshot[0];
const subCards = artikelSnapshot.slice(6, 8).concat(artikelSnapshot.slice(3, 5));
---

<section class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#1738d1]">Employer Job Insight</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight">Career Tips & Panduan Sukses</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1.5 leading-relaxed">
          Insight, tips menyusun CV ATS, teknik wawancara kerja, dan peta jalan pengembangan diri untuk karier masa depan.
        </p>
      </div>

      <div class="hidden lg:block max-w-xs text-right">
        <blockquote class="font-serif italic text-base text-slate-700 leading-snug">
          "Langkah kecil hari ini, bisa jadi perubahan besar untuk masa depanmu."
        </blockquote>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1 block">Employer Job Editorial</span>
      </div>
    </div>

    <!-- Category Pills & Link -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
        <button class="px-4 py-1.5 rounded-full bg-[#1738d1] text-white text-xs font-bold shrink-0">Semua</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0 transition">Tips Karier</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0 transition">CV & Interview</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0 transition">Pengembangan Diri</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0 transition">Dunia Kerja</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0 transition">Industri & Teknologi</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0 transition">Remote Work</button>
      </div>

      <a href="/career" class="hidden sm:flex items-center gap-1 text-xs font-bold text-[#1738d1] hover:underline shrink-0">
        <span>Lihat Semua Artikel</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- 3-Column Grid with Perfectly Matched Vertical Heights -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- Col 1: Featured In-Depth Guide (5 cols) -->
      <div class="lg:col-span-5 bg-slate-50/50 rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between h-full">
        <div>
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
            <img src={featured.image} alt={featured.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#1738d1] text-white shadow-sm">
              Panduan Unggulan
            </span>
            <button type="button" aria-label="Simpan" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 flex items-center justify-center text-slate-600 hover:text-[#1738d1] shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
              </svg>
            </button>
          </div>

          <div class="p-6">
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
              <span class="font-semibold text-slate-800">{featured.author}</span>
              <span>·</span>
              <span>{featured.date}</span>
              <span>·</span>
              <span>{featured.readTime}</span>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-slate-900 leading-snug mb-3">
              <a href={"/career/" + featured.slug} class="hover:text-[#1738d1] transition">{featured.title}</a>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
              {featured.excerpt}
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-0 border-t border-slate-200/80 mt-2 flex items-center justify-between text-xs text-slate-500">
          <span>{featured.date} · {featured.readTime}</span>
          <a href={"/career/" + featured.slug} class="font-semibold text-[#1738d1] hover:underline flex items-center gap-1">
            <span>Baca Panduan Lengkap</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Stacked Middle Articles (4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        {subCards.map((item) => (
          <div class="bg-slate-50/50 rounded-2xl border border-slate-200 overflow-hidden flex items-center gap-3 hover:border-blue-300 transition shadow-sm group p-1.5">
            <!-- Thumbnail -->
            <div class="w-28 sm:w-32 h-24 rounded-xl overflow-hidden bg-slate-100 shrink-0 relative">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              <span class="absolute bottom-1.5 left-1.5 text-[8px] font-bold uppercase tracking-wider text-white bg-slate-900/80 px-1.5 py-0.5 rounded">
                {item.readTime}
              </span>
            </div>
            <div class="flex-1 min-w-0 py-1 pr-2">
              <span class="inline-block text-[9px] font-bold uppercase tracking-wider text-[#1738d1] bg-blue-50 px-2 py-0.5 rounded mb-1">
                {item.category}
              </span>
              <h4 class="text-xs sm:text-[13px] font-semibold text-slate-900 group-hover:text-[#1738d1] transition line-clamp-2 leading-snug">
                <a href={"/career/" + item.slug}>{item.title}</a>
              </h4>
              <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-1.5">
                <span>{item.date}</span>
                <span>·</span>
                <span>{item.author}</span>
              </div>
            </div>
            <button type="button" aria-label="Simpan" class="text-slate-300 hover:text-slate-600 shrink-0 pr-2 self-start pt-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
              </svg>
            </button>
          </div>
        ))}
      </div>

      <!-- Col 3: Career Toolset & Downloads (3 cols) - Fills Blank Space Completely! -->
      <div class="lg:col-span-3 flex flex-col gap-4">

        <!-- Card 1: Download Template CV ATS Free -->
        <div class="bg-gradient-to-br from-emerald-50/80 via-white to-teal-50/40 rounded-2xl border border-emerald-200/80 p-5 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="px-2 py-0.5 rounded-md text-[9px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800">
              Download Gratis
            </span>
            <span class="text-[10px] text-emerald-700 font-semibold">Rating 4.9/5</span>
          </div>

          <h3 class="text-sm font-semibold text-slate-900 leading-snug mb-1">
            Paket Template CV ATS & Surat Lamaran 2026
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-3">
            Format standar rekruter BUMN & multinasional. Siap edit dalam format DOCX & Google Docs.
          </p>

          <div class="text-[10px] text-slate-500 mb-3 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>35.000+ talenta telah mengunduh</span>
          </div>

          <a
            href="/career#template"
            class="w-full py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold text-center transition flex items-center justify-center gap-1.5 shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Unduh Template (DOCX)</span>
          </a>
        </div>

        <!-- Card 2: AI CV Matcher & Reviewer Tool -->
        <div class="bg-gradient-to-br from-blue-50/90 via-indigo-50/50 to-white rounded-2xl border border-blue-200/80 p-5 shadow-sm">
          <div class="flex items-center gap-1.5 text-[#1738d1] mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#1738d1]">Fitur Cerdas</span>
          </div>

          <h3 class="text-sm font-semibold text-slate-900 leading-snug mb-1">
            Cek Skor & Kesesuaian CV ATS
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Bandingkan kata kunci CV kamu dengan kualifikasi lowongan incaran dalam 30 detik.
          </p>

          <a
            href="/career"
            class="w-full py-2.5 px-3 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-semibold text-center transition flex items-center justify-center gap-1 shadow-sm"
          >
            <span>Cek Skor CV Sekarang →</span>
          </a>
        </div>

        <!-- Card 3: Komunitas Diskusi Karier -->
        <div class="bg-slate-50/80 rounded-2xl border border-slate-200 p-4 shadow-sm flex items-center justify-between gap-3">
          <div class="min-w-0">
            <h4 class="text-xs font-bold text-slate-900 truncate">Grup Diskusi & Info Loker</h4>
            <p class="text-[11px] text-slate-500 truncate">12.500+ member Telegram aktif</p>
          </div>
          <a
            href="https://t.me"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-blue-400 hover:text-[#1738d1] text-xs font-semibold text-slate-700 transition shrink-0 shadow-2xs"
          >
            Gabung →
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

          </form>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100">
          <span class="font-serif italic text-base text-slate-800 rotate-[-2deg] block leading-tight">
            Same People Brighter Opportunities
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom Popular Topics Row -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#1738d1] flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-900 block">Jelajahi Topik Populer</span>
          <span class="text-[10px] text-slate-400">Temukan artikel sesuai dengan minat dan kebutuhan kariermu</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-xs">
        <a href="/career?q=interview" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Interview
        </a>
        <a href="/career?q=cv" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          CV & Portofolio
        </a>
        <a href="/career?q=skill" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Skill Development
        </a>
        <a href="/career?q=switch" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Career Switch
        </a>
        <a href="/career?q=remote" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Remote Work
        </a>
        <a href="/career?q=ai" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          AI & Teknologi
        </a>
        <a href="/career?q=balance" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Work-Life Balance
        </a>
      </div>
    </div>
  </div>
</section>
