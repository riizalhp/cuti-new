---
import '../styles/global.css';
import '../styles/employer.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  faqSchema?: Record<string, any>;
  breadcrumbSchema?: Record<string, any>;
}

const {
  title,
  description,
  keywords = 'Employr, CV builder, resume builder, ATS friendly CV, career compass, job application tracker, career workspace, buat CV ATS, career operating system',
  ogImage = 'https://employr.id/images/hero-section.webp',
  ogType = 'website',
  canonicalUrl = 'https://employr.id/',
  faqSchema,
  breadcrumbSchema,
} = Astro.props;

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://employr.id/#organization',
      name: 'Employr',
      alternateName: 'Employr — Career Operating System',
      url: 'https://employr.id/',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://employr.id/#logo',
        url: 'https://employr.id/logo.webp',
        width: 512,
        height: 512,
      },
      description:
        'Your career workspace for the next step: build CVs, find your fit, and tailor your experience for every role.',
      sameAs: [
        'https://www.instagram.com/employr.id',
        'https://www.linkedin.com/company/employr-id',
        'https://www.tiktok.com/@employr.id',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://employr.id/#website',
      url: 'https://employr.id/',
      name: 'Employr',
      publisher: { '@id': 'https://employr.id/#organization' },
    },
    {
      '@type': 'WebPage',
      '@id': 'https://employr.id/#webpage',
      url: canonicalUrl,
      name: title,
      description: description,
      isPartOf: { '@id': 'https://employr.id/#website' },
      about: { '@id': 'https://employr.id/#organization' },
      inLanguage: 'en-US',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://employr.id/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://employr.id/',
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://employr.id/#webapp',
      name: 'Employr',
      url: 'https://employr.id/',
      description:
        'Build ATS-friendly CVs, match your skills to job requirements, and track every application without the hassle.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'All',
      publisher: { '@id': 'https://employr.id/#organization' },
      offers: {
        '@type': 'Offer',
        price: '19000',
        priceCurrency: 'IDR',
        description: 'Lifetime Membership access.',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="site-bg" itemscope itemtype="https://schema.org/WebPage">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Employr" />
    <meta name="publisher" content="Employr" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#f4f3ee" />

    <!-- Image Source for legacy parsers / SEO extensions -->
    <link rel="image_src" href={ogImage} />

    <!-- Favicons & Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Employr: Career Operating System" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Employr" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Employr: Career Operating System" />

    <!-- Preconnect & Google Fonts (DM Sans · Instrument Sans · Instrument Serif · Inter Tight · Manrope) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..800;1,9..40,300..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Inter+Tight:ital,wght@0,300..900;1,300..900&family=Manrope:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body>
    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // ---------- Header scroll-state (smart reveal, hide on scroll down, auto-show on idle) ----------
      const header = document.querySelector('.site-header');
      if (header) {
        let lastScrollY = window.scrollY;
        let isSolid = window.scrollY > 60;
        let isHidden = false;
        let idleTimer: any = null;

        const IDLE_DELAY = 2200; // 2.2 detik tanpa scroll -> otomatis muncul kembali

        if (isSolid) {
          header.classList.add('site-header--solid');
        }

        const showHeader = () => {
          if (isHidden) {
            isHidden = false;
            header.classList.remove('site-header--hidden');
            header.classList.add('site-header--visible');
          }
        };

        const hideHeader = () => {
          // Jangan sembunyikan jika menu mobile terbuka atau masih di area hero teratas
          if (header.classList.contains('is-menu-open') || window.scrollY <= 100) return;
          if (!isHidden) {
            isHidden = true;
            header.classList.remove('site-header--visible');
            header.classList.add('site-header--hidden');
          }
        };

        const resetIdleTimer = () => {
          if (idleTimer) clearTimeout(idleTimer);
          idleTimer = setTimeout(() => {
            // Setelah lama tidak di-scroll -> muncul lagi secara otomatis
            showHeader();
          }, IDLE_DELAY);
        };

        const onScroll = () => {
          const currentScrollY = window.scrollY;
          const diff = currentScrollY - lastScrollY;

          // 1. Morph ke floating solid navbar saat lewat hero
          if (currentScrollY > 60) {
            if (!isSolid) {
              isSolid = true;
              header.classList.add('site-header--solid');
            }
          } else {
            if (isSolid) {
              isSolid = false;
              header.classList.remove('site-header--solid');
              showHeader();
            }
          }

          // 2. Arah scroll: scroll ke bawah -> sembunyi, scroll ke atas -> muncul
          if (isSolid) {
            // Filter jitter kecil (toleransi 8px)
            if (Math.abs(diff) > 8) {
              if (diff > 0 && currentScrollY > 120) {
                // Scroll ke bawah -> sembunyikan navbar
                hideHeader();
              } else if (diff < 0) {
                // Scroll ke atas -> munculkan navbar
                showHeader();
              }
              lastScrollY = currentScrollY;
            }
          } else {
            lastScrollY = currentScrollY;
          }

          // 3. Reset idle timer: kalau berhenti scroll -> muncul lagi
          resetIdleTimer();
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        resetIdleTimer();
      }

      // ---------- Motion (hormati prefers-reduced-motion) ----------
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        // Parallax halus hanya pada artefak visual yang ada di DOM
        const parallaxLayers: Array<[string, number]> = [
          ['.hero__product', -13],
          ['.versions__stage', 9],
        ];

        parallaxLayers.forEach(([selector, yPercent]) => {
          const el = document.querySelector(selector);
          if (!el) return;
          gsap.to(el, {
            yPercent,
            ease: 'none',
            scrollTrigger: {
              trigger: el.closest('section') ?? el,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 0.85,
            },
          });
        });

        ScrollTrigger.refresh();
      }
    </script>

    <!-- Visitor Tracker Script -->
    <script is:inline>
      (function() {
        var VISITOR_KEY = 'cuti_visitor_id';
        var SESSION_KEY = 'cuti_session_id';
        var LAST_ACTIVE_KEY = 'cuti_session_last_active';
        var TIMEOUT = 30 * 60 * 1000;

        function getCookie(name) {
          var m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return m ? decodeURIComponent(m[2]) : null;
        }
        function setCookie(name, val, days) {
          var exp = new Date(Date.now() + (days || 365) * 864e5).toUTCString();
          document.cookie = name + '=' + encodeURIComponent(val) + '; expires=' + exp + '; path=/; SameSite=Lax';
        }

        var visId = localStorage.getItem(VISITOR_KEY) || getCookie(VISITOR_KEY);
        if (!visId) {
          visId = 'vis_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9);
        }
        localStorage.setItem(VISITOR_KEY, visId);
        setCookie(VISITOR_KEY, visId, 365);

        var now = Date.now();
        var lastActive = sessionStorage.getItem(LAST_ACTIVE_KEY);
        var sessId = sessionStorage.getItem(SESSION_KEY);
        if (!sessId || !lastActive || (now - parseInt(lastActive, 10)) > TIMEOUT) {
          sessId = 'sess_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9);
          sessionStorage.setItem(SESSION_KEY, sessId);
        }
        sessionStorage.setItem(LAST_ACTIVE_KEY, now.toString());

        var ua = navigator.userAgent;
        var device_type = 'Desktop';
        if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) device_type = 'Tablet';
        else if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry/i.test(ua)) device_type = 'Mobile';

        var os = 'Unknown OS';
        if (/Windows/i.test(ua)) os = 'Windows';
        else if (/Macintosh|Mac OS X/i.test(ua)) os = 'macOS';
        else if (/iPhone|iPad|iPod/i.test(ua)) os = 'iOS';
        else if (/Android/i.test(ua)) os = 'Android';
        else if (/Linux/i.test(ua)) os = 'Linux';

        var browser = 'Browser';
        var browser_version = '';
        if (/Edg\/([0-9.]+)/i.test(ua)) { browser = 'Edge'; browser_version = RegExp.$1; }
        else if (/Chrome\/([0-9.]+)/i.test(ua)) { browser = 'Chrome'; browser_version = RegExp.$1; }
        else if (/Safari\/([0-9.]+)/i.test(ua) && !/Chrome/i.test(ua)) { browser = 'Safari'; browser_version = RegExp.$1; }
        else if (/Firefox\/([0-9.]+)/i.test(ua)) { browser = 'Firefox'; browser_version = RegExp.$1; }

        var ref = document.referrer || '';
        var params = new URLSearchParams(window.location.search);
        var utm_source = params.get('utm_source') || undefined;
        var utm_medium = params.get('utm_medium') || undefined;
        var utm_campaign = params.get('utm_campaign') || undefined;

        var source = 'Direct';
        if (utm_source) {
          source = 'Campaign (' + utm_source + (utm_medium ? ' / ' + utm_medium : '') + ')';
        } else if (ref) {
          try {
            var refHost = new URL(ref).hostname.toLowerCase();
            var currHost = window.location.hostname.toLowerCase();
            if (refHost === currHost || refHost.endsWith('.' + currHost) || (currHost.includes('employr.id') && refHost.includes('employr.id'))) {
              source = 'Internal Navigation';
            } else if (refHost.includes('google.')) {
              source = 'Google Organic';
            } else if (refHost.includes('bing.') || refHost.includes('yahoo.') || refHost.includes('duckduckgo.') || refHost.includes('ecosia.')) {
              source = 'Search Engine';
            } else if (refHost.includes('instagram.com') || refHost.includes('l.instagram.com')) {
              source = 'Instagram';
            } else if (refHost.includes('tiktok.com')) {
              source = 'TikTok';
            } else if (refHost.includes('threads.net')) {
              source = 'Threads';
            } else if (refHost.includes('facebook.com') || refHost.includes('fb.com')) {
              source = 'Facebook';
            } else if (refHost.includes('twitter.com') || refHost.includes('t.co') || refHost.includes('x.com')) {
              source = 'Twitter / X';
            } else if (refHost.includes('linkedin.com') || refHost.includes('lnkd.in')) {
              source = 'LinkedIn';
            } else if (refHost.includes('whatsapp.com') || refHost.includes('wa.me')) {
              source = 'WhatsApp';
            } else if (refHost.includes('youtube.com') || refHost.includes('youtu.be')) {
              source = 'YouTube';
            } else if (refHost.includes('telegram.org') || refHost.includes('t.me')) {
              source = 'Telegram';
            } else {
              source = 'Referral (' + refHost.replace(/^www\./, '') + ')';
            }
          } catch(e) {
            source = 'Referral (External)';
          }
        }

        var isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' || /^(\d{1,3}\.){3}\d{1,3}$/.test(window.location.hostname);
        var trackEndpoint = isDev
          ? window.location.protocol + '//' + window.location.hostname + ':3002/api/track'
          : 'https://masterdata.employr.id/api/track';

        function send(action, dur) {
          var payload = {
            action: action,
            visitor_id: visId,
            session_id: sessId,
            url: window.location.href,
            path: window.location.pathname,
            title: document.title || 'Employr Web',
            hostname: window.location.hostname,
            domain: window.location.hostname.replace(/:\d+$/, ''),
            device: { device_type: device_type, browser: browser, browser_version: browser_version, os: os, screen_resolution: window.screen.width + 'x' + window.screen.height },
            traffic: { traffic_source: source, referrer: ref, utm_source: utm_source, utm_medium: utm_medium, utm_campaign: utm_campaign },
            duration_increment_sec: dur || 25
          };
          var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
          if (navigator.sendBeacon) {
            navigator.sendBeacon(trackEndpoint, blob);
          } else {
            fetch(trackEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true }).catch(function() {});
          }
        }

        send('page_view');
        setInterval(function() {
          if (document.visibilityState === 'visible') send('heartbeat', 25);
        }, 25000);
      })();
    </script>
  </body>
</html>
