---
// SearchModal.astro - Unified multi-category search overlay
---

<div
  id="global-search-modal"
  class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden items-start justify-center p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Pencarian Direktori Karier"
>
  <div class="bg-white rounded-2xl w-full max-w-3xl shadow-2xl border border-slate-200 overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
    <!-- Search Input Header -->
    <div class="p-4 sm:p-5 border-b border-slate-200 flex items-center gap-3 bg-slate-50/50">
      <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="text"
        id="modal-search-input"
        placeholder="Cari lowongan, artikel, event, course, atau sertifikasi..."
        class="w-full text-base sm:text-lg text-slate-900 placeholder-slate-400 outline-none bg-transparent font-medium"
        autofocus
      />
      <button
        type="button"
        id="close-search-modal"
        class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition cursor-pointer"
        aria-label="Tutup pencarian"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Category Filter Tabs inside Modal -->
    <div class="px-4 py-2.5 border-b border-slate-100 flex items-center gap-2 overflow-x-auto text-xs font-bold no-scrollbar">
      <button data-tab="all" class="search-tab-btn px-3 py-1.5 rounded-lg bg-[#1738d1] text-white">Semua</button>
      <button data-tab="lowongan" class="search-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100">Lowongan (4)</button>
      <button data-tab="artikel" class="search-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100">Artikel (8)</button>
      <button data-tab="sertifikasi" class="search-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100">Sertifikasi (4)</button>
      <button data-tab="course" class="search-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100">Course (3)</button>
      <button data-tab="event" class="search-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100">Event (4)</button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results-box" class="p-4 sm:p-6 max-h-[60vh] overflow-y-auto space-y-3">
      <!-- Default Quick Suggestions -->
      <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Rekomendasi Pencarian</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <a href="/lowongan?exp=fresh" class="p-3 rounded-xl border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 flex items-center justify-between group transition">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-blue-50 text-[#1738d1] flex items-center justify-center text-xs font-bold">L</span>
            <span class="text-xs font-bold text-slate-800 group-hover:text-[#1738d1]">Lowongan Fresh Graduate</span>
          </div>
          <span class="text-[10px] text-slate-400">4 Lowongan</span>
        </a>
        <a href="/sertifikasi?q=google" class="p-3 rounded-xl border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 flex items-center justify-between group transition">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-xs font-bold">S</span>
            <span class="text-xs font-bold text-slate-800 group-hover:text-[#1738d1]">Google Data Analytics</span>
          </div>
          <span class="text-[10px] text-slate-400">Sertifikasi</span>
        </a>
        <a href="/career?cat=cv" class="p-3 rounded-xl border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 flex items-center justify-between group transition">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs font-bold">A</span>
            <span class="text-xs font-bold text-slate-800 group-hover:text-[#1738d1]">Panduan CV ATS-Friendly</span>
          </div>
          <span class="text-[10px] text-slate-400">Artikel</span>
        </a>
        <a href="/event" class="p-3 rounded-xl border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 flex items-center justify-between group transition">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-xs font-bold">E</span>
            <span class="text-xs font-bold text-slate-800 group-hover:text-[#1738d1]">Jakarta Career Expo 2026</span>
          </div>
          <span class="text-[10px] text-slate-400">Job Fair</span>
        </a>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <span>Tekan <kbd class="px-1.5 py-0.5 rounded bg-white border border-slate-300 font-mono text-[10px]">ESC</kbd> untuk menutup</span>
      <a href="/lowongan" class="font-bold text-[#1738d1] hover:underline">Buka Direktori Lengkap →</a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('global-search-modal');
    const openBtn = document.getElementById('open-search-btn');
    const heroBtn = document.getElementById('hero-search-btn');
    const heroInput = document.getElementById('hero-search-input');
    const closeBtn = document.getElementById('close-search-modal');
    const modalInput = document.getElementById('modal-search-input');

    function openModal(initialQuery) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalInput) {
        if (initialQuery) modalInput.value = initialQuery;
        modalInput.focus();
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    openBtn?.addEventListener('click', () => openModal(''));
    heroBtn?.addEventListener('click', () => openModal(heroInput?.value || ''));
    heroInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') openModal(heroInput.value);
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>
