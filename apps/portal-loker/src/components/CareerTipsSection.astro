---
// CareerTipsSection.astro - Career Tips & Articles + Newsletter Box
import { artikelList } from '../data/mock';

const featured = artikelList[0];
const subCards = artikelList.slice(6, 8).concat(artikelList.slice(3, 5));
---

<section class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-[11px] font-medium uppercase tracking-wider text-[#1738d1]">Employer Job Insight</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-medium text-slate-900 tracking-tight">Career Tips & Articles</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Dapatkan insight, tips, dan panduan praktis seputar karier, pengembangan diri, dunia kerja, hingga teknologi masa depan.
        </p>
      </div>

      <div class="hidden lg:block max-w-xs text-right">
        <blockquote class="font-serif italic text-base text-slate-700 leading-snug">
          "Langkah kecil hari ini, bisa jadi perubahan besar untuk masa depanmu."
        </blockquote>
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1 block">Employer Job</span>
      </div>
    </div>

    <!-- Category Pills & Link -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
        <button class="px-4 py-1.5 rounded-full bg-[#1738d1] text-white text-xs font-bold shrink-0">Semua</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0">Tips Karier</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0">CV & Interview</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0">Pengembangan Diri</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0">Dunia Kerja</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0">Industri & Teknologi</button>
        <button class="px-4 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shrink-0">Remote Work</button>
      </div>

      <a href="/career" class="hidden sm:flex items-center gap-1 text-xs font-bold text-[#1738d1] hover:underline shrink-0">
        <span>Lihat Semua Artikel</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Col 1: Featured Left (5 cols) -->
      <div class="lg:col-span-5 bg-slate-50/50 rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
        <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
          <img src={featured.image} alt={featured.title} class="w-full h-full object-cover" loading="lazy" />
          <span class="absolute top-3 left-3 px-3 py-1 rounded-md text-[10px] font-medium uppercase tracking-wider bg-[#1738d1] text-white shadow-sm">
            Tips Karier
          </span>
          <button type="button" aria-label="Simpan" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 flex items-center justify-center text-slate-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
            </svg>
          </button>
        </div>

        <div class="p-6">
          <h3 class="text-lg sm:text-xl font-medium text-slate-900 leading-snug mb-3">
            <a href={"/career/" + featured.slug} class="hover:text-[#1738d1] transition">{featured.title}</a>
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
            {featured.excerpt}
          </p>
          <div class="pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs text-slate-500">
            <span>{featured.date} · {featured.readTime}</span>
            <a href={"/career/" + featured.slug} class="font-bold text-[#1738d1] hover:underline flex items-center gap-1">
              <span>Baca Selengkapnya</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Stacked Middle (4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        {subCards.map((item) => (
          <div class="bg-slate-50/50 rounded-2xl border border-slate-200 p-3.5 flex items-center gap-3 hover:border-blue-300 transition group">
            <div class="w-20 h-16 rounded-xl overflow-hidden bg-slate-100 shrink-0">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
            </div>
            <div class="flex-1 min-w-0">
              <span class="inline-block text-[9px] font-extrabold uppercase tracking-wider text-[#1738d1] bg-blue-50 px-2 py-0.5 rounded mb-1">
                {item.category}
              </span>
              <h4 class="text-xs font-bold text-slate-900 group-hover:text-[#1738d1] transition line-clamp-2 leading-snug">
                <a href={"/career/" + item.slug}>{item.title}</a>
              </h4>
              <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-1">
                <span>{item.date}</span>
                <span>·</span>
                <span>{item.readTime}</span>
              </div>
            </div>
            <button type="button" aria-label="Simpan" class="text-slate-300 hover:text-slate-600 shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
              </svg>
            </button>
          </div>
        ))}
      </div>

      <!-- Col 3: Employer Job Newsletter Box (3 cols) -->
      <div class="lg:col-span-3 bg-gradient-to-b from-blue-50/80 via-white to-blue-50/50 rounded-2xl border border-blue-200/80 p-6 flex flex-col justify-between shadow-sm relative">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#1738d1] text-white flex items-center justify-center mb-4 shadow-md shadow-blue-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <span class="text-[10px] font-medium uppercase tracking-wider text-slate-400 block mb-1">Employer Job Newsletter</span>
          <h3 class="text-lg font-medium text-slate-900 leading-snug mb-2">
            Insight Karier Langsung ke Inbox Kamu
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-5">
            Dapatkan artikel terbaru, tips karier, info event, dan peluang kerja setiap minggu.
          </p>

          <!-- Input Email Form -->
          <form class="space-y-3" onsubmit="alert('Terima kasih telah berlangganan newsletter Employer Job!'); return false;">
            <div class="relative">
              <input
                type="email"
                placeholder="Masukkan email kamu"
                required
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs text-slate-800 bg-white placeholder-slate-400 outline-none focus:border-[#1738d1] pr-10"
              />
              <button type="submit" aria-label="Daftar" class="absolute right-1.5 top-1.5 w-7 h-7 rounded-lg bg-[#1738d1] text-white flex items-center justify-center hover:bg-[#122ca6] transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>
            <p class="text-[10px] text-slate-400 font-medium">
              Bergabung dengan 50.000+ pembaca lainnya
            </p>
          </form>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100">
          <span class="font-serif italic text-base text-slate-800 rotate-[-2deg] block leading-tight">
            Same People Brighter Opportunities
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom Popular Topics Row -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-blue-50 text-[#1738d1] flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-slate-900 block">Jelajahi Topik Populer</span>
          <span class="text-[10px] text-slate-400">Temukan artikel sesuai dengan minat dan kebutuhan kariermu</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-xs">
        <a href="/career?q=interview" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Interview
        </a>
        <a href="/career?q=cv" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          CV & Portofolio
        </a>
        <a href="/career?q=skill" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Skill Development
        </a>
        <a href="/career?q=switch" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Career Switch
        </a>
        <a href="/career?q=remote" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Remote Work
        </a>
        <a href="/career?q=ai" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          AI & Teknologi
        </a>
        <a href="/career?q=balance" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition">
          Work-Life Balance
        </a>
      </div>
    </div>
  </div>
</section>
