---
// SertifikatSection.astro - Sertifikasi Profesional with Cult UI Cutout Cards
import { sertifikasiList, ensureData } from '../data/mock';
import OrganicCardSmall from './common/OrganicCardSmall.astro';

await ensureData();
const topSertifikasi = [...sertifikasiList].slice(0, 4);
---

<section id="sertifikasi" class="py-8 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <div class="section-label mb-2.5">
          <span>02</span>
          <i></i>
          <span>SERTIFIKASI RESMI</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight">
          Validasi keahlianmu,<br class="hidden sm:inline" />
          <em>dengan sertifikasi kredibel.</em>
        </h2>
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-3.5 leading-relaxed font-medium max-w-xl">
          Tingkatkan bobot profil kariermu dengan sertifikasi resmi standar nasional BNSP dan global (Google, AWS, Microsoft).
        </p>
      </div>

      <a
        href="/sertifikasi"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start sm:self-auto group"
      >
        <span>Lihat Semua Sertifikasi</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 4 Sertifikasi Cards (Horizontal Snap Carousel di Mobile, Grid di Tablet/Desktop) -->
    <div class="flex overflow-x-auto snap-x snap-mandatory sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-7 pb-4 sm:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar">
      {topSertifikasi.length === 0 ? (
        <div class="col-span-full text-center py-12 text-sm text-[#6e6d68] bg-white rounded-[28px] border border-[#d7d6cf]">
          Belum ada data sertifikasi yang dimuat. Silakan periksa kembali nanti.
        </div>
      ) : (
        topSertifikasi.map((cert) => (
          <OrganicCardSmall
            className="shrink-0 w-[275px] sm:w-auto snap-start"
            image={cert.image}
            imageAlt={cert.title}
            category={cert.issuer}
            date={cert.duration}
            title={cert.title}
            href={`/sertifikasi/${cert.slug}`}
            description={cert.description}
            price={cert.price}
            badge={cert.level}
            actionText="Lihat Persyaratan"
          />
        ))
      )}
    </div>
  </div>
</section>
