---
// PilihanKamuSection.astro - 4 Highlight Cards + 1 Google Ads Card
import { topPicks } from '../data/mock';
---

<section class="py-10 bg-white border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-[11px] font-medium uppercase tracking-wider text-[#1738d1]">Rekomendasi</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-medium text-slate-900 tracking-tight">Pilihan Untuk Kamu</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Informasi terbaru dan peluang terkurasi yang sedang banyak dicari.</p>
      </div>
    </div>

    <!-- 5 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {topPicks.map((item) => (
        <a href={item.link} class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400 transition-all flex flex-col">
          <!-- Thumbnail with category pill -->
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class={"absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-md text-[10px] font-medium uppercase tracking-wider " + item.badgeColor + " shadow-sm"}>
              {item.type}
            </span>
          </div>

          <!-- Card Body -->
          <div class="p-3.5 flex flex-col flex-1 justify-between gap-2">
            <div>
              <span class="text-[11px] font-medium text-slate-400 block mb-1">{item.date}</span>
              <h3 class="text-xs sm:text-[13px] font-medium text-slate-900 group-hover:text-[#1738d1] transition-colors line-clamp-2 leading-snug">
                {item.title}
              </h3>
            </div>

            <!-- Meta details -->
            <div class="flex items-center gap-3 text-[11px] text-slate-500 pt-2 border-t border-slate-100">
              <span class="flex items-center gap-1 truncate">
                <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                </svg>
                {item.meta1}
              </span>
              <span class="flex items-center gap-1 shrink-0">
                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                {item.meta2}
              </span>
            </div>
          </div>
        </a>
      ))}

      <!-- Card 5: Native Google Ads Slot -->
      <div class="bg-gradient-to-br from-blue-50/70 via-indigo-50/40 to-white rounded-2xl border border-blue-200/80 p-4 flex flex-col justify-between relative shadow-sm">
        <!-- Google Ads Tag -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[#4285F4]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#EA4335]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#FBBC05]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#34A853]"></span>
            <span class="text-[10px] font-medium text-slate-500 uppercase tracking-wider ml-1">Google Ads</span>
          </div>
          <span class="text-[9px] font-medium text-slate-400 bg-white/80 px-2 py-0.5 rounded-full border border-slate-200">Sponsor</span>
        </div>

        <div class="my-3">
          <h3 class="text-sm font-medium text-slate-900 leading-snug mb-1">
            Your Business Here
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Jangkau talent terbaik dan generasi muda Indonesia di sini.
          </p>
        </div>

        <a
          href="/tentang#iklan"
          class="w-full py-2.5 px-3 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-medium text-center shadow-sm shadow-blue-500/20 transition active:scale-[0.98] flex items-center justify-center gap-1"
        >
          <span>Pasang Iklan Sekarang</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
