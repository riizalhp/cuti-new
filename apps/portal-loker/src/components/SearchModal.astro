---
// SearchModal.astro - Unified multi-category search overlay
---

<div
  id="global-search-modal"
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-start justify-center p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Pencarian Direktori Karier"
>
  <div class="bg-[#f4f3ee] rounded-2xl w-full max-w-3xl shadow-2xl border border-[#d7d6cf] overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
    <!-- Search Input Header -->
    <div class="p-4 sm:p-5 border-b border-[#d7d6cf] flex items-center gap-3 bg-white">
      <svg class="w-5 h-5 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="text"
        id="modal-search-input"
        placeholder="Cari lowongan, artikel, event, course, atau sertifikasi..."
        class="w-full text-base sm:text-lg text-[#101010] placeholder-[#a5a5a1] outline-none bg-transparent font-medium"
        autofocus
      />
      <button
        type="button"
        id="close-search-modal"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#6e6d68] hover:text-[#101010] hover:bg-[#101010]/5 transition cursor-pointer"
        aria-label="Tutup pencarian"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Category Filter Tabs inside Modal -->
    <div class="px-4 py-3 border-b border-[#d7d6cf] flex items-center gap-2 overflow-x-auto text-xs font-bold no-scrollbar bg-[#f4f3ee]">
      <button data-tab="all" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-[#101010] text-white">Semua</button>
      <button data-tab="lowongan" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Lowongan (4)</button>
      <button data-tab="artikel" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Artikel (8)</button>
      <button data-tab="sertifikasi" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Sertifikasi (4)</button>
      <button data-tab="course" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Course (3)</button>
      <button data-tab="event" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Event (4)</button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results-box" class="p-4 sm:p-6 max-h-[60vh] overflow-y-auto space-y-3 bg-[#f4f3ee]">
      <!-- Default Quick Suggestions -->
      <div class="section-label mb-3"><span>REKOMENDASI PENCARIAN</span><i></i></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <a href="/lowongan?exp=fresh" class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#0000ff] flex items-center justify-between group transition shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-blue-50 text-[#0000ff] flex items-center justify-center text-xs font-bold border border-blue-100">L</span>
            <span class="text-xs font-bold text-[#101010] group-hover:text-[#0000ff]">Lowongan Fresh Graduate</span>
          </div>
          <span class="text-[10px] font-bold text-[#6e6d68] uppercase">4 Loker</span>
        </a>
        <a href="/sertifikasi?q=google" class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#0000ff] flex items-center justify-between group transition shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-amber-50 text-amber-700 flex items-center justify-center text-xs font-bold border border-amber-200">S</span>
            <span class="text-xs font-bold text-[#101010] group-hover:text-[#0000ff]">Google Data Analytics</span>
          </div>
          <span class="text-[10px] font-bold text-[#6e6d68] uppercase">Sertifikasi</span>
        </a>
        <a href="/career?cat=cv" class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#0000ff] flex items-center justify-between group transition shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center text-xs font-bold border border-emerald-200">A</span>
            <span class="text-xs font-bold text-[#101010] group-hover:text-[#0000ff]">Panduan CV ATS-Friendly</span>
          </div>
          <span class="text-[10px] font-bold text-[#6e6d68] uppercase">Artikel</span>
        </a>
        <a href="/event" class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#0000ff] flex items-center justify-between group transition shadow-xs">
          <div class="flex items-center gap-2.5">
            <span class="w-7 h-7 rounded-full bg-purple-50 text-purple-700 flex items-center justify-center text-xs font-bold border border-purple-200">E</span>
            <span class="text-xs font-bold text-[#101010] group-hover:text-[#0000ff]">Jakarta Career Expo 2026</span>
          </div>
          <span class="text-[10px] font-bold text-[#6e6d68] uppercase">Job Fair</span>
        </a>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-4 bg-white border-t border-[#d7d6cf] flex items-center justify-between text-xs text-[#6e6d68]">
      <span>Tekan <kbd class="px-2 py-0.5 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] font-mono text-[10px] text-[#101010]">ESC</kbd> untuk menutup</span>
      <a href="/lowongan" class="font-bold text-[#0000ff] hover:underline">Buka Direktori Lengkap →</a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('global-search-modal');
    const openBtn = document.getElementById('open-search-btn');
    const heroBtn = document.getElementById('hero-search-btn');
    const heroInput = document.getElementById('hero-search-input');
    const closeBtn = document.getElementById('close-search-modal');
    const modalInput = document.getElementById('modal-search-input');

    function openModal(initialQuery) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalInput) {
        if (initialQuery) modalInput.value = initialQuery;
        modalInput.focus();
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    openBtn?.addEventListener('click', () => openModal(''));
    heroBtn?.addEventListener('click', () => openModal(heroInput?.value || ''));
    heroInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') openModal(heroInput.value);
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>
