---
import '../styles/global.css';
import '../styles/employer.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  faqSchema?: Record<string, any>;
  breadcrumbSchema?: Record<string, any>;
}

const {
  title,
  description,
  ogImage = 'https://employr.id/images/cuti-hero.png',
  ogType = 'website',
  canonicalUrl = 'https://employr.id/',
  faqSchema,
  breadcrumbSchema,
} = Astro.props;

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://employr.id/#organization',
      name: 'Employr',
      alternateName: 'Employr — Career Operating System',
      url: 'https://employr.id/',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://employr.id/#logo',
        url: 'https://employr.id/logo.webp',
        width: 512,
        height: 512,
      },
      description:
        'Your career workspace for the next step: build CVs, find your fit, and tailor your experience for every role.',
      sameAs: [
        'https://www.instagram.com/employr.id',
        'https://www.linkedin.com/company/employr-id',
        'https://www.tiktok.com/@employr.id',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://employr.id/#website',
      url: 'https://employr.id/',
      name: 'Employr',
      publisher: { '@id': 'https://employr.id/#organization' },
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://employr.id/#webapp',
      name: 'Employr',
      url: 'https://employr.id/',
      description:
        'Build ATS-friendly CVs, match your skills to job requirements, and track every application without the hassle.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'All',
      publisher: { '@id': 'https://employr.id/#organization' },
      offers: {
        '@type': 'Offer',
        price: '19000',
        priceCurrency: 'IDR',
        description: 'Lifetime Membership access.',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="site-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#f4f3ee" />

    <!-- Favicons & Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Employr: Career Operating System" />
    <meta property="og:site_name" content="Employr" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Employr: Career Operating System" />

    <!-- Preconnect & Google Fonts (DM Sans · Instrument Sans · Instrument Serif · Inter Tight · Manrope) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..800;1,9..40,300..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Inter+Tight:ital,wght@0,300..900;1,300..900&family=Manrope:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </head>
  <body>
    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // ---------- Header scroll-state (smooth morph & hysteresis) ----------
      const header = document.querySelector('.site-header');
      if (header) {
        let isSolid = window.scrollY > 50;
        if (isSolid) header.classList.add('site-header--solid');

        ScrollTrigger.create({
          start: 'top -50px',
          onEnter: () => {
            if (isSolid) return;
            isSolid = true;
            header.classList.add('site-header--solid');
            gsap.fromTo(
              header,
              { opacity: 0, y: -20 },
              { opacity: 1, y: 0, duration: 0.35, ease: 'power3.out' }
            );
          },
          onLeaveBack: () => {
            if (!isSolid) return;
            isSolid = false;
            header.classList.remove('site-header--solid');
            gsap.set(header, { clearProps: 'all' });
            gsap.fromTo(
              header,
              { opacity: 0, y: -10 },
              { opacity: 1, y: 0, duration: 0.25, ease: 'power2.out', clearProps: 'all' }
            );
          },
        });
      }

      // ---------- Motion (hormati prefers-reduced-motion) ----------
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        // Parallax halus hanya pada foto & artefak visual (bukan teks utama)
        const parallaxLayers: Array<[string, number]> = [
          ['.hero__product', -13],
          ['.builder__visual', -9],
          ['.career-observation__image img', 8],
          ['.pricing__scene img', 7],
          ['.versions__stage', 9],
          ['.pivot__photo img', 10],
          ['.final-cta > img', -8],
        ];

        parallaxLayers.forEach(([selector, yPercent]) => {
          const el = document.querySelector(selector);
          if (!el) return;
          gsap.to(el, {
            yPercent,
            ease: 'none',
            scrollTrigger: {
              trigger: el.closest('section') ?? el,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 0.85,
            },
          });
        });

        // Horizontal job rail — dipin di desktop, native scroll di mobile
        const jobs = document.querySelector<HTMLElement>('.jobs');
        const rail = document.querySelector<HTMLElement>('.job-rail');
        const desktopMotion = window.matchMedia('(min-width: 701px)');

        if (jobs && rail && desktopMotion.matches) {
          const getDistance = () => Math.max(0, rail.scrollWidth - window.innerWidth + 92);
          gsap.to(rail, {
            x: () => -getDistance(),
            ease: 'none',
            scrollTrigger: {
              trigger: jobs,
              start: 'top top+=90',
              end: () => `+=${getDistance()}`,
              pin: true,
              pinSpacing: true,
              scrub: 0.9,
              invalidateOnRefresh: true,
            },
          });
        }

        ScrollTrigger.refresh();
      }
    </script>

    <!-- Visitor Tracker Script -->
    <script is:inline>
      (function() {
        var VISITOR_KEY = 'cuti_visitor_id';
        var SESSION_KEY = 'cuti_session_id';
        var LAST_ACTIVE_KEY = 'cuti_session_last_active';
        var TIMEOUT = 30 * 60 * 1000;

        function getCookie(name) {
          var m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return m ? decodeURIComponent(m[2]) : null;
        }
        function setCookie(name, val, days) {
          var exp = new Date(Date.now() + (days || 365) * 864e5).toUTCString();
          document.cookie = name + '=' + encodeURIComponent(val) + '; expires=' + exp + '; path=/; SameSite=Lax';
        }

        var visId = localStorage.getItem(VISITOR_KEY) || getCookie(VISITOR_KEY);
        if (!visId) {
          visId = 'vis_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9);
        }
        localStorage.setItem(VISITOR_KEY, visId);
        setCookie(VISITOR_KEY, visId, 365);

        var now = Date.now();
        var lastActive = sessionStorage.getItem(LAST_ACTIVE_KEY);
        var sessId = sessionStorage.getItem(SESSION_KEY);
        if (!sessId || !lastActive || (now - parseInt(lastActive, 10)) > TIMEOUT) {
          sessId = 'sess_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9);
          sessionStorage.setItem(SESSION_KEY, sessId);
        }
        sessionStorage.setItem(LAST_ACTIVE_KEY, now.toString());

        var ua = navigator.userAgent;
        var device_type = 'Desktop';
        if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) device_type = 'Tablet';
        else if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry/i.test(ua)) device_type = 'Mobile';

        var os = 'Unknown OS';
        if (/Windows/i.test(ua)) os = 'Windows';
        else if (/Macintosh|Mac OS X/i.test(ua)) os = 'macOS';
        else if (/iPhone|iPad|iPod/i.test(ua)) os = 'iOS';
        else if (/Android/i.test(ua)) os = 'Android';
        else if (/Linux/i.test(ua)) os = 'Linux';

        var browser = 'Browser';
        var browser_version = '';
        if (/Edg\/([0-9.]+)/i.test(ua)) { browser = 'Edge'; browser_version = RegExp.$1; }
        else if (/Chrome\/([0-9.]+)/i.test(ua)) { browser = 'Chrome'; browser_version = RegExp.$1; }
        else if (/Safari\/([0-9.]+)/i.test(ua) && !/Chrome/i.test(ua)) { browser = 'Safari'; browser_version = RegExp.$1; }
        else if (/Firefox\/([0-9.]+)/i.test(ua)) { browser = 'Firefox'; browser_version = RegExp.$1; }

        var ref = document.referrer || '';
        var params = new URLSearchParams(window.location.search);
        var utm_source = params.get('utm_source') || undefined;
        var utm_medium = params.get('utm_medium') || undefined;
        var utm_campaign = params.get('utm_campaign') || undefined;

        var source = 'Direct';
        if (utm_source) source = 'Campaign (' + utm_source + (utm_medium ? ' / ' + utm_medium : '') + ')';
        else if (ref.includes('google.')) source = 'Google Organic';
        else if (ref.includes('instagram.com')) source = 'Instagram';
        else if (ref.includes('tiktok.com')) source = 'TikTok';
        else if (ref.includes('facebook.com')) source = 'Facebook';
        else if (ref.includes('linkedin.com')) source = 'LinkedIn';
        else if (ref.includes('whatsapp.com')) source = 'WhatsApp';
        else if (ref && !ref.includes(window.location.hostname)) source = 'Referral';

        function send(action, dur) {
          var payload = {
            action: action,
            visitor_id: visId,
            session_id: sessId,
            url: window.location.href,
            path: window.location.pathname,
            title: document.title || 'Employr Web',
            device: { device_type: device_type, browser: browser, browser_version: browser_version, os: os, screen_resolution: window.screen.width + 'x' + window.screen.height },
            traffic: { traffic_source: source, referrer: ref, utm_source: utm_source, utm_medium: utm_medium, utm_campaign: utm_campaign },
            duration_increment_sec: dur || 25
          };
          var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track', blob);
          } else {
            fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true }).catch(function() {});
          }
        }

        send('page_view');
        setInterval(function() {
          if (document.visibilityState === 'visible') send('heartbeat', 25);
        }, 25000);
      })();
    </script>
  </body>
</html>
