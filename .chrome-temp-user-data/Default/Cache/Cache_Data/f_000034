  (function() {
    const modal = document.getElementById('global-search-modal');
    const openBtn = document.getElementById('open-search-btn');
    const closeBtn = document.getElementById('close-search-modal');
    const modalInput = document.getElementById('modal-search-input');
    const tabBtns = document.querySelectorAll('.search-tab-btn');
    let currentTarget = '/lowongan';

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('bg-[#101010]', 'text-white');
          b.classList.add('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        });
        btn.classList.remove('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        btn.classList.add('bg-[#101010]', 'text-white');
        currentTarget = btn.getAttribute('data-target') || '/lowongan';
      });
    });

    function openModal(initialQuery) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalInput) {
        if (initialQuery) modalInput.value = initialQuery;
        modalInput.focus();
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function executeSearch() {
      const q = modalInput?.value?.trim() || '';
      const dest = currentTarget || '/lowongan';
      window.location.href = `${dest}${q ? '?q=' + encodeURIComponent(q) : ''}`;
    }

    openBtn?.addEventListener('click', () => openModal(''));
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    modalInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeSearch();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
