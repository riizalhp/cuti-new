---
const companyCategories = [
  {
    title: 'Teknologi & Startup',
    companies: [
      { name: 'GoTo / Tokopedia', role: 'UI/UX Intern & Marketing', location: 'Jakarta', count: '140+ alumni' },
      { name: 'Shopee Indonesia', role: 'Operations & CS Specialist', location: 'Jakarta', count: '115+ alumni' },
      { name: 'Traveloka', role: 'Product Design Associate', location: 'BSD / Remote', count: '85+ alumni' },
      { name: 'Bibit & Stockbit', role: 'Junior Frontend & Marketing', location: 'Jakarta', count: '92+ alumni' },
      { name: 'Dana Indonesia', role: 'Customer Success & HR Assistant', location: 'Jakarta', count: '78+ alumni' },
      { name: 'Ruangguru', role: 'Content Writer & Lead Gen', location: 'Jakarta', count: '105+ alumni' },
    ],
  },
  {
    title: 'BUMN & Perbankan',
    companies: [
      { name: 'Bank BCA', role: 'Management Trainee & Teller', location: 'Nasional', count: '160+ alumni' },
      { name: 'Bank Mandiri', role: 'Officer Development Program', location: 'Nasional', count: '135+ alumni' },
      { name: 'Telkomsel & Telkom', role: 'Digital Apprentice & Admin', location: 'Bandung & Jakarta', count: '120+ alumni' },
      { name: 'BRI (Bank Rakyat Indonesia)', role: 'Frontliner & Digital Support', location: 'Nasional', count: '145+ alumni' },
    ],
  },
  {
    title: 'FMCG & Industri Kreatif',
    companies: [
      { name: 'Unilever Indonesia', role: 'Commercial Intern', location: 'BSD', count: '70+ alumni' },
      { name: 'Paragon Technology (Wardah)', role: 'Brand & Creative Associate', location: 'Tangerang', count: '95+ alumni' },
      { name: 'Indofood', role: 'Supply Chain & Admin Intern', location: 'Jakarta', count: '88+ alumni' },
      { name: 'Nestlé Indonesia', role: 'Sales & Field Associate', location: 'Jakarta', count: '64+ alumni' },
    ],
  },
];

const totalPlacements = '1.250+';
const totalCompanies = '180+';
---

<section class="section user-distribution" id="sebaran-user">
  <div class="section-heading reveal" data-reveal>
    <span class="kicker">SEBARAN ALUMNI & PENGGUNA</span>
    <h2>Pengguna CUTI lolos di <em>perusahaan impian.</em></h2>
    <p>Dari startup teknologi ternama, perbankan BUMN, hingga FMCG raksasa Indonesia.</p>
  </div>

  <div class="distribution-stats reveal" data-reveal>
    <div class="stat-box">
      <strong>{totalPlacements}</strong>
      <span>Talenta Muda Diterima Kerja</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-box">
      <strong>{totalCompanies}</strong>
      <span>Perusahaan & Industry Destination</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat-box">
      <strong>94%</strong>
      <span>Respon Undangan Wawancara</span>
    </div>
  </div>

  <div class="category-tabs-container">
    {companyCategories.map((cat, catIdx) => (
      <div class="category-group reveal" data-reveal>
        <div class="category-header">
          <span class="cat-number">0{catIdx + 1}</span>
          <h3>{cat.title}</h3>
        </div>
        <div class="company-grid">
          {cat.companies.map((comp) => (
            <div class="company-card">
              <div class="comp-badge-top">
                <span class="comp-name">{comp.name}</span>
                <span class="comp-count">{comp.count}</span>
              </div>
              <div class="comp-details">
                <span class="comp-role">{comp.role}</span>
                <span class="comp-location">{comp.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="distribution-footer reveal" data-reveal>
    <p>Ingin nama perusahaan impianmu ada di daftar berikutnya?</p>
    <a href="#akses" class="button button-small">Buat CV & Siapkan Lamaran <span>↗</span></a>
  </div>
</section>

<style>
  .user-distribution {
    background: var(--paper);
    border-bottom: var(--line);
  }

  .distribution-stats {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 32px 40px;
    margin-bottom: 60px;
    border: var(--line);
    background: var(--cobalt);
    color: var(--paper);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-box strong {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    line-height: 1;
    font-weight: 400;
  }

  .stat-box span {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: color-mix(in srgb, var(--paper) 30%, transparent);
  }

  .category-tabs-container {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .category-group {
    border-top: var(--line);
    padding-top: 30px;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .cat-number {
    font-family: var(--serif);
    font-size: 24px;
    color: var(--cobalt);
    font-style: italic;
  }

  .category-header h3 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .company-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .company-card {
    padding: 20px;
    border: var(--line);
    background: #ffffff;
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .company-card:hover {
    transform: translateY(-4px);
    box-shadow: 8px 8px 0 var(--cobalt);
    background: var(--periwinkle);
  }

  .comp-badge-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    gap: 8px;
  }

  .comp-name {
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
  }

  .comp-count {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 99px;
    background: var(--lime);
    color: var(--ink);
    border: 1px solid var(--ink);
    white-space: nowrap;
  }

  .comp-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }

  .comp-role {
    font-weight: 600;
  }

  .comp-location {
    font-size: 12px;
    opacity: 0.75;
  }

  .distribution-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30px 40px;
    margin-top: 60px;
    border: var(--line);
    background: var(--lime);
    color: var(--ink);
  }

  .distribution-footer p {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .distribution-stats {
      flex-direction: column;
      gap: 24px;
      padding: 28px 20px;
    }

    .stat-divider {
      width: 80%;
      height: 1px;
    }

    .company-grid {
      grid-template-columns: 1fr;
    }

    .distribution-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 24px 20px;
    }
  }
</style>
