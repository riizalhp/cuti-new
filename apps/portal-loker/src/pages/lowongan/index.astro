---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterPortal from '../../components/FooterPortal.astro';
import AdSlot from '../../components/AdSlot.astro';
import SearchModal from '../../components/SearchModal.astro';
import PageHero from '../../components/common/PageHero.astro';
import SubsectionHeader from '../../components/common/SubsectionHeader.astro';
import CompanyLogo from '../../components/CompanyLogo.astro';
import {
  lowonganList,
  sertifikasiList,
  courseList,
  eventList,
  artikelList,
  ensureData,
} from '../../data/mock';

await ensureData();
const topSertifikasi = sertifikasiList.slice(0, 3);
const topCourses = courseList.slice(0, 3);
const topEvents = eventList.slice(0, 3);
const topArticles = artikelList.slice(0, 3);

const title = "Direktori Lowongan Kerja Terlengkap | Employer Job";
const lowonganListSnapshot = [...lowonganList];
const description = "Temukan info lowongan kerja terverifikasi untuk fresh graduate, SMA/SMK, mahasiswa, dan profesional muda di seluruh Indonesia.";

// Hitung jumlah lowongan per kategori dari data database
const categoryMap: Record<string, number> = {};
for (const job of lowonganListSnapshot) {
  const cat = job.category || 'Umum';
  categoryMap[cat] = (categoryMap[cat] || 0) + 1;
}

// Map kategori ke label sidebar
const sidebarCategories = [
  { label: 'Teknologi & IT', key: 'IT' },
  { label: 'Perbankan & Finance', key: 'Finance' },
  { label: 'Marketing & Digital', key: 'Marketing' },
  { label: 'Operations & Logistik', key: 'Teknik & Produksi' },
  { label: 'Admin & Operasional', key: 'Admin & Operasional' },
  { label: 'Pendidikan', key: 'Pendidikan' },
  { label: 'Kesehatan', key: 'Kesehatan' },
  { label: 'Lainnya', key: 'Umum' },
].filter(c => (categoryMap[c.key] || 0) > 0);

---

<BaseLayout title={title} description={description} canonicalUrl="http://localhost:3003/lowongan">
  <Navbar />

  <main class="bg-[#f4f3ee] min-h-screen pb-20">
    <!-- Page Hero -->
    <PageHero
      eyebrow="Direktori Karier Terkurasi"
      title="Lowongan Kerja Terbaru di <em>Indonesia</em>"
      description="Peluang karier terverifikasi dari perusahaan rintisan, BUMN, hingga korporasi multinasional untuk fresh graduate dan talenta muda."
      badge={{ text: `${lowonganListSnapshot.length} Lowongan Tersedia`, bgColor: 'bg-blue-50', textColor: 'text-[#0000ff]', borderColor: 'border border-blue-200' }}
    >
      <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-[#6e6d68] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0000ff] transition">Beranda</a>
        <span>/</span>
        <span class="text-[#101010] font-semibold">Lowongan Kerja</span>
      </nav>
    </PageHero>

    <!-- Main Container Layout: 70% Kiri & 30% Kanan Desktop -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-6">
      <!-- Top Leaderboard Google Ads Slot -->
      <AdSlot type="leaderboard" note="Rekomendasi program pelatihan dan bursa kerja nasional." />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mt-6">
        
        <!-- KOLOM KIRI (70%): Daftar Lowongan Utama + Section-Section Lainnya -->
        <div class="lg:col-span-8 space-y-10">
          
          <!-- Filter Quick Pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
            <button class="px-4 py-2 rounded-full bg-[#0000ff] text-white text-xs font-semibold shrink-0 shadow-xs">
              Semua Lowongan
            </button>
            <button class="px-4 py-2 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">
              Fresh Graduate
            </button>
            <button class="px-4 py-2 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">
              Kerja Remote
            </button>
            <button class="px-4 py-2 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">
              Magang &amp; Internship
            </button>
            <button class="px-4 py-2 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">
              BUMN &amp; Perbankan
            </button>
            <button class="px-4 py-2 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">
              IT &amp; Software
            </button>
          </div>

          <!-- Section 1: Daftar Lowongan Utama -->
          <section aria-labelledby="heading-job-list" class="space-y-4">
            <SubsectionHeader title="Daftar Peluang Karier Aktif" rightContent={true}>
              <span slot="right" class="text-xs text-[#6e6d68] font-semibold">Urutkan: Terbaru</span>
            </SubsectionHeader>

            <div class="space-y-4">
              {lowonganListSnapshot.map((job) => (
                <article class="bg-white rounded-2xl p-5 sm:p-6 border border-[#d7d6cf] hover:border-[#0000ff]/30 hover:shadow-[0_12px_30px_-4px_rgba(16,16,16,0.08)] hover:-translate-y-1 transition duration-300 flex flex-col md:flex-row md:items-center justify-between gap-5">
                  <div class="flex items-start gap-4">
                    <CompanyLogo name={job.company} logoUrl={job.companyLogo} size="lg" />
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 flex-wrap mb-1">
                        <span class="text-xs font-semibold text-[#101010]">{job.company}</span>
                        <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] font-medium text-[#6e6d68]">{job.location}</span>
                        <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200 text-[#0000ff] font-semibold">{job.type}</span>
                        {job.badge && (
                          <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-800 font-semibold">
                            {job.badge}
                          </span>
                        )}
                      </div>
                      <h3 class="text-base sm:text-lg font-semibold text-[#101010] hover:text-[#0000ff] transition leading-snug">
                        <a href={`/lowongan/${job.slug}`}>{job.title}</a>
                      </h3>
                      <p class="text-xs text-[#6e6d68] line-clamp-2 mt-1.5 max-w-2xl leading-relaxed">
                        {job.description}
                      </p>
                      <div class="flex items-center gap-3 mt-3 text-xs text-[#6e6d68] flex-wrap">
                        <span class="font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">{job.salary}</span>
                        <span>Pengalaman: {job.experience}</span>
                        <span>Diposting: {job.postedAt}</span>
                      </div>
                    </div>
                  </div>

                  <div class="flex sm:flex-row md:flex-col items-center sm:justify-end gap-2.5 shrink-0 pt-3 md:pt-0 border-t md:border-t-0 border-[#d7d6cf]/50">
                    <a
                      href={`/lowongan/${job.slug}`}
                      class="w-full md:w-36 min-h-[42px] text-center px-4 py-2 rounded-full bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold transition flex items-center justify-center shadow-xs"
                    >
                      Lamar Sekarang
                    </a>
                    <a
                      href={`/lowongan/${job.slug}`}
                      class="w-full md:w-36 min-h-[42px] text-center px-4 py-2 rounded-full bg-white hover:bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf] text-xs font-semibold transition flex items-center justify-center"
                    >
                      Detail Info
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- In-Feed Google Ads Placement di Jeda Antar Section -->
          <AdSlot type="infeed" note="Tingkatkan kualifikasi CV Anda dengan sertifikasi keahlian terakreditasi." />

          <!-- Section 2: Sertifikasi yang Sedang Membuka Pendaftaran -->
          <section aria-labelledby="heading-sertifikasi-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8">
            <div class="mb-6 pb-3 border-b border-[#d7d6cf]/50">
              <SubsectionHeader
                title="Sertifikasi Resmi yang Sedang Buka"
                level={2}
                eyebrow="Peningkatan Kualifikasi CV"
                eyebrowColor="text-emerald-700"
                rightContent={true}
              >
                <a slot="right" href="/sertifikasi" class="text-xs font-semibold text-[#0000ff] hover:underline shrink-0">
                  Lihat Semua Sertifikasi →
                </a>
              </SubsectionHeader>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {topSertifikasi.map((sert) => (
                <article class="p-4 rounded-xl border border-[#d7d6cf] bg-[#f4f3ee] hover:border-[#0000ff]/30 hover:shadow-sm transition flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-[10px] text-[#6e6d68] mb-1.5">
                      <span class="font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">{sert.issuer}</span>
                      <span>{sert.duration}</span>
                    </div>
                    <h3 class="text-xs sm:text-sm font-semibold text-[#101010] hover:text-[#0000ff] transition line-clamp-2 leading-snug">
                      <a href={`/sertifikasi/${sert.slug}`}>{sert.title}</a>
                    </h3>
                    <p class="text-xs text-[#6e6d68] line-clamp-2 mt-1.5">{sert.description}</p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-[#d7d6cf]/50 flex items-center justify-between">
                    <span class="text-xs font-bold text-[#101010]">{sert.price}</span>
                    <a href={`/sertifikasi/${sert.slug}`} class="text-xs font-semibold text-[#0000ff] hover:underline">
                      Daftar Ujian →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Section 3: Course & Pelatihan Skill Digital Pilihan -->
          <section aria-labelledby="heading-course-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8">
            <div class="mb-6 pb-3 border-b border-[#d7d6cf]/50">
              <SubsectionHeader
                title="Course & Pelatihan Kerja Terbuka"
                level={2}
                eyebrow="Kuasai Keterampilan yang Dicari HRD"
                eyebrowColor="text-purple-700"
                rightContent={true}
              >
                <a slot="right" href="/course" class="text-xs font-semibold text-[#0000ff] hover:underline shrink-0">
                  Lihat Semua Pelatihan →
                </a>
              </SubsectionHeader>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {topCourses.map((crs) => (
                <article class="rounded-xl border border-[#d7d6cf] overflow-hidden bg-[#f4f3ee] hover:border-[#0000ff]/30 hover:shadow-sm transition flex flex-col justify-between">
                  <div class="h-28 bg-[#eae8e0] relative overflow-hidden">
                    <img src={crs.image} alt={crs.title} class="w-full h-full object-cover" loading="lazy" />
                    <span class="absolute top-2 left-2 px-2.5 py-0.5 rounded-full bg-[#101010]/80 text-white text-[9px] font-bold">
                      {crs.level}
                    </span>
                  </div>
                  <div class="p-3.5 flex flex-col flex-1 justify-between">
                    <div>
                      <span class="text-[10px] text-[#6e6d68] block mb-1">{crs.provider} · {crs.duration}</span>
                      <h3 class="text-xs sm:text-sm font-semibold text-[#101010] hover:text-[#0000ff] transition line-clamp-2 leading-snug">
                        <a href={`/course/${crs.slug}`}>{crs.title}</a>
                      </h3>
                    </div>
                    <div class="mt-3 pt-2.5 border-t border-[#d7d6cf]/50 flex items-center justify-between">
                      <span class="text-xs font-bold text-emerald-700">{crs.price}</span>
                      <a href={`/course/${crs.slug}`} class="text-xs font-semibold text-[#0000ff] hover:underline">
                        Ikuti Kelas →
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Section 4: Event & Job Fair Terdekat -->
          <section aria-labelledby="heading-event-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8">
            <div class="mb-6 pb-3 border-b border-[#d7d6cf]/50">
              <SubsectionHeader
                title="Agenda Job Fair Terdekat"
                level={2}
                eyebrow="Networking & Walk-In Interview"
                eyebrowColor="text-amber-700"
                rightContent={true}
              >
                <a slot="right" href="/event" class="text-xs font-semibold text-[#0000ff] hover:underline shrink-0">
                  Lihat Semua Event →
                </a>
              </SubsectionHeader>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {topEvents.map((evt) => (
                <article class="p-4 rounded-xl border border-[#d7d6cf] bg-[#f4f3ee] hover:border-[#0000ff]/30 hover:shadow-sm transition flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-2 text-[10px] text-[#6e6d68] mb-2">
                      <span class="font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">{evt.day} {evt.month} 2026</span>
                      <span>{evt.format}</span>
                    </div>
                    <h3 class="text-xs sm:text-sm font-semibold text-[#101010] hover:text-[#0000ff] transition line-clamp-2 leading-snug">
                      <a href={`/event/${evt.slug}`}>{evt.title}</a>
                    </h3>
                    <p class="text-xs text-[#6e6d68] line-clamp-2 mt-1.5">{evt.location}</p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-[#d7d6cf]/50 flex items-center justify-between">
                    <span class="text-xs font-bold text-emerald-700">{evt.price}</span>
                    <a href={`/event/${evt.slug}`} class="text-xs font-semibold text-amber-800 hover:underline">
                      Daftar Hadir →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Section 5: Artikel & Panduan Lolos Kerja Terbaru -->
          <section aria-labelledby="heading-article-section" class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-8">
            <div class="mb-6 pb-3 border-b border-[#d7d6cf]/50">
              <SubsectionHeader
                title="Panduan Karier & CV Terkini"
                level={2}
                eyebrow="Wawasan & Tips Lolos Seleksi"
                eyebrowColor="text-rose-700"
                rightContent={true}
              >
                <a slot="right" href="/career" class="text-xs font-semibold text-[#0000ff] hover:underline shrink-0">
                  Lihat Semua Artikel →
                </a>
              </SubsectionHeader>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {topArticles.map((art) => (
                <article class="p-4 rounded-xl border border-[#d7d6cf] bg-[#f4f3ee] hover:border-[#0000ff]/30 hover:shadow-sm transition flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-[10px] text-[#6e6d68] mb-1.5">
                      <span class="font-bold text-[#0000ff] bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-full">{art.category}</span>
                      <span>{art.readTime}</span>
                    </div>
                    <h3 class="text-xs sm:text-sm font-semibold text-[#101010] hover:text-[#0000ff] transition line-clamp-2 leading-snug">
                      <a href={`/career/${art.slug}`}>{art.title}</a>
                    </h3>
                    <p class="text-xs text-[#6e6d68] line-clamp-2 mt-1.5">{art.excerpt}</p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-[#d7d6cf]/50 flex items-center justify-between">
                    <span class="text-[11px] text-[#6e6d68]">{art.date}</span>
                    <a href={`/career/${art.slug}`} class="text-xs font-semibold text-[#0000ff] hover:underline">
                      Baca Artikel →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>

        </div>

        <!-- KOLOM KANAN (30%): Filter Cepat, MREC Sponsor, Tips Sukses, dan Sticky Skyscraper Ad -->
        <aside class="lg:col-span-4 space-y-6">
          
          <!-- Box 1: Filter Cepat Berdasarkan Kota & Bidang -->
          <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-xs">
            <h3 class="text-sm font-bold text-[#101010] mb-3 pb-2 border-b border-[#d7d6cf]/50 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#0000ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
              Lokasi Populer
            </h3>
            <div class="flex items-center gap-2 flex-wrap">
              <a href="/lowongan?geo=Jakarta" class="px-3 py-1.5 rounded-full bg-[#f4f3ee] hover:bg-blue-50 hover:text-[#0000ff] text-[#101010] border border-[#d7d6cf] hover:border-[#0000ff]/30 text-xs font-semibold transition">
                Jakarta
              </a>
              <a href="/lowongan?geo=Bandung" class="px-3 py-1.5 rounded-full bg-[#f4f3ee] hover:bg-blue-50 hover:text-[#0000ff] text-[#101010] border border-[#d7d6cf] hover:border-[#0000ff]/30 text-xs font-semibold transition">
                Bandung
              </a>
              <a href="/lowongan?geo=Surabaya" class="px-3 py-1.5 rounded-full bg-[#f4f3ee] hover:bg-blue-50 hover:text-[#0000ff] text-[#101010] border border-[#d7d6cf] hover:border-[#0000ff]/30 text-xs font-semibold transition">
                Surabaya
              </a>
              <a href="/lowongan?geo=Yogyakarta" class="px-3 py-1.5 rounded-full bg-[#f4f3ee] hover:bg-blue-50 hover:text-[#0000ff] text-[#101010] border border-[#d7d6cf] hover:border-[#0000ff]/30 text-xs font-semibold transition">
                Yogyakarta
              </a>
              <a href="/lowongan?geo=Remote" class="px-3 py-1.5 rounded-full bg-[#f4f3ee] hover:bg-blue-50 hover:text-[#0000ff] text-[#101010] border border-[#d7d6cf] hover:border-[#0000ff]/30 text-xs font-semibold transition">
                Kerja Remote
              </a>
            </div>

            <h3 class="text-sm font-bold text-[#101010] mt-5 mb-3 pb-2 border-b border-[#d7d6cf]/50 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              Bidang Pekerjaan
            </h3>
            <div class="space-y-1.5 text-xs">
              {sidebarCategories.map((cat) => (
                <a href={`/lowongan?cat=${encodeURIComponent(cat.key)}`} class="flex justify-between py-1 px-2 rounded-lg text-[#101010] hover:bg-[#f4f3ee] hover:text-[#0000ff] transition font-medium">
                  <span>{cat.label}</span>
                  <span class="text-[#6e6d68] font-bold">{categoryMap[cat.key] || 0} Lowongan</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Box 2: Google Ads MREC (300x250) Sponsor B2C -->
          <AdSlot type="mrec" note="Review resume CV otomatis dengan standar penyaring ATS." />

          <!-- Box 3: Tips Sukses Melamar Hari Ini -->
          <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-xs">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-[#0000ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <h4 class="text-xs font-bold text-[#0000ff] uppercase tracking-wider">
                Checklist Melamar Cepat
              </h4>
            </div>
            <ul class="text-xs text-[#101010] space-y-2 mt-2">
              <li class="flex items-start gap-2">
                <span class="text-emerald-700 font-bold">✓</span>
                <span>Kirim lamaran pada jam produktif (08.00 - 11.00 WIB).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-700 font-bold">✓</span>
                <span>Pastikan ukuran file resume PDF tidak melebihi 2MB.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-700 font-bold">✓</span>
                <span>Gunakan format nama file resmi: <em>NamaLengkap_CV.pdf</em>.</span>
              </li>
            </ul>
            <a
              href="http://localhost:3000/cv"
              class="mt-4 min-h-[42px] w-full px-4 py-2 rounded-full bg-[#0000ff] hover:bg-[#1738d1] text-white text-xs font-semibold flex items-center justify-center gap-1.5 transition shadow-xs"
            >
              <span>Optimalkan CV Saya</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>

          <!-- Box 4: High-Viewability Sticky Sidebar Ad (300x600) -->
          <div class="sticky top-24">
            <AdSlot type="skyscraper" note="Program bimbingan karier intensif dan penyaluran kerja." />
          </div>

        </aside>

      </div>
    </div>
  </main>

  <FooterPortal />
  <SearchModal />
</BaseLayout>
