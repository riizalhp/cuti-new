---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterPortal from '../../components/FooterPortal.astro';
import AdSlot from '../../components/AdSlot.astro';
import SearchModal from '../../components/SearchModal.astro';
import DetailCrossSections from '../../components/DetailCrossSections.astro';
import { getPortalCourseBySlug } from '../../lib/data';

const requestedSlug = Astro.params.slug || '';
const course = await getPortalCourseBySlug(requestedSlug);
if (!course) {
  return Astro.redirect('/course');
}
if (requestedSlug !== course.slug) {
  return Astro.redirect(`/course/${course.slug}`, 301);
}
const siteOrigin = Astro.url.origin || 'http://localhost:3003';
const canonical = `${siteOrigin}/course/${course.slug}`;
const title = `Pelatihan ${course.title} (${course.provider}) | Employr`;
const description = `Ikuti pelatihan ${course.title} oleh ${course.provider}. Durasi: ${course.duration}, Level: ${course.level}, Harga: ${course.price}. Silabus kurikulum, benefit kelulusan, dan tautan pendaftaran kelas resmi.`;
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} ogImage={course.image}>
  <Navbar />

  <main class="bg-[#f4f3ee] min-h-screen pb-20">
    <!-- Breadcrumbs Navigation -->
    <div class="bg-white border-b border-[#d7d6cf]">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 py-3.5 sm:py-4">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6e6d68] flex-wrap">
          <a href="/" class="hover:text-[#1738D1] py-1 transition">Beranda</a>
          <span>/</span>
          <a href="/course" class="hover:text-[#1738D1] py-1 transition">Course & Pelatihan</a>
          <span>/</span>
          <span class="text-[#6e6d68] font-medium">{course.provider}</span>
          <span>/</span>
          <span class="text-[#101010] font-semibold truncate max-w-[140px] sm:max-w-xs" aria-current="page">{course.title}</span>
        </nav>
      </div>
    </div>

    <!-- Course Header Card -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-5 sm:pt-6">
      <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 sm:p-8 shadow-xs">
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
          <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6 flex-1 min-w-0">
            <div class="w-full sm:w-48 h-36 sm:h-32 rounded-2xl bg-[#f4f3ee] border border-[#d7d6cf] overflow-hidden shrink-0 shadow-2xs relative">
              <img src={course.image} alt={course.title} class="w-full h-full object-cover" />
              <span class="absolute top-2 left-2 px-2.5 py-0.5 rounded-full bg-[#101010]/80 text-white text-[10px] font-semibold backdrop-blur-xs">
                {course.level}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap mb-1.5">
                <span class="text-sm font-semibold text-[#101010]">{course.provider}</span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-purple-50 border border-purple-200 text-purple-700 text-[11px] font-semibold">
                  {course.category}
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#6e6d68] text-[11px] font-medium">
                  {course.language}
                </span>
              </div>
              <h1 class="text-xl sm:text-2xl lg:text-3xl font-semibold text-[#101010] tracking-tight leading-snug break-words">
                {course.title}
              </h1>
              <div class="flex items-center gap-y-2 gap-x-4 flex-wrap mt-3 text-xs text-[#6e6d68] font-medium">
                <span class="flex items-center gap-1.5 text-emerald-700 font-bold text-sm">
                  {course.price}
                </span>
                {course.certificate && (
                  <span class="text-[#6e6d68] text-xs">
                    Sertifikat kelulusan tersedia
                  </span>
                )}
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  Durasi: {course.duration}
                </span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                  Rating {course.rating} ({course.students} peserta)
                </span>
              </div>

              <!-- Key Benefits Badges -->
              <div class="flex items-center gap-1.5 flex-wrap mt-4">
                {course.benefits.map((b) => (
                  <span class="text-xs px-3 py-1 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#101010] font-medium">
                    {b}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0 w-full lg:w-64 pt-4 lg:pt-0 border-t lg:border-t-0 border-[#d7d6cf]/50">
            <a
              href={course.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full min-h-[44px] px-5 py-3 rounded-full bg-orange-500 hover:bg-orange-600 active:scale-[0.98] text-white font-semibold text-xs shadow-md shadow-orange-500/20 text-center flex items-center justify-center gap-2 transition cursor-pointer"
            >
              <span>Ikuti Kelas di Situs Resmi</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <div class="flex items-center gap-2 w-full">
              <button
                type="button"
                id="btn-bookmark-course"
                class="flex-1 min-h-[44px] px-4 py-2.5 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer active:scale-[0.98]"
              >
                <svg class="w-4 h-4 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <span>Simpan</span>
              </button>
              <button
                type="button"
                id="btn-share-course"
                class="flex-1 min-h-[44px] px-4 py-2.5 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer active:scale-[0.98]"
              >
                <svg class="w-4 h-4 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                <span>Bagikan</span>
              </button>
            </div>
            <span class="text-[11px] text-[#6e6d68] text-center">
              Akses materi seumur hidup dan sertifikat resmi
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Layout (Left Content + Right Sidebar) -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-6 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Detail Information -->
        <div class="lg:col-span-8 space-y-6">
          <!-- 1. Overview -->
          <article class="bg-white rounded-2xl border border-[#d7d6cf] p-5 sm:p-8">
            <h2 class="text-base sm:text-lg font-semibold text-[#101010] mb-4 pb-3 border-b border-[#d7d6cf]/50">
              Gambaran Pelatihan
            </h2>
            <div class="text-sm text-[#101010] leading-relaxed whitespace-pre-line space-y-3">
              <p>{course.description}</p>
            </div>

            <div class="mt-8 pt-6 border-t border-[#d7d6cf]/50">
              <h3 class="text-base font-semibold text-[#101010] mb-3">Keuntungan Belajar di Program Ini:</h3>
              <ul class="space-y-2.5 text-sm text-[#101010]">
                {course.benefits.map((b) => (
                  <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>

          <!-- 2. Curriculum Modules -->
          <article class="bg-white rounded-2xl border border-[#d7d6cf] p-5 sm:p-8">
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#d7d6cf]/50">
              <h2 class="text-base sm:text-lg font-semibold text-[#101010]">
                Silabus Kurikulum Pembelajaran
              </h2>
              <span class="text-xs text-[#6e6d68] font-medium">
                {course.modules.length} Modul Lengkap
              </span>
            </div>

            <div class="space-y-3">
              {course.modules.map((m, idx) => (
                <div class="p-4 rounded-xl bg-[#f4f3ee] border border-[#d7d6cf] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-blue-50 text-[#1738D1] border border-blue-200 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5 sm:mt-0">
                      {idx + 1}
                    </span>
                    <div>
                      <strong class="text-sm font-semibold text-[#101010] block">{m.title}</strong>
                      <span class="text-xs text-[#6e6d68]">{m.lessons}</span>
                    </div>
                  </div>
                  <span class="text-xs font-semibold text-[#101010] shrink-0 bg-white px-3 py-1 rounded-full border border-[#d7d6cf] self-start sm:self-auto">
                    {m.duration}
                  </span>
                </div>
              ))}
            </div>
          </article>

          <!-- 3. Enrollment & Access -->
          <article id="daftar-kelas" class="bg-white rounded-2xl border border-[#d7d6cf] p-5 sm:p-8">
            <h2 class="text-base sm:text-lg font-semibold text-[#101010] mb-3">
              Pendaftaran & Akses Kelas
            </h2>
            <p class="text-sm text-[#6e6d68] leading-relaxed mb-4">
              Pendaftaran dan pembayaran kursus diproses langsung melalui situs resmi penyelenggara ({course.provider}). Setelah mendaftar, kamu akan mendapatkan akses ke video pembelajaran, materi unduhan, dan forum diskusi.
            </p>
            <div class="p-5 rounded-2xl bg-[#f4f3ee] border border-[#d7d6cf] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <span class="text-xs font-semibold text-[#101010] block">Platform Penyelenggara:</span>
                <span class="text-xs text-[#6e6d68]">{course.provider} (Terverifikasi)</span>
              </div>
              <a
                href={course.officialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto min-h-[44px] px-5 py-2.5 rounded-full bg-[#1738D1] hover:bg-[#132EA8] active:scale-[0.98] text-white text-xs font-semibold transition flex items-center justify-center gap-2 shadow-xs"
              >
                <span>Buka Situs Resmi Kursus</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
            </div>
          </article>

          <!-- Google Ads: In-feed Unit (Setelah Alur Pendaftaran Selesai) -->
          <AdSlot type="infeed" note="Pelajari materi pendukung dan uji kompetensi kerja." />
        </div>

        <!-- Right: Sidebar Information & Ads -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-xs">
            <h3 class="text-sm font-semibold text-[#101010] mb-4 pb-2 border-b border-[#d7d6cf]/50">
              Informasi Pelatihan
            </h3>
            <div class="space-y-3 text-xs">
              <div class="flex justify-between py-1 border-b border-[#d7d6cf]/50">
                <span class="text-[#6e6d68]">Penyelenggara</span>
                <span class="font-semibold text-[#101010] text-right">{course.provider}</span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#d7d6cf]/50">
                <span class="text-[#6e6d68]">Biaya Kelas</span>
                <span class="font-bold text-emerald-700 text-right">{course.price}</span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#d7d6cf]/50">
                <span class="text-[#6e6d68]">Total Durasi</span>
                <span class="font-semibold text-[#101010] text-right">{course.duration}</span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#d7d6cf]/50">
                <span class="text-[#6e6d68]">Tingkat Kesulitan</span>
                <span class="font-semibold text-[#101010] text-right">{course.level}</span>
              </div>
              <div class="flex justify-between py-1 border-b border-[#d7d6cf]/50">
                <span class="text-[#6e6d68]">Bahasa Pengantar</span>
                <span class="font-semibold text-[#101010] text-right">{course.language}</span>
              </div>
              <div class="flex justify-between py-1">
                <span class="text-[#6e6d68]">Sertifikat Kelulusan</span>
                <span class="font-semibold text-emerald-700 text-right">Tersedia</span>
              </div>
            </div>
          </div>

          <!-- Certification Value -->
          <div class="bg-[#f4f3ee] rounded-2xl border border-[#d7d6cf] p-5">
            <h4 class="text-xs font-bold text-[#101010] uppercase tracking-wider mb-1">
              Portofolio Nyata
            </h4>
            <p class="text-xs text-[#6e6d68] leading-relaxed mt-2">
              Selesaikan seluruh studi kasus dalam kursus ini untuk dicantumkan pada portofolio dan CV kamu saat melamar pekerjaan.
            </p>
          </div>

          <!-- Google Ads: High-Viewability Sticky Sidebar Unit (300x600) -->
          <div class="sticky top-24">
            <AdSlot type="skyscraper" note="Jangkau ribuan pelajar dan fresh graduate yang aktif meningkatkan skill." />
          </div>
        </aside>
      </div>

      <!-- Google Ads: Leaderboard horizontal sebelum rekomendasi -->
      <AdSlot type="leaderboard" note="Rekomendasi kursus dan bootcamp terverifikasi." />

      <!-- 5 Cross-Section Modules (Rekomendasi Lainnya) -->
      <DetailCrossSections
        currentType="course"
        currentSlug={course.slug}
        category={course.category}
        geo={course.geoTag}
      />
    </div>
  </main>

  <FooterPortal />
  <SearchModal />

  <!-- Native Floating Feedback Toast -->
  <div
    id="detail-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 translate-y-3"
  >
    <div class="px-4 py-2.5 rounded-full bg-[#101010] text-white text-xs font-semibold shadow-xl border border-white/10 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <span id="detail-toast-msg">Tersimpan</span>
    </div>
  </div>

  <!-- Script for Toast Feedback -->
  <script is:inline>
    function triggerToast(text) {
      const toast = document.getElementById('detail-toast');
      const msg = document.getElementById('detail-toast-msg');
      if (!toast || !msg) return;
      msg.textContent = text;
      toast.classList.remove('opacity-0', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-3');
      }, 2400);
    }

    const shareBtn = document.getElementById('btn-share-course');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } catch (err) {}
        } else {
          navigator.clipboard.writeText(window.location.href);
          triggerToast('Tautan pelatihan berhasil disalin!');
        }
      });
    }

    const bookmarkBtn = document.getElementById('btn-bookmark-course');
    if (bookmarkBtn) {
      bookmarkBtn.addEventListener('click', () => {
        triggerToast('Pelatihan disimpan ke daftar favorit!');
      });
    }
  </script>

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Course",
        "name": course.title,
        "description": course.description,
        "provider": {
          "@type": "Organization",
          "name": course.provider
        },
        "offers": {
          "@type": "Offer",
          "price": course.price === "Gratis" ? "0" : course.price,
          "priceCurrency": "IDR",
          "category": "Education"
        },
        "url": canonical
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${siteOrigin}/` },
          { "@type": "ListItem", "position": 2, "name": "Pelatihan", "item": `${siteOrigin}/course` },
          { "@type": "ListItem", "position": 3, "name": course.title, "item": canonical }
        ]
      }
    ]
  })} />
</BaseLayout>
