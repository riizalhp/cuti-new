                        <div>
                          <div class="flex items-center justify-between gap-1.5 mb-1.5">
                            <span class="text-[11px] font-bold text-[#6e6d68] uppercase tracking-wider truncate">
                              {job.company}
                            </span>
                            {job.badge ? (
                              <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${
                                job.badge === 'Hot' ? 'bg-amber-50 text-amber-800 border border-amber-200/80' : 'bg-blue-50 text-[#1738D1] border border-blue-100'
                              }`}>
                                {job.badge}
                              </span>
                            ) : null}
                          </div>
                          <h3 class="text-xs font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-1.5 flex items-center">
                            {job.position}
                          </h3>
                          <div class="flex items-center gap-1.5 text-[10.5px] text-[#6e6d68] font-medium mb-2.5 flex-wrap">
                            <span class="inline-flex items-center gap-1 text-[#101010] font-semibold">
                              <svg class="w-3 h-3 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                              </svg>
                              {job.location}
                            </span>
                            <span>·</span>
                            <span>{job.type}</span>
                          </div>
                        </div>
                        <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex flex-col gap-1.5 mt-auto">
                          <div class="flex items-center justify-between gap-1.5">
                            <span class="font-bold text-[#101010] text-xs truncate">{job.salary}</span>
                            <span class="text-[10px] font-semibold text-[#1738D1] shrink-0 flex items-center gap-0.5">
                              Lihat
                              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                              </svg>
                            </span>
                          </div>
                          <div class="flex items-center gap-1.5 text-[10px] text-[#6e6d68]">
                            <svg class="w-3 h-3 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="truncate">{job.postedTime}</span>
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </details>
              </div>

              <!-- Panel Halaman 2 (11 Loker Berikutnya + 1 Edukasi/Tools Tracker) -->
              <div id="job-grid-page-2" data-job-page-panel="2" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-3.5 hidden">
                {/* 4 Loker Pertama Halaman 2 (Slot 1, 2, 3, 4) */}
                {page2Jobs.slice(0, 4).map((job) => (
                  <a
                    href={`/lowongan/${job.slug}`}
                    class="group bg-white rounded-xl border border-[#d7d6cf] p-3.5 flex flex-col justify-between hover:border-[#1738D1]/40 hover:shadow-[0_8px_20px_-4px_rgba(16,16,16,0.06)] hover:-translate-y-0.5 transition-all duration-200 relative overflow-hidden"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1.5 mb-1.5">
                        <span class="text-[11px] font-bold text-[#6e6d68] uppercase tracking-wider truncate">
                          {job.company}
                        </span>
                        {job.badge ? (
                          <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${
                            job.badge === 'Hot' ? 'bg-amber-50 text-amber-800 border border-amber-200/80' : 'bg-blue-50 text-[#1738D1] border border-blue-100'
                          }`}>
                            {job.badge}
                          </span>
                        ) : null}
                      </div>
                      <h3 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center">
                        {job.position}
                      </h3>
