---
/**
 * Employr landing — port 1:1 dari employer-career-platform/client/src/pages/Home.tsx
 * Cinematic Surrealism: metafora karier puitis, warm paper, film grain,
 * tipografi editorial, dan Employr Blue sebagai sinyal yang presisi.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/employer/Icon.astro';
import CvArtifact from '../components/employer/CvArtifact.astro';
import CompanyTicker from '../components/employer/CompanyTicker.astro';
import HeroCanvas from '../components/employer/HeroCanvas';
import ScrollAnimations from '../components/employer/ScrollAnimations';
import WhyEmployr from '../components/employer/WhyEmployr';

import dashboard3 from '../assets/dashboard-3.webp';
import dashboard4 from '../assets/dashboard-4.webp';
import dashboard1 from '../assets/dashboard-1.webp';
import dashboard2 from '../assets/dashboard-2.webp';
import ReviewsCarousel from '../components/employer/ReviewsCarousel';
import FooterReveal from '../components/employer/FooterReveal';

const heroImage = '/images/hero-section.webp';
const logoMark = '/logo.webp';

const navItems = [
  ['Product', '#product'],
  ['Jobs', '#jobs'],
  ['Career', '#career'],
  ['Insights', '#resources'],
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Employr only for fresh graduates?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Anyone actively looking for work, making a career switch, or wanting to polish their portfolio and CV can use Employr.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I create multiple CV versions in one account?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Every role requires a different focus. You can save dedicated versions for UI/UX, marketing, or any other role without overwriting previous drafts.',
      },
    },
  ],
};
---

<BaseLayout
  title="Employr: Your CV Workspace & Career Compass"
  description="Build ATS-friendly CVs, match your skills to job requirements, and track every application without the hassle."
  canonicalUrl="https://employr.id/"
  faqSchema={faqSchema}
>
  <div id="top" class="site-shell">
    <ScrollAnimations client:load />

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="top-announcement">
      <div class="announcement-content">
        <a href="/pre-register" class="announcement-link">
          Join the Early Access Waitlist <Icon name="chevron-right" size={13} />
        </a>
      </div>
    </div>

    <main class="site-main">
      <!-- HERO FRAME CONTAINER (FRAMED CARD CANVAS) -->
      <div class="hero-frame-container">
      <section class="hero-card" aria-labelledby="hero-title">
        <!-- Background Image & Washes -->
        <HeroCanvas client:only="react" />
        <img class="hero__image" src={heroImage} alt="Young professional crossing a surreal city district with a glowing blue career path" />
        <div class="hero__wash"></div>
        <div class="hero__grain"></div>

        <!-- Integrated Header Navigation (Inside Hero Card) -->
        <header class="site-header">
          <div class="header-left">
            <nav class="desktop-nav" aria-label="Main navigation">
              {navItems.map(([label, href]) => <button data-navigate={href}>{label}</button>)}
            </nav>
          </div>

          <a href="#top" class="brand-mark brand-mark--center" aria-label="Employr Home">
            <img src={logoMark} alt="Employr" class="brand-logo-main" />
          </a>

          <div class="header-actions">
            <button class="login-link" data-toast="Sign in will be available at launch.">Sign In</button>
            <a class="header-cta" href="/pre-register">Early Access <Icon name="move-up-right" size={14} /></a>
            <button class="menu-toggle" aria-label="Navigation menu" aria-expanded="false" data-menu-button>
              <span class="menu-toggle__bar menu-toggle__bar--top"></span>
              <span class="menu-toggle__bar menu-toggle__bar--mid"></span>
              <span class="menu-toggle__bar menu-toggle__bar--bot"></span>
            </button>
          </div>
        </header>

        <!-- Mobile Nav Backdrop & Glass Sheet Drawer -->
        <div class="mobile-nav-backdrop" data-menu-backdrop></div>
        <nav class="mobile-nav" aria-label="Mobile navigation" data-menu>
          <button class="mobile-nav__close" aria-label="Close menu" data-menu-close>
            <Icon name="x" size={18} />
          </button>
          <div class="mobile-nav__links">
            {navItems.map(
              ([label, href]) => (
                <button data-navigate={href}>
                  <span>{label}</span>
                  <Icon name="chevron-right" size={18} />
                </button>
              )
            )}
          </div>
          <div class="mobile-nav__footer">
            <a class="mobile-nav__login" href="/login">Sign In</a>
            <a class="mobile-start" href="/pre-register">Early Access <Icon name="arrow-up-right" size={16} /></a>
          </div>
        </nav>

        <!-- Hero Content -->
        <div class="hero__inner">
          <div class="hero__content">
            <h1 id="hero-title">Your career starts<br /><em>right here, right now.</em></h1>
          </div>
          <div class="hero__content hero__content--right">
            <p class="hero__subtitle">Your next chapter<br /><em>starts with you.</em></p>
          </div>
        </div>

        <div class="hero__scroll"><span>SCROLL TO EXPLORE</span><i></i></div>
      </section>
    </div>

    <!-- COMPANY TICKER / MARQUEE (UNIFIED LIGHT PAPER THEME) -->
    <CompanyTicker variant="light" />

    <!-- 01 STATEMENT -->
    <section class="statement section-space" id="product">
        <div class="editorial-frame statement__frame">
          <div class="section-label"><span>01</span><i></i><span>YOUR CAREER, YOUR WAY</span></div>
          <div class="statement__body">
            <h2>Your experience<br />is bigger than <em>one resume.</em></h2>
            <p>Your skills don't fit neatly into rigid templates. Employr helps you turn every project and achievement into real proof that recruiters notice.</p>
          </div>
          <div class="statement__tick"><span>01</span><i></i><span>07</span></div>
        </div>
      </section>

      <!-- WHY EMPLOYR -->
      <WhyEmployr client:load />

      <!-- 03 ADAPT -->
      <section class="adapt section-space" id="career">
        <div class="adapt__intro editorial-frame">
          <div class="section-label"><span>03</span><i></i><span>ADAPT</span></div>
          <h2>One rigid template<br /><em>won't work for every company.</em></h2>
          <p>Every job looks for specific points. Highlight the experience that matters most for the role you want.</p>
        </div>
        <div class="adapt__flow editorial-frame">
          <div class="adapt__original"><p>FULL CV</p><CvArtifact variant="mini" /></div>
          <div class="adapt__scanner"><Icon name="scan-line" size={22} /><span>HIGHLIGHTING<br />KEY POINTS</span><i></i></div>
          <div class="adapt__target"><p>TAILORED CV</p><CvArtifact variant="mini" /></div>
        </div>
        <div class="adapt__footer editorial-frame">
          <div><span class="blue-dot"></span> Keyword alignment <span class="blue-dot"></span> Targeted action points <span class="blue-dot"></span> Skill priority</div>
          <button class="action-link" data-toast="CV adaptation coming soon.">Adapt Your CV Now <Icon name="arrow-up-right" /></button>
        </div>
      </section>

      <!-- 04 MANAGE -->
      <section class="versions section-space" aria-labelledby="versions-title">
        <div class="versions__headline">
          <div class="section-label section-label--inverse"><span>04</span><i></i><span>MANAGE</span></div>
          <h2 id="versions-title">One profile.<br /><em>Many target roles.</em></h2>
          <p>Apply as a UI Designer, Product Manager, or Data Analyst without juggling separate files.</p>
        </div>
        <div class="versions__stage">
          <div class="versions__glow"></div>
          <article class="version-card version-card--rear"><span>01</span><b>Growth<br />Marketing</b><small>Updated 3 weeks ago</small></article>
          <article class="version-card version-card--mid"><span>02</span><b>UI/UX<br />Designer</b><small>Updated 1 month ago</small></article>
          <article class="version-card version-card--front">
            <span>03</span><b>Product<br />Designer</b><small>Updated 2 days ago</small>
            <div><span>MAIN DRAFT</span><Icon name="arrow-up-right" size={14} /></div>
          </article>
          <div class="versions__caption"><Icon name="circle-dot" size={15} /> All versions saved, ready to send.</div>
        </div>
      </section>

      <!-- 05 WHY Employr -->
      <section class="why-employer section-space" aria-labelledby="why-employer-title">
        <div class="editorial-frame">
          <div class="why-employer__top">
            <div class="why-employer__heading">
              <div class="section-label section-label--inverse"><span>05</span><i></i><span>WHY Employr</span></div>
              <h2 id="why-employer-title">More than an<br /><em>online form.</em></h2>
            </div>
            <p class="why-employer__lead">
              Employr gives you full visibility: craft strong resume bullets, check job-fit scores, and follow up on interviews.
            </p>
          </div>

          <div class="why-employer__grid">
            <!-- Left: Feature List Items with interactive switching -->
            <div class="why-employer__nav">
              <article class="why-reason why-reason--card is-active" data-dashboard-target="0">
                <span class="why-reason__num">01</span>
                <div class="why-reason__content">
                  <h3>Your whole job hunt, in one place</h3>
                  <p>Build your CV, send applications, and track interview calls in one organized dashboard.</p>
                </div>
                <div class="why-reason__mobile-preview">
                  <Image
                    src={dashboard3}
                    alt="01 — Organized job search flow"
                    class="why-reason__mobile-img"
                    loading="eager"
                  />
                </div>
              </article>

              <article class="why-reason why-reason--card" data-dashboard-target="1">
                <span class="why-reason__num">02</span>
                <div class="why-reason__content">
                  <h3>Save unlimited CV versions</h3>
                  <p>Save technical, managerial, or creative versions in one click and tailor the focus whenever you need to.</p>
                </div>
                <div class="why-reason__mobile-preview">
                  <Image
                    src={dashboard4}
                    alt="02 — Multiple CV versions"
                    class="why-reason__mobile-img"
                    loading="lazy"
                  />
                </div>
              </article>

              <article class="why-reason why-reason--card" data-dashboard-target="2">
                <span class="why-reason__num">03</span>
                <div class="why-reason__content">
                  <h3>Check your fit before applying</h3>
                  <p>See which parts need work before you send your application to a recruiter.</p>
                </div>
                <div class="why-reason__mobile-preview">
                  <Image
                    src={dashboard1}
                    alt="03 — Qualification fit check"
                    class="why-reason__mobile-img"
                    loading="lazy"
                  />
                </div>
              </article>

              <article class="why-reason why-reason--card" data-dashboard-target="3">
                <span class="why-reason__num">04</span>
                <div class="why-reason__content">
                  <h3>Real-time application tracker</h3>
                  <p>Never forget an interview date again. Track every application from sent to salary negotiation.</p>
                </div>
                <div class="why-reason__mobile-preview">
                  <Image
                    src={dashboard2}
                    alt="04 — Centralized application tracker"
                    class="why-reason__mobile-img"
                    loading="lazy"
                  />
                </div>
              </article>
            </div>

            <!-- Right: Pure Image Showcase with all 4 images -->
            <div class="why-employer__dashboard-wrap">
              <div class="why-employer__image-stage">
                <Image
                  src={dashboard3}
                  alt="01 — Perjalanan karier terpadu"
                  class="dashboard-preview-img is-active"
                  data-dashboard-img="0"
                  loading="eager"
                />
                <Image
                  src={dashboard4}
                  alt="02 — Multi-versi CV tanpa batas"
                  class="dashboard-preview-img"
                  data-dashboard-img="1"
                  loading="lazy"
                />
                <Image
                  src={dashboard1}
                  alt="03 — Smart role matching"
                  class="dashboard-preview-img"
                  data-dashboard-img="2"
                  loading="lazy"
                />
                <Image
                  src={dashboard2}
                  alt="04 — Centralized application tracking"
                  class="dashboard-preview-img"
                  data-dashboard-img="3"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- USER STORIES -->
      <section class="testimonials-ready" aria-labelledby="stories-title">
        <div class="editorial-frame testimonials-ready__frame">
          <div class="testimonials-ready__grid">
            <div class="testimonials-ready__copy">
              <div class="testimonials-ready__eyebrow">
                <span>USER STORIES</span><i></i> <span>REAL EXPERIENCES</span>
              </div>
              <h2 id="stories-title">Not fake testimonials,<br /><em>real results.</em></h2>
              <p>Real stories from people who landed interviews and found their dream careers through Employr.</p>
              <button class="action-link" data-toast="Share your story feature coming soon.">Share Your Story <Icon name="arrow-up-right" /></button>
            </div>

            <div class="testimonials-ready__carousel-wrap">
              <ReviewsCarousel client:only="react" />
            </div>
          </div>
        </div>
      </section>


      <!-- CAREER OBSERVATION -->
      <section class="career-observation section-space" aria-label="Career reflection">
        <div class="career-observation__bg">
          <video
            class="career-observation__video"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            aria-hidden="true"
          >
            <source src="/fish-swim.webm" type="video/webm" />
            <source src="/video/fish-swim.webm" type="video/webm" />
            <source src="/vidio/fish-swim.webm" type="video/webm" />
          </video>
          <div class="career-observation__wash"></div>
        </div>

        <div class="editorial-frame career-observation__frame">
          <div class="career-observation__copy">
            <div class="career-observation__wordmark"><span>CONTROL IN YOUR HANDS</span></div>
            <p>Explore your options,<br />find your own rhythm.</p>
            <small></small>
          </div>
          <div class="career-observation__footer-label">
            <span>CAREER REFLECTION</span>
            <b>07 / 07</b>
          </div>
        </div>
      </section>
    </main>

    <FooterReveal client:only="react" logoMark={logoMark} />
  </div>

  <script>
    // Navigasi smooth-scroll & toast placeholder (pengganti onClick React)
    function showToast(message: string) {
      let host = document.getElementById('employer-toast');
      if (!host) {
        host = document.createElement('div');
        host.id = 'employer-toast';
        Object.assign(host.style, {
          position: 'fixed',
          left: '50%',
          bottom: '28px',
          transform: 'translateX(-50%) translateY(16px)',
          background: '#111',
          color: '#fff',
          font: '700 12px/1 "Manrope", Arial, sans-serif',
          letterSpacing: '.04em',
          padding: '14px 18px',
          zIndex: '9999',
          opacity: '0',
          transition: 'opacity .25s ease-out, transform .25s cubic-bezier(.23,1,.32,1)',
          pointerEvents: 'none',
          boxShadow: '0 18px 46px rgba(0,0,0,.28)',
        });
        document.body.appendChild(host);
      }
      host.textContent = message;
      requestAnimationFrame(() => {
        host!.style.opacity = '1';
        host!.style.transform = 'translateX(-50%) translateY(0)';
      });
      window.clearTimeout(Number(host.dataset.t));
      host.dataset.t = String(
        window.setTimeout(() => {
          host!.style.opacity = '0';
          host!.style.transform = 'translateX(-50%) translateY(16px)';
        }, 2400)
      );
    }

    // Listen for events from React components
    window.addEventListener('show-toast', (e: Event) => {
      const customEvent = e as CustomEvent<string>;
      if (customEvent.detail) {
        showToast(customEvent.detail);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-navigate]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.querySelector(btn.dataset.navigate || '');
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const menu = document.querySelector('[data-menu]');
        menu?.classList.remove('is-open');
        document.querySelector('[data-menu-button]')?.setAttribute('aria-expanded', 'false');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-toast]').forEach((btn) => {
      btn.addEventListener('click', () => showToast(btn.dataset.toast || ''));
    });

    const siteHeader = document.querySelector('.site-header');
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menuCloseButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
    const menuBackdrop = document.querySelector('[data-menu-backdrop]');
    const menu = document.querySelector('[data-menu]');

    const closeMenu = () => {
      menu?.classList.remove('is-open');
      menuBackdrop?.classList.remove('is-open');
      siteHeader?.classList.remove('is-menu-open');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.classList.remove('is-active');
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      menuButton?.setAttribute('aria-expanded', 'true');
      menuButton?.classList.add('is-active');
      menu?.classList.add('is-open');
      menuBackdrop?.classList.add('is-open');
      siteHeader?.classList.add('is-menu-open');
      document.body.style.overflow = 'hidden';
    };

    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuCloseButton?.addEventListener('click', closeMenu);
    menuBackdrop?.addEventListener('click', closeMenu);

    document.querySelectorAll('[data-menu] [data-navigate]').forEach((btn) => {
      btn.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Auto-init and play career observation video
    const fishVideo = document.querySelector<HTMLVideoElement>('.career-observation__video');
    if (fishVideo) {
      fishVideo.muted = true;
      fishVideo.defaultMuted = true;
      const playPromise = fishVideo.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          window.addEventListener('scroll', () => fishVideo.play(), { once: true });
          window.addEventListener('click', () => fishVideo.play(), { once: true });
          window.addEventListener('touchstart', () => fishVideo.play(), { once: true });
        });
      }
    }

    // Dashboard 1:1 image switcher on hover / click
    const whyCards = document.querySelectorAll<HTMLElement>('.why-reason--card');
    const dashboardImages = document.querySelectorAll<HTMLElement>('.dashboard-preview-img');

    whyCards.forEach((card) => {
      const activate = () => {
        const targetIndex = card.dataset.dashboardTarget;
        if (!targetIndex) return;

        whyCards.forEach((c) => c.classList.remove('is-active'));
        dashboardImages.forEach((img) => img.classList.remove('is-active'));

        card.classList.add('is-active');
        const activeImg = document.querySelector<HTMLElement>(`.dashboard-preview-img[data-dashboard-img="${targetIndex}"]`);
        if (activeImg) {
          activeImg.classList.add('is-active');
        }
      };

      card.addEventListener('mouseenter', activate);
      card.addEventListener('click', activate);
    });
  </script>
</BaseLayout>
