---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { kursusList } from '../../data/mock';

export function getStaticPaths(){
  return kursusList.map(k=>({params:{slug:k.slug}, props:{kursus:k}}))
}
const { kursus } = Astro.props;
const canonical = `http://localhost:3003/kursus/${kursus.slug}/`;
const title = `${kursus.title} — ${kursus.provider} | ${kursus.geoTag} | PortalKerja`;
const description = `${kursus.title} oleh ${kursus.provider}. ${kursus.level} · ${kursus.duration} · ${kursus.price}. ${kursus.benefits.join(', ')}`;
const related = kursusList.filter(x=>x.slug!==kursus.slug).slice(0,2);
---
<BaseLayout title={title} description={description} canonicalUrl={canonical}>
  <Header />
  <main>
    <div class="wrap">
      <nav class="breadcrumb">
        <a href="/">Beranda</a><span>›</span>
        <a href="/#kursus">Kursus</a><span>›</span>
        <a href="/#kursus">{kursus.provider}</a><span>›</span>
        <span aria-current="page">{kursus.title}</span>
      </nav>

      <!-- Hero Kursus -->
      <div class="kursus-hero">
        <div class="kursus-main">
          <span class="caps">{kursus.provider} · {kursus.geoTag}</span>
          <h1 style="font-size:28px; margin-top:6px;">{kursus.title}</h1>
          <p class="muted" style="margin-top:8px;">Kursus milik lembaga pihak ketiga — pendaftaran dilakukan di situs lembaga. PortalKerja hanya mengkurasi informasi.</p>
          <div style="display:flex; gap:14px; flex-wrap:wrap; margin-top:12px; align-items:center;">
            <span class="stars">★★★★<span class="off">★</span> {kursus.rating}</span>
            <span class="tiny" style="display:flex; align-items:center; gap:4px;"><i data-lucide="users" class="w-3.5 h-3.5 text-slate-400"></i> {kursus.students}</span>
            <span class="chip"><i data-lucide="signal" class="w-3 h-3"></i> {kursus.level}</span>
            <span class="chip"><i data-lucide="clock" class="w-3 h-3"></i> {kursus.duration}</span>
            <span class="chip"><i data-lucide="languages" class="w-3 h-3"></i> {kursus.language}</span>
          </div>
          <div class="chips" style="margin-top:12px;">
            {kursus.benefits.map(b=><span class="chip">{b}</span>)}
          </div>
        </div>
        <div class="ph" style="width:360px; min-height:200px; flex:none;">Preview Video / Gambar</div>
      </div>

      <div class="layout" style="padding-top:18px;">
        <div class="stack">
          <article class="card">
            <h2 style="font-size:18px;">Yang akan kamu pelajari</h2>
            <ul class="check-list">
              <li>Membuat funnel & persona untuk UMKM lokal {kursus.geoTag}</li>
              <li>Riset keyword GEO dan optimasi konten</li>
              <li>Menjalankan iklan Meta & Google dengan budget terbatas</li>
              <li>Membaca data Analytics dan optimasi ROAS</li>
            </ul>
          </article>

          <article class="card">
            <h2 style="font-size:18px;">Kurikulum — {kursus.duration}</h2>
            <div class="stack" style="gap:10px; margin-top:12px;">
              {kursus.modules.map((m,i)=>(
                <div class="module">
                  <div style="display:flex; justify-content:space-between; gap:10px;">
                    <strong style="font-size:14px;">{i+1}. {m.title}</strong>
                    <span class="tiny">{m.duration}</span>
                  </div>
                  <span class="tiny">{m.lessons}</span>
                </div>
              ))}
            </div>
            <div class="notice" style="margin-top:14px;">
              <span class="dot"></span>
              <span><strong>GEO:</strong> Contoh studi kasus menggunakan bisnis di {kursus.geoTag} agar relevan dengan pasar lokal.</span>
            </div>
          </article>

          <AdSlot type="infeed" />

          <article class="card">
            <h3>Untuk siapa kursus ini?</h3>
            <p class="small muted">Pemula yang ingin masuk dunia digital marketing, pegiat UMKM, dan fresh graduate yang butuh skill praktis untuk melamar kerja.</p>
            <h3 style="margin-top:14px;">Persyaratan</h3>
            <p class="small muted">Tidak ada — cukup laptop/HP dan koneksi internet.</p>
          </article>

          <section>
            <h2 style="margin-bottom:12px;">Kursus lain dari {kursus.provider}</h2>
            <div class="grid-2">
              {related.map(r=>(
                <a class="card" href={`/kursus/${r.slug}/`}>
                  <span class="caps">{r.provider} · {r.geoTag}</span>
                  <h3 style="font-size:15px;">{r.title}</h3>
                  <div style="display:flex; justify-content:space-between;"><span class="stars">★★★★<span class="off">★</span> {r.rating}</span><strong style="font-size:13px;">{r.price}</strong></div>
                </a>
              ))}
            </div>
          </section>
        </div>

        <aside class="sidebar">
          <div class="side-box price-card">
            <div class="ph" style="height:120px;">Gambar Kursus</div>
            <div style="margin-top:12px;">
              <div style="display:flex; gap:8px; align-items:baseline;">
                <strong style="font-size:22px;">{kursus.price}</strong>
                {kursus.originalPrice && <span class="tiny" style="text-decoration:line-through;">{kursus.originalPrice}</span>}
                <span class="badge lime">Hemat 30%</span>
              </div>
              <a class="btn btn-primary btn-block" href="#" style="margin-top:12px;"><i data-lucide="external-link" class="w-3.5 h-3.5"></i> Daftar di Situs Lembaga</a>
              <span class="tiny" style="display:block; text-align:center; margin-top:6px;">Akses seumur hidup · Sertifikat</span>
              <div class="divider"></div>
              <div class="small" style="line-height:1.7;">
                <div style="display:flex; gap:6px; align-items:center;"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> {kursus.duration} materi</div>
                <div style="display:flex; gap:6px; align-items:center;"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> {kursus.benefits[0]}</div>
                <div style="display:flex; gap:6px; align-items:center;"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> Bahasa: {kursus.language}</div>
                <div style="display:flex; gap:6px; align-items:center;"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> Level: {kursus.level}</div>
                <div style="display:flex; gap:6px; align-items:center;"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-rose-500"></i> Lokasi: {kursus.geoTag}</div>
              </div>
              <div class="notice" style="margin-top:12px; font-size:12px;">
                <span class="dot"></span>
                PortalKerja tidak memungut biaya — pembayaran langsung ke {kursus.provider}.
              </div>
            </div>
          </div>
          <AdSlot type="mrec" />
          <div class="side-box">
            <h4>Tentang {kursus.provider}</h4>
            <p class="small muted">Lembaga pelatihan terkurasi dengan 50+ instruktur industri. Rating rata-rata 4.6/5 dari 12rb ulasan.</p>
            <a class="small" href="#" style="color:var(--cobalt);">Lihat semua kursus →</a>
          </div>
          <AdSlot type="skyscraper" />
        </aside>
      </div>
    </div>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"Course",
    "name": kursus.title,
    "description": description,
    "provider": {"@type":"Organization","name": kursus.provider},
    "offers": {"@type":"Offer","price": kursus.price, "priceCurrency":"IDR"},
    "url": canonical,
    "educationalLevel": kursus.level,
    "inLanguage": kursus.language
  })} />
  <style>
    .breadcrumb{display:flex; gap:8px; align-items:center; flex-wrap:wrap; padding:16px 0 8px; font-size:13px; color:var(--muted);}
    .breadcrumb a:hover{color:var(--cobalt);}
    .kursus-hero{background:var(--surface); border:1px solid var(--border); border-radius:var(--r); padding:18px; display:flex; gap:18px; align-items:center; box-shadow:var(--shadow);}
    .kursus-main{flex:1}
    .check-list{margin:10px 0 0 18px; color:var(--muted); font-size:14px; line-height:1.8;}
    .module{border:1px solid var(--border); border-radius:var(--r-sm); padding:12px; background:var(--periwinkle-soft);}
    .price-card{border:1px solid var(--cobalt);}
    .divider{height:1px; background:var(--border); margin:12px 0;}
    @media(max-width: 780px){ .kursus-hero{flex-direction:column;} .kursus-hero .ph{width:100% !important;} }
  </style>
</BaseLayout>
