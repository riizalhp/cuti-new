    const triggerProv = document.getElementById('calc-trigger-prov');
    const triggerUmk = document.getElementById('calc-trigger-umk');
    const triggerChevron = document.getElementById('calc-trigger-chevron');
    const regionPopover = document.getElementById('calc-region-popover');
    const ddSearch = document.getElementById('calc-dd-search');
    const ddProvFilter = document.getElementById('calc-dd-prov-filter');
    const ddOptions = document.querySelectorAll('.calc-dd-option');
    const ddEmpty = document.getElementById('calc-dd-empty');

    const regionZone = document.getElementById('calc-region-zone');
    const btnApplyUmk = document.getElementById('btn-apply-umk');
    const grossInput = document.getElementById('calc-gross-input');
    const grossSlider = document.getElementById('calc-gross-slider');
    const allowanceInput = document.getElementById('calc-allowance-input');
    const ptkpSelect = document.getElementById('calc-ptkp-select');
    const schemeGrossBtn = document.getElementById('scheme-gross-btn');
    const schemeNetBtn = document.getElementById('scheme-net-btn');
    const chkJht = document.getElementById('chk-bpjs-jht');
    const chkJp = document.getElementById('chk-bpjs-jp');
    const chkKes = document.getElementById('chk-bpjs-kes');
    const presetBtns = document.querySelectorAll('.calc-preset-btn');

    let currentScheme = 'gross';
    let lastSummaryClipboard = '';

    function getSelectedOptionEl() {
      const currentId = regionValueInput ? regionValueInput.value : '';
      for (let i = 0; i < ddOptions.length; i++) {
        if (ddOptions[i].getAttribute('data-id') === currentId) {
          return ddOptions[i];
        }
      }
      return ddOptions[0] || null;
    }

    function getSelectedRegionData() {
      const opt = getSelectedOptionEl();
      if (!opt) return null;
      return {
        id: opt.getAttribute('data-id') || 'kota-semarang',
        city: opt.getAttribute('data-city') || 'Kota Semarang',
        province: opt.getAttribute('data-province') || 'Jawa Tengah',
        query: opt.getAttribute('data-query') || 'Semarang',
        umk: parseInt(opt.getAttribute('data-umk') || '3701709', 10),
        umkExactFormatted: opt.getAttribute('data-umk-exact') || 'Rp 3.701.709',
        sk: opt.getAttribute('data-sk') || '',
        living: parseInt(opt.getAttribute('data-living') || '2900000', 10),
        rent: parseInt(opt.getAttribute('data-rent') || '850000', 10),
        food: parseInt(opt.getAttribute('data-food') || '1400000', 10),
        transport: parseInt(opt.getAttribute('data-transport') || '650000', 10),
        zone: opt.getAttribute('data-zone') || '',
      };
    }

    function openDropdown() {
      if (!regionPopover || !regionTrigger) return;
      regionPopover.classList.remove('hidden');
      regionTrigger.setAttribute('aria-expanded', 'true');
      triggerChevron?.classList.add('rotate-180');
      setTimeout(() => {
        ddSearch?.focus();
      }, 20);
    }

    function closeDropdown() {
      if (!regionPopover || !regionTrigger) return;
      regionPopover.classList.add('hidden');
      regionTrigger.setAttribute('aria-expanded', 'false');
      triggerChevron?.classList.remove('rotate-180');
    }

    function filterDropdownList() {
      const q = (ddSearch ? ddSearch.value : '').trim().toLowerCase();
      const prov = ddProvFilter ? ddProvFilter.value : '';
      let visible = 0;

      ddOptions.forEach((opt) => {
        const hay = opt.getAttribute('data-search') || '';
        const optProv = opt.getAttribute('data-province') || '';
        const matchQ = !q || hay.includes(q);
        const matchProv = !prov || optProv === prov;
        if (matchQ && matchProv) {
          opt.classList.remove('hidden');
          opt.classList.add('flex');
          visible++;
        } else {
          opt.classList.add('hidden');
          opt.classList.remove('flex');
        }
      });

      if (ddEmpty) {
        if (visible === 0) {
          ddEmpty.classList.remove('hidden');
        } else {
          ddEmpty.classList.add('hidden');
        }
      }
    }

    function selectRegionById(regionId, syncSalaryToUmk) {
      if (!regionValueInput) return;
      regionValueInput.value = regionId;

      ddOptions.forEach((opt) => {
        const isCurrent = opt.getAttribute('data-id') === regionId;
        opt.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          opt.classList.add('bg-[#f0f2ff]/80');
          opt.classList.remove('bg-white');
        } else {
          opt.classList.remove('bg-[#f0f2ff]/80');
          opt.classList.add('bg-white');
        }
      });

      const region = getSelectedRegionData();
      if (region) {
        if (triggerCity) triggerCity.textContent = region.city;
        if (triggerProv) triggerProv.textContent = region.province;
        if (triggerUmk) triggerUmk.textContent = region.umkExactFormatted;
        if (syncSalaryToUmk && grossInput) {
          grossInput.value = formatInputThousands(region.umk);
          if (grossSlider) grossSlider.value = String(region.umk);
        }
      }

      closeDropdown();
      recalculate();
    }

    regionTrigger?.addEventListener('click', () => {
      const isOpen = regionTrigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    ddSearch?.addEventListener('input', filterDropdownList);
    ddProvFilter?.addEventListener('change', filterDropdownList);

    ddOptions.forEach((opt) => {
      opt.addEventListener('click', () => {
        const id = opt.getAttribute('data-id');
        if (id) selectRegionById(id, false);
      });
    });

    document.addEventListener('click', (e) => {
      if (dropdownRoot && !dropdownRoot.contains(e.target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown();
      }
    });

    function highlightActivePreset(baseSalary, umkVal) {
      presetBtns.forEach((btn) => {
        const presetAttr = btn.getAttribute('data-preset');
        const targetVal = presetAttr === 'umk' ? umkVal : parseInt(presetAttr || '0', 10);
        const isActive = Math.abs(baseSalary - targetVal) < 500;
        if (isActive) {
          btn.classList.add('border-[#1738D1]', 'bg-[#f0f2ff]', 'text-[#1738D1]');
          btn.classList.remove('border-[#d7d6cf]', 'bg-white', 'bg-[#f9f8f5]', 'text-[#101010]');
        } else {
          btn.classList.remove('border-[#1738D1]', 'bg-[#f0f2ff]', 'text-[#1738D1]');
          btn.classList.add('border-[#d7d6cf]', presetAttr === 'umk' ? 'bg-[#f9f8f5]' : 'bg-white', 'text-[#101010]');
        }
      });
    }

    function recalculate() {
      const region = getSelectedRegionData();
      if (!region) return;

      const baseSalary = parseNumericInput(grossInput?.value);
      const variableAllowance = parseNumericInput(allowanceInput?.value);
      const totalInitialGross = baseSalary + variableAllowance;

      const ptkpOpt = ptkpSelect?.options[ptkpSelect.selectedIndex];
      const ptkpCode = ptkpOpt ? ptkpOpt.value : 'TK/0';
      const terCategory = ptkpOpt ? ptkpOpt.getAttribute('data-ter') || 'A' : 'A';

      const deductJht = chkJht?.checked ? Math.round(baseSalary * 0.02) : 0;
      const deductJp = chkJp?.checked ? Math.round(Math.min(baseSalary, CAP_BPJS_JP) * 0.01) : 0;
      const deductKes = chkKes?.checked ? Math.round(Math.min(baseSalary, CAP_BPJS_KES) * 0.01) : 0;
      const totalEmployeeBpjs = deductJht + deductJp + deductKes;

      const terRatePct = getTerRate(totalInitialGross, terCategory);
      const deductTax = Math.round(totalInitialGross * (terRatePct / 100));

      const totalDeductions = totalEmployeeBpjs + deductTax;

      let takeHomePay = 0;
      let netSubsidy = 0;
      let effectiveGross = totalInitialGross;

      if (currentScheme === 'net') {
        takeHomePay = totalInitialGross;
        netSubsidy = totalDeductions;
        effectiveGross = totalInitialGross + netSubsidy;
      } else {
        takeHomePay = Math.max(0, totalInitialGross - totalDeductions);
      }

      const compKes = Math.round(Math.min(baseSalary, CAP_BPJS_KES) * 0.04);
      const compJht = Math.round(baseSalary * 0.037);
      const compJp = Math.round(Math.min(baseSalary, CAP_BPJS_JP) * 0.02);
      const compJkkJkm = Math.round(baseSalary * 0.0054);
      const totalCompanyContribution = compKes + compJht + compJp + compJkkJkm + netSubsidy;
      const totalCtc = totalInitialGross + totalCompanyContribution;

      // Update UI Wilayah & Benchmark Daya Beli Daerah
      if (regionZone) regionZone.textContent = region.zone;
      const elCityName = document.getElementById('benchmark-city-name');
      if (elCityName) elCityName.textContent = region.city;

      const elProvName = document.getElementById('benchmark-prov-name');
      if (elProvName) elProvName.textContent = region.province;

      const elSkRef = document.getElementById('benchmark-sk-ref');
      if (elSkRef) elSkRef.textContent = region.sk;

      const elBreakdownCity = document.getElementById('benchmark-breakdown-city');
      if (elBreakdownCity) elBreakdownCity.textContent = region.city;

      const elZonePill = document.getElementById('benchmark-zone-pill');
      if (elZonePill) elZonePill.textContent = region.zone;

      const elUmkVal = document.getElementById('benchmark-umk-val');
      if (elUmkVal) elUmkVal.textContent = region.umkExactFormatted;

      const diffFromUmk = baseSalary - region.umk;
      const elUmkDiff = document.getElementById('benchmark-umk-diff');
      if (elUmkDiff) {
        if (Math.abs(diffFromUmk) < 500) {
          elUmkDiff.textContent = 'Sesuai standar UMK daerah';
          elUmkDiff.className = 'text-[11px] font-bold text-[#065f46] tabular-nums mt-0.5 block';
        } else if (diffFromUmk > 0) {
          elUmkDiff.textContent = '+' + formatRupiah(diffFromUmk) + ' di atas UMK';
          elUmkDiff.className = 'text-[11px] font-bold text-[#065f46] tabular-nums mt-0.5 block';
        } else {
          elUmkDiff.textContent = '-' + formatRupiah(Math.abs(diffFromUmk)) + ' di bawah UMK';
          elUmkDiff.className = 'text-[11px] font-bold text-[#b91c1c] tabular-nums mt-0.5 block';
        }
      }

      const elKhlVal = document.getElementById('benchmark-khl-val');
      if (elKhlVal) elKhlVal.textContent = formatRupiah(region.living);

      const elRentVal = document.getElementById('benchmark-rent-val');
      if (elRentVal) elRentVal.textContent = formatRupiah(region.rent) + ' / bln';

      const elFoodVal = document.getElementById('benchmark-food-val');
      if (elFoodVal) elFoodVal.textContent = formatRupiah(region.food) + ' / bln';

      const elTransportVal = document.getElementById('benchmark-transport-val');
      if (elTransportVal) elTransportVal.textContent = formatRupiah(region.transport) + ' / bln';

      const surplus = takeHomePay - region.living;
      const elSurplusVal = document.getElementById('benchmark-surplus-val');
      if (elSurplusVal) {
        if (surplus >= 0) {
          elSurplusVal.textContent = '+' + formatRupiah(surplus);
          elSurplusVal.className = 'text-sm sm:text-base font-extrabold text-[#065f46] tabular-nums';
        } else {
          elSurplusVal.textContent = '-' + formatRupiah(Math.abs(surplus));
          elSurplusVal.className = 'text-sm sm:text-base font-extrabold text-[#b91c1c] tabular-nums';
        }
      }

      // Badge & Ringkasan Daya Beli
      const elStatusBadge = document.getElementById('benchmark-status-badge');
      const elSummaryText = document.getElementById('benchmark-summary-text');

      if (baseSalary < region.umk - 500) {
        if (elStatusBadge) {
          elStatusBadge.textContent = 'Di Bawah Standar UMK';
          elStatusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-[#fef2f2] text-[#991b1b] border border-[#fecaca] tabular-nums';
        }
        if (elSummaryText) {
          elSummaryText.textContent =
            'Gaji pokok ini berada di bawah patokan UMK ' +
            region.city +
            ' (' +
            region.umkExactFormatted +
            '). Pastikan apakah posisi ini merupakan paruh waktu, magang, atau skala usaha mikro yang memiliki ketentuan tersendiri.';
        }
      } else if (surplus >= region.living * 0.2) {
        if (elStatusBadge) {
          elStatusBadge.textContent = 'Daya Beli Kuat & Sehat';
          elStatusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-[#ecfdf5] text-[#065f46] border border-[#a7f3d0] tabular-nums';
        }
        if (elSummaryText) {
          elSummaryText.textContent =
            'Gaji bersih ' +
            formatRupiah(takeHomePay) +
            ' melampaui biaya hidup lajang di ' +
            region.city +
            ' (kos ' +
            formatRupiah(region.rent) +
            ', makan ' +
            formatRupiah(region.food) +
            ', transport ' +
            formatRupiah(region.transport) +
            '). Kamu memiliki ruang sisa sekitar ' +
            formatRupiah(surplus) +
            ' per bulan untuk ditabung.';
        }
      } else {
        if (elStatusBadge) {
          elStatusBadge.textContent = 'Sesuai Standar Daerah';
          elStatusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-[#fffbeb] text-[#92400e] border border-[#fde68a] tabular-nums';
        }
        if (elSummaryText) {
          elSummaryText.textContent =
            'Gaji ini memenuhi standar UMK ' +
            region.city +
            ', namun setelah dipotong iuran wajib cukup berdekatan dengan estimasi biaya hidup lajang (' +
            formatRupiah(region.living) +
            '). Disarankan mengatur anggaran kos (' +
            formatRupiah(region.rent) +
            ') dan makan harian secara disiplin.';
        }
      }

      // Alokasi 50 / 30 / 20
      const elNeeds = document.getElementById('alloc-needs');
      const elWants = document.getElementById('alloc-wants');
      const elSavings = document.getElementById('alloc-savings');
      if (elNeeds) elNeeds.textContent = formatRupiah(takeHomePay * 0.5);
      if (elWants) elWants.textContent = formatRupiah(takeHomePay * 0.3);
      if (elSavings) elSavings.textContent = formatRupiah(takeHomePay * 0.2);

      // Update Slip Kanan
      const elSlipTerBadge = document.getElementById('slip-ter-badge');
      if (elSlipTerBadge) elSlipTerBadge.textContent = 'TER Kategori ' + terCategory;

      const elThpMonthly = document.getElementById('res-thp-monthly');
      if (elThpMonthly) elThpMonthly.textContent = formatRupiah(takeHomePay);

      const elThpYearly = document.getElementById('res-thp-yearly');
      if (elThpYearly) elThpYearly.textContent = formatRupiah(takeHomePay * 12);

      const denom = effectiveGross > 0 ? effectiveGross : 1;
      const thpPct = Math.max(0, Math.min(100, (takeHomePay / denom) * 100));
      const bpjsPct = Math.max(0, Math.min(100, (totalEmployeeBpjs / denom) * 100));
      const taxPct = Math.max(0, Math.min(100, (deductTax / denom) * 100));

      const elRatioPill = document.getElementById('res-thp-ratio-pill');
      if (elRatioPill) {
        elRatioPill.textContent =
          currentScheme === 'net'
            ? '100% Terima Bersih (Net)'
            : thpPct.toFixed(1).replace('.', ',') + '% dari Bruto';
      }

      const barThp = document.getElementById('bar-thp');
      const barBpjs = document.getElementById('bar-bpjs');
      const barTax = document.getElementById('bar-tax');
      if (barThp) barThp.style.width = thpPct.toFixed(2) + '%';
      if (barBpjs) barBpjs.style.width = bpjsPct.toFixed(2) + '%';
      if (barTax) barTax.style.width = taxPct.toFixed(2) + '%';

      const legThp = document.getElementById('legend-thp-pct');
      const legBpjs = document.getElementById('legend-bpjs-pct');
      const legTax = document.getElementById('legend-tax-pct');
      if (legThp) legThp.textContent = thpPct.toFixed(1).replace('.', ',') + '%';
      if (legBpjs) legBpjs.textContent = bpjsPct.toFixed(1).replace('.', ',') + '%';
      if (legTax) legTax.textContent = taxPct.toFixed(1).replace('.', ',') + '%';

      // Rincian Bruto & Potongan
      const elBase = document.getElementById('res-base-salary');
      const elAllow = document.getElementById('res-allowance');
      const rowSubsidy = document.getElementById('row-net-subsidy');
      const elSubsidy = document.getElementById('res-net-subsidy');
      const elTotalGross = document.getElementById('res-total-gross');

      if (elBase) elBase.textContent = formatRupiah(baseSalary);
      if (elAllow) elAllow.textContent = formatRupiah(variableAllowance);
      if (rowSubsidy && elSubsidy) {
        if (currentScheme === 'net') {
          rowSubsidy.classList.remove('hidden');
          rowSubsidy.classList.add('flex');
          elSubsidy.textContent = '+' + formatRupiah(netSubsidy);
        } else {
          rowSubsidy.classList.add('hidden');
          rowSubsidy.classList.remove('flex');
        }
      }
      if (elTotalGross) elTotalGross.textContent = formatRupiah(effectiveGross);

      const elSchemeNote = document.getElementById('res-scheme-note');
      if (elSchemeNote) {
        elSchemeNote.textContent =
          currentScheme === 'net' ? 'Ditanggung perusahaan' : 'Dipotong dari gaji';
      }

      const elDedJht = document.getElementById('res-deduct-jht');
      const elDedJp = document.getElementById('res-deduct-jp');
      const elDedKes = document.getElementById('res-deduct-kes');
      const elTerRateLabel = document.getElementById('res-ter-rate-label');
      const elTerPtkpLabel = document.getElementById('res-ter-ptkp-label');
      const elDedTax = document.getElementById('res-deduct-tax');
      const elTotDed = document.getElementById('res-total-deductions');

      if (elDedJht) elDedJht.textContent = deductJht > 0 ? '-' + formatRupiah(deductJht) : 'Rp 0';
      if (elDedJp) elDedJp.textContent = deductJp > 0 ? '-' + formatRupiah(deductJp) : 'Rp 0';
      if (elDedKes) elDedKes.textContent = deductKes > 0 ? '-' + formatRupiah(deductKes) : 'Rp 0';
      if (elTerRateLabel) elTerRateLabel.textContent = 'TER ' + String(terRatePct).replace('.', ',') + '%';
      if (elTerPtkpLabel) elTerPtkpLabel.textContent = 'Status ' + ptkpCode + ' · Kategori ' + terCategory;
      if (elDedTax) {
        elDedTax.textContent = deductTax > 0 ? '-' + formatRupiah(deductTax) : 'Rp 0 (Bebas Pajak)';
        elDedTax.className =
          deductTax > 0
            ? 'font-bold text-[#b91c1c] tabular-nums'
            : 'font-bold text-[#065f46] tabular-nums';
      }
      if (elTotDed) {
        elTotDed.textContent =
          currentScheme === 'net'
            ? 'Rp 0 (Ditanggung Kantor)'
            : '-' + formatRupiah(totalDeductions);
      }

      // Iuran Perusahaan
      const elCompKes = document.getElementById('res-comp-kes');
      const elCompJht = document.getElementById('res-comp-jht');
      const elCompJp = document.getElementById('res-comp-jp');
      const elCompJkk = document.getElementById('res-comp-jkk');
      const elCompCtc = document.getElementById('res-comp-ctc');

      if (elCompKes) elCompKes.textContent = formatRupiah(compKes);
      if (elCompJht) elCompJht.textContent = formatRupiah(compJht);
      if (elCompJp) elCompJp.textContent = formatRupiah(compJp);
      if (elCompJkk) elCompJkk.textContent = formatRupiah(compJkkJkm);
      if (elCompCtc) elCompCtc.textContent = formatRupiah(totalCtc);

      // Update CTA Loker Kota
      const btnCityJobs = document.getElementById('btn-explore-city-jobs');
      const btnCityLabel = document.getElementById('btn-city-label');
      if (btnCityJobs) {
        btnCityJobs.setAttribute('href', '/lowongan?loc=' + encodeURIComponent(region.query));
      }
      if (btnCityLabel) {
        btnCityLabel.textContent = region.city;
      }

      highlightActivePreset(baseSalary, region.umk);

      lastSummaryClipboard = [
        'SIMULASI GAJI BERSIH (TAKE-HOME PAY) - EMPLOYR',
        'Lokasi Kerja: ' + region.city + ', ' + region.province + ' (UMK 2026: ' + region.umkExactFormatted + ')',
        'Dasar Hukum: ' + region.sk,
        'Status Pajak: ' + ptkpCode + ' (TER Kategori ' + terCategory + ') · Skema ' + (currentScheme === 'net' ? 'Net/Gross-Up' : 'Gross'),
        '----------------------------------------',
        'Gaji Pokok & Tunjangan Tetap: ' + formatRupiah(baseSalary),
        'Tunjangan Tidak Tetap: ' + formatRupiah(variableAllowance),
        'Potongan BPJS TK (JHT 2% + JP 1%): -' + formatRupiah(deductJht + deductJp),
        'Potongan BPJS Kesehatan (1%): -' + formatRupiah(deductKes),
        'PPh 21 Bulanan (TER ' + terRatePct + '%): -' + formatRupiah(deductTax),
        '----------------------------------------',
        'ESTIMASI TAKE-HOME PAY: ' + formatRupiah(takeHomePay) + ' / bulan',
        'Estimasi Biaya Hidup Lajang di ' + region.city + ': ' + formatRupiah(region.living) + ' (Kos ' + formatRupiah(region.rent) + ', Makan ' + formatRupiah(region.food) + ', Transport ' + formatRupiah(region.transport) + ')',
      ].join('\n');
    }

    // Event Listeners
    grossInput?.addEventListener('input', () => {
      const val = parseNumericInput(grossInput.value);
      grossInput.value = val > 0 ? formatInputThousands(val) : '';
      if (grossSlider) {
        grossSlider.value = String(Math.min(35000000, Math.max(2000000, val)));
      }
      recalculate();
    });

    grossInput?.addEventListener('blur', () => {
      const val = parseNumericInput(grossInput.value);
      grossInput.value = formatInputThousands(val);
    });

    grossSlider?.addEventListener('input', () => {
      const val = parseInt(grossSlider.value || '0', 10);
      if (grossInput) grossInput.value = formatInputThousands(val);
      recalculate();
    });

    allowanceInput?.addEventListener('input', () => {
      const val = parseNumericInput(allowanceInput.value);
      allowanceInput.value = val > 0 ? formatInputThousands(val) : '';
      recalculate();
    });

    allowanceInput?.addEventListener('blur', () => {
      const val = parseNumericInput(allowanceInput.value);
      allowanceInput.value = formatInputThousands(val);
    });

    ptkpSelect?.addEventListener('change', recalculate);
    chkJht?.addEventListener('change', recalculate);
    chkJp?.addEventListener('change', recalculate);
    chkKes?.addEventListener('change', recalculate);

    btnApplyUmk?.addEventListener('click', () => {
      const region = getSelectedRegionData();
      if (!region || !grossInput) return;
      grossInput.value = formatInputThousands(region.umk);
      if (grossSlider) grossSlider.value = String(region.umk);
      recalculate();
    });

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const presetAttr = btn.getAttribute('data-preset');
        const region = getSelectedRegionData();
        const targetVal =
          presetAttr === 'umk'
            ? region
              ? region.umk
              : 3701709
            : parseInt(presetAttr || '6000000', 10);
        if (grossInput) grossInput.value = formatInputThousands(targetVal);
        if (grossSlider) grossSlider.value = String(targetVal);
        recalculate();
      });
    });

    function setScheme(scheme) {
      currentScheme = scheme;
      if (scheme === 'gross') {
        schemeGrossBtn?.setAttribute('aria-pressed', 'true');
        schemeNetBtn?.setAttribute('aria-pressed', 'false');
        schemeGrossBtn?.classList.add('border-[#1738D1]', 'bg-[#f0f2ff]', 'text-[#1738D1]');
        schemeGrossBtn?.classList.remove('border-[#d7d6cf]', 'bg-[#f9f8f5]', 'text-[#55544f]');
        schemeNetBtn?.classList.remove('border-[#1738D1]', 'bg-[#f0f2ff]', 'text-[#1738D1]');
        schemeNetBtn?.classList.add('border-[#d7d6cf]', 'bg-[#f9f8f5]', 'text-[#55544f]');
      } else {
        schemeGrossBtn?.setAttribute('aria-pressed', 'false');
        schemeNetBtn?.setAttribute('aria-pressed', 'true');
        schemeNetBtn?.classList.add('border-[#1738D1]', 'bg-[#f0f2ff]', 'text-[#1738D1]');
        schemeNetBtn?.classList.remove('border-[#d7d6cf]', 'bg-[#f9f8f5]', 'text-[#55544f]');
        schemeGrossBtn?.classList.remove('border-[#1738D1]', 'bg-[#f0f2ff]', 'text-[#1738D1]');
        schemeGrossBtn?.classList.add('border-[#d7d6cf]', 'bg-[#f9f8f5]', 'text-[#55544f]');
      }
      recalculate();
    }

    schemeGrossBtn?.addEventListener('click', () => setScheme('gross'));
    schemeNetBtn?.addEventListener('click', () => setScheme('net'));

    // Copy to Clipboard
    const btnCopySlip = document.getElementById('btn-copy-slip');
    const btnCopyText = document.getElementById('btn-copy-slip-text');
    btnCopySlip?.addEventListener('click', () => {
      if (!lastSummaryClipboard) return;
      navigator.clipboard?.writeText(lastSummaryClipboard).then(() => {
        if (btnCopyText) {
          const prev = btnCopyText.textContent;
          btnCopyText.textContent = 'Rincian Tersalin';
          setTimeout(() => {
            btnCopyText.textContent = prev;
          }, 2000);
        }
      });
    });

    // Expose helper for external benchmark table buttons
    window.__employrSelectCalcRegion = function (regionId) {
      selectRegionById(regionId, true);
      const calcEl = document.getElementById('kalkulator-gaji');
      calcEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Initial render
    recalculate();
  })();
</script>
