---
// EventPortalSection.astro - Event & Job Fair with Interactive Calendar & Spotlight
import { eventList, ensureData } from '../data/mock';

await ensureData();
const eventsSnapshot = [...eventList];

// Bulan mapping untuk sorting kronologis
const monthOrder: Record<string, number> = {
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Mei: 5, Jun: 6,
  Jul: 7, Agu: 8, Sep: 9, Okt: 10, Nov: 11, Des: 12
};

// Urutkan secara kronologis (dari tanggal terdekat)
const sortedEvents = [...eventList].sort((a, b) => {
  const yearA = parseInt(a.dateYear || '2026');
  const yearB = parseInt(b.dateYear || '2026');
  if (yearA !== yearB) return yearA - yearB;
  
  const monthA = monthOrder[a.dateMonth || a.month || 'Jan'] || 1;
  const monthB = monthOrder[b.dateMonth || b.month || 'Jan'] || 1;
  if (monthA !== monthB) return monthA - monthB;

  const dayA = parseInt(a.dateDay || a.day || '1');
  const dayB = parseInt(b.dateDay || b.day || '1');
  return dayA - dayB;
});
---

<section id="event" class="py-12 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
      <div>
        <div class="section-label mb-3"><i></i>04 // AGENDA &amp; BURSA KERJA</div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-[#101010] tracking-tight">
          Temukan Event yang <em>Membuka Peluang Baru</em>
        </h2>
        <p class="text-sm sm:text-base text-[#6e6d68] mt-2 max-w-2xl leading-relaxed">
          Ikuti berbagai job fair, webinar karier, workshop industri, dan sesi walk-in interview untuk membangun jejaring profesional.
        </p>
      </div>

      <!-- Quick Action / Banner -->
      <a
        href="/event"
        class="inline-flex items-center gap-2 px-4.5 py-2 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start lg:self-auto group"
      >
        <span>Lihat Semua Event ({sortedEvents.length})</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Category Filters & Dropdowns -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
        <button class="px-4 py-1.5 rounded-full bg-[#0000ff] text-white text-xs font-semibold shrink-0">Semua Event</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">Job Fair</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">Webinar</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">Workshop</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">Seminar</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition">Career Talk</button>
      </div>

      <!-- Dropdown Selects with Clean Chevron Icons -->
      <div class="flex items-center gap-2 text-xs">
        <div class="relative inline-flex items-center">
          <select class="appearance-none pl-3 pr-8 py-1.5 rounded-full border border-[#d7d6cf] bg-white text-[#101010] font-semibold text-xs outline-none hover:border-[#101010] focus:border-[#0000ff] shadow-xs cursor-pointer transition">
            <option>Semua Format</option>
            <option>Online (Webinar)</option>
            <option>Offline (Job Fair)</option>
            <option>Hybrid</option>
          </select>
          <svg class="w-3.5 h-3.5 text-[#6e6d68] absolute right-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

        <div class="relative inline-flex items-center">
          <select class="appearance-none pl-3 pr-8 py-1.5 rounded-full border border-[#d7d6cf] bg-white text-[#101010] font-semibold text-xs outline-none hover:border-[#101010] focus:border-[#0000ff] shadow-xs cursor-pointer transition">
            <option>Semua Kota</option>
            <option>Jakarta</option>
            <option>Bandung</option>
            <option>Surabaya</option>
            <option>Yogyakarta</option>
          </select>
          <svg class="w-3.5 h-3.5 text-[#6e6d68] absolute right-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Main Content: Left 8-Cols (2x2 Cards) & Right 4-Cols (4 Matched Widgets, Zero Blankspace) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- 4 Event Cards (8 cols) -->
      <div class="lg:col-span-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base sm:text-lg font-semibold text-slate-900">Event & Bursa Kerja Terdekat</h3>
          <span class="text-xs text-slate-500 font-medium">Terverifikasi Penyelenggara</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {sortedEvents.slice(0, 4).map((event) => (
            <div class="bg-white rounded-2xl border border-[#d7d6cf] overflow-hidden shadow-sm hover:shadow-[0_12px_30px_-4px_rgba(16,16,16,0.08)] hover:border-[#0000ff]/30 hover:-translate-y-1 transition duration-300 flex flex-col justify-between group">
              <div>
                <!-- Image with Type Badge and Bookmark -->
                <div class="relative aspect-[16/9] overflow-hidden bg-[#f4f3ee]">
                  <img src={event.image} alt={event.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
                  <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[#0000ff] text-white shadow-sm">
                    {event.type}
                  </span>
                  <button type="button" aria-label="Simpan Event" class="absolute top-3 right-3 w-7 h-7 rounded-full bg-white/90 flex items-center justify-center text-[#6e6d68] hover:text-[#0000ff] shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                    </svg>
                  </button>
                </div>

                <!-- Event Details with Date Badge -->
                <div class="p-4 flex items-start gap-3">
                  <!-- Date Badge Box -->
                  <div class="w-12 rounded-xl border border-[#d7d6cf] bg-[#f4f3ee] overflow-hidden shrink-0 text-center">
                    <span class="block text-base font-bold text-[#0000ff] pt-1.5 leading-none">{event.dateDay || event.day}</span>
                    <span class="block text-[9px] font-extrabold uppercase text-[#6e6d68] pb-1">{event.dateMonth || event.month}</span>
                  </div>

                  <div class="flex-1 min-w-0">
                    <span class="text-[10px] font-bold text-[#6e6d68] uppercase tracking-wider block mb-0.5">{event.organizer}</span>
                    <h4 class="text-sm font-semibold text-[#101010] leading-snug line-clamp-2 mb-1 group-hover:text-[#0000ff] transition">
                      <a href={"/event/" + event.slug}>{event.title}</a>
                    </h4>
                    <p class="text-xs text-[#6e6d68] line-clamp-2 leading-relaxed">
                      {event.description}
                    </p>
                  </div>
                </div>

                <!-- Meta location, participants, format badge -->
                <div class="px-4 pb-3 space-y-1.5 text-xs text-[#6e6d68] border-t border-[#d7d6cf]/50 pt-3">
                  <div class="flex items-center gap-1.5 truncate">
                    <svg class="w-3.5 h-3.5 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    </svg>
                    <span class="truncate">{event.location}</span>
                  </div>

                  <div class="flex items-center justify-between text-[11px]">
                    <span class="flex items-center gap-1 text-[#6e6d68]">
                      <svg class="w-3.5 h-3.5 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                      </svg>
                      {event.companiesCount || event.attendeesCount || 'Cek detail di link resmi'}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold text-[10px]">
                      {event.format}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Button CTA -->
              <div class="p-4 pt-0">
                <a
                  href={"/event/" + event.slug}
                  class="w-full py-2.5 rounded-full bg-[#f4f3ee] hover:bg-[#101010] text-[#101010] hover:text-white text-xs font-bold text-center block transition border border-[#d7d6cf] hover:border-[#101010] shadow-xs"
                >
                  Lihat Detail & Daftar →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Kalender + Spotlight + Organizer B2B + Alert Box (4 cols, Matched Height!) -->
      <div class="lg:col-span-4 flex flex-col gap-4">

        <!-- 1. Kalender Event Widget -->
        <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3.5 pb-2.5 border-b border-[#d7d6cf]/50">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-[#101010]">Kalender Agenda</h3>
            <span class="text-[11px] font-bold text-[#0000ff]">Januari 2026</span>
          </div>

          <!-- Calendar Days Grid -->
          <div class="grid grid-cols-7 gap-1 text-center text-xs mb-3">
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Sen</span>
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Sel</span>
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Rab</span>
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Kam</span>
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Jum</span>
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Sab</span>
            <span class="text-[#6e6d68] font-semibold py-1 text-[11px]">Min</span>

            <span class="py-1"></span>
            <span class="py-1"></span>
            <span class="py-1"></span>
            <span class="text-[#101010] py-1">1</span>
            <span class="text-[#101010] py-1">2</span>
            <span class="text-[#101010] py-1">3</span>
            <span class="text-[#101010] py-1">4</span>

            <span class="text-[#101010] py-1">5</span>
            <span class="text-[#101010] py-1">6</span>
            <span class="text-[#101010] py-1">7</span>
            <span class="text-[#101010] py-1">8</span>
            <span class="text-[#101010] py-1">9</span>
            <span class="text-[#101010] py-1">10</span>
            <span class="text-[#101010] py-1">11</span>

            <span class="text-[#101010] py-1">12</span>
            <span class="text-[#101010] py-1">13</span>
            <span class="text-[#101010] py-1">14</span>
            <!-- Active Highlight Event Dates -->
            <span class="py-1 rounded-full bg-[#0000ff] text-white font-bold cursor-pointer" title="Job Fair Nasional">15</span>
            <span class="text-[#101010] py-1">16</span>
            <span class="text-[#101010] py-1">17</span>
            <span class="py-1 rounded-full bg-amber-500 text-white font-bold cursor-pointer" title="Webinar CV ATS">18</span>

            <span class="text-[#101010] py-1">19</span>
            <span class="text-[#101010] py-1">20</span>
            <span class="text-[#101010] py-1">21</span>
            <span class="text-[#101010] py-1">22</span>
            <span class="text-[#101010] py-1">23</span>
            <span class="py-1 rounded-full bg-emerald-600 text-white font-bold cursor-pointer" title="Tech Career Day">24</span>
            <span class="text-[#101010] py-1">25</span>

            <span class="text-[#101010] py-1">26</span>
            <span class="text-[#101010] py-1">27</span>
            <span class="py-1 rounded-full bg-blue-100 text-[#0000ff] font-bold cursor-pointer" title="Bursa Kerja BUMN">28</span>
            <span class="text-[#101010] py-1">29</span>
            <span class="text-[#101010] py-1">30</span>
            <span class="text-[#101010] py-1">31</span>
          </div>

          <!-- Calendar Legend -->
          <div class="flex items-center justify-between text-[10px] text-[#6e6d68] pt-2 border-t border-[#d7d6cf]/50">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[#0000ff]"></span> Job Fair</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Webinar</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-600"></span> Workshop</span>
          </div>
        </div>

        <!-- 2. Spotlight Event Card -->
        <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between mb-2">
            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-extrabold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200">
              Spotlight Event
            </span>
            <span class="text-[10px] font-bold text-amber-700">Tiket Terbatas</span>
          </div>

          <h4 class="text-sm font-semibold text-[#101010] leading-snug mb-1.5">
            Indonesia National Career Expo & Job Fair 2026
          </h4>
          <div class="space-y-1 text-xs text-[#6e6d68] mb-3.5">
            <div class="flex items-center gap-1.5">
              <span class="text-[#101010] font-bold">15-16 Jan 2026</span>
              <span>·</span>
