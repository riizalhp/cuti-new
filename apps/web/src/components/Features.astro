---
import { FileCheck, BrainCircuit, Kanban, Mic, Linkedin, DollarSign } from 'lucide-react';

const features = [
  {
    icon: 'FileCheck',
    title: 'CV ATS-Optimized',
    description: 'Template profesional yang lolos sistem ATS dengan score real-time',
  },
  {
    icon: 'BrainCircuit',
    title: 'AI CV Screener',
    description: 'Analisis CV seperti recruiter profesional, lengkap dengan rekomendasi',
  },
  {
    icon: 'Kanban',
    title: 'Kelola Lamaran',
    description: 'Track semua lamaran dalam satu dashboard Kanban yang intuitif',
  },
  {
    icon: 'Mic',
    title: 'Latihan Interview AI',
    description: 'Mock interview dengan AI evaluator dan feedback real-time',
  },
  {
    icon: 'Linkedin',
    title: 'Optimasi LinkedIn',
    description: 'AI-powered profile analyzer dan content generator untuk networking',
  },
  {
    icon: 'DollarSign',
    title: 'Dapat Uang',
    description: 'Join campaign, selesaikan task, withdraw komisi ke rekening Anda',
  },
];
---

<section id="features" class="section-container py-20 lg:py-32">
  <div class="text-center mb-16 space-y-4">
    <h2 class="text-4xl lg:text-5xl font-bold">
      Semua yang Anda Butuhkan untuk <br />
      <span class="text-gradient">Mendapatkan Pekerjaan Impian</span>
    </h2>
    <p class="text-xl text-text-secondary max-w-3xl mx-auto">
      Platform lengkap yang menggabungkan AI, automation, dan best practices untuk mempercepat perjalanan karir Anda
    </p>
  </div>

  <!-- Bento Grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {features.map((feature, index) => (
      <div
        class="glass-card p-8 space-y-4 animate-on-scroll"
        style={`animation-delay: ${index * 50}ms;`}
      >
        <!-- Icon -->
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-indigo to-accent-violet flex items-center justify-center">
          {feature.icon === 'FileCheck' && (
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          )}
          {feature.icon === 'BrainCircuit' && (
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          )}
          {feature.icon === 'Kanban' && (
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
            </svg>
          )}
          {feature.icon === 'Mic' && (
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
            </svg>
          )}
          {feature.icon === 'Linkedin' && (
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
          )}
          {feature.icon === 'DollarSign' && (
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          )}
        </div>

        <!-- Content -->
        <h3 class="text-xl font-semibold">{feature.title}</h3>
        <p class="text-text-secondary">{feature.description}</p>
      </div>
    ))}
  </div>
</section>

<script>
  // Animate on scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });
</script>
