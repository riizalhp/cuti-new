---
// EventPortalSection.astro - Event & Job Fair with Cult UI Cutout Cards & Interactive Calendar
import { eventList, ensureData } from '../data/mock';
import { CV_BUILDER_URL } from '../lib/urls';
import CutoutCorner from './common/CutoutCorner.astro';
import OrganicCardSmall from './common/OrganicCardSmall.astro';

await ensureData();

// Bulan mapping untuk sorting kronologis
const monthOrder: Record<string, number> = {
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, Mei: 5, Jun: 6,
  Jul: 7, Agu: 8, Sep: 9, Okt: 10, Nov: 11, Des: 12
};

// Deduplikasi event berdasarkan judul
const seenTitles = new Set<string>();
const uniqueEvents = [...eventList].filter((e) => {
  const key = (e.title || '').trim().toLowerCase();
  if (seenTitles.has(key)) return false;
  seenTitles.add(key);
  return true;
});

// Urutkan secara kronologis (dari tanggal terdekat)
const sortedEvents = uniqueEvents.sort((a, b) => {
  const yearA = parseInt(a.dateYear || '2026');
  const yearB = parseInt(b.dateYear || '2026');
  if (yearA !== yearB) return yearA - yearB;
  
  const monthA = monthOrder[a.dateMonth || a.month || 'Jan'] || 1;
  const monthB = monthOrder[b.dateMonth || b.month || 'Jan'] || 1;
  if (monthA !== monthB) return monthA - monthB;

  const dayA = parseInt(a.dateDay || a.day || '1');
  const dayB = parseInt(b.dateDay || b.day || '1');
  return dayA - dayB;
});

// Ambil daftar kota/wilayah unik yang HANYA ada di event aktif saat ini
const availableCitiesSet = new Set<string>();
for (const ev of sortedEvents) {
  const loc = (ev.location || '').trim();
  if (!loc) continue;
  if (loc.toLowerCase().startsWith('online via') || loc.toLowerCase() === 'online') {
    const parts = loc.split(',');
    if (parts.length > 1) {
      const region = parts[parts.length - 1].trim();
      if (region && !region.toLowerCase().includes('online') && !region.toLowerCase().includes('aplikasi')) {
        availableCitiesSet.add(region);
      }
    }
    continue;
  }
  const parts = loc.split(',');
  const city = (parts.length > 1 ? parts[parts.length - 1] : parts[0]).trim();
  if (city && !city.toLowerCase().includes('online')) {
    availableCitiesSet.add(city);
  }
}
const availableCities = Array.from(availableCitiesSet);

const spotlightEvent = sortedEvents[0];
const activeMonthName = spotlightEvent?.dateMonth || spotlightEvent?.month || 'November';
const activeYear = spotlightEvent?.dateYear || '2026';

const eventDaysMap = new Map<number, typeof sortedEvents[number]>();
for (const ev of sortedEvents) {
  const d = parseInt(ev.dateDay || ev.day || '0', 10);
  if (d > 0 && (ev.dateMonth === activeMonthName || ev.month === activeMonthName)) {
    eventDaysMap.set(d, ev);
  }
}

const calendarDays = Array.from({ length: 30 }, (_, i) => {
  const day = i + 1;
  const col = i % 7;
  const isTopRow = day <= 7;
  const ev = eventDaysMap.get(day);

  if (!ev) {
    return { day, col, isTopRow, event: null };
  }

  const isJobFair = (ev.type || '').toLowerCase().includes('job fair');
  const isWebinar = (ev.type || '').toLowerCase().includes('webinar');
  const bgClass = isJobFair
    ? 'bg-[#1738D1] text-white hover:bg-[#132EA8]'
    : isWebinar
    ? 'bg-amber-500 text-white hover:bg-amber-600'
    : 'bg-emerald-600 text-white hover:bg-emerald-700';
  const badgeBg = isJobFair
    ? 'bg-[#1738D1] text-white'
    : isWebinar
    ? 'bg-amber-500 text-white'
    : 'bg-emerald-600 text-white';

  let posClass = 'left-1/2 -translate-x-1/2';
  let arrowClass = 'left-1/2 -translate-x-1/2';
  if (col === 0 || col === 1) {
    posClass = 'left-0 translate-x-0';
    arrowClass = 'left-3';
  } else if (col === 5 || col === 6) {
    posClass = 'right-0 translate-x-0';
    arrowClass = 'right-3';
  }

  return {
    day,
    col,
    isTopRow,
    event: ev,
    badgeBg,
    bgClass,
    posClass,
    arrowClass,
  };
});
---

<section id="event" class="py-8 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 sm:gap-6 mb-6 sm:mb-8">
      <div>
        <div class="section-label mb-2.5 sm:mb-3">
          <span>04</span>
          <i></i>
          <span>AGENDA &amp; BURSA KERJA</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-[#101010] tracking-tight">
          Temukan Event yang <em>Membuka Peluang Baru</em>
        </h2>
        <p class="text-sm sm:text-base text-[#6e6d68] mt-2 max-w-2xl leading-relaxed">
          Ikuti berbagai job fair, webinar karier, workshop industri, dan sesi walk-in interview untuk membangun jejaring profesional.
        </p>
      </div>

      <!-- Quick Action / Banner -->
      <a
        href="/event"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start lg:self-auto group"
      >
        <span>Lihat Semua Event</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Category Filters & Dropdowns -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 sm:mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar" id="event-type-tabs">
        <button type="button" data-type="all" class="event-filter-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-[#1738D1] text-white text-xs font-semibold shrink-0 cursor-pointer transition">Semua Event</button>
        <button type="button" data-type="job fair" class="event-filter-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer">Job Fair</button>
        <button type="button" data-type="webinar" class="event-filter-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer">Webinar</button>
        <button type="button" data-type="workshop" class="event-filter-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer">Workshop</button>
        <button type="button" data-type="seminar" class="event-filter-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer">Seminar</button>
        <button type="button" data-type="career talk" class="event-filter-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer">Career Talk</button>
      </div>

      <!-- Dropdown Selects -->
      <div class="flex items-center gap-2 text-xs">
        <div class="relative inline-flex items-center">
          <select id="event-format-filter" class="appearance-none pl-3 pr-8 py-1.5 rounded-full border border-[#d7d6cf] bg-white text-[#101010] font-semibold text-xs outline-none hover:border-[#101010] focus:border-[#1738D1] shadow-xs cursor-pointer transition">
            <option value="all">Semua Format</option>
            <option value="online">Online (Webinar)</option>
            <option value="offline">Offline (Job Fair)</option>
            <option value="hybrid">Hybrid</option>
          </select>
          <svg class="w-3.5 h-3.5 text-[#6e6d68] absolute right-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

        <div class="relative inline-flex items-center">
          <select id="event-city-filter" class="appearance-none pl-3 pr-8 py-1.5 rounded-full border border-[#d7d6cf] bg-white text-[#101010] font-semibold text-xs outline-none hover:border-[#101010] focus:border-[#1738D1] shadow-xs cursor-pointer transition">
            <option value="all">Semua Kota</option>
            {availableCities.map((city) => (
              <option value={city.toLowerCase()}>{city}</option>
            ))}
          </select>
          <svg class="w-3.5 h-3.5 text-[#6e6d68] absolute right-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Main Content: Left 8-Cols (Cutout Cards) & Right 4-Cols (Calendar, Spotlight & Checklist) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">

      <!-- 4 Event Cards (Horizontal Snap Carousel di Mobile, 2 Cols di Tablet/Desktop) -->
      <div class="lg:col-span-8 flex flex-col">
        <div class="flex items-center justify-between mb-4 sm:mb-5">
          <h3 class="text-base sm:text-lg font-bold text-[#101010]">Event &amp; Bursa Kerja Terdekat</h3>
          <span class="text-xs text-[#6e6d68] font-medium">Terverifikasi Penyelenggara</span>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory sm:grid sm:grid-cols-2 gap-4 sm:gap-6 pb-4 sm:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar flex-1" id="event-cards-grid">
          {sortedEvents.length === 0 ? (
            <div class="col-span-full text-center py-12 text-sm text-[#6e6d68] bg-white rounded-[28px] border border-[#d7d6cf]">
              Belum ada event yang dijadwalkan saat ini.
            </div>
          ) : (
            sortedEvents.slice(0, 4).map((event) => (
              <OrganicCardSmall
                className="event-card-item shrink-0 w-[285px] sm:w-auto snap-start"
                image={event.image}
                imageAlt={event.title}
                category={`${event.format} — ${event.type}`}
                date={`${event.dateDay || event.day} ${event.dateMonth || event.month} ${event.dateYear || '2026'}`}
                title={event.title}
                href={`/event/${event.slug}`}
                description={event.description}
                location={event.location}
                price={event.price}
                badge={event.organizer}
                actionText="Lihat Detail"
                data-type={(event.type || '').toLowerCase()}
                data-format={(event.format || '').toLowerCase()}
                data-location={(event.location || '').toLowerCase()}
              />
            ))
          )}
        </div>
        <div id="no-events-message" class="hidden text-center py-10 bg-white rounded-[28px] border border-[#d7d6cf] text-sm text-[#6e6d68]">
          Tidak ada event yang sesuai dengan filter yang dipilih. Silakan coba filter lainnya.
        </div>
      </div>

      <!-- Right Column: Kalender + Spotlight + Checklist Persiapan (4 cols) -->
      <div class="lg:col-span-4 flex flex-col">
        <div class="hidden lg:flex items-center justify-between mb-4 sm:mb-5">
          <h3 class="text-base sm:text-lg font-bold text-[#101010]">Jadwal &amp; Persiapan</h3>
          <span class="text-xs text-[#6e6d68] font-medium">Siap Melamar</span>
        </div>

        <div class="flex-1 flex flex-col gap-4 sm:gap-5">

        <!-- 1. Kalender Event Widget Dinamis (Ditampilkan di tablet/desktop agar mobile hemat layar) -->
        <div class="calendar-widget-card hidden sm:block relative bg-white rounded-[28px] border border-[#d7d6cf]/90 p-5 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)]">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-[#d7d6cf]/50">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-[#101010]">Kalender Agenda</h3>
            <span class="text-[11px] font-bold text-[#1738D1]">{activeMonthName} {activeYear}</span>
          </div>

          <!-- Calendar Days Grid -->
          <div class="grid grid-cols-7 gap-1 text-center text-xs mb-2.5">
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Sen</span>
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Sel</span>
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Rab</span>
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Kam</span>
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Jum</span>
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Sab</span>
            <span class="text-[#6e6d68] font-semibold py-0.5 text-[11px]">Min</span>

            {/* Render 30 hari untuk bulan aktif */}
            {calendarDays.map((item) => {
              if (item.event) {
                const ev = item.event;
                return (
                  <div class="relative group/cal flex items-center justify-center hover:z-50 focus-within:z-50">
                    <a
                      href={`/event/${ev.slug}`}
                      class={`w-full py-0.5 rounded-full ${item.bgClass} font-bold text-center block transition cursor-pointer shadow-2xs hover:scale-105 active:scale-95`}
                      aria-label={`${ev.title} (${ev.date})`}
                    >
                      {item.day}
                    </a>

                    {/* Custom Design System Tooltip (CSS Native) */}
                    <div
                      role="tooltip"
                      class={`pointer-events-none absolute ${item.isTopRow ? 'top-full mt-2' : 'bottom-full mb-2'} ${item.posClass} z-50 opacity-0 invisible group-hover/cal:opacity-100 group-hover/cal:visible group-focus-within/cal:opacity-100 group-focus-within/cal:visible transition-all duration-150 ease-out`}
                    >
                      <div class="relative bg-[#101010] text-white text-xs rounded-xl p-3 shadow-2xl border border-white/10 w-56 sm:w-64 text-left">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                          <span class={`text-[9px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full ${item.badgeBg}`}>
                            {ev.type}
                          </span>
                          <span class="text-[10px] text-[#a0a09b] font-medium truncate max-w-[120px]">
                            {ev.format}
                          </span>
                        </div>
                        <p class="text-xs font-bold text-[#f5f6f2] leading-snug line-clamp-2 mb-1.5">
                          {ev.title}
                        </p>
                        <div class="pt-1.5 border-t border-white/10 flex items-center justify-between text-[10px] text-[#a0a09b]">
                          <span class="font-medium text-[#d7d6cf]">
                            {ev.fullDate || ev.date}
                          </span>
                          <span class="text-[#c8f55b] font-bold flex items-center gap-0.5">
                            Detail <span>→</span>
                          </span>
                        </div>
                        <div
                          class={`absolute ${item.isTopRow ? 'bottom-full -mb-px border-b-[5px] border-b-[#101010]' : 'top-full -mt-px border-t-[5px] border-t-[#101010]'} ${item.arrowClass} w-0 h-0 border-x-4 border-x-transparent`}
                        ></div>
                      </div>
                    </div>
                  </div>
                );
              }
              return <span class="text-[#101010] py-0.5">{item.day}</span>;
            })}
          </div>

          <!-- Calendar Legend -->
          <div class="flex items-center justify-between text-[10px] text-[#6e6d68] pt-2 border-t border-[#d7d6cf]/50">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[#1738D1]"></span> Job Fair</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Webinar</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-600"></span> Workshop</span>
          </div>
        </div>

        <!-- 2. Spotlight Event Cutout Card (Data Riil) -->
        {spotlightEvent && (
          <div class="group/cutout bg-white rounded-[28px] border border-[#d7d6cf]/90 p-5 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)] relative overflow-hidden flex flex-col justify-between" data-slot="cutout-card">
            <!-- Pin Badge (Top-Right) -->
            <div class="absolute top-0 right-0 bg-amber-500 text-white rounded-bl-[14px] px-3 h-[24px] flex items-center text-[10px] font-extrabold uppercase tracking-wider shadow-xs ring-1 ring-white/20 z-10" data-slot="cutout-card-pin">
              <span class="leading-none">Spotlight</span>
              <CutoutCorner class="text-amber-500 absolute top-0 -left-[13px] -rotate-90 pointer-events-none" size={14} />
              <CutoutCorner class="text-amber-500 absolute right-0 -bottom-[13px] -rotate-90 pointer-events-none" size={14} />
            </div>

            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                  {spotlightEvent.format || 'Pilihan'}
                </span>
              </div>

              <h4 class="text-sm sm:text-base font-bold text-[#101010] leading-snug mb-1.5 group-hover/cutout:text-[#1738D1] transition">
                <a href={`/event/${spotlightEvent.slug}`} class="hover:underline">{spotlightEvent.title}</a>
              </h4>
              <div class="space-y-1 text-xs text-[#6e6d68] mb-3.5 font-medium">
                <div class="flex items-center gap-1.5">
                  <span class="text-[#101010] font-bold">{spotlightEvent.fullDate || spotlightEvent.date}</span>
                  <span>·</span>
                  <span class="truncate">{spotlightEvent.location}</span>
                </div>
                <div class="text-[11px] text-[#6e6d68] truncate">
                  Diselenggarakan oleh {spotlightEvent.organizer}
                </div>
              </div>
            </div>

            <a
              href={`/event/${spotlightEvent.slug}`}
              class="w-full py-2 px-3 rounded-full bg-[#101010] hover:bg-[#000000] text-white text-xs font-bold text-center transition-all duration-300 block shadow-xs active:scale-[0.98]"
            >
              Lihat Detail &amp; Tiket
            </a>
          </div>
        )}

        <!-- 3. Checklist Persiapan Job Fair + CTA Buat CV ATS (Pengisi Ruang Sejajar Grid) -->
        <div class="group/cutout bg-white rounded-[28px] border border-[#d7d6cf]/90 p-5 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)] relative overflow-hidden flex-1 flex flex-col justify-between" data-slot="cutout-card">
          <!-- Pin Badge (Top-Right) -->
          <div class="absolute top-0 right-0 bg-[#1738D1] text-white rounded-bl-[14px] px-3 h-[24px] flex items-center text-[10px] font-extrabold uppercase tracking-wider shadow-xs ring-1 ring-white/20 z-10" data-slot="cutout-card-pin">
            <span class="leading-none">Siap Kerja</span>
            <CutoutCorner class="text-[#1738D1] absolute top-0 -left-[13px] -rotate-90 pointer-events-none" size={14} />
            <CutoutCorner class="text-[#1738D1] absolute right-0 -bottom-[13px] -rotate-90 pointer-events-none" size={14} />
          </div>

          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-[10px] font-bold text-[#1738D1] bg-[#1738D1]/8 px-2 py-0.5 rounded-full border border-[#1738D1]/20">
                Persiapan Bursa Kerja
              </span>
            </div>

            <h4 class="text-sm sm:text-base font-bold text-[#101010] leading-snug mb-2">
              Checklist Hadir Job Fair &amp; Walk-In
            </h4>

            <ul class="space-y-1.5 text-xs text-[#52514d] mb-4 font-medium">
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">✓</span>
                <span>Siapkan CV format ATS 1 halaman (PDF &amp; cetak 5 rangkap)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">✓</span>
                <span>Catat daftar booth perusahaan &amp; posisi incaran sebelum tiba</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-4 h-4 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">✓</span>
                <span>Latih perkenalan singkat 60 detik saat menyerahkan berkas</span>
              </li>
            </ul>
          </div>

          <a
            href={CV_BUILDER_URL}
            class="w-full py-2 px-3 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white text-xs font-bold text-center transition-all duration-300 block shadow-xs active:scale-[0.98]"
          >
            Buat CV Standar ATS
          </a>
        </div>

        </div>

      </div>

    </div>

    <!-- Bottom Banner -->
    <div class="mt-8 bg-white border border-[#d7d6cf]/90 rounded-[28px] p-5 sm:p-6 flex flex-col lg:flex-row items-center justify-between gap-4 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)]">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#1738D1] flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm sm:text-base font-semibold text-[#101010] leading-snug">
            Ingin Hadir ke Bursa Kerja atau Mempublikasikan Event Kampus?
          </h4>
          <p class="text-xs sm:text-sm text-[#6e6d68] mt-0.5 font-medium">
            Jelajahi kalender job fair nasional atau daftarkan agenda institusimu ke talenta muda terverifikasi.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 shrink-0 w-full lg:w-auto justify-end">
        <a
          href="/kemitraan#mitra-event"
          class="px-4 py-2.5 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs sm:text-sm font-semibold transition text-center"
        >
          Daftarkan Event Kampus
        </a>
        <a
          href="/event"
          class="px-5 py-2.5 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white text-xs sm:text-sm font-semibold transition shadow-sm text-center"
        >
          Lihat Semua Event
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const typeTabs = document.querySelectorAll('#event-type-tabs .event-filter-btn');
    const formatFilter = document.getElementById('event-format-filter');
    const cityFilter = document.getElementById('event-city-filter');
    const cards = document.querySelectorAll('.event-card-item');
    const noMsg = document.getElementById('no-events-message');

    let currentType = 'all';
    let currentFormat = 'all';
    let currentCity = 'all';

    function applyEventFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const type = card.getAttribute('data-type') || '';
        const format = card.getAttribute('data-format') || '';
        const loc = card.getAttribute('data-location') || '';

        const matchType = currentType === 'all' || type.includes(currentType);
        const matchFormat = currentFormat === 'all' || format.includes(currentFormat);
        const matchCity = currentCity === 'all' || loc.includes(currentCity);

        if (matchType && matchFormat && matchCity) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noMsg) {
        if (visibleCount === 0) noMsg.classList.remove('hidden');
        else noMsg.classList.add('hidden');
      }
    }

    typeTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        typeTabs.forEach((t) => {
          t.classList.remove('bg-[#1738D1]', 'text-white');
          t.classList.add('bg-white', 'text-[#101010]', 'border', 'border-[#d7d6cf]');
        });
        tab.classList.remove('bg-white', 'text-[#101010]', 'border', 'border-[#d7d6cf]');
        tab.classList.add('bg-[#1738D1]', 'text-white');

        currentType = tab.getAttribute('data-type') || 'all';
        applyEventFilters();
      });
    });

    formatFilter?.addEventListener('change', (e) => {
      currentFormat = e.target.value;
      applyEventFilters();
    });

    cityFilter?.addEventListener('change', (e) => {
      currentCity = e.target.value;
      applyEventFilters();
    });
  })();
</script>
