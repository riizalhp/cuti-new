---
interface Props {
  name:
    | 'arrow-down'
    | 'arrow-left'
    | 'arrow-up-right'
    | 'check'
    | 'chevron-right'
    | 'circle-dot'
    | 'file-text'
    | 'layout-grid'
    | 'menu'
    | 'move-up-right'
    | 'scan-line'
    | 'sparkles'
    | 'target'
    | 'x';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth = 2, class: className } = Astro.props;

const paths: Record<string, string> = {
