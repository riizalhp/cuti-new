---
/**
 * CompanyTicker.astro
 * Ticker marquee logo perusahaan dalam 2 baris:
 * - Baris 1 (Atas): Bergerak ke KIRI
 * - Baris 2 (Bawah): Bergerak ke KANAN
 * Menggunakan 20 logo dari folder public/testimoni/ dengan loop mulus tanpa jeda.
 */

interface CompanyLogo {
  name: string;
  src: string;
}

const row1Companies: CompanyLogo[] = [
  { name: 'Alfamart', src: '/testimoni/alfamart.webp' },
  { name: 'Astra International', src: '/testimoni/astra.webp' },
  { name: 'Bank Mandiri', src: '/testimoni/mandiri.webp' },
  { name: 'Deloitte', src: '/testimoni/deloitte.webp' },
  { name: 'Denso', src: '/testimoni/denso.webp' },
  { name: 'Fore Coffee', src: '/testimoni/fore.webp' },
  { name: 'Gojek', src: '/testimoni/gojek.webp' },
  { name: 'Indofood', src: '/testimoni/indofood.webp' },
  { name: 'Indomaret', src: '/testimoni/indomaret.webp' },
];

const row2Companies: CompanyLogo[] = [
  { name: 'MR.DIY', src: '/testimoni/mrdiy.webp' },
  { name: 'Shopee', src: '/testimoni/shopee.webp' },
  { name: 'Sinar Mas', src: '/testimoni/sinarmas.webp' },
  { name: 'Solaria', src: '/testimoni/solaria.webp' },
  { name: 'Suzuki', src: '/testimoni/suzuki.webp' },
  { name: 'Telkom Indonesia', src: '/testimoni/telkom.webp' },
  { name: 'Trans TV', src: '/testimoni/transtv.webp' },
  { name: 'Unilever', src: '/testimoni/unilever.webp' },
  { name: 'Wings Group', src: '/testimoni/wings.webp' },
];

interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'light' } = Astro.props;
---

<section class:list={['company-ticker', `company-ticker--${variant}`]} aria-label="Companies where users prepare their next career move">
  <div class="company-ticker__header">
    <div class="company-ticker__title-wrapper">
      <span class="company-ticker__dot"></span>
      <p class="company-ticker__title">Used to prepare their next steps at</p>
      <span class="company-ticker__dot"></span>
    </div>
  </div>

  <div class="company-ticker__sliders-container">
    <!-- ROW 1: MOVES LEFT -->
    <div class="company-ticker__slider" tabindex="0" role="region" aria-label="Company logos row 1">
      <div class="company-ticker__track company-ticker__track--left">
        <div class="company-ticker__group">
          {row1Companies.map((company) => (
            <div class="company-ticker__item" title={company.name} aria-label={company.name}>
              <img src={company.src} alt={company.name} class="company-logo-img" loading="lazy" />
            </div>
          ))}
        </div>
        <div class="company-ticker__group" aria-hidden="true">
          {row1Companies.map((company) => (
            <div class="company-ticker__item" title={company.name} aria-label={company.name}>
              <img src={company.src} alt={company.name} class="company-logo-img" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ROW 2: MOVES RIGHT -->
    <div class="company-ticker__slider" tabindex="0" role="region" aria-label="Company logos row 2">
      <div class="company-ticker__track company-ticker__track--right">
        <div class="company-ticker__group">
          {row2Companies.map((company) => (
            <div class="company-ticker__item" title={company.name} aria-label={company.name}>
              <img src={company.src} alt={company.name} class="company-logo-img" loading="lazy" />
            </div>
          ))}
        </div>
        <div class="company-ticker__group" aria-hidden="true">
          {row2Companies.map((company) => (
            <div class="company-ticker__item" title={company.name} aria-label={company.name}>
              <img src={company.src} alt={company.name} class="company-logo-img" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .company-ticker {
    width: 100% !important;
    overflow: hidden !important;
    position: relative !important;
    padding: 24px 0 10px !important;
    z-index: 5;
    box-sizing: border-box;
  }

  /* DARK VARIANT */
  .company-ticker--dark {
    background: transparent !important;
  }

  .company-ticker--dark .company-ticker__title {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  .company-ticker--dark .company-ticker__dot {
    background: #5078ff !important;
    box-shadow: 0 0 8px rgba(80, 120, 255, 0.6);
  }

  .company-ticker--dark .company-ticker__item img {
    filter: grayscale(100%) brightness(1.2) opacity(0.48) !important;
  }

  .company-ticker--dark .company-ticker__item:hover img {
    filter: grayscale(0%) brightness(1) opacity(1) !important;
  }

  /* LIGHT VARIANT (Default) */
  .company-ticker--light {
    background: var(--paper) !important;
  }

  .company-ticker--light .company-ticker__title {
    color: #6b6a65 !important;
  }

  .company-ticker--light .company-ticker__dot {
    background: var(--blue, #1738D1) !important;
    opacity: 0.75;
  }

  .company-ticker--light .company-ticker__item img {
    filter: grayscale(100%) contrast(0.85) opacity(0.55) !important;
  }

  .company-ticker--light .company-ticker__item:hover img {
    filter: grayscale(0%) contrast(1) opacity(1) !important;
  }

  /* HEADER */
  .company-ticker__header {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    margin-bottom: 24px !important;
    text-align: center !important;
    width: 100% !important;
  }

  .company-ticker__title-wrapper {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 12px !important;
  }

  .company-ticker__dot {
    display: inline-block !important;
    width: 5px !important;
    height: 5px !important;
    border-radius: 999px !important;
    flex-shrink: 0 !important;
  }

  .company-ticker__title {
    font-family: "Inter Tight", "Inter", sans-serif !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
  }

  /* SLIDERS CONTAINER (2 BARIS) */
  .company-ticker__sliders-container {
    display: flex !important;
    flex-direction: column !important;
    gap: 22px !important;
    width: 100% !important;
    overflow: hidden !important;
  }

  .company-ticker__slider {
    width: 100% !important;
    overflow: hidden !important;
    position: relative !important;
    display: flex !important;
    flex-direction: row !important;
    padding: 6px 0 !important;
    /* Efek fade gradasi halus di sisi kiri & kanan */
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.8) 4%,
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0.8) 96%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.8) 4%,
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0.8) 96%,
      transparent 100%
    );
  }

  .company-ticker__track {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    width: max-content !important;
    will-change: transform;
  }

  .company-ticker__group {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    gap: 52px !important;
    padding-right: 52px !important;
    flex-shrink: 0 !important;
  }

  /* Baris 1: jalan ke KIRI */
  .company-ticker__track--left {
    animation: ticker-slide-left 32s linear infinite !important;
  }

  /* Baris 2: jalan ke KANAN */
  .company-ticker__track--right {
    animation: ticker-slide-right 32s linear infinite !important;
  }

  /* Saat kursor diarahkan ke slider, gerakan dijeda agar nyaman dilihat */
  .company-ticker__slider:hover .company-ticker__track {
    animation-play-state: paused !important;
  }

  .company-ticker__item {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 170px !important;
    height: 56px !important;
    padding: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    cursor: pointer !important;
    user-select: none !important;
    flex-shrink: 0 !important;
    transition: transform 0.24s cubic-bezier(0.23, 1, 0.32, 1) !important;
  }

  .company-ticker__item img {
    display: block !important;
    max-height: 44px !important;
    max-width: 145px !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
    transition: filter 0.28s cubic-bezier(0.23, 1, 0.32, 1),
                opacity 0.28s cubic-bezier(0.23, 1, 0.32, 1),
                transform 0.28s cubic-bezier(0.23, 1, 0.32, 1) !important;
  }

  .company-ticker__item:hover {
    transform: translateY(-2px) !important;
  }

  .company-ticker__item:hover img {
    transform: scale(1.1) !important;
  }

  @keyframes ticker-slide-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes ticker-slide-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (max-width: 700px) {
    .company-ticker {
      padding: 16px 0 6px !important;
    }
    .company-ticker__header {
      margin-bottom: 16px !important;
    }
    .company-ticker__title {
      font-size: 10px !important;
      letter-spacing: 0.1em !important;
    }
    .company-ticker__sliders-container {
      gap: 16px !important;
    }
    .company-ticker__group {
      gap: 32px !important;
      padding-right: 32px !important;
    }
    .company-ticker__item {
      width: 130px !important;
      height: 44px !important;
    }
    .company-ticker__item img {
      max-height: 32px !important;
      max-width: 105px !important;
    }
    .company-ticker__track--left {
      animation-duration: 24s !important;
    }
    .company-ticker__track--right {
      animation-duration: 24s !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-ticker__track {
      animation: none !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
    }
    .company-ticker__item {
      scroll-snap-align: center !important;
    }
  }
</style>
