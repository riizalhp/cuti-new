---
// Navbar.astro - Header Editorial Career Information Portal
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-[72px] flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center group py-1" aria-label="Beranda Employer Job">
      <img
        src="/employer-job.svg"
        alt="Employer Job"
        class="h-9 sm:h-10 w-auto object-contain transition-transform group-hover:scale-[1.02]"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 text-[14px] font-normal text-slate-600">
      <a href="/" class="px-3.5 py-2 rounded-lg text-[#1738d1] font-medium bg-blue-50/80 hover:bg-blue-50 transition-colors">
        Beranda
      </a>

      <!-- Dropdown Lowongan -->
      <div class="relative group">
        <a href="/lowongan" class="px-3 py-2 rounded-lg hover:text-slate-900 hover:bg-slate-100 flex items-center gap-1 transition-colors cursor-pointer">
          <span>Lowongan</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>
        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-150 z-50">
          <div class="w-56 bg-white rounded-xl shadow-xl border border-slate-100 p-2 text-sm">
            <a href="/lowongan" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-[#1738d1]"></span>
              Semua Lowongan
            </a>
            <a href="/lowongan?exp=fresh" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
              Fresh Graduate
            </a>
            <a href="/lowongan?type=remote" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
              Kerja Remote
            </a>
            <a href="/lowongan?type=magang" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
              Magang & Internship
            </a>
          </div>
        </div>
      </div>

      <a href="/sertifikasi" class="px-3 py-2 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
        Sertifikasi
      </a>
      <a href="/course" class="px-3 py-2 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
        Course
      </a>
      <a href="/event" class="px-3 py-2 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
        Event
      </a>

      <!-- Dropdown Artikel -->
      <div class="relative group">
        <a href="/career" class="px-3 py-2 rounded-lg hover:text-slate-900 hover:bg-slate-100 flex items-center gap-1 transition-colors cursor-pointer">
          <span>Artikel</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>
        <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-150 z-50">
          <div class="w-56 bg-white rounded-xl shadow-xl border border-slate-100 p-2 text-sm">
            <a href="/career" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-[#1738d1]"></span>
              Semua Artikel
            </a>
            <a href="/career?cat=tips" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
              Tips Karier
            </a>
            <a href="/career?cat=cv" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
              CV & Interview
            </a>
            <a href="/career?cat=gaji" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-blue-50 hover:text-[#1738d1] transition">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
              Dunia Kerja & Gaji
            </a>
          </div>
        </div>
      </div>

      <a href="/tentang" class="px-3 py-2 rounded-lg hover:text-slate-900 hover:bg-slate-100 transition-colors">
        Tentang
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Search Button Trigger -->
      <button
        type="button"
        id="open-search-btn"
        aria-label="Cari info lowongan, sertifikasi, dan event"
        class="w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 hover:text-[#1738d1] hover:bg-slate-100 transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>

      <!-- Masuk Button (Link ke portal akun pengguna) -->
      <a
        href="http://localhost:3000/login"
        class="px-5 py-2.5 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-sm font-medium shadow-md shadow-blue-600/20 hover:shadow-lg hover:shadow-blue-600/30 transition-all active:scale-[0.98] inline-flex items-center gap-1.5"
      >
        <span>Masuk</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Buka menu navigasi"
        class="lg:hidden w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 hover:bg-slate-100"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white px-4 py-4 space-y-2 shadow-lg">
    <a href="/" class="block px-3 py-2.5 rounded-lg text-sm font-bold text-[#1738d1] bg-blue-50">Beranda</a>
    <a href="/lowongan" class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50">Lowongan Kerja</a>
    <a href="/sertifikasi" class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50">Sertifikasi</a>
    <a href="/course" class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50">Course & Pelatihan</a>
    <a href="/event" class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50">Event & Job Fair</a>
    <a href="/career" class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50">Artikel & Tips Karier</a>
    <a href="/tentang" class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50">Tentang Employer Job</a>
  </div>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
