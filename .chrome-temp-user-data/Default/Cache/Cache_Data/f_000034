/* ============================================================
   EMPLOYER JOB — Design System (Port 4321 Matched)
   Palet: warm paper (#f4f3ee), deep ink (#101010), Employr blue (#0000ff / #1738d1)
   Tipografi: Inter Tight + DM Sans + Instrument Serif (italic em) + Caveat
   Mikro-interaksi & Bentuk: Pill (rounded-full), signature .section-label
   ============================================================ */

* { box-sizing: border-box; }

:root {
  /* Color Palette — 1:1 Matched to Port 4321 */
  --paper: #f4f3ee;
  --paper-soft: #f9f8f5;
  --surface: #ffffff;
  --ink: #101010;
  --blue: #0000ff;
  --blue-hover: #0000cc;
  --cobalt: #1738d1;
  --periwinkle: #c9d0ff;
  --periwinkle-soft: #f0f2ff;
  --lime: #c8f55b;
  --muted: #55544f;
  --faint: #8e8d88;
  --border: #d7d6cf;
  --border-light: rgba(16, 16, 16, 0.08);
  --line: rgba(16, 16, 16, 0.12);

  /* Typography */
  --sans: 'Inter Tight', 'DM Sans', system-ui, sans-serif;
  --display: 'DM Sans', 'Inter Tight', sans-serif;
  --serif: 'Instrument Serif', Georgia, serif;
  --doodle: 'Caveat', cursive, sans-serif;

  /* Radius — Pill & Smooth */
  --r-pill: 9999px;
  --r-card: 20px;
  --r-card-sm: 14px;
  --r-sm: 8px;

  /* Elevation */
  --shadow-paper: 0 4px 20px -2px rgba(16, 16, 16, 0.04);
  --shadow-hover: 0 12px 30px -4px rgba(16, 16, 16, 0.08);
  --shadow-pill: 0 4px 14px rgba(0, 0, 255, 0.25);

  /* Transitions */
  --ease: cubic-bezier(0.23, 1, 0.32, 1);
  --fast: 180ms;
  --normal: 260ms;
}

html {
  scroll-behavior: smooth;
  background: var(--paper);
  scrollbar-width: thin;
  scrollbar-color: rgba(16, 16, 16, 0.25) transparent;
  overflow-x: clip;
  max-width: 100vw;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.55;
  overflow-x: clip;
  max-width: 100vw;
}

::-moz-selection {
  background: var(--blue);
  color: #ffffff;
}

::selection {
  background: var(--blue);
  color: #ffffff;
}

a {
  color: inherit;
  text-decoration: none;
}
a:hover {
  text-decoration: none;
}
img {
  display: block;
  max-width: 100%;
}
button {
  font: inherit;
  cursor: pointer;
}
button:focus-visible, a:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
}

.font-doodle {
  font-family: var(--doodle);
}

/* ---------- Typography & Editorial Accents ---------- */
h1, h2, h3, h4 {
  font-family: var(--display);
  line-height: 1.15;
  letter-spacing: -0.03em;
  font-weight: 700;
  color: var(--ink);
}

h1 em, h2 em, h3 em, em {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  color: var(--blue);
  letter-spacing: -0.02em;
}

.small {
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
}
.tiny {
  font-size: 11px;
  font-weight: 500;
  color: var(--faint);
}
.caps {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 10px;
  font-weight: 700;
  color: var(--blue);
}

/* Signature Section Label — Port 4321 */
.section-label {
  align-items: center;
  color: #75746e;
  display: flex;
  font-size: 10px;
  font-weight: 800;
  gap: 9px;
  letter-spacing: .145em;
  line-height: 1;
  text-transform: uppercase;
}
.section-label i {
  background: var(--blue);
  display: inline-block;
  height: 7px;
  width: 7px;
  border-radius: 1px;
  flex-shrink: 0;
}
.section-label--inverse {
  color: #a5a5a1;
}
.section-label--inverse i {
  background: #ffffff;
}

/* ---------- Buttons & Chips (Pill Shaped) ---------- */
.btn-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px 20px;
  border-radius: var(--r-pill);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.03em;
  transition: transform var(--fast) var(--ease), background var(--fast) var(--ease), box-shadow var(--fast) var(--ease), border-color var(--fast) var(--ease), color var(--fast) var(--ease);
}
.btn-pill:hover {
  transform: translateY(-1px);
}
.btn-pill:active {
  transform: translateY(1px) scale(0.98);
}

.btn-pill-primary {
  background: var(--blue);
  color: #ffffff;
  border: 1px solid var(--blue);
  box-shadow: var(--shadow-pill);
}
.btn-pill-primary:hover {
  background: var(--blue-hover);
  border-color: var(--blue-hover);
  color: #ffffff;
  box-shadow: 0 6px 20px rgba(0, 0, 255, 0.35);
}

.btn-pill-outline {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-paper);
}
.btn-pill-outline:hover {
  border-color: var(--ink);
  color: var(--ink);
}

.btn-pill-ghost {
  background: transparent;
  color: var(--muted);
  border: 1px solid transparent;
}
.btn-pill-ghost:hover {
  color: var(--ink);
  background: rgba(16, 16, 16, 0.04);
}

/* Pills & Tags */
.pill-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 12px;
  border-radius: var(--r-pill);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.02em;
  background: var(--surface);
  border: 1px solid var(--border-light);
  color: var(--ink);
  transition: all var(--fast) var(--ease);
}
.pill-tag:hover {
  border-color: var(--border);
}
.pill-tag.active {
  background: var(--ink);
  color: #ffffff;
  border-color: var(--ink);
}
.pill-tag.blue {
  background: var(--periwinkle-soft);
  color: var(--blue);
  border-color: rgba(0, 0, 255, 0.15);
}

/* ---------- Cards & Containers ---------- */
.card-paper {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-paper);
  transition: transform var(--normal) var(--ease), box-shadow var(--normal) var(--ease), border-color var(--fast) var(--ease);
}
.card-paper:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(0, 0, 255, 0.25);
}

.card-paper-sm {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-card-sm);
  box-shadow: var(--shadow-paper);
  transition: transform var(--normal) var(--ease), box-shadow var(--normal) var(--ease), border-color var(--fast) var(--ease);
}
.card-paper-sm:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(0, 0, 255, 0.25);
}

/* Legacy .card mapping to card-paper */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-card-sm);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-shadow: var(--shadow-paper);
  transition: border-color var(--fast) var(--ease), box-shadow var(--normal) var(--ease), transform var(--fast) var(--ease);
}
.card:hover {
  border-color: rgba(0, 0, 255, 0.3);
  box-shadow: var(--shadow-hover);
  transform: translateY(-2px);
}

/* ---------- Native Ad Slot (Framed Paper Style) ---------- */
.ad-slot-editorial {
  background: #f9f8f5;
  border: 1px dashed var(--border);
  border-radius: var(--r-card-sm);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px;
  text-align: center;
}
.ad-slot-tag {
  position: absolute;
  top: 8px;
  right: 10px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  background: var(--paper);
  padding: 2px 8px;
  border-radius: var(--r-pill);
  border: 1px solid var(--border);
}

/* ============================================================
   Employr Design System — Sleek Global & Custom Scrollbars
   Editorial Paper & Ink Aesthetic
   ============================================================ */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(16, 16, 16, 0.2);
  border-radius: 9999px;
  -webkit-transition: background-color 0.2s ease;
  transition: background-color 0.2s ease;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(16, 16, 16, 0.45);
}

::-webkit-scrollbar-thumb:active {
  background: var(--cobalt, #1738d1);
}

/* Custom Sleek Scrollbar Utility */
.custom-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: rgba(16, 16, 16, 0.25) transparent;
}

.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(16, 16, 16, 0.22);
  border-radius: 9999px;
  -webkit-transition: background-color 0.2s ease;
  transition: background-color 0.2s ease;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(16, 16, 16, 0.45);
}

.custom-scrollbar::-webkit-scrollbar-thumb:active {
  background: var(--cobalt, #1738d1);
}

/* Hide Scrollbars Utilities */
.no-scrollbar::-webkit-scrollbar,
.scrollbar-none::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.no-scrollbar,
.scrollbar-none {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* ---------- Animation & Motion ---------- */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}
.animate-float {
  animation: float 4s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

