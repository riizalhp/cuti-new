---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterPortal from '../../components/FooterPortal.astro';
import AdSlot from '../../components/AdSlot.astro';
import SearchModal from '../../components/SearchModal.astro';
import PageHero from '../../components/common/PageHero.astro';
import OrganicCardSmall from '../../components/common/OrganicCardSmall.astro';
import {
  lowonganList,
  eventList,
  artikelList,
  sertifikasiList,
  courseList,
  ensureData,
} from '../../data/mock';

await ensureData();

const rawQ = Astro.url.searchParams.get('q') || '';
const query = rawQ.trim().toLowerCase();
const rawTab = (Astro.url.searchParams.get('type') || Astro.url.searchParams.get('tab') || 'all').toLowerCase();
const activeTab = ['all', 'lowongan', 'event', 'career', 'sertifikasi', 'course'].includes(rawTab) ? rawTab : 'all';

// Filter data riil berdasarkan query
const matchingJobs = query
  ? lowonganList.filter((j) => {
      const matchTitle = (j.title || '').toLowerCase().includes(query);
      const matchComp = (j.company || '').toLowerCase().includes(query);
      const matchDesc = (j.description || '').toLowerCase().includes(query);
      const matchCat = (j.category || '').toLowerCase().includes(query);
      const matchLoc = (j.location || j.geo || '').toLowerCase().includes(query);
      const matchType = (j.type || '').toLowerCase().includes(query);
      return matchTitle || matchComp || matchDesc || matchCat || matchLoc || matchType;
    })
  : lowonganList;

const matchingEvents = query
  ? eventList.filter((e) => {
      const matchTitle = (e.title || '').toLowerCase().includes(query);
      const matchOrg = (e.organizer || '').toLowerCase().includes(query);
      const matchDesc = (e.description || '').toLowerCase().includes(query);
      const matchLoc = (e.location || e.geo || '').toLowerCase().includes(query);
      const matchType = (e.type || '').toLowerCase().includes(query);
      const matchFmt = (e.format || '').toLowerCase().includes(query);
      return matchTitle || matchOrg || matchDesc || matchLoc || matchType || matchFmt;
    })
  : eventList;

const matchingArticles = query
  ? artikelList.filter((a) => {
      const matchTitle = (a.title || '').toLowerCase().includes(query);
      const matchExcerpt = (a.excerpt || '').toLowerCase().includes(query);
      const matchCat = (a.category || '').toLowerCase().includes(query);
      const matchAuthor = (a.author || '').toLowerCase().includes(query);
      const matchTags = Array.isArray(a.tags) && a.tags.some((t) => t.toLowerCase().includes(query));
      return matchTitle || matchExcerpt || matchCat || matchAuthor || matchTags;
    })
  : artikelList;

const matchingCerts = query
  ? sertifikasiList.filter((c) => {
      const matchTitle = (c.title || '').toLowerCase().includes(query);
      const matchProv = (c.provider || '').toLowerCase().includes(query);
      const matchIss = (c.issuer || '').toLowerCase().includes(query);
      const matchDesc = (c.description || '').toLowerCase().includes(query);
      const matchSkills = Array.isArray(c.skills) && c.skills.some((s) => s.toLowerCase().includes(query));
      return matchTitle || matchProv || matchIss || matchDesc || matchSkills;
    })
  : sertifikasiList;

const matchingCourses = query
  ? courseList.filter((k) => {
      const matchTitle = (k.title || '').toLowerCase().includes(query);
      const matchProv = (k.provider || '').toLowerCase().includes(query);
      const matchDesc = (k.description || '').toLowerCase().includes(query);
      const matchLvl = (k.level || '').toLowerCase().includes(query);
      const matchBen = Array.isArray(k.benefits) && k.benefits.some((b) => b.toLowerCase().includes(query));
      return matchTitle || matchProv || matchDesc || matchLvl || matchBen;
    })
  : courseList;

const totalMatches =
  matchingJobs.length +
  matchingEvents.length +
  matchingArticles.length +
  matchingCerts.length +
  matchingCourses.length;

const title = rawQ
  ? `Hasil Pencarian: "${rawQ}" | Employr Portal`
  : 'Pencarian Terpadu Lowongan, Event & Panduan Karier | Employr Portal';
const description =
  'Cari lowongan kerja resmi, agenda bursa kerja & event, tips wawancara, skema sertifikasi, dan kursus skill digital terlengkap.';

const getTabUrl = (tab: string) => {
  const params = new URLSearchParams();
  if (rawQ) params.set('q', rawQ);
  if (tab !== 'all') params.set('type', tab);
  const qStr = params.toString();
  return `/search${qStr ? '?' + qStr : ''}`;
};
---

<BaseLayout title={title} description={description} canonicalUrl="http://localhost:3003/search">
  <Navbar />

  <main class="bg-[#f4f3ee] min-h-screen pb-20">
    <!-- Page Hero -->
    <PageHero
      eyebrow="PENCARIAN TERPADU PORTAL"
      title={rawQ ? `Hasil Pencarian: <em>"${rawQ}"</em>` : "Eksplorasi Peluang &amp; <em>Panduan Karier</em>"}
      description={rawQ ? `Ditemukan ${totalMatches} informasi dari direktori lowongan, event, panduan karier, dan pelatihan skill.` : "Temukan lowongan kerja, agenda job fair, tips persiapan karier, sertifikasi resmi, dan kursus keahlian dalam satu pencarian."}
      badge={{
        text: `${totalMatches} Total Ditemukan`,
        bgColor: 'bg-blue-50',
        textColor: 'text-[#1738D1]',
        borderColor: 'border border-blue-200',
      }}
    >
      <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-[#6e6d68] mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1738D1] transition">Beranda</a>
        <span>/</span>
        <span class="text-[#101010] font-semibold">Pencarian</span>
      </nav>
    </PageHero>

    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-6 sm:pt-8">
      <!-- Search Input Bar -->
      <form
        action="/search"
        method="GET"
        class="bg-white border border-[#d7d6cf] focus-within:border-[#1738D1] focus-within:ring-4 focus-within:ring-blue-500/10 rounded-full shadow-xs p-1.5 pl-4 sm:pl-5 flex items-center gap-2 mb-6"
      >
        <svg class="w-4 sm:w-5 h-4 sm:h-5 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          name="q"
          value={rawQ}
          placeholder="Cari lowongan, event, tips karier, sertifikasi, atau pelatihan skill..."
          class="min-w-0 flex-1 text-xs sm:text-sm md:text-base text-[#101010] placeholder-[#6e6d68] outline-none bg-transparent font-medium"
        />
        {rawQ && (
          <a
            href="/search"
            class="text-xs font-bold text-[#6e6d68] hover:text-[#101010] px-2 shrink-0 transition"
          >
            Reset
          </a>
        )}
        <button
          type="submit"
          class="px-5 sm:px-6 py-2.5 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white font-bold text-xs sm:text-sm shadow-md shadow-[#1738D1]/20 transition cursor-pointer shrink-0"
        >
          Cari
        </button>
      </form>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-8 no-scrollbar text-xs">
        <a
          href={getTabUrl('all')}
          class:list={[
            "px-4 py-2 rounded-full font-bold shrink-0 transition shadow-2xs",
            activeTab === 'all'
              ? "bg-[#1738D1] text-white"
              : "bg-white text-[#101010] border border-[#d7d6cf] hover:border-[#101010]"
          ]}
        >
          Semua ({totalMatches})
        </a>
        <a
          href={getTabUrl('lowongan')}
          class:list={[
            "px-4 py-2 rounded-full font-bold shrink-0 transition shadow-2xs",
            activeTab === 'lowongan'
              ? "bg-[#1738D1] text-white"
              : "bg-white text-[#101010] border border-[#d7d6cf] hover:border-[#101010]"
          ]}
        >
          Lowongan Kerja ({matchingJobs.length})
        </a>
        <a
          href={getTabUrl('event')}
          class:list={[
            "px-4 py-2 rounded-full font-bold shrink-0 transition shadow-2xs",
            activeTab === 'event'
              ? "bg-[#1738D1] text-white"
              : "bg-white text-[#101010] border border-[#d7d6cf] hover:border-[#101010]"
          ]}
        >
          Event &amp; Job Fair ({matchingEvents.length})
        </a>
        <a
          href={getTabUrl('career')}
          class:list={[
            "px-4 py-2 rounded-full font-bold shrink-0 transition shadow-2xs",
            activeTab === 'career'
              ? "bg-[#1738D1] text-white"
              : "bg-white text-[#101010] border border-[#d7d6cf] hover:border-[#101010]"
          ]}
        >
          Tips Karier ({matchingArticles.length})
        </a>
        <a
          href={getTabUrl('sertifikasi')}
          class:list={[
            "px-4 py-2 rounded-full font-bold shrink-0 transition shadow-2xs",
            activeTab === 'sertifikasi'
              ? "bg-[#1738D1] text-white"
              : "bg-white text-[#101010] border border-[#d7d6cf] hover:border-[#101010]"
          ]}
        >
          Sertifikasi ({matchingCerts.length})
        </a>
        <a
          href={getTabUrl('course')}
          class:list={[
            "px-4 py-2 rounded-full font-bold shrink-0 transition shadow-2xs",
            activeTab === 'course'
              ? "bg-[#1738D1] text-white"
              : "bg-white text-[#101010] border border-[#d7d6cf] hover:border-[#101010]"
          ]}
        >
          Pelatihan Skill ({matchingCourses.length})
        </a>
      </div>

      <!-- KONDISI HASIL 0 (EMPTY STATE) -->
      {totalMatches === 0 && (
        <div class="bg-white rounded-2xl border border-[#d7d6cf] p-8 sm:p-12 text-center max-w-xl mx-auto my-8">
          <div class="w-14 h-14 rounded-full bg-blue-50 text-[#1738D1] border border-blue-200 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <h2 class="text-lg sm:text-xl font-bold text-[#101010] mb-2">
            Tidak ada hasil untuk "{rawQ}"
          </h2>
          <p class="text-xs sm:text-sm text-[#6e6d68] mb-6 leading-relaxed">
            Periksa ejaan kata kunci kamu atau coba cari dengan kata yang lebih umum, seperti bidang kerja, nama kota, atau kategori peluang.
          </p>
          <div class="flex flex-wrap gap-2 justify-center">
            <span class="text-xs font-bold text-[#101010] self-center mr-1">Rekomendasi kata kunci:</span>
            <a href="/search?q=admin" class="px-3 py-1 bg-[#f4f3ee] hover:bg-[#eae8e0] border border-[#d7d6cf] rounded-full text-xs font-semibold text-[#101010] transition">Admin</a>
            <a href="/search?q=bumn" class="px-3 py-1 bg-[#f4f3ee] hover:bg-[#eae8e0] border border-[#d7d6cf] rounded-full text-xs font-semibold text-[#101010] transition">BUMN</a>
            <a href="/search?q=remote" class="px-3 py-1 bg-[#f4f3ee] hover:bg-[#eae8e0] border border-[#d7d6cf] rounded-full text-xs font-semibold text-[#101010] transition">Remote</a>
            <a href="/search?q=fresh" class="px-3 py-1 bg-[#f4f3ee] hover:bg-[#eae8e0] border border-[#d7d6cf] rounded-full text-xs font-semibold text-[#101010] transition">Fresh Graduate</a>
            <a href="/search?q=webinar" class="px-3 py-1 bg-[#f4f3ee] hover:bg-[#eae8e0] border border-[#d7d6cf] rounded-full text-xs font-semibold text-[#101010] transition">Webinar</a>
            <a href="/search?q=cv" class="px-3 py-1 bg-[#f4f3ee] hover:bg-[#eae8e0] border border-[#d7d6cf] rounded-full text-xs font-semibold text-[#101010] transition">Panduan CV</a>
          </div>
        </div>
      )}

      <!-- KONDISI HASIL ADA: TAMPILAN BERDASARKAN TAB -->

      <!-- TAB: SEMUA (MULTI-CATEGORY OVERVIEW) -->
      {totalMatches > 0 && activeTab === 'all' && (
        <div class="space-y-12">
          <!-- 1. Lowongan Terkait -->
          {matchingJobs.length > 0 && (
            <section>
              <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#d7d6cf]/80">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#1738D1]"></span>
                  <h2 class="text-base sm:text-lg font-bold text-[#101010]">
                    Lowongan Kerja Terkait <span class="text-[#6e6d68] text-xs sm:text-sm font-semibold">({matchingJobs.length})</span>
                  </h2>
                </div>
                {matchingJobs.length > 4 && (
                  <a
                    href={getTabUrl('lowongan')}
                    class="text-xs font-bold text-[#1738D1] hover:underline flex items-center gap-1"
                  >
                    Lihat Semua Lowongan ({matchingJobs.length}) →
                  </a>
                )}
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                {matchingJobs.slice(0, 4).map((job) => (
                  <a
                    href={`/lowongan/${job.slug}`}
                    class="group bg-white rounded-xl border border-[#d7d6cf] p-4 flex flex-col justify-between hover:border-[#1738D1]/40 hover:shadow-md transition"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1.5 mb-2">
                        <span class="text-[11px] font-bold text-[#6e6d68] uppercase truncate">{job.company}</span>
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-blue-50 text-[#1738D1] border border-blue-100 shrink-0">
                          {job.type}
                        </span>
                      </div>
                      <h3 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-2">
                        {job.title}
                      </h3>
                      <div class="text-[11px] text-[#6e6d68] font-medium flex items-center gap-1 mb-3">
                        <svg class="w-3 h-3 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        </svg>
                        <span>{job.location || job.geo}</span>
                      </div>
                    </div>
                    <div class="pt-2 border-t border-[#d7d6cf]/60 flex items-center justify-between">
                      <span class="font-bold text-[#101010] text-xs truncate">{job.salary}</span>
                      <span class="text-[10px] font-bold text-[#1738D1] flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
                        Lihat →
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- 2. Event & Job Fair Terkait -->
          {matchingEvents.length > 0 && (
            <section>
              <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#d7d6cf]/80">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                  <h2 class="text-base sm:text-lg font-bold text-[#101010]">
                    Event &amp; Job Fair Terkait <span class="text-[#6e6d68] text-xs sm:text-sm font-semibold">({matchingEvents.length})</span>
                  </h2>
                </div>
                {matchingEvents.length > 3 && (
                  <a
                    href={getTabUrl('event')}
                    class="text-xs font-bold text-[#1738D1] hover:underline flex items-center gap-1"
                  >
                    Lihat Semua Event ({matchingEvents.length}) →
                  </a>
                )}
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {matchingEvents.slice(0, 3).map((ev) => (
                  <OrganicCardSmall
                    image={ev.image}
                    imageAlt={ev.title}
                    category={`${ev.format} — ${ev.type}`}
                    date={`${ev.day} ${ev.month} 2026`}
                    title={ev.title}
                    href={`/event/${ev.slug}`}
                    description={ev.description}
                    location={ev.location}
                    price={ev.price}
                    actionText="Lihat Detail"
                  />
                ))}
              </div>
            </section>
          )}

          <!-- 3. Tips Karier & Artikel Terkait -->
          {matchingArticles.length > 0 && (
            <section>
              <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#d7d6cf]/80">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                  <h2 class="text-base sm:text-lg font-bold text-[#101010]">
                    Tips Karier &amp; Panduan Terkait <span class="text-[#6e6d68] text-xs sm:text-sm font-semibold">({matchingArticles.length})</span>
                  </h2>
                </div>
                {matchingArticles.length > 3 && (
                  <a
                    href={getTabUrl('career')}
                    class="text-xs font-bold text-[#1738D1] hover:underline flex items-center gap-1"
                  >
                    Lihat Semua Artikel ({matchingArticles.length}) →
                  </a>
                )}
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {matchingArticles.slice(0, 3).map((art) => (
                  <OrganicCardSmall
                    image={art.image}
                    imageAlt={art.title}
                    category={art.category}
                    date={art.date ? `${art.date} · ${art.readTime}` : art.readTime}
                    title={art.title}
                    href={`/career/${art.slug}`}
                    description={art.excerpt}
                    actionText="Baca Panduan"
                  />
                ))}
              </div>
            </section>
          )}

          <!-- 4. Sertifikasi & Pelatihan Skill Terkait -->
          {(matchingCerts.length > 0 || matchingCourses.length > 0) && (
            <section>
              <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#d7d6cf]/80">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                  <h2 class="text-base sm:text-lg font-bold text-[#101010]">
                    Sertifikasi &amp; Pelatihan Skill Terkait <span class="text-[#6e6d68] text-xs sm:text-sm font-semibold">({matchingCerts.length + matchingCourses.length})</span>
                  </h2>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {matchingCerts.slice(0, 2).map((cert) => (
                  <OrganicCardSmall
                    image={cert.image}
                    imageAlt={cert.title}
                    category={cert.issuer}
                    date={cert.duration}
                    title={cert.title}
                    href={`/sertifikasi/${cert.slug}`}
                    description={cert.description}
                    price={cert.price}
                    actionText="Detail Skema"
                  />
                ))}

                {matchingCourses.slice(0, 1).map((course) => (
                  <OrganicCardSmall
                    image={course.image}
                    imageAlt={course.title}
                    category={`${course.level} — ${course.provider}`}
                    date={course.duration || 'Online'}
                    title={course.title}
                    href={`/course/${course.slug}`}
                    description={course.description}
                    price={course.price}
                    actionText="Pelajari Kursus"
                  />
                ))}
              </div>
            </section>
          )}
        </div>
      )}

      <!-- TAB SPESIFIK: LOWONGAN -->
      {totalMatches > 0 && activeTab === 'lowongan' && (
        <div class="space-y-4">
          <div class="text-xs text-[#6e6d68] font-bold mb-3">Menampilkan {matchingJobs.length} lowongan kerja</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
            {matchingJobs.map((job) => (
              <a
                href={`/lowongan/${job.slug}`}
                class="group bg-white rounded-xl border border-[#d7d6cf] p-4 flex flex-col justify-between hover:border-[#1738D1]/40 hover:shadow-md transition"
              >
                <div>
                  <div class="flex items-center justify-between gap-1.5 mb-2">
                    <span class="text-[11px] font-bold text-[#6e6d68] uppercase truncate">{job.company}</span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-blue-50 text-[#1738D1] border border-blue-100 shrink-0">
                      {job.type}
                    </span>
                  </div>
                  <h3 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-2">
                    {job.title}
                  </h3>
                  <div class="text-[11px] text-[#6e6d68] font-medium flex items-center gap-1 mb-3">
                    <svg class="w-3 h-3 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    </svg>
                    <span>{job.location || job.geo}</span>
                  </div>
                </div>
                <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex items-center justify-between">
                  <span class="font-bold text-[#101010] text-xs truncate">{job.salary}</span>
                  <span class="text-[10px] font-bold text-[#1738D1] flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
                    Lihat →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- TAB SPESIFIK: EVENT -->
      {totalMatches > 0 && activeTab === 'event' && (
        <div class="space-y-4">
          <div class="text-xs text-[#6e6d68] font-bold mb-3">Menampilkan {matchingEvents.length} event &amp; job fair</div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {matchingEvents.map((ev) => (
              <OrganicCardSmall
                image={ev.image}
                imageAlt={ev.title}
                category={`${ev.format} — ${ev.type}`}
                date={`${ev.day} ${ev.month} 2026`}
                title={ev.title}
                href={`/event/${ev.slug}`}
                description={ev.description}
                location={ev.location}
                price={ev.price}
                actionText="Lihat Detail"
              />
            ))}
          </div>
        </div>
      )}

      <!-- TAB SPESIFIK: CAREER (ARTIKEL) -->
      {totalMatches > 0 && activeTab === 'career' && (
        <div class="space-y-4">
          <div class="text-xs text-[#6e6d68] font-bold mb-3">Menampilkan {matchingArticles.length} tips &amp; artikel panduan</div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {matchingArticles.map((art) => (
              <OrganicCardSmall
                image={art.image}
                imageAlt={art.title}
                category={art.category}
                date={art.date ? `${art.date} · ${art.readTime}` : art.readTime}
                title={art.title}
                href={`/career/${art.slug}`}
                description={art.excerpt}
                actionText="Baca Panduan"
              />
            ))}
          </div>
        </div>
      )}

      <!-- TAB SPESIFIK: SERTIFIKASI -->
      {totalMatches > 0 && activeTab === 'sertifikasi' && (
        <div class="space-y-4">
          <div class="text-xs text-[#6e6d68] font-bold mb-3">Menampilkan {matchingCerts.length} skema sertifikasi</div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {matchingCerts.map((cert) => (
              <OrganicCardSmall
                image={cert.image}
                imageAlt={cert.title}
                category={cert.issuer}
                date={cert.duration}
                title={cert.title}
                href={`/sertifikasi/${cert.slug}`}
                description={cert.description}
                price={cert.price}
                actionText="Detail Skema"
              />
            ))}
          </div>
        </div>
      )}

      <!-- TAB SPESIFIK: PELATIHAN (COURSE) -->
      {totalMatches > 0 && activeTab === 'course' && (
        <div class="space-y-4">
          <div class="text-xs text-[#6e6d68] font-bold mb-3">Menampilkan {matchingCourses.length} program kursus &amp; pelatihan</div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {matchingCourses.map((course) => (
              <OrganicCardSmall
                image={course.image}
                imageAlt={course.title}
                category={`${course.level} — ${course.provider}`}
                date={course.duration || 'Online'}
                title={course.title}
                href={`/course/${course.slug}`}
                description={course.description}
                price={course.price}
                actionText="Pelajari Kursus"
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <FooterPortal />
  <SearchModal />
</BaseLayout>
