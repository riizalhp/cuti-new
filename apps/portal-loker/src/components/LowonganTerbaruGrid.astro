                aria-label="Spotlight Berikutnya"
              >
                ›
              </button>
            </div>
          </div>
        </div>

        <!-- 3. Widget Job Tracker (Ramping & Tanpa Blok Preview Kanban) -->
        <div class="bg-white rounded-2xl border border-[#d7d6cf]/90 p-4 sm:p-5 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)] relative overflow-hidden flex-1 flex flex-col justify-between group">
          <!-- Subtle Accent Background -->
          <div class="absolute -top-12 -right-12 w-28 h-28 rounded-full bg-[#1738D1]/5 blur-xl pointer-events-none"></div>

          <div>
            <div class="flex items-center justify-between gap-1.5 mb-2.5">
              <div class="flex items-center gap-1.5">
                <span class="text-[9.5px] font-bold text-[#1738D1] bg-blue-50 px-2 py-0.5 rounded-full border border-blue-200">
                  Fitur Unggulan
                </span>
                <span class="text-[9.5px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  Gratis
                </span>
              </div>
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#6e6d68]">
                Tracker
              </span>
            </div>

            <h4 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug group-hover:text-[#1738D1] transition">
              Lamar Banyak Tempat? Pantau Semua di Satu Papan.
            </h4>
            <p class="text-[10.5px] text-[#6e6d68] leading-relaxed font-medium mt-1">
              Pantau tahap seleksi, jadwal wawancara, dan riwayat lamaran kamu secara rapi di satu tempat.
            </p>
          </div>

          <div class="mt-3.5">
            <a
              href={TRACKER_URL}
              class="w-full py-2.5 px-4 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white text-xs font-bold text-center transition-all duration-200 flex items-center justify-center gap-2 shadow-xs active:scale-[0.98] group/btn"
            >
              <span>Buka Tracker</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <div class="text-center text-[9.5px] text-[#6e6d68] font-medium mt-1.5">
              Gratis selamanya · Tanpa batas kuota
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // 1. Spotlight Carousel
    function initSpotlightCarousel() {
      const card = document.getElementById('spotlight-carousel-card');
      if (!card) return;

      const slides = card.querySelectorAll('[data-spotlight-slide]');
      const dots = card.querySelectorAll('[data-spotlight-dot]');
      const prevBtn = card.querySelector('[data-spotlight-prev]');
      const nextBtn = card.querySelector('[data-spotlight-next]');
      const counter = card.querySelector('[data-spotlight-counter]');

      if (!slides.length) return;

      let currentIndex = 0;
      const total = slides.length;
      let timer = null;
      const INTERVAL = 4500;

      function goToSlide(index) {
        currentIndex = (index + total) % total;

        slides.forEach((slide, idx) => {
          if (idx === currentIndex) {
            slide.classList.remove('opacity-0', 'pointer-events-none', 'scale-[0.98]');
            slide.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
          } else {
            slide.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
            slide.classList.add('opacity-0', 'pointer-events-none', 'scale-[0.98]');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === currentIndex) {
            dot.classList.remove('w-2', 'bg-[#d7d6cf]');
            dot.classList.add('w-5', 'bg-[#1738D1]');
          } else {
            dot.classList.remove('w-5', 'bg-[#1738D1]');
            dot.classList.add('w-2', 'bg-[#d7d6cf]');
          }
        });

        if (counter) {
          counter.textContent = `${currentIndex + 1} / ${total} Program`;
        }
      }

      function startTimer() {
        stopTimer();
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = setInterval(() => {
          goToSlide(currentIndex + 1);
        }, INTERVAL);
      }

      function stopTimer() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex - 1);
        startTimer();
      });

      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex + 1);
        startTimer();
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(idx);
          startTimer();
        });
      });

      card.addEventListener('mouseenter', stopTimer);
      card.addEventListener('mouseleave', startTimer);

      startTimer();
    }

    // 2. In-Place Job Pagination (0ms Reload)
    function initJobPagination() {
      const page1Panel = document.getElementById('job-grid-page-1');
      const page2Panel = document.getElementById('job-grid-page-2');
      const prevBtn = document.getElementById('job-page-prev-btn');
      const nextBtn = document.getElementById('job-page-next-btn');
      const btn1 = document.querySelector('[data-job-page-btn="1"]');
      const btn2 = document.querySelector('[data-job-page-btn="2"]');
      const pageInfo = document.getElementById('job-page-info');

      if (!page1Panel || !page2Panel || !btn1 || !btn2 || !prevBtn || !nextBtn) return;

      let currentPage = 1;
      const totalJobs = pageInfo ? (pageInfo.getAttribute('data-total') || '22') : '22';

      function setPage(page) {
        if (page === currentPage) return;
        currentPage = page;

        if (currentPage === 1) {
          page1Panel.classList.remove('hidden');
          page2Panel.classList.add('hidden');

          // Button 1 active
          btn1.className = 'w-9 h-9 min-w-[38px] min-h-[38px] rounded-lg bg-[#1738D1] text-white text-xs font-bold shadow-xs flex items-center justify-center transition cursor-pointer';
          btn1.setAttribute('aria-current', 'page');

          // Button 2 inactive
          btn2.className = 'w-9 h-9 min-w-[38px] min-h-[38px] rounded-lg border border-[#d7d6cf] bg-white hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold transition flex items-center justify-center cursor-pointer';
          btn2.removeAttribute('aria-current');

          // Prev btn disabled
          prevBtn.setAttribute('disabled', 'true');
          prevBtn.className = 'px-3 py-2 min-h-[38px] rounded-lg border border-[#d7d6cf]/60 bg-[#f4f3ee]/50 text-[#a5a5a1] text-xs font-semibold cursor-not-allowed select-none transition flex items-center justify-center';

          // Next btn active
          nextBtn.removeAttribute('disabled');
          nextBtn.className = 'px-3.5 py-2 min-h-[38px] rounded-lg border border-[#d7d6cf] bg-white hover:bg-[#101010] hover:text-white text-[#101010] text-xs font-semibold transition flex items-center gap-1 shadow-2xs group cursor-pointer';

          if (pageInfo) {
            pageInfo.innerHTML = `Showcase Beranda: <strong class="text-[#101010] font-bold">1–11</strong> dari 22 Unggulan (<strong class="text-[#1738D1] font-bold">${totalJobs}</strong> Total Loker)`;
          }
        } else {
          page1Panel.classList.add('hidden');
          page2Panel.classList.remove('hidden');

          // Button 1 inactive
          btn1.className = 'w-9 h-9 min-w-[38px] min-h-[38px] rounded-lg border border-[#d7d6cf] bg-white hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold transition flex items-center justify-center cursor-pointer';
          btn1.removeAttribute('aria-current');

          // Button 2 active
          btn2.className = 'w-9 h-9 min-w-[38px] min-h-[38px] rounded-lg bg-[#1738D1] text-white text-xs font-bold shadow-xs flex items-center justify-center transition cursor-pointer';
          btn2.setAttribute('aria-current', 'page');

          // Prev btn active
          prevBtn.removeAttribute('disabled');
          prevBtn.className = 'px-3 py-2 min-h-[38px] rounded-lg border border-[#d7d6cf] bg-white hover:bg-[#101010] hover:text-white text-[#101010] text-xs font-semibold transition cursor-pointer shadow-2xs flex items-center justify-center';

          // Next btn disabled
          nextBtn.setAttribute('disabled', 'true');
          nextBtn.className = 'px-3.5 py-2 min-h-[38px] rounded-lg border border-[#d7d6cf]/60 bg-[#f4f3ee]/50 text-[#a5a5a1] text-xs font-semibold cursor-not-allowed select-none transition flex items-center gap-1';

          if (pageInfo) {
            const endNum = Math.min(22, parseInt(totalJobs, 10));
            pageInfo.innerHTML = `Showcase Beranda: <strong class="text-[#101010] font-bold">12–${endNum}</strong> dari 22 Unggulan (<strong class="text-[#1738D1] font-bold">${totalJobs}</strong> Total Loker)`;
          }
        }

        // Scroll back to top of lowongan section if needed
        const lowonganSec = document.getElementById('lowongan');
        if (lowonganSec && window.scrollY > lowonganSec.offsetTop + 150) {
          lowonganSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      btn1.addEventListener('click', () => setPage(1));
      btn2.addEventListener('click', () => setPage(2));
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) setPage(currentPage - 1);
      });
      nextBtn.addEventListener('click', () => {
        if (currentPage < 2) setPage(currentPage + 1);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initSpotlightCarousel();
        initJobPagination();
      });
    } else {
      initSpotlightCarousel();
      initJobPagination();
    }
  })();
</script>
