---
// FooterPortal.astro - Comprehensive Portal Footer
---

<footer class="bg-white border-t border-slate-200 pt-14 pb-10">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-12 border-b border-slate-200">
      <!-- Col 1: Brand & Bio (4 cols) -->
      <div class="lg:col-span-4 flex flex-col justify-between">
        <div>
          <!-- Brand Logo -->
          <div class="mb-4">
            <a href="/" class="inline-block" aria-label="Beranda Employer Job">
              <img
                src="/employer-job.svg"
                alt="Employer Job"
                class="h-10 sm:h-11 w-auto object-contain"
              />
            </a>
          </div>

          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-sm mb-6">
            Platform karier untuk generasi muda Indonesia. Temukan peluang, kembangkan diri, dan wujudkan masa depan yang lebih baik bersama CUTI.
          </p>

          <!-- Social Icons -->
          <div class="flex items-center gap-2.5 text-slate-500">
            <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center hover:text-[#1738d1] hover:border-blue-300 transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://tiktok.com" target="_blank" rel="noopener" aria-label="TikTok" class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center hover:text-[#1738d1] hover:border-blue-300 transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube" class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center hover:text-[#1738d1] hover:border-blue-300 transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center hover:text-[#1738d1] hover:border-blue-300 transition">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Platform Menu (2 cols) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-medium text-slate-900 uppercase tracking-wider mb-4">Platform</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
          <li><a href="/lowongan" class="hover:text-[#1738d1] transition">Cari Lowongan</a></li>
          <li><a href="/sertifikasi" class="hover:text-[#1738d1] transition">Sertifikasi</a></li>
          <li><a href="/course" class="hover:text-[#1738d1] transition">Course</a></li>
          <li><a href="/event" class="hover:text-[#1738d1] transition">Event & Job Fair</a></li>
          <li><a href="/career?cat=tips" class="hover:text-[#1738d1] transition">Career Tips</a></li>
          <li><a href="/career" class="hover:text-[#1738d1] transition">Artikel</a></li>
        </ul>
      </div>

      <!-- Col 3: Tentang Menu (2 cols) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-medium text-slate-900 uppercase tracking-wider mb-4">Tentang</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
          <li><a href="/tentang" class="hover:text-[#1738d1] transition">Tentang CUTI</a></li>
          <li><a href="/tentang#karier" class="hover:text-[#1738d1] transition">Karier di CUTI</a></li>
          <li><a href="/tentang#press" class="hover:text-[#1738d1] transition">Media & Press</a></li>
          <li><a href="/tentang#kontak" class="hover:text-[#1738d1] transition">Kontak</a></li>
          <li><a href="/tentang#privasi" class="hover:text-[#1738d1] transition">Kebijakan Privasi</a></li>
          <li><a href="/tentang#terms" class="hover:text-[#1738d1] transition">Syarat & Ketentuan</a></li>
        </ul>
      </div>

      <!-- Col 4: Bantuan Menu (2 cols) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-medium text-slate-900 uppercase tracking-wider mb-4">Bantuan</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 font-medium">
          <li><a href="/tentang#faq" class="hover:text-[#1738d1] transition">Pusat Bantuan</a></li>
          <li><a href="/tentang#faq" class="hover:text-[#1738d1] transition">FAQ</a></li>
          <li><a href="/tentang#panduan" class="hover:text-[#1738d1] transition">Panduan Penggunaan</a></li>
          <li><a href="/tentang#lapor" class="hover:text-[#1738d1] transition">Laporkan Masalah</a></li>
        </ul>
      </div>

      <!-- Col 5: App Download (2 cols) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-medium text-slate-900 uppercase tracking-wider mb-2">Unduh Aplikasi CUTI</h4>
        <p class="text-xs text-slate-500 mb-4">Akses peluang karier kapan saja, di mana saja.</p>

        <div class="space-y-2">
          <!-- Google Play Badge -->
          <a href="#" class="block bg-slate-900 hover:bg-slate-800 text-white p-2.5 rounded-xl transition shadow-sm">
            <div class="flex items-center gap-2">
              <svg class="w-6 h-6 text-emerald-400" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186c-.352-.397-.57-.962-.57-1.614V3.428c0-.652.218-1.217.57-1.614zm11.602 11.604l2.585 2.585-11.44 6.605 8.855-9.19zm0-2.836L6.356 1.391l11.44 6.605-2.585 2.586zm1.414 1.414l3.535-2.041c.883-.51.883-1.348 0-1.858L16.625 9.996l-1.414 1.414 1.414 1.414 3.535-2.041z"/></svg>
              <div>
                <span class="text-[9px] uppercase tracking-wider block leading-none text-slate-400">GET IT ON</span>
                <span class="text-xs font-bold leading-tight">Google Play</span>
              </div>
            </div>
          </a>

          <!-- App Store Badge -->
          <a href="#" class="block bg-slate-900 hover:bg-slate-800 text-white p-2.5 rounded-xl transition shadow-sm">
            <div class="flex items-center gap-2">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 0.6-2.65 1.35-.58.66-1.09 1.73-0.95 2.76 1 .08 2.06-.51 2.68-1.26z"/></svg>
              <div>
                <span class="text-[9px] uppercase tracking-wider block leading-none text-slate-400">Download on the</span>
                <span class="text-xs font-bold leading-tight">App Store</span>
              </div>
            </div>
          </a>
        </div>

        <div class="mt-4 pt-4 border-t border-slate-100">
          <span class="font-serif italic text-base text-slate-800 rotate-[-2deg] block leading-tight">
            Better Skills Brighter Future
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © 2026 CUTI. All rights reserved.
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a href="/tentang#privasi" class="hover:text-[#1738d1]">Privasi</a>
        <a href="/tentang#terms" class="hover:text-[#1738d1]">Syarat & Ketentuan</a>
        <a href="/tentang#cookie" class="hover:text-[#1738d1]">Cookie</a>
        <a href="/tentang#sitemap" class="hover:text-[#1738d1]">Peta Situs</a>
      </div>

      <!-- Language Selector -->
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white">
        <span>🇮🇩</span>
        <span class="font-medium text-slate-700">Bahasa Indonesia</span>
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </div>
  </div>
</footer>
