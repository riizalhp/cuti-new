---
/**
 * CompanyTicker.astro
 * Section editorial dengan tema cerah / light paper (var(--paper))
 * Headline:
 * "Where future
 * careers find their
 * [ C ] starting point." (logo berdampingan dengan 'starting point.')
 * Subtext dibawahnya: "Discover opportunities from 1,000+ companies."
 */

interface CompanyLogo {
  name: string;
  src: string;
}

const companies: CompanyLogo[] = [
  { name: 'Alfamart', src: '/testimoni/alfamart.webp' },
  { name: 'Astra International', src: '/testimoni/astra.webp' },
  { name: 'Bank Mandiri', src: '/testimoni/mandiri.webp' },
  { name: 'Deloitte', src: '/testimoni/deloitte.webp' },
  { name: 'Denso', src: '/testimoni/denso.webp' },
  { name: 'Fore Coffee', src: '/testimoni/fore.webp' },
  { name: 'Gojek', src: '/testimoni/gojek.webp' },
  { name: 'Indofood', src: '/testimoni/indofood.webp' },
  { name: 'Indomaret', src: '/testimoni/indomaret.webp' },
  { name: 'MR.DIY', src: '/testimoni/mrdiy.webp' },
  { name: 'Shopee', src: '/testimoni/shopee.webp' },
  { name: 'Sinar Mas', src: '/testimoni/sinarmas.webp' },
  { name: 'Solaria', src: '/testimoni/solaria.webp' },
  { name: 'Suzuki', src: '/testimoni/suzuki.webp' },
  { name: 'Telkom Indonesia', src: '/testimoni/telkom.webp' },
  { name: 'Trans TV', src: '/testimoni/transtv.webp' },
  { name: 'Unilever', src: '/testimoni/unilever.webp' },
  { name: 'Wings Group', src: '/testimoni/wings.webp' },
];
---

<section class="company-ticker company-ticker--light" aria-label="Where future careers find their starting point">
  <div class="company-ticker__container">
    <div class="company-ticker__content">
      <h2 class="company-ticker__headline">
        Where future<br />
        careers find their<br />
        <span class="company-ticker__last-line">
          <span class="company-ticker__logo-slot" id="ticker-logo-rotator" aria-live="polite">
            {companies.map((company, index) => (
              <span
                class:list={['company-ticker__logo-item', { 'is-active': index === 0 }]}
                data-index={index}
                title={company.name}
                aria-label={company.name}
              >
                <img
                  src={company.src}
                  alt={company.name}
                  class="company-logo-img"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </span>
            ))}
          </span>
          <em>starting point.</em>
        </span>
      </h2>

      <p class="company-ticker__supporting">
        Discover opportunities from 1,000+ companies.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  function setupTickerRotator() {
    const slot = document.getElementById('ticker-logo-rotator');
    if (!slot) return;
    const items = slot.querySelectorAll('.company-ticker__logo-item');
    if (items.length <= 1) return;

    if (window._tickerRotatorInterval) {
      clearInterval(window._tickerRotatorInterval);
    }

    let current = 0;
    // Transisi rileks: berganti setiap 3.8 detik
    window._tickerRotatorInterval = setInterval(() => {
      items[current].classList.remove('is-active');
      current = (current + 1) % items.length;
      items[current].classList.add('is-active');
    }, 3800);
  }

  setupTickerRotator();
  document.addEventListener('astro:page-load', setupTickerRotator);
</script>

<style>
  .company-ticker {
    width: 100% !important;
    background: var(--paper, #f4f3ee) !important;
    color: var(--ink, #101114) !important;
    padding: clamp(80px, 8vw, 110px) 0 !important;
    position: relative !important;
    border-top: 1px solid rgba(16, 17, 20, 0.08) !important;
    border-bottom: 1px solid rgba(16, 17, 20, 0.08) !important;
    z-index: 5;
    box-sizing: border-box;
    overflow: hidden !important;
  }

  .company-ticker__container {
    width: min(1380px, calc(100% - 64px));
    margin: 0 auto;
    box-sizing: border-box;
  }

  .company-ticker__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .company-ticker__headline {
    font-family: "DM Sans", Arial, sans-serif;
    font-size: clamp(2.6rem, 4.4vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -.085em;
    line-height: .96;
    color: var(--ink, #101114);
    margin: 0;
  }

  .company-ticker__headline em {
    font-family: "Instrument Serif", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--blue, #1738D1);
  }

  .company-ticker__last-line {
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 1vw, 12px);
    vertical-align: middle;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  /* LOGO SLOT [ C ] - DISAMPING 'starting point.', NO CARD, FULL COLOR */
  .company-ticker__logo-slot {
    position: relative;
    width: clamp(100px, 12vw, 150px);
    height: clamp(40px, 4.8vw, 62px);
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    flex-shrink: 0;
  }

  .company-ticker__logo-item {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    /* Transisi lembut dan tidak terburu-buru (0.85s) */
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.85s;
    pointer-events: none;
  }

  .company-ticker__logo-item.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .company-ticker__logo-item img {
    display: block;
    max-height: clamp(38px, 4.8vw, 58px);
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: none !important; /* ORIGINAL FULL COLOR - TIDAK DI-GRAYSCALE */
    user-select: none;
  }

  /* SUBTEXT PERSIS DIBAWAH HEADLINE */
  .company-ticker__supporting {
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #686762;
    margin: 26px 0 0;
    max-width: 460px;
  }

  @media (max-width: 900px) {
    .company-ticker {
      padding: 56px 0 46px !important;
    }
    .company-ticker__container {
      width: calc(100% - 32px);
    }
    .company-ticker__headline {
      font-size: clamp(1.85rem, 6.8vw, 2.5rem);
      line-height: 1.08;
      letter-spacing: -0.04em;
    }
    .company-ticker__last-line {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 8px;
      margin-top: 8px;
    }
    .company-ticker__logo-slot {
      height: 36px;
      width: 100px;
    }
    .company-ticker__logo-item img {
      max-height: 28px;
    }
    .company-ticker__supporting {
      font-size: 13.5px;
      margin-top: 18px;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-ticker__logo-item {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
