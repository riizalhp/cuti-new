---
// EventPortalSection.astro - Event & Job Fair with Interactive Calendar
import { eventList } from '../data/mock';
---

<section class="py-12 bg-slate-50/50 border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-[11px] font-medium uppercase tracking-wider text-[#1738d1]">Event & Job Fair</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-medium text-slate-900 tracking-tight">
          Temukan Event yang Membuka Peluang Baru
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-2xl">
          Ikuti berbagai event, job fair, webinar, dan workshop untuk memperluas wawasan, membangun jaringan, dan mendekatkanmu pada karier impian.
        </p>
      </div>

      <!-- Banner Lebih Dari Sekadar Lowongan -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200/80 rounded-2xl p-4 sm:p-5 flex items-center justify-between gap-6 max-w-md shrink-0">
        <div>
          <h4 class="text-sm font-medium text-slate-900">Lebih dari Sekadar Lowongan</h4>
          <p class="text-xs text-slate-600 mt-0.5">Bertemu langsung dengan perusahaan dan perluas relasi masa depanmu.</p>
        </div>
        <a href="/event" class="px-4 py-2 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-bold shrink-0 transition shadow-sm">
          Lihat Semua Event →
        </a>
      </div>
    </div>

    <!-- Category Filters & Dropdowns -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar">
        <button class="px-4 py-1.5 rounded-full bg-[#1738d1] text-white text-xs font-bold shrink-0">Semua Event</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shrink-0">Job Fair</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shrink-0">Webinar</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shrink-0">Workshop</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shrink-0">Seminar</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shrink-0">Conference</button>
        <button class="px-4 py-1.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-semibold shrink-0">Career Talk</button>
      </div>

      <!-- Dropdown Selects -->
      <div class="flex items-center gap-2 text-xs">
        <select class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold outline-none">
          <option>Online / Offline</option>
          <option>Online</option>
          <option>Offline</option>
          <option>Hybrid</option>
        </select>
        <select class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold outline-none">
          <option>Semua Kota</option>
          <option>Jakarta</option>
          <option>Bandung</option>
          <option>Surabaya</option>
          <option>Yogyakarta</option>
        </select>
        <select class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold outline-none">
          <option>Semua Tanggal</option>
          <option>Minggu Ini</option>
          <option>Bulan Ini</option>
        </select>
      </div>
    </div>

    <!-- Main Section Content: 4 Event Cards + Right Calendar Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- 4 Event Cards (8 cols) -->
      <div class="lg:col-span-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-medium text-slate-900">Event Mendatang</h3>
          <a href="/event" class="text-xs font-bold text-[#1738d1] hover:underline">Lihat Semua Event →</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {eventList.map((event) => (
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400 transition flex flex-col justify-between">
              <div>
                <!-- Image with Type Badge and Bookmark -->
                <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
                  <img src={event.image} alt={event.title} class="w-full h-full object-cover" loading="lazy" />
                  <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-md text-[10px] font-medium uppercase tracking-wider bg-[#1738d1] text-white shadow-sm">
                    {event.type}
                  </span>
                  <button type="button" aria-label="Simpan Event" class="absolute top-3 right-3 w-7 h-7 rounded-full bg-white/90 flex items-center justify-center text-slate-600">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                    </svg>
                  </button>
                </div>

                <!-- Event Details with Date Badge -->
                <div class="p-4 flex items-start gap-3">
                  <!-- Date Badge Box -->
                  <div class="w-12 rounded-xl border border-slate-200 bg-blue-50/60 overflow-hidden shrink-0 text-center">
                    <span class="block text-base font-medium text-[#1738d1] pt-1.5 leading-none">{event.dateDay}</span>
                    <span class="block text-[9px] font-extrabold uppercase text-slate-500 pb-1">{event.dateMonth} {event.dateYear}</span>
                  </div>

                  <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-medium text-slate-900 leading-snug line-clamp-1 mb-1">
                      <a href={"/event/" + event.slug} class="hover:text-[#1738d1] transition">{event.title}</a>
                    </h4>
                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                      {event.description}
                    </p>
                  </div>
                </div>

                <!-- Meta location, participants, format badge -->
                <div class="px-4 pb-3 space-y-1.5 text-xs text-slate-600 border-t border-slate-100 pt-3">
                  <div class="flex items-center gap-1.5 truncate">
                    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    </svg>
                    <span class="truncate">{event.location}</span>
                  </div>

                  <div class="flex items-center justify-between text-[11px]">
                    <span class="flex items-center gap-1 text-slate-500">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                      </svg>
                      {event.companiesCount || event.attendeesCount}
                    </span>
                    <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-bold text-[10px]">
                      {event.format}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Button CTA -->
              <div class="p-4 pt-0">
                <a
                  href={"/event/" + event.slug}
                  class="w-full py-2.5 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-bold text-center block transition shadow-sm"
                >
                  Lihat Detail →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Kalender Event Widget (4 cols) -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <!-- Calendar Widget -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
            <h3 class="text-sm font-medium text-slate-900">Kalender Event</h3>
            <a href="/event" class="text-xs text-[#1738d1] font-bold hover:underline">Lihat Semua →</a>
          </div>

          <!-- Month Header -->
          <div class="flex items-center justify-between mb-3 text-xs font-bold text-slate-800">
            <button class="p-1 hover:bg-slate-100 rounded">‹</button>
            <span>Januari 2026</span>
            <button class="p-1 hover:bg-slate-100 rounded">›</button>
          </div>

          <!-- Calendar Days Grid -->
          <div class="grid grid-cols-7 gap-1 text-center text-xs">
            <span class="text-slate-400 font-medium py-1">Sen</span>
            <span class="text-slate-400 font-medium py-1">Sel</span>
            <span class="text-slate-400 font-medium py-1">Rab</span>
            <span class="text-slate-400 font-medium py-1">Kam</span>
            <span class="text-slate-400 font-medium py-1">Jum</span>
            <span class="text-slate-400 font-medium py-1">Sab</span>
            <span class="text-slate-400 font-medium py-1">Min</span>

            <span class="text-slate-300 py-1"></span>
            <span class="text-slate-300 py-1"></span>
            <span class="text-slate-300 py-1"></span>
            <span class="text-slate-700 py-1">1</span>
            <span class="text-slate-700 py-1">2</span>
            <span class="text-slate-700 py-1">3</span>
            <span class="text-slate-700 py-1">4</span>

            <span class="text-slate-700 py-1">5</span>
            <span class="text-slate-700 py-1">6</span>
            <span class="text-slate-700 py-1">7</span>
            <span class="text-slate-700 py-1">8</span>
            <span class="text-slate-700 py-1">9</span>
            <span class="text-slate-700 py-1">10</span>
            <span class="text-slate-700 py-1">11</span>

            <span class="text-slate-700 py-1">12</span>
            <span class="text-slate-700 py-1">13</span>
            <span class="text-slate-700 py-1">14</span>
            <!-- Active Event Date -->
            <span class="py-1 rounded-full bg-[#1738d1] text-white font-bold">15</span>
            <span class="text-slate-700 py-1">16</span>
            <span class="text-slate-700 py-1">17</span>
            <span class="py-1 rounded-full bg-blue-100 text-[#1738d1] font-bold">18</span>

            <span class="text-slate-700 py-1">19</span>
            <span class="text-slate-700 py-1">20</span>
            <span class="text-slate-700 py-1">21</span>
            <span class="text-slate-700 py-1">22</span>
            <span class="text-slate-700 py-1">23</span>
            <span class="py-1 rounded-full bg-blue-100 text-[#1738d1] font-bold">24</span>
            <span class="text-slate-700 py-1">25</span>

            <span class="text-slate-700 py-1">26</span>
            <span class="text-slate-700 py-1">27</span>
            <span class="py-1 rounded-full bg-blue-100 text-[#1738d1] font-bold">28</span>
            <span class="text-slate-700 py-1">29</span>
            <span class="text-slate-700 py-1">30</span>
            <span class="text-slate-700 py-1">31</span>
          </div>
        </div>

        <!-- Mini Update Event Box -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50/60 rounded-2xl border border-blue-100 p-5 shadow-sm">
          <div class="flex items-center gap-2 mb-2 text-[#1738d1]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <h4 class="text-sm font-medium text-slate-900">Dapatkan Update Event</h4>
          </div>
          <p class="text-xs text-slate-600 mb-3">
            Jadilah yang pertama tahu tentang event terbaru, job fair, dan webinar menarik.
          </p>
          <form class="flex items-center gap-2" onsubmit="alert('Terdaftar untuk notifikasi event!'); return false;">
            <input
              type="email"
              placeholder="Masukkan email kamu"
              required
              class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-white text-xs text-slate-800 outline-none focus:border-[#1738d1]"
            />
            <button type="submit" class="px-3.5 py-2 rounded-xl bg-[#1738d1] text-white text-xs font-bold shrink-0">
              →
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Bottom Banner -->
    <div class="mt-8 bg-gradient-to-r from-blue-50/90 to-indigo-50/70 border border-blue-200/80 rounded-2xl p-5 sm:p-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="font-doodle text-2xl sm:text-3xl font-bold text-slate-900 rotate-[-3deg] hidden sm:block">
          Same People Brighter Opportunities
        </span>
        <div class="sm:border-l sm:border-slate-300 sm:pl-4">
          <h4 class="text-base font-medium text-slate-900">Siap Bertemu Peluang Nyata?</h4>
          <p class="text-xs text-slate-600">Ikuti event karier dan perluas jaringanmu sekarang.</p>
        </div>
      </div>

      <a href="/event" class="px-6 py-2.5 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-bold transition shadow-sm shrink-0">
        Lihat Semua Event →
      </a>
    </div>
  </div>
</section>
