# Database
DATABASE_URL="postgresql://user:password@localhost:5432/employr"

# Cron Scheduler
ENABLE_CRON=true
CRON_TIMEZONE=Asia/Jakarta

# Job Sync
JOB_SYNC_GRACE_DAYS=3

# Logo Storage (local filesystem fallback)
LOGO_STORAGE_PATH=public/uploads/logos
CDN_BASE_URL=/uploads/logos

# SeaweedFS (optional, jika sudah setup)
# SEAWEEDFS_URL=http://localhost:9333
# SEAWEEDFS_FILER_URL=http://localhost:8888
# CDN_BASE_URL=https://cdn.employr.id

# Other existing env vars...
