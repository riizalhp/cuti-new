---
import CutoutCorner from './common/CutoutCorner.astro';
import AdSlot from './AdSlot.astro';
import { REGION_WAGE_BENCHMARKS, PROVINCE_LIST } from '../data/umk-2026';
import { TRACKER_URL } from '../lib/urls';

interface Props {
  showSectionHeader?: boolean;
}

const { showSectionHeader = true } = Astro.props;
const defaultRegion =
  REGION_WAGE_BENCHMARKS.find((r) => r.id === 'kota-semarang') || REGION_WAGE_BENCHMARKS[0];

function formatExactRupiah(val: number): string {
  const hasDecimals = Math.round(val * 100) % 100 !== 0;
  return (
    'Rp ' +
    val.toLocaleString('id-ID', {
      minimumFractionDigits: hasDecimals ? 2 : 0,
      maximumFractionDigits: hasDecimals ? 2 : 0,
    })
  );
}
---

<section id="kalkulator-gaji" class="py-8 sm:py-14 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-20">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    {showSectionHeader && (
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 sm:mb-10">
        <div>
          <div class="section-label mb-2.5">
            <span>STANDAR UPAH RIIL</span>
            <i></i>
            <span>PP 58/2023 &amp; 142 UMK 2026</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight leading-[1.12]">
            Kalkulator gaji bersih &amp;<br class="hidden sm:inline" />
            <em>daya beli kota kerja.</em>
          </h2>
          <p class="text-xs sm:text-sm text-[#55544f] mt-2.5 max-w-2xl leading-relaxed font-medium">
            Hitung estimasi pendapatan bersih bulanan (take-home pay), rincian potongan BPJS Ketenagakerjaan, BPJS Kesehatan, dan PPh 21 Tarif Efektif Rata-rata (TER) beserta perbandingannya terhadap 142 UMK Kabupaten/Kota Tahun 2026.
          </p>
        </div>

        <div class="flex items-center gap-2 self-start md:self-auto shrink-0">
          <span class="px-3.5 py-2 rounded-full text-xs font-bold bg-white text-[#101010] border border-[#d7d6cf] shadow-xs tabular-nums">
            142 Kabupaten/Kota · UMK 2026
          </span>
        </div>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- PANEL KIRI: INPUT PARAMETER & ANALISIS UPAH RIIL (7 KOLOM) -->
      <div class="lg:col-span-7 space-y-5 min-w-0">
        
        <!-- KARTU 1: INPUT PENGHASILAN & LOKASI KERJA -->
        <div class="bg-white rounded-[20px] sm:rounded-[24px] border border-[#d7d6cf] p-5 sm:p-7 shadow-[0_4px_20px_-2px_rgba(16,16,16,0.04)] space-y-6">
          
          <!-- Baris 1: Pilih Wilayah Kerja (Custom Dropdown Rata Kiri Kota/Kab & Rata Kanan Nominal) -->
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <label id="calc-region-label" for="calc-region-trigger" class="text-xs sm:text-sm font-bold text-[#101010]">
                1. Lokasi Kabupaten / Kota Kerja (142 Daerah)
              </label>
              <span id="calc-region-zone" class="text-[11px] font-semibold text-[#1738D1] bg-[#f0f2ff] px-2.5 py-0.5 rounded-full border border-[#1738D1]/20">
                {defaultRegion.zoneLabel}
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5">
              <!-- Custom Searchable Aligned Dropdown (8 Kolom) -->
              <div class="sm:col-span-8 relative" id="calc-region-dropdown-root">
                <input type="hidden" id="calc-region-value" value={defaultRegion.id} />

                <button
                  type="button"
                  id="calc-region-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="calc-region-label"
                  class="w-full min-h-[48px] px-4 py-2.5 rounded-xl bg-[#f9f8f5] border border-[#d7d6cf] hover:border-[#101010] focus:border-[#1738D1] focus:bg-white transition flex items-center justify-between gap-3 cursor-pointer focus-visible:ring-2 focus-visible:ring-[#1738D1] outline-none"
                >
                  <span class="min-w-0 flex-1 text-left">
                    <span id="calc-trigger-city" class="block text-xs sm:text-sm font-bold text-[#101010] truncate">
                      {defaultRegion.city}
                    </span>
                    <span id="calc-trigger-prov" class="block text-[11px] font-medium text-[#55544f] truncate">
                      {defaultRegion.province}
                    </span>
                  </span>

                  <span class="shrink-0 flex items-center gap-2.5">
                    <span class="text-right">
                      <span class="block text-[10px] font-bold uppercase tracking-wider text-[#55544f]">UMK 2026</span>
                      <span id="calc-trigger-umk" class="block text-xs sm:text-sm font-extrabold text-[#1738D1] tabular-nums">
                        {formatExactRupiah(defaultRegion.umkExact)}
                      </span>
                    </span>
                    <svg id="calc-trigger-chevron" class="w-4 h-4 text-[#55544f] transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </button>

                <!-- Popover Panel -->
                <div
                  id="calc-region-popover"
                  role="dialog"
                  aria-label="Pilih Kabupaten atau Kota UMK 2026"
                  class="hidden absolute left-0 right-0 top-[calc(100%+6px)] z-50 bg-white rounded-2xl border border-[#101010] shadow-[0_18px_40px_rgba(16,16,16,0.16)] overflow-hidden"
                >
                  <!-- Search & Filter Provinsi di dalam Dropdown -->
                  <div class="p-3 bg-[#f9f8f5] border-b border-[#d7d6cf] space-y-2">
                    <div class="relative flex items-center">
                      <svg class="w-4 h-4 text-[#55544f] absolute left-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                      </svg>
                      <input
                        type="text"
                        id="calc-dd-search"
                        placeholder="Cari Kabupaten/Kota atau Provinsi..."
                        autocomplete="off"
                        class="w-full min-h-[40px] pl-9 pr-3 py-1.5 rounded-lg bg-white border border-[#d7d6cf] focus:border-[#1738D1] text-xs font-medium text-[#101010] placeholder-[#55544f] outline-none"
                      />
                    </div>

                    <div class="flex items-center justify-between gap-2">
                      <label for="calc-dd-prov-filter" class="sr-only">Filter Provinsi</label>
                      <select
                        id="calc-dd-prov-filter"
                        class="w-full min-h-[36px] px-2.5 py-1 rounded-lg bg-white border border-[#d7d6cf] text-[11px] font-bold text-[#101010] outline-none cursor-pointer"
                      >
                        <option value="">Semua Provinsi (142 Kabupaten/Kota)</option>
                        {PROVINCE_LIST.map((prov) => (
                          <option value={prov}>{prov}</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <!-- Header Kolom Rata Kiri (Kota/Kab) & Rata Kanan (Nominal UMK) -->
                  <div class="px-4 py-2 bg-[#f4f3ee] border-b border-[#d7d6cf] flex items-center justify-between text-[10px] font-extrabold uppercase tracking-wider text-[#55544f]">
                    <span class="text-left">Kabupaten / Kota (Provinsi)</span>
                    <span class="text-right">Nominal UMK 2026</span>
                  </div>

                  <!-- Daftar 142 Kabupaten/Kota -->
                  <div
                    id="calc-dd-list"
                    role="listbox"
                    aria-label="Daftar 142 UMK Kabupaten/Kota 2026"
                    class="max-h-[290px] overflow-y-auto divide-y divide-[#d7d6cf]/50"
                  >
                    {REGION_WAGE_BENCHMARKS.map((reg) => {
                      const isSelected = reg.id === defaultRegion.id;
                      const formattedExact = formatExactRupiah(reg.umkExact);
                      return (
                        <button
                          type="button"
                          role="option"
                          aria-selected={isSelected ? 'true' : 'false'}
                          data-id={reg.id}
                          data-no={reg.no}
                          data-city={reg.city}
                          data-province={reg.province}
                          data-query={reg.searchQuery}
                          data-umk={reg.umk2026}
                          data-umk-exact={formattedExact}
                          data-sk={reg.skReference}
                          data-living={reg.livingCostSingle}
                          data-rent={reg.rentEstimate}
                          data-food={reg.foodEstimate}
                          data-transport={reg.transportUtilityEstimate}
                          data-zone={reg.zoneLabel}
                          data-search={`${reg.city} ${reg.province} ${reg.zoneLabel}`.toLowerCase()}
                          class={`calc-dd-option w-full px-4 py-2.5 flex items-center justify-between gap-3 transition cursor-pointer text-left hover:bg-[#f0f2ff] focus:bg-[#f0f2ff] outline-none ${
                            isSelected ? 'bg-[#f0f2ff]/80' : 'bg-white'
                          }`}
                        >
                          <!-- RATA KIRI: Nama Kota/Kabupaten & Provinsi -->
                          <span class="min-w-0 flex-1 text-left">
                            <span class="block text-xs sm:text-sm font-bold text-[#101010] truncate">
                              {reg.city}
                            </span>
                            <span class="block text-[11px] font-medium text-[#55544f] truncate">
                              {reg.province} · {reg.zoneLabel}
                            </span>
                          </span>

                          <!-- RATA KANAN: Nominal UMK 2026 Presisi -->
                          <span class="shrink-0 text-right tabular-nums">
                            <span class="block text-xs sm:text-sm font-extrabold text-[#101010] tabular-nums">
                              {formattedExact}
                            </span>
                            <span class="block text-[10px] font-semibold text-[#55544f] tabular-nums">
                              KHL Rp {reg.livingCostSingle.toLocaleString('id-ID')}
                            </span>
                          </span>
                        </button>
                      );
                    })}
                  </div>

                  <div id="calc-dd-empty" class="hidden p-5 text-center text-xs text-[#55544f] font-medium">
                    Kabupaten/Kota tidak ditemukan. Coba kata kunci lain.
                  </div>
                </div>
              </div>

              <button
                type="button"
                id="btn-apply-umk"
                class="sm:col-span-4 min-h-[48px] px-4 py-2.5 rounded-xl bg-[#f4f3ee] hover:bg-[#101010] text-[#101010] hover:text-white border border-[#d7d6cf] hover:border-[#101010] text-xs font-bold transition cursor-pointer flex items-center justify-center gap-1.5 active:scale-[0.98]"
              >
                <span>Gunakan Angka UMK</span>
              </button>
            </div>
            <p class="text-[11px] text-[#55544f] mt-1.5 font-medium">
              Standar UMK 2026 mengacu pada Keputusan Gubernur/Walikota masing-masing daerah dan menjadi batas upah minimum resmi.
            </p>
          </div>

          <!-- Baris 2: Input Gaji Pokok + Tunjangan Tetap -->
          <div class="pt-4 border-t border-[#d7d6cf]/70">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <label for="calc-gross-input" class="text-xs sm:text-sm font-bold text-[#101010]">
                2. Gaji Pokok &amp; Tunjangan Tetap (Per Bulan)
              </label>
              <span class="text-[11px] font-medium text-[#55544f]">Dasar hitung BPJS &amp; PPh 21</span>
            </div>

            <div class="relative flex items-center">
              <span class="absolute left-4 text-sm sm:text-base font-extrabold text-[#55544f] select-none pointer-events-none">
                Rp
              </span>
              <input
                type="text"
                id="calc-gross-input"
                inputmode="numeric"
                value={defaultRegion.umk2026.toLocaleString('id-ID')}
                aria-label="Nominal Gaji Pokok dan Tunjangan Tetap dalam Rupiah"
                class="w-full min-h-[52px] pl-12 pr-4 py-3 rounded-xl bg-[#f9f8f5] border border-[#d7d6cf] focus:border-[#1738D1] focus:bg-white text-lg sm:text-xl font-extrabold text-[#101010] tabular-nums outline-none transition focus-visible:ring-2 focus-visible:ring-[#1738D1]"
              />
            </div>

            <!-- Range Slider Halus -->
            <div class="mt-3">
              <label for="calc-gross-slider" class="sr-only">Geser nominal gaji kotor</label>
              <input
                type="range"
                id="calc-gross-slider"
                min="2000000"
                max="35000000"
                step="100000"
                value={String(defaultRegion.umk2026)}
                class="w-full h-2 bg-[#e5e4dc] rounded-lg appearance-none cursor-pointer accent-[#1738D1]"
              />
              <div class="flex justify-between text-[11px] font-semibold text-[#55544f] tabular-nums mt-1">
                <span>Rp 2 Jt</span>
                <span>Rp 10 Jt</span>
                <span>Rp 20 Jt</span>
                <span>Rp 35 Jt</span>
              </div>
            </div>

            <!-- Quick Preset Nominal Buttons (Min 44px touch target) -->
            <div class="mt-3.5">
              <span class="text-[11px] font-bold text-[#55544f] block mb-2">Pilihan Cepat Gaji Kotor:</span>
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                <button
                  type="button"
                  data-preset="umk"
                  class="calc-preset-btn min-h-[44px] px-2.5 py-2 rounded-xl border border-[#1738D1] bg-[#f0f2ff] text-xs font-bold text-[#1738D1] transition cursor-pointer active:scale-[0.98]"
                >
                  Sesuai UMK
                </button>
                <button
                  type="button"
                  data-preset="4500000"
                  class="calc-preset-btn min-h-[44px] px-2.5 py-2 rounded-xl border border-[#d7d6cf] bg-white hover:border-[#1738D1] hover:text-[#1738D1] text-xs font-bold text-[#101010] tabular-nums transition cursor-pointer active:scale-[0.98]"
                >
                  Rp 4,5 Jt
                </button>
                <button
                  type="button"
                  data-preset="6000000"
                  class="calc-preset-btn min-h-[44px] px-2.5 py-2 rounded-xl border border-[#d7d6cf] bg-white hover:border-[#1738D1] hover:text-[#1738D1] text-xs font-bold text-[#101010] tabular-nums transition cursor-pointer active:scale-[0.98]"
                >
                  Rp 6 Jt
                </button>
                <button
                  type="button"
                  data-preset="8000000"
                  class="calc-preset-btn min-h-[44px] px-2.5 py-2 rounded-xl border border-[#d7d6cf] bg-white hover:border-[#1738D1] hover:text-[#1738D1] text-xs font-bold text-[#101010] tabular-nums transition cursor-pointer active:scale-[0.98]"
                >
                  Rp 8 Jt
                </button>
                <button
                  type="button"
                  data-preset="10000000"
                  class="calc-preset-btn min-h-[44px] px-2.5 py-2 rounded-xl border border-[#d7d6cf] bg-white hover:border-[#1738D1] hover:text-[#1738D1] text-xs font-bold text-[#101010] tabular-nums transition cursor-pointer active:scale-[0.98]"
                >
                  Rp 10 Jt
                </button>
                <button
                  type="button"
                  data-preset="15000000"
                  class="calc-preset-btn min-h-[44px] px-2.5 py-2 rounded-xl border border-[#d7d6cf] bg-white hover:border-[#1738D1] hover:text-[#1738D1] text-xs font-bold text-[#101010] tabular-nums transition cursor-pointer active:scale-[0.98]"
                >
                  Rp 15 Jt
                </button>
              </div>
            </div>
          </div>

          <!-- Baris 3: Tunjangan Tidak Tetap / Insentif Bulanan -->
          <div class="pt-4 border-t border-[#d7d6cf]/70">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <label for="calc-allowance-input" class="text-xs sm:text-sm font-bold text-[#101010]">
                3. Tunjangan Tidak Tetap / Insentif (Opsional)
              </label>
              <span class="text-[11px] font-medium text-[#55544f]">Uang makan/transport kehadiran, komisi</span>
            </div>

            <div class="relative flex items-center">
              <span class="absolute left-4 text-sm font-bold text-[#55544f] select-none pointer-events-none">
                Rp
              </span>
              <input
                type="text"
                id="calc-allowance-input"
                inputmode="numeric"
                value="0"
                aria-label="Nominal Tunjangan Tidak Tetap atau Insentif dalam Rupiah"
                class="w-full min-h-[46px] pl-12 pr-4 py-2.5 rounded-xl bg-[#f9f8f5] border border-[#d7d6cf] focus:border-[#1738D1] focus:bg-white text-sm sm:text-base font-bold text-[#101010] tabular-nums outline-none transition focus-visible:ring-2 focus-visible:ring-[#1738D1]"
              />
            </div>
            <p class="text-[11px] text-[#55544f] mt-1.5 font-medium">
              Tunjangan tidak tetap menambah penghasilan bruto kena pajak PPh 21, namun tidak menjadi dasar potongan iuran BPJS.
            </p>
          </div>

          <!-- Baris 4: Status PTKP & Skema Pemotongan -->
          <div class="pt-4 border-t border-[#d7d6cf]/70 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Status PTKP -->
            <div>
              <label for="calc-ptkp-select" class="text-xs sm:text-sm font-bold text-[#101010] block mb-2">
                4. Status Perkawinan &amp; Tanggungan (PTKP)
              </label>
              <div class="relative">
                <select
                  id="calc-ptkp-select"
                  class="w-full min-h-[46px] pl-3.5 pr-9 py-2.5 rounded-xl bg-[#f9f8f5] border border-[#d7d6cf] hover:border-[#101010] focus:border-[#1738D1] focus:bg-white text-xs sm:text-sm font-bold text-[#101010] outline-none transition appearance-none cursor-pointer focus-visible:ring-2 focus-visible:ring-[#1738D1]"
                >
                  <option value="TK/0" data-ter="A">TK/0 - Lajang, 0 Tanggungan (TER A)</option>
                  <option value="TK/1" data-ter="A">TK/1 - Lajang, 1 Tanggungan (TER A)</option>
                  <option value="K/0" data-ter="A">K/0 - Menikah, 0 Tanggungan (TER A)</option>
                  <option value="TK/2" data-ter="B">TK/2 - Lajang, 2 Tanggungan (TER B)</option>
                  <option value="TK/3" data-ter="B">TK/3 - Lajang, 3 Tanggungan (TER B)</option>
                  <option value="K/1" data-ter="B">K/1 - Menikah, 1 Tanggungan (TER B)</option>
                  <option value="K/2" data-ter="B">K/2 - Menikah, 2 Tanggungan (TER B)</option>
                  <option value="K/3" data-ter="C">K/3 - Menikah, 3 Tanggungan (TER C)</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[#55544f]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Skema Pemotongan Pajak -->
            <div>
              <span class="text-xs sm:text-sm font-bold text-[#101010] block mb-2">
                5. Skema Kontrak Gaji
              </span>
              <div class="grid grid-cols-2 gap-2" role="group" aria-label="Pilih skema pemotongan gaji">
                <button
                  type="button"
                  id="scheme-gross-btn"
                  data-scheme="gross"
                  aria-pressed="true"
                  class="calc-scheme-btn min-h-[46px] px-3 py-2 rounded-xl border border-[#1738D1] bg-[#f0f2ff] text-[#1738D1] text-xs font-bold transition cursor-pointer"
                >
                  Potong Gaji (Gross)
                </button>
                <button
                  type="button"
                  id="scheme-net-btn"
                  data-scheme="net"
                  aria-pressed="false"
                  class="calc-scheme-btn min-h-[46px] px-3 py-2 rounded-xl border border-[#d7d6cf] bg-[#f9f8f5] text-[#55544f] hover:text-[#101010] text-xs font-bold transition cursor-pointer"
                >
                  Terima Bersih (Net)
                </button>
              </div>
            </div>
          </div>

          <!-- Baris 5: Komponen Kepesertaan BPJS -->
          <div class="pt-4 border-t border-[#d7d6cf]/70">
            <span class="text-xs font-bold text-[#101010] block mb-2.5">
              Komponen Kepesertaan BPJS Karyawan:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <label class="min-h-[44px] px-3.5 py-2.5 rounded-xl border border-[#d7d6cf] bg-[#f9f8f5] hover:border-[#101010] flex items-center gap-2.5 cursor-pointer transition select-none">
                <input
                  type="checkbox"
                  id="chk-bpjs-jht"
                  checked
                  class="w-4 h-4 rounded accent-[#1738D1] cursor-pointer shrink-0"
                />
                <span class="text-xs font-bold text-[#101010]">
                  BPJS TK - JHT <span class="text-[#55544f] font-semibold">(2%)</span>
                </span>
              </label>

              <label class="min-h-[44px] px-3.5 py-2.5 rounded-xl border border-[#d7d6cf] bg-[#f9f8f5] hover:border-[#101010] flex items-center gap-2.5 cursor-pointer transition select-none">
                <input
                  type="checkbox"
                  id="chk-bpjs-jp"
                  checked
                  class="w-4 h-4 rounded accent-[#1738D1] cursor-pointer shrink-0"
                />
                <span class="text-xs font-bold text-[#101010]">
                  BPJS TK - JP <span class="text-[#55544f] font-semibold">(1%)</span>
                </span>
              </label>

              <label class="min-h-[44px] px-3.5 py-2.5 rounded-xl border border-[#d7d6cf] bg-[#f9f8f5] hover:border-[#101010] flex items-center gap-2.5 cursor-pointer transition select-none">
                <input
                  type="checkbox"
                  id="chk-bpjs-kes"
                  checked
                  class="w-4 h-4 rounded accent-[#1738D1] cursor-pointer shrink-0"
                />
                <span class="text-xs font-bold text-[#101010]">
                  BPJS Kesehatan <span class="text-[#55544f] font-semibold">(1%)</span>
                </span>
              </label>
            </div>
          </div>

        </div>

        <!-- KARTU 2: ANALISIS DAYA BELI & STANDAR UPAH RIIL WILAYAH -->
        <div class="bg-white rounded-[20px] sm:rounded-[24px] border border-[#d7d6cf] p-5 sm:p-7 shadow-[0_4px_20px_-2px_rgba(16,16,16,0.04)] space-y-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#1738D1] block mb-1">
                Benchmark Daya Beli Daerah
              </span>
              <h3 class="text-base sm:text-lg font-bold text-[#101010]">
                Analisis Upah Riil di <span id="benchmark-city-name">{defaultRegion.city}</span>
              </h3>
              <p class="text-[11px] font-medium text-[#55544f] mt-0.5">
                Provinsi <span id="benchmark-prov-name" class="font-bold text-[#101010]">{defaultRegion.province}</span> · Dasar Hukum: <span id="benchmark-sk-ref" class="font-semibold text-[#101010]">{defaultRegion.skReference}</span>
              </p>
            </div>
            <span
              id="benchmark-status-badge"
