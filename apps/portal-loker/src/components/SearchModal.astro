---
// SearchModal.astro - Unified multi-category search overlay with real database data
import { getPortalCounts } from '../lib/data';
import { lowonganList, eventList, artikelList, ensureData } from '../data/mock';

await ensureData();
const counts = await getPortalCounts();
---

<div
  id="global-search-modal"
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden items-start justify-center p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Pencarian Direktori Karier"
>
  <div class="bg-[#f4f3ee] rounded-2xl w-full max-w-3xl shadow-2xl border border-[#d7d6cf] overflow-hidden my-8 animate-in fade-in zoom-in-95 duration-200">
    <!-- Search Input Header -->
    <div class="p-4 sm:p-5 border-b border-[#d7d6cf] flex items-center gap-3 bg-white">
      <svg class="w-5 h-5 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="text"
        id="modal-search-input"
        placeholder="Cari loker, tips karier, event, pelatihan, atau sertifikasi..."
        class="w-full text-base sm:text-lg text-[#101010] placeholder-[#a5a5a1] outline-none bg-transparent font-medium"
        autofocus
      />
      <button
        type="button"
        id="close-search-modal"
        class="w-8 h-8 rounded-full flex items-center justify-center text-[#6e6d68] hover:text-[#101010] hover:bg-[#101010]/5 transition cursor-pointer"
        aria-label="Tutup pencarian"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Category Filter Tabs inside Modal -->
    <div class="px-4 py-3 border-b border-[#d7d6cf] flex items-center gap-2 overflow-x-auto text-xs font-bold no-scrollbar bg-[#f4f3ee]" id="modal-category-tabs">
      <button data-tab="all" data-target="/search" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-[#101010] text-white">Semua</button>
      <button data-tab="lowongan" data-target="/search?type=lowongan" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Loker ({counts.jobs > 1000 ? `${Math.floor(counts.jobs / 1000)}k+` : counts.jobs})</button>
      {counts.events > 0 && <button data-tab="event" data-target="/search?type=event" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Event ({counts.events})</button>}
      {counts.articles > 0 && <button data-tab="artikel" data-target="/search?type=career" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Artikel ({counts.articles})</button>}
      {counts.certs > 0 && <button data-tab="sertifikasi" data-target="/search?type=sertifikasi" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Sertifikasi ({counts.certs})</button>}
      {counts.courses > 0 && <button data-tab="course" data-target="/search?type=course" class="search-tab-btn px-3.5 py-1.5 rounded-full bg-white text-[#6e6d68] border border-[#d7d6cf] hover:border-[#101010]">Pelatihan ({counts.courses})</button>}
    </div>

    <!-- Search Results Container -->
    <div id="search-results-box" class="p-4 sm:p-6 max-h-[60vh] overflow-y-auto space-y-3 bg-[#f4f3ee]">
      <!-- Default Quick Suggestions -->
      <div class="section-label mb-3"><span>Rekomendasi Pencarian Terkini</span><i></i></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {lowonganList.slice(0, 2).map((job) => (
          <a href={`/lowongan/${job.slug}`} class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#1738D1] flex items-center justify-between group transition shadow-xs">
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <span class="w-7 h-7 rounded-full bg-blue-50 text-[#1738D1] flex items-center justify-center text-xs font-bold border border-blue-100 shrink-0">L</span>
              <span class="text-xs font-bold text-[#101010] group-hover:text-[#1738D1] truncate">{job.title}</span>
            </div>
            <span class="text-[11px] font-bold text-[#55544f] shrink-0 truncate max-w-[120px]">{job.company}</span>
          </a>
        ))}
        {eventList.slice(0, 1).map((ev) => (
          <a href={`/event/${ev.slug}`} class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#1738D1] flex items-center justify-between group transition shadow-xs">
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <span class="w-7 h-7 rounded-full bg-amber-50 text-amber-800 flex items-center justify-center text-xs font-bold border border-amber-200 shrink-0">E</span>
              <span class="text-xs font-bold text-[#101010] group-hover:text-[#1738D1] truncate">{ev.title}</span>
            </div>
            <span class="text-[11px] font-bold text-[#55544f] shrink-0 truncate max-w-[120px]">{ev.date}</span>
          </a>
        ))}
        {artikelList.slice(0, 1).map((art) => (
          <a href={`/career/${art.slug}`} class="p-3.5 rounded-xl bg-white border border-[#d7d6cf] hover:border-[#1738D1] flex items-center justify-between group transition shadow-xs">
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <span class="w-7 h-7 rounded-full bg-rose-50 text-rose-700 flex items-center justify-center text-xs font-bold border border-rose-200 shrink-0">A</span>
              <span class="text-xs font-bold text-[#101010] group-hover:text-[#1738D1] truncate">{art.title}</span>
            </div>
            <span class="text-[11px] font-bold text-[#55544f] shrink-0 truncate max-w-[120px]">{art.category}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="p-4 bg-white border-t border-[#d7d6cf] flex items-center justify-between text-xs text-[#6e6d68]">
      <span>Tekan <kbd class="px-2 py-0.5 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] font-mono text-[10px] text-[#101010]">ESC</kbd> untuk menutup</span>
      <a href="/search" class="font-bold text-[#1738D1] hover:underline">Buka Pencarian Terpadu</a>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const modal = document.getElementById('global-search-modal');
    const openBtn = document.getElementById('open-search-btn');
    const closeBtn = document.getElementById('close-search-modal');
    const modalInput = document.getElementById('modal-search-input');
    const tabBtns = document.querySelectorAll('.search-tab-btn');
    let currentTarget = '/search';

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('bg-[#101010]', 'text-white');
          b.classList.add('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        });
        btn.classList.remove('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        btn.classList.add('bg-[#101010]', 'text-white');
        currentTarget = btn.getAttribute('data-target') || '/search';
      });
    });

    function openModal(initialQuery) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalInput) {
        if (initialQuery) modalInput.value = initialQuery;
        modalInput.focus();
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function executeSearch() {
      const q = modalInput?.value?.trim() || '';
      let dest = currentTarget || '/search';
      if (q) {
        dest += (dest.includes('?') ? '&' : '?') + 'q=' + encodeURIComponent(q);
      }
      window.location.href = dest;
    }

    openBtn?.addEventListener('click', () => openModal(''));
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    modalInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeSearch();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>
