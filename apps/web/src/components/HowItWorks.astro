---
const steps = [
  {
    number: '01',
    title: 'Daftar Gratis',
    description: 'Buat akun dengan Google atau email dalam 30 detik',
    icon: 'UserPlus',
  },
  {
    number: '02',
    title: 'Buat CV ATS',
    description: 'Pilih template, isi data, dapatkan ATS score real-time',
    icon: 'FileEdit',
  },
  {
    number: '03',
    title: 'Screening AI',
    description: 'AI analyze CV Anda seperti recruiter profesional',
    icon: 'Search',
  },
  {
    number: '04',
    title: 'Lamar & Track',
    description: 'Kirim lamaran dan kelola pipeline sampai offering',
    icon: 'Rocket',
  },
];
---

<section id="how-it-works" class="section-container py-20 lg:py-32 bg-gradient-to-b from-transparent to-glass-light/30">
  <div class="text-center mb-16 space-y-4">
    <h2 class="text-4xl lg:text-5xl font-bold">
      Cara <span class="text-gradient">Kerjanya</span>
    </h2>
    <p class="text-xl text-text-secondary max-w-3xl mx-auto">
      4 langkah sederhana untuk memulai perjalanan karir Anda
    </p>
  </div>

  <div class="max-w-5xl mx-auto">
    {steps.map((step, index) => (
      <div
        class="relative flex flex-col md:flex-row gap-8 mb-16 last:mb-0 animate-on-scroll"
        style={`animation-delay: ${index * 100}ms;`}
      >
        {/* Vertical Line (Desktop) */}
        {index < steps.length - 1 && (
          <div class="hidden md:block absolute left-16 top-24 w-0.5 h-full bg-gradient-to-b from-accent-indigo to-accent-violet opacity-20"></div>
        )}

        {/* Number Circle */}
        <div class="flex-shrink-0 w-32 h-32 mx-auto md:mx-0 rounded-full glass-heavy flex items-center justify-center relative z-10">
          <span class="text-4xl font-bold text-gradient">{step.number}</span>
        </div>

        {/* Content */}
        <div class={`flex-1 glass-card p-8 ${index % 2 === 0 ? 'md:ml-8' : 'md:mr-8'}`}>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-indigo to-accent-violet flex items-center justify-center">
              {step.icon === 'UserPlus' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                </svg>
              )}
              {step.icon === 'FileEdit' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              )}
              {step.icon === 'Search' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              )}
              {step.icon === 'Rocket' && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              )}
            </div>

            <h3 class="text-2xl font-semibold">{step.title}</h3>
            <p class="text-lg text-text-secondary">{step.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });
</script>
