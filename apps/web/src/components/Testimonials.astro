---
const testimonials = [
  {
    name: "Rania Amanda",
    role: "Fresh Graduate · Frontend Dev Intern",
    school: "Universitas Indonesia",
    avatar: "RA",
    quote: "Dulu bikin CV bingung harus mulai dari mana. Di CUTI, tinggal isi data sekali, langsung jadi CV ATS yang rapi. Minggu kedua setelah sebar lamaran langsung dipanggil wawancara!",
    badge: "CV ATS 94% · Wawancara Lolos",
    bgClass: "card-periwinkle"
  },
  {
    name: "Dimas Prasetyo",
    role: "Siswa SMK Informatika · Social Media Staff",
    school: "SMKN 1 Jakarta",
    avatar: "DP",
    quote: "Fitur tracker-nya ngebantu banget biar nggak kelewatan jadwal tes. Ditambah ada misi harian yang bikin ketagihan buat ngerjain tugas karier sambil dapat penghasilan tambahan!",
    badge: "Tracker Active · 12 Misi Selesai",
    bgClass: "card-paper"
  },
  {
    name: "Nabila Putri",
    role: "Mahasiswi Akhir · Management Trainee",
    school: "Universitas Diponegoro",
    avatar: "NP",
    quote: "Yang paling aku suka: sekali bayar untuk selamanya. Nggak ada pusing tagihan langganan bulanan. Info lokernya terkurasi rapi dan langsung terhubung ke portal resmi.",
    badge: "Lifetime Member · MT Accepted",
    bgClass: "card-lime"
  }
];
---

<section class="section testimonials" id="testimoni">
  <div class="section-heading reveal" data-reveal>
    <span class="kicker">KISAH NYATA TALENTA MUDA</span>
    <h2>Dari bingung jadi <em>diterima kerja.</em></h2>
    <p>Dengarkan cerita teman-teman SMA/SMK, mahasiswa, dan fresh graduate yang melangkah lebih percaya diri bersama CUTI.</p>
  </div>

  <div class="testimonial-grid">
    {testimonials.map((t, index) => (
      <article class={`testimonial-card ${t.bgClass} reveal`} data-reveal style={`transition-delay: ${index * 0.1}s`}>
        <div class="card-header-row">
          <div class="user-badge">{t.badge}</div>
          <div class="quote-mark">“</div>
        </div>
        <p class="testimonial-quote">{t.quote}</p>
        <div class="testimonial-author">
          <div class="author-avatar">{t.avatar}</div>
          <div class="author-info">
            <strong>{t.name}</strong>
            <small>{t.role}</small>
            <span>{t.school}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .testimonials {
    border-bottom: var(--line);
    background: var(--paper);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px 28px;
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    transition: transform 0.3s cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
  }

  .card-periwinkle {
    background: var(--periwinkle);
  }

  .card-paper {
    background: #ffffff;
  }

  .card-lime {
    background: var(--lime);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .user-badge {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--ink);
    border-radius: 99px;
    background: var(--paper);
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .quote-mark {
    font-family: var(--serif);
    font-size: 48px;
    line-height: 0.6;
    color: var(--ink);
    opacity: 0.4;
  }

  .testimonial-quote {
    margin: 0 0 28px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    font-weight: 500;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--cobalt);
    color: var(--paper);
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .card-lime .author-avatar {
    background: var(--ink);
    color: var(--paper);
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-info strong {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .author-info small {
    font-size: 12px;
    color: color-mix(in srgb, var(--ink) 80%, transparent);
    font-weight: 600;
  }

  .author-info span {
    font-size: 11px;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  @media (max-width: 900px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
