---
import BaseLayout from '../layouts/BaseLayout.astro';
import PreRegisterForm from '../components/employer/PreRegisterForm';

const logoMark = '/logo.webp';
---

<BaseLayout
  title="Daftar Early Tester: Akses Akun Gratis — Employr"
  description="Dapatkan akses gratis seumur hidup sebagai Early Tester. Buat CV ATS-friendly, pantau lamaran kerja, dan siapkan karier impianmu."
  canonicalUrl="https://employr.id/pre-register"
>
  <div class="min-h-screen bg-white text-[#101010] font-sans p-6 sm:p-10 flex flex-col justify-between selection:bg-[#0000ff] selection:text-white">
    <!-- Top Header -->
    <header class="max-w-lg w-full mx-auto flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition" aria-label="Beranda">
        <img src={logoMark} alt="Employr" class="h-7 sm:h-8 w-auto object-contain" />
      </a>

      <a
        href="/"
        class="text-xs font-bold text-gray-400 hover:text-gray-700 transition flex items-center gap-1.5 py-1.5 px-3 rounded-full hover:bg-black/5"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        <span>Tutup</span>
      </a>
    </header>

    <!-- Center Screen Content (Onboarding Cardless Style) -->
    <main class="max-w-lg w-full mx-auto my-auto py-8 sm:py-12">
      <PreRegisterForm client:load />
    </main>

    <!-- Bottom Footer -->
    <footer class="max-w-lg w-full mx-auto text-center pt-4">
      <p class="text-xs font-medium text-gray-400 flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span>Data kamu aman bersama Employr</span>
      </p>
    </footer>
  </div>
</BaseLayout>
