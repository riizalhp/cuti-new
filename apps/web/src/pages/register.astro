---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginModal from '../components/LoginModal.astro';
import RegisterModal from '../components/RegisterModal.astro';
import { getGoogleAuthUrl } from '../utils/env';

const googleAuthUrl = getGoogleAuthUrl();
---

<BaseLayout 
  title="Daftar Akun — Employr Career OS" 
  description="Daftar akun Employr untuk membuat CV ATS, memantau lamaran, dan meraih reward karier."
  canonicalUrl="https://employr.id/register"
>
  <header class="site-header">
    <a href="/" class="brand" aria-label="Kembali ke beranda Employr">
      <img src="/logo.webp" alt="Employr" width="150" height="41" class="brand-logo" />
    </a>
    <a href="/" class="text-link">← Kembali ke Beranda</a>
  </header>

  <main class="register-page-container">
    <div class="register-card-wrapper reveal" data-reveal>
      <div class="register-card">
        <div class="brand-mark-wrapper">
          <img src="/logo.webp" alt="Employr" width="150" height="41" class="modal-logo" />
        </div>
        
        <div class="card-header">
          <span class="kicker">CAREER OS INDONESIA</span>
          <h1>Daftar Akun <em>Employr</em></h1>
          <p>Mulai perjalanan kariermu: susun CV ATS, pantau lamaran tanpa batas, dan selesaikan misi berhadiah.</p>
        </div>

        <div class="feature-bullets">
          <div class="bullet-item">
            <span class="bullet-icon">✓</span>
            <div>
              <strong>CV Builder ATS Instan</strong>
              <p>Unduh PDF privat langsung dari browser.</p>
            </div>
          </div>
          <div class="bullet-item">
            <span class="bullet-icon">✓</span>
            <div>
              <strong>Job Tracker Unlimited</strong>
              <p>Kelola seluruh lamaran di papan Kanban.</p>
            </div>
          </div>
          <div class="bullet-item">
            <span class="bullet-icon">✓</span>
            <div>
              <strong>Misi Berhadiah Saldo</strong>
              <p>Bangun kebiasaan positif dan kumpulkan reward.</p>
            </div>
          </div>
        </div>

        <!-- Success Notification State -->
        <div id="register-success-state" class="success-box" style="display: none;">
          <div class="success-icon">✓</div>
          <h3>Pendaftaran Berhasil!</h3>
          <p id="register-success-msg">Akun kamu telah berhasil dibuat dan disimpan.</p>
          <a href="http://localhost:3000/onboarding" class="button submit-register-btn mt-3" style="width: 100%; justify-content: center; text-decoration: none;">
            <span>Lanjut ke Onboarding</span>
            <span class="btn-arrow">↗</span>
          </a>
        </div>

        <!-- Registration Form (Stay on Port 4321) -->
        <form id="register-form" class="register-form" action="javascript:void(0);" onsubmit="return false;">
          <div id="register-error-alert" class="error-alert" style="display: none;"></div>

          <div class="input-group">
            <label for="reg-fullname" class="input-label">Nama Lengkap</label>
            <input 
              type="text" 
              id="reg-fullname" 
              name="fullname" 
              placeholder="contoh: Budi Pratama" 
              class="modal-input" 
              required 
            />
          </div>

          <div class="input-group">
            <label for="reg-email" class="input-label">Email</label>
            <input 
              type="email" 
              id="reg-email" 
              name="email" 
              placeholder="contoh: budi@gmail.com" 
              class="modal-input" 
              required 
            />
          </div>

          <div class="input-group">
            <label for="reg-password" class="input-label">Kata Sandi</label>
            <input 
              type="password" 
              id="reg-password" 
              name="password" 
              placeholder="Min. 6 karakter" 
              class="modal-input" 
              minlength="6"
              required 
            />
          </div>

          <button type="submit" class="button submit-register-btn">
            <span>Daftar Akun Sekarang</span>
            <span class="btn-arrow">↗</span>
          </button>
        </form>

        <div class="divider-text">atau daftar dengan</div>

        <div class="action-box">
          <a href={googleAuthUrl} class="button google-auth-btn">
            <div class="btn-left">
              <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.15C3.26 21.37 7.37 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.24C.45 8.15 0 9.97 0 12s.45 3.85 1.24 5.42l4.04-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.37 0 3.26 2.63 1.24 6.58l4.04 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              <span>Daftar dengan Google</span>
            </div>
            <span class="btn-arrow">↗</span>
          </a>
          <small class="guarantee-note">Gratis pendaftaran · Privasi data terlindungi</small>
        </div>

        <div class="card-footer">
          <p>Sudah punya akun? <button type="button" class="text-button" data-open-login>Masuk di sini ↗</button></p>
        </div>
      </div>
    </div>
  </main>

  <LoginModal />
  <RegisterModal />
</BaseLayout>

<style>
  .brand-logo {
    width: auto;
    height: 34px;
    display: block;
  }

  .register-page-container {
    min-height: calc(100vh - 78px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 50px 20px;
    background: var(--paper);
  }

  .register-card-wrapper {
    width: 100%;
    max-width: 480px;
  }

  .register-card {
    position: relative;
    padding: 40px 32px 32px;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    transform: rotate(1deg);
    transition: transform 0.3s ease;
  }

  .register-card:hover {
    transform: rotate(0deg);
  }

  .brand-mark-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 14px;
  }

  .modal-logo {
    width: auto;
    height: 38px;
    display: block;
  }

  .card-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .card-header h1 {
    margin: 6px 0 8px;
    font-size: clamp(2rem, 4vw, 2.7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .card-header h1 em {
    font-family: var(--serif);
    font-style: italic;
    color: var(--cobalt);
  }

  .card-header p {
    margin: 0;
    font-size: 13.5px;
    color: color-mix(in srgb, var(--ink) 75%, transparent);
    line-height: 1.45;
  }

  .feature-bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    padding: 14px 18px;
    background: var(--periwinkle);
    border: 1.5px solid var(--ink);
    border-radius: 12px;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .bullet-icon {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    font-size: 10px;
    font-weight: 700;
  }

  .bullet-item strong {
    display: block;
    font-size: 12.5px;
    color: var(--ink);
  }

  .bullet-item p {
    margin: 1px 0 0;
    font-size: 11px;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
  }

  .register-form {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin-bottom: 6px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .input-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .modal-input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    background: #ffffff;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .modal-input::placeholder {
    color: color-mix(in srgb, var(--ink) 45%, transparent);
    font-size: 13.5px;
  }

  .modal-input:focus {
    border-color: var(--cobalt);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .submit-register-btn {
    min-height: 48px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    color: #ffffff;
    background: var(--ink);
    font-family: var(--sans);
    font-weight: 700;
    font-size: 14.5px;
    cursor: pointer;
    margin-top: 4px;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .submit-register-btn:hover {
    transform: translateY(-2px);
    background: var(--cobalt);
    border-color: var(--cobalt);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .divider-text {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: color-mix(in srgb, var(--ink) 50%, transparent);
    margin: 14px 0 14px;
    position: relative;
  }

  .divider-text::before,
  .divider-text::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 30%;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .divider-text::before {
    left: 0;
  }

  .divider-text::after {
    right: 0;
  }

  .action-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .google-auth-btn {
    min-height: 48px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    border: 1px solid var(--cobalt);
    border-radius: 999px;
    color: var(--paper);
    background: var(--cobalt);
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14.5px;
    transition: transform 0.25s, color 0.25s, background 0.25s, box-shadow 0.25s;
  }

  .google-auth-btn:hover {
    transform: translateY(-2px);
    color: var(--cobalt);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .btn-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-left svg {
    background: #ffffff;
    border-radius: 50%;
    padding: 2.5px;
    box-sizing: content-box;
  }

  .btn-arrow {
    font-size: 19px;
    line-height: 1;
  }

  .guarantee-note {
    font-size: 11.5px;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .error-alert {
    padding: 10px 14px;
    border-radius: 10px;
    background: #FEE2E2;
    border: 1.5px solid #EF4444;
    color: #991B1B;
    font-size: 12.5px;
    font-weight: 600;
  }

  .success-box {
    padding: 22px;
    background: #ECFDF5;
    border: 1.5px solid #10B981;
    border-radius: 12px;
    text-align: center;
    margin-bottom: 16px;
  }

  .success-icon {
    width: 38px;
    height: 38px;
    margin: 0 auto 8px;
    background: #10B981;
    color: #ffffff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: bold;
  }

  .success-box h3 {
    margin: 0 0 4px;
    font-size: 19px;
    font-weight: 700;
    color: #065F46;
  }

  .success-box p {
    margin: 0 0 14px;
    font-size: 13.5px;
    color: #047857;
  }

  .card-footer {
    margin-top: 24px;
    text-align: center;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .card-footer p {
    margin: 0;
    font-size: 13px;
  }

  .text-button {
    background: transparent;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--cobalt);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .text-button:hover {
    color: var(--ink);
  }
</style>

<script is:inline>
  (() => {
    function initRegisterPage() {
      const regForm = document.getElementById('register-form');
      const errAlert = document.getElementById('register-error-alert');
      const successState = document.getElementById('register-success-state');
      const successMsg = document.getElementById('register-success-msg');

      if (regForm) {
        regForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (errAlert) errAlert.style.display = 'none';

          const fullNameInput = document.getElementById('reg-fullname');
          const emailInput = document.getElementById('reg-email');
          const passwordInput = document.getElementById('reg-password');

          const fullName = fullNameInput ? fullNameInput.value.trim() : '';
          const email = emailInput ? emailInput.value.trim() : '';
          const password = passwordInput ? passwordInput.value : '';

          if (!fullName || !email || !password) {
            if (errAlert) {
              errAlert.innerText = 'Mohon lengkapi semua data formulir.';
              errAlert.style.display = 'block';
            }
            return;
          }

          if (password.length < 6) {
            if (errAlert) {
              errAlert.innerText = 'Kata sandi minimal 6 karakter.';
              errAlert.style.display = 'block';
            }
            return;
          }

          const submitBtn = regForm.querySelector('.submit-register-btn span');
          if (submitBtn) submitBtn.innerText = 'Menyimpan ke Database...';

          try {
            const res = await fetch('http://localhost:3000/api/auth/register', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                name: fullName,
                email: email,
                password: password,
              }),
            });

            const result = await res.json();

            if (!res.ok || !result.success) {
              if (errAlert) {
                errAlert.innerText = result.message || 'Gagal mendaftar. Silakan coba lagi.';
                errAlert.style.display = 'block';
              }
              if (submitBtn) submitBtn.innerText = 'Daftar Akun Sekarang';
              return;
            }

            // Save verified user session into localStorage
            const userData = {
              id: result.data.id,
              name: result.data.name,
              email: result.data.email,
              role: result.data.role,
              registeredAt: new Date().toISOString()
            };

            localStorage.setItem('cuti_user_session', JSON.stringify(userData));
            document.cookie = `cuti_user_session=${encodeURIComponent(JSON.stringify(userData))}; max-age=${30 * 24 * 60 * 60}; path=/; SameSite=Lax`;

            if (submitBtn) submitBtn.innerText = 'Pendaftaran Berhasil! Menuju Onboarding...';

            // Direct transition to onboarding on port 3000
            setTimeout(() => {
              window.location.href = 'http://localhost:3000/onboarding';
            }, 300);
          } catch (err) {
            console.error('Fetch error:', err);
            if (errAlert) {
              errAlert.innerText = 'Tidak dapat terhubung ke server database (localhost:3000). Pastikan server aktif.';
              errAlert.style.display = 'block';
            }
            if (submitBtn) submitBtn.innerText = 'Daftar Akun Sekarang';
          }
        });
      }

      // Handle register page google button -> Redirects directly to Onboarding
      const regGoogleBtns = document.querySelectorAll('.action-box .google-auth-btn');
      regGoogleBtns.forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          const textSpan = btn.querySelector('span');
          if (textSpan) textSpan.innerText = 'Memproses Pendaftaran...';
          try {
            const googleUser = {
              name: 'Google User',
              email: 'user@gmail.com',
              role: 'user',
              provider: 'google'
            };
            localStorage.setItem('cuti_user_session', JSON.stringify(googleUser));
            document.cookie = `cuti_user_session=${encodeURIComponent(JSON.stringify(googleUser))}; max-age=${30 * 24 * 60 * 60}; path=/; SameSite=Lax`;
          } catch (err) {}
          window.location.href = 'http://localhost:3000/onboarding';
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRegisterPage);
    } else {
      initRegisterPage();
    }
  })();
</script>
