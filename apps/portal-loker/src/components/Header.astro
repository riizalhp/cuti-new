---
const requestUrl = Astro.request.url ? new URL(Astro.request.url) : null;
const isDev = import.meta.env.DEV;
const host = requestUrl ? requestUrl.hostname : 'localhost';
const protocol = requestUrl ? requestUrl.protocol : 'http:';

const dashboardUrl = import.meta.env.PUBLIC_APP_URL || (isDev ? `${protocol}//${host}:3000` : 'https://app.employr.id');
---

<header class="site-header" data-od-id="site-header">
  <div class="wrap">
    <a class="logo" href="/">
      <span class="mark">PK</span>PortalKerja
    </a>
    <nav class="nav" data-od-id="main-nav" data-menu aria-label="Navigasi utama">
      <a href="/" class="active">Beranda</a>
      <a href="/#lowongan">Lowongan</a>
      <a href="/#artikel">Artikel</a>
      <a href="/#kursus">Kursus</a>
      <a href="/#sertifikat">Sertifikat</a>
      <a href="/#event">Job Fair</a>
    </nav>
    <div class="header-actions">
      <a class="btn btn-sm" href={`${dashboardUrl}/login`}>Masuk</a>
      <a class="btn btn-sm btn-primary" href={`${dashboardUrl}/register`}>Daftar</a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false" data-menu-button>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
