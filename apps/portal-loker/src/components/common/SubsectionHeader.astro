---
// SubsectionHeader.astro - Consistent sub-section heading component (Port 4321 Style)

interface Props {
  title: string;
  level?: 2 | 3;
  eyebrow?: string;
  eyebrowColor?: string;
  rightContent?: boolean;
  className?: string;
}

const {
  title,
  level = 2,
  eyebrow,
  eyebrowColor = 'text-[#1738D1]',
  rightContent = false,
  className = ''
} = Astro.props;

const HeadingTag = `h${level}` as 'h2' | 'h3';
const headingSize = level === 2 ? 'text-xl sm:text-2xl font-bold' : 'text-lg sm:text-xl font-bold';
---

<div class={`subsection-header ${rightContent ? 'flex flex-col sm:flex-row sm:items-end justify-between gap-3' : ''} pb-3 ${className}`}>
  <div class="min-w-0 flex-1">
    {eyebrow && (
      <div class="section-label mb-2">
        <span class={eyebrowColor}>{eyebrow}</span>
        <i></i>
      </div>
    )}
    <HeadingTag class={`${headingSize} text-[#101010] tracking-tight`} set:html={title} />
  </div>
  {rightContent && (
    <div class="shrink-0 mb-0.5">
      <slot name="right" />
    </div>
  )}
</div>
