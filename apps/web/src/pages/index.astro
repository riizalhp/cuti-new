---
/**
 * Employr landing — port 1:1 dari employer-career-platform/client/src/pages/Home.tsx
 * Cinematic Surrealism: metafora karier puitis, warm paper, film grain,
 * tipografi editorial, dan Employr Blue sebagai sinyal yang presisi.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/employer/Icon.astro';
import CvArtifact from '../components/employer/CvArtifact.astro';
import CompanyTicker from '../components/employer/CompanyTicker.astro';
import ScrollAnimations from '../components/employer/ScrollAnimations';
import WhyEmployr from '../components/employer/WhyEmployr';
import FooterReveal from '../components/employer/FooterReveal';
import BentoMoreThanForm from '../components/employer/BentoMoreThanForm';

const heroImage = '/images/hero-section.webp';
const logoMark = '/logo.webp';

const navItems = [
  ['Produk', '#product'],
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Apakah Employr hanya untuk lulusan baru?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Tidak. Siapa pun yang sedang aktif mencari kerja, ingin pindah haluan karier, maupun merapikan portofolio dan CV bisa memakai Employr untuk menyiapkan berkas dan memantau status lamaran.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bisakah saya membuat beberapa versi CV di satu akun?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bisa. Tiap posisi sering memerlukan fokus pengalaman yang berbeda. Kamu bisa menyimpan beberapa versi khusus untuk desain, marketing, administrasi, atau bidang lainnya tanpa menimpa draf yang sudah ada.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bagaimana cara kerja skor kecocokan dengan loker?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Employr membandingkan kualifikasi yang tertulis di CV dengan syarat yang dicantumkan pada deskripsi loker. Sistem akan memperlihatkan keahlian atau kata kunci yang belum kamu cantumkan agar bisa kamu lengkapi sebelum mengirim berkas.',
      },
    },
    {
      '@type': 'Question',
      name: 'Apakah CV yang dibuat ramah sistem ATS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ya. Format berkas disusun dengan tata letak satu kolom yang bersih, penamaan bagian yang terstandarisasi, dan teks yang mudah dibaca oleh perangkat lunak Applicant Tracking System (ATS).',
      },
    },
    {
      '@type': 'Question',
      name: 'Bagaimana cara mengunduh CV ke format PDF?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Kamu bisa langsung mengunduh hasil CV berformat PDF yang rapi melalui tombol cetak/unduh di halaman pratinjau. Formatnya langsung siap dikirim ke email HR atau diunggah ke portal loker.',
      },
    },
  ],
};
---

<BaseLayout
  title="Employr: Susun CV ATS & Pantau Lamaran Kerja Jadi Mudah"
  description="Buat CV ramah ATS, sesuaikan keahlian dengan kriteria loker, dan rapikan status lamaran kerjamu di satu tempat. Praktis dan siap kirim."
  canonicalUrl="https://employr.id/"
  faqSchema={faqSchema}
>
  <div id="top" class="site-shell">
    <ScrollAnimations client:load />

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="top-announcement">
      <div class="announcement-content">
        <a href="/pre-register" class="announcement-link" title="Daftar Akses Awal Sekarang">
          Daftar Akses Awal Sekarang <Icon name="chevron-right" size={13} />
        </a>
      </div>
    </div>

    <!-- Mobile Nav Backdrop & Glass Sheet Drawer (Root Level for Viewport Freedom) -->
    <div class="mobile-nav-backdrop" data-menu-backdrop></div>
    <nav class="mobile-nav" aria-label="Navigasi mobile" data-menu>
      <button class="mobile-nav__close" aria-label="Tutup menu" data-menu-close>
        <Icon name="x" size={18} />
      </button>
      <div class="mobile-nav__links">
        {navItems.map(
          ([label, href]) => (
            <button data-navigate={href}>
              <span>{label}</span>
              <Icon name="chevron-right" size={18} />
            </button>
          )
        )}
      </div>
      <div class="mobile-nav__footer">
        <a class="mobile-start" href="/pre-register" title="Daftar Akses Awal">Akses Awal <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </nav>

    <main class="site-main" itemprop="mainContentOfPage">
      <!-- HERO FRAME CONTAINER (FRAMED CARD CANVAS) -->
      <div class="hero-frame-container">
      <section class="hero-card" aria-labelledby="hero-title">
        <!-- Background Image & Washes -->
        <img
          class="hero__image"
          src={heroImage}
          alt="Talenta muda melangkah percaya diri menyusuri kota menuju peluang karier impian"
          title="Employr - Langkah Awal Menuju Karier Impian"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__wash"></div>
        <div class="hero__grain"></div>

        <!-- Integrated Header Navigation (Inside Hero Card) -->
        <header class="site-header">
          <div class="header-left">
            <nav class="desktop-nav" aria-label="Navigasi utama">
              {navItems.map(([label, href]) => <button data-navigate={href}>{label}</button>)}
            </nav>
          </div>

          <a href="#top" class="brand-mark brand-mark--center" aria-label="Beranda Employr" title="Employr - Kembali ke atas" rel="home">
            <img src={logoMark} alt="Logo Employr" title="Logo Employr" class="brand-logo-main" width="140" height="36" />
          </a>

          <div class="header-actions">
            <!-- <button class="login-link" data-toast="Fitur masuk akan tersedia saat peluncuran resmi.">Masuk</button> -->
            <a class="header-cta" href="/pre-register" title="Dapatkan Akses Awal ke Employr">Akses Awal <Icon name="move-up-right" size={14} /></a>
            <button class="menu-toggle" aria-label="Menu navigasi" aria-expanded="false" data-menu-button>
              <span class="menu-toggle__bar menu-toggle__bar--top"></span>
              <span class="menu-toggle__bar menu-toggle__bar--mid"></span>
              <span class="menu-toggle__bar menu-toggle__bar--bot"></span>
            </button>
          </div>
        </header>

        <!-- Hero Content -->
        <div class="hero__inner">
          <div class="hero__content">
            <h1 id="hero-title">Langkah pertama kariermu,<br /><em>dimulai dari sini.</em></h1>
          </div>
          <div class="hero__content hero__content--right">
            <p class="hero__subtitle">Peluang baru<br /><em>siap kamu jemput.</em></p>
          </div>
        </div>

        <div class="hero__scroll"><span>GULIR KE BAWAH</span><i></i></div>
      </section>
    </div>

    <!-- COMPANY TICKER / SHOWCASE (LIGHT PAPER THEME) -->
    <CompanyTicker />

    <!-- 01 STATEMENT -->
    <section class="statement section-space" id="product">
        <div class="editorial-frame statement__frame">
          <div class="section-label"><span>01</span><i></i><span>KARIERMU, PILIHANMU</span></div>
          <div class="statement__body">
            <h2>Pengalamanmu terlalu luas<br />untuk <em>satu CV yang kaku.</em></h2>
            <p>Tiap posisi kerja butuh sorotan yang berbeda. Di Employr, kamu bisa merapikan pencapaian dan keahlianmu jadi bukti nyata yang langsung dilirik rekruter.</p>
          </div>
          <div class="statement__tick"><span>01</span><i></i><span>07</span></div>
        </div>
      </section>

      <!-- WHY EMPLOYR -->
      <WhyEmployr client:load />

      <!-- 03 ADAPT -->
      <section class="adapt section-space" id="career">
        <div class="adapt__intro editorial-frame">
          <div class="section-label"><span>03</span><i></i><span>SESUAIKAN</span></div>
          <h2>Kriteria rekruter berbeda-beda<br /><em>untuk tiap posisi.</em></h2>
          <p>Tonjolkan pengalaman dan keahlian yang paling relevan dengan posisi yang kamu lamar agar lolos tahap seleksi.</p>
        </div>
        <div class="adapt__flow editorial-frame">
          <div class="adapt__original"><p>CV UTAMA</p><CvArtifact variant="mini" /></div>
          <div class="adapt__scanner"><Icon name="scan-line" size={22} /><span>MENYOROT<br />POIN UTAMA</span><i></i></div>
          <div class="adapt__target"><p>CV SPESIFIK</p><CvArtifact variant="mini" /></div>
        </div>
        <div class="adapt__footer editorial-frame">
          <div><span class="blue-dot"></span> Kesesuaian kata kunci <span class="blue-dot"></span> Poin pengalaman terarah <span class="blue-dot"></span> Prioritas keahlian</div>
          <button class="action-link" data-toast="Fitur penyesuaian CV segera hadir.">Sesuaikan CV Sekarang <Icon name="arrow-up-right" /></button>
        </div>
      </section>

      <!-- 04 MANAGE -->
      <section class="versions section-space" aria-labelledby="versions-title">
        <div class="versions__headline">
          <div class="section-label section-label--inverse"><span>04</span><i></i><span>KELOLA</span></div>
          <h2 id="versions-title">Satu profil induk.<br /><em>Beragam pilihan posisi.</em></h2>
          <p>Melamar sebagai UI Designer, Admin, atau Marketing tanpa pusing mengelola banyak berkas terpisah.</p>
          <div class="versions__caption"><Icon name="circle-dot" size={15} /> Semua draf tersimpan rapi, siap dikirim.</div>
        </div>
        <div class="versions__stage">
          <div class="versions__glow"></div>
          <article class="version-card version-card--rear"><span>01</span><b>Growth<br />Marketing</b><small>Diperbarui 3 minggu lalu</small></article>
          <article class="version-card version-card--mid"><span>02</span><b>UI/UX<br />Designer</b><small>Diperbarui 1 bulan lalu</small></article>
          <article class="version-card version-card--front">
            <span>03</span><b>Product<br />Designer</b><small>Diperbarui 2 hari lalu</small>
            <div><span>DRAF UTAMA</span><Icon name="arrow-up-right" size={14} /></div>
          </article>
        </div>
      </section>

      <!-- 05 CAPABILITIES (Full-bleed Scroll-driven Showcase) -->
      <BentoMoreThanForm client:only="react" />

      <!-- 06 FAQ -->
      <section class="faq-section section-space" id="faq" aria-labelledby="faq-title">
        <div class="editorial-frame faq-section__frame">
          <div class="faq-section__top">
            <div class="faq-section__heading">
              <div class="section-label section-label--inverse"><span>06</span><i></i><span>FAQ</span></div>
              <h2 id="faq-title">Pertanyaan umum,<br /><em>seputar penggunaan Employr.</em></h2>
            </div>
            <p class="faq-section__lead">
              Hal-hal yang sering ditanyakan mengenai pembuatan CV, penyesuaian kriteria loker, dan fitur pemantau lamaran.
            </p>
          </div>

          <div class="faq-section__list">
            <details class="faq-item" name="faq-accordion">
              <summary class="faq-item__question">
                <span>Apakah Employr hanya untuk lulusan baru?</span>
                <span class="faq-item__icon"><Icon name="plus" size={18} /></span>
              </summary>
              <div class="faq-item__answer">
                <p>Tidak. Siapa pun yang sedang aktif mencari kerja, ingin pindah haluan karier, maupun merapikan portofolio dan CV bisa memakai Employr untuk menyiapkan berkas dan memantau status lamaran.</p>
              </div>
            </details>

            <details class="faq-item" name="faq-accordion">
              <summary class="faq-item__question">
                <span>Bisakah saya membuat beberapa versi CV di satu akun?</span>
                <span class="faq-item__icon"><Icon name="plus" size={18} /></span>
              </summary>
              <div class="faq-item__answer">
                <p>Bisa. Tiap posisi sering memerlukan fokus pengalaman yang berbeda. Kamu bisa menyimpan beberapa versi khusus untuk desain, marketing, administrasi, atau bidang lainnya tanpa menimpa draf yang sudah ada.</p>
              </div>
            </details>

            <details class="faq-item" name="faq-accordion">
              <summary class="faq-item__question">
                <span>Bagaimana cara kerja skor kecocokan dengan loker?</span>
                <span class="faq-item__icon"><Icon name="plus" size={18} /></span>
              </summary>
              <div class="faq-item__answer">
                <p>Employr membandingkan kualifikasi yang tertulis di CV dengan syarat yang dicantumkan pada deskripsi loker. Sistem akan memperlihatkan keahlian atau kata kunci yang belum kamu cantumkan agar bisa kamu lengkapi sebelum mengirim berkas.</p>
              </div>
            </details>

            <details class="faq-item" name="faq-accordion">
              <summary class="faq-item__question">
                <span>Apakah CV yang dibuat ramah sistem ATS?</span>
                <span class="faq-item__icon"><Icon name="plus" size={18} /></span>
              </summary>
              <div class="faq-item__answer">
                <p>Ya. Format berkas disusun dengan tata letak satu kolom yang bersih, penamaan bagian yang terstandarisasi, dan teks yang mudah dibaca oleh perangkat lunak Applicant Tracking System (ATS).</p>
              </div>
            </details>

            <details class="faq-item" name="faq-accordion">
              <summary class="faq-item__question">
                <span>Bagaimana cara mengunduh CV ke format PDF?</span>
                <span class="faq-item__icon"><Icon name="plus" size={18} /></span>
              </summary>
              <div class="faq-item__answer">
                <p>Kamu bisa langsung mengunduh hasil CV berformat PDF yang rapi melalui tombol cetak/unduh di halaman pratinjau. Formatnya langsung siap dikirim ke email HR atau diunggah ke portal loker.</p>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- USER STORIES -->
      <section class="testimonials-ready" aria-labelledby="stories-title">
        <div class="editorial-frame testimonials-ready__frame">
          <div class="testimonials-ready__grid">
            <div class="testimonials-ready__copy">
              <div class="testimonials-ready__eyebrow">
                <span>CERITA PENGGUNA</span><i></i> <span>PENGALAMAN NYATA</span>
              </div>
              <h2 id="stories-title">Cerita perjalanan<br /><em>menuju karier impian.</em></h2>
              <p>Pengalaman langsung dari rekan-rekan yang berhasil dapat panggilan interview dan tawaran kerja.</p>
              <a href="/pre-register" class="action-link" title="Daftar Akses Awal Employr dan bagikan ceritamu">Ceritakan Pengalamanmu <Icon name="arrow-up-right" /></a>
            </div>

            <div class="testimonials-ready__carousel-wrap" style="padding-top: clamp(32px, 9vw, 116px);">
              <div class="reviews-carousel-stage">
                <!-- Stacked background cards for 3D depth matching original style -->
                <div
                  class="reviews-card is-stacked"
                  style="transform: translateX(-50%) translateY(28px) scale(0.92); opacity: 0.45; z-index: 1;"
                  aria-hidden="true"
                ></div>
                <div
                  class="reviews-card is-stacked"
                  style="transform: translateX(-50%) translateY(14px) scale(0.96); opacity: 0.75; z-index: 2;"
                  aria-hidden="true"
                ></div>

                <!-- Main active card with identical original reviews-card style -->
                <figure
                  class="reviews-card is-active"
                  style="transform: translateX(-50%) translateY(0) scale(1); z-index: 3;"
                >
                  <blockquote class="reviews-card__quote">
                    <div class="reviews-card__quote-mark">“</div>
                    <p class="reviews-card__text">
                      Saat kamu berhasil mendapat panggilan interview atau surat penawaran kerja lewat Employr, bagikan ceritamu agar bisa menginspirasi pencari kerja lainnya di sini.
                    </p>
                  </blockquote>

                  <figcaption class="reviews-card__footer">
                    <div class="reviews-card__author-wrap">
                      <div class="reviews-card__avatar">★</div>
                      <div class="reviews-card__meta">
                        <span class="reviews-card__author">Cerita Kamu di Sini</span>
                        <span class="reviews-card__title">Panggilan Interview Berikutnya · Disiapkan</span>
                      </div>
                    </div>
                  </figcaption>
                </figure>
              </div>
            </div>
          </div>
        </div>
      </section>


      <!-- CAREER OBSERVATION -->
      <section class="career-observation section-space" aria-label="Refleksi karier">
        <div class="career-observation__bg">
          <video
            class="career-observation__video"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            aria-hidden="true"
          >
            <source src="/fish-swim.webm" type="video/webm" />
            <source src="/video/fish-swim.webm" type="video/webm" />
            <source src="/vidio/fish-swim.webm" type="video/webm" />
          </video>
          <div class="career-observation__wash"></div>
        </div>

        <div class="editorial-frame career-observation__frame">
          <div class="career-observation__copy">
            <div class="career-observation__wordmark"><span>KENDALI DI TANGANMU</span></div>
            <p>Tentukan langkahmu,<br />temukan ritme terbaikmu.</p>
            <small></small>
          </div>
          <div class="career-observation__footer-label">
            <span>REFLEKSI KARIER</span>
            <b>07 / 07</b>
          </div>
        </div>
      </section>
    </main>

    <FooterReveal client:load logoMark={logoMark} />
  </div>

  <script>
    // Navigasi smooth-scroll & toast placeholder (pengganti onClick React)
    function showToast(message: string) {
      let host = document.getElementById('employer-toast');
      if (!host) {
        host = document.createElement('div');
        host.id = 'employer-toast';
        Object.assign(host.style, {
          position: 'fixed',
          left: '50%',
          bottom: '28px',
          transform: 'translateX(-50%) translateY(16px)',
          background: '#111',
          color: '#fff',
          font: '700 12px/1 "Manrope", Arial, sans-serif',
          letterSpacing: '.04em',
          padding: '14px 18px',
          zIndex: '9999',
          opacity: '0',
          transition: 'opacity .25s ease-out, transform .25s cubic-bezier(.23,1,.32,1)',
          pointerEvents: 'none',
          boxShadow: '0 18px 46px rgba(0,0,0,.28)',
        });
        document.body.appendChild(host);
      }
      host.textContent = message;
      requestAnimationFrame(() => {
        host!.style.opacity = '1';
        host!.style.transform = 'translateX(-50%) translateY(0)';
      });
      window.clearTimeout(Number(host.dataset.t));
      host.dataset.t = String(
        window.setTimeout(() => {
          host!.style.opacity = '0';
          host!.style.transform = 'translateX(-50%) translateY(16px)';
        }, 2400)
      );
    }

    // Listen for events from React components
    window.addEventListener('show-toast', (e: Event) => {
      const customEvent = e as CustomEvent<string>;
      if (customEvent.detail) {
        showToast(customEvent.detail);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('[data-navigate]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.querySelector(btn.dataset.navigate || '');
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const menu = document.querySelector('[data-menu]');
        menu?.classList.remove('is-open');
        document.querySelector('[data-menu-button]')?.setAttribute('aria-expanded', 'false');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-toast]').forEach((btn) => {
      btn.addEventListener('click', () => showToast(btn.dataset.toast || ''));
    });

    const siteHeader = document.querySelector('.site-header');
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menuCloseButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
    const menuBackdrop = document.querySelector('[data-menu-backdrop]');
    const menu = document.querySelector('[data-menu]');

    const closeMenu = () => {
      menu?.classList.remove('is-open');
      menuBackdrop?.classList.remove('is-open');
      siteHeader?.classList.remove('is-menu-open');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.classList.remove('is-active');
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      menuButton?.setAttribute('aria-expanded', 'true');
      menuButton?.classList.add('is-active');
      menu?.classList.add('is-open');
      menuBackdrop?.classList.add('is-open');
      siteHeader?.classList.add('is-menu-open');
      document.body.style.overflow = 'hidden';
    };

    menuButton?.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuCloseButton?.addEventListener('click', closeMenu);
    menuBackdrop?.addEventListener('click', closeMenu);

    document.querySelectorAll('[data-menu] [data-navigate]').forEach((btn) => {
      btn.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Auto-init and play career observation video
    const fishVideo = document.querySelector<HTMLVideoElement>('.career-observation__video');
    if (fishVideo) {
      fishVideo.muted = true;
      fishVideo.defaultMuted = true;
      const playPromise = fishVideo.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          window.addEventListener('scroll', () => fishVideo.play(), { once: true });
          window.addEventListener('click', () => fishVideo.play(), { once: true });
          window.addEventListener('touchstart', () => fishVideo.play(), { once: true });
        });
      }
    }

    // Exclusive Accordion for FAQ (close others when one opens)
    const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          faqItems.forEach((other) => {
            if (other !== item && other.open) {
              other.open = false;
            }
          });
        }
      });
    });
  </script>
</BaseLayout>
