---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterPortal from '../../components/FooterPortal.astro';
import AdSlot from '../../components/AdSlot.astro';
import SearchModal from '../../components/SearchModal.astro';
import DetailCrossSections from '../../components/DetailCrossSections.astro';
import { getPortalArticleBySlug } from '../../lib/data';

const artikel = await getPortalArticleBySlug(Astro.params.slug || '');
if (!artikel) {
  return Astro.redirect('/career');
}
const canonical = `http://localhost:3003/career/${artikel.slug}`;
const title = `${artikel.title} | Employer Job`;
const description = artikel.excerpt;
---

<BaseLayout title={title} description={description} canonicalUrl={canonical}>
  <Navbar />

  <main class="bg-[#f4f3ee] min-h-screen pb-20">
    <!-- Breadcrumbs Navigation -->
    <div class="bg-white border-b border-[#d7d6cf]">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 py-4">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6e6d68] flex-wrap">
          <a href="/" class="hover:text-[#0000ff] transition">Beranda</a>
          <span>/</span>
          <a href="/career" class="hover:text-[#0000ff] transition">Artikel & Tips Karier</a>
          <span>/</span>
          <span class="text-[#6e6d68] font-medium">{artikel.category}</span>
          <span>/</span>
          <span class="text-[#101010] font-semibold truncate max-w-[200px] sm:max-w-xs" aria-current="page">{artikel.title}</span>
        </nav>
      </div>
    </div>

    <!-- Article Hero Header -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-6">
      <div class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-10 shadow-xs">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 flex-wrap mb-3 text-xs text-[#6e6d68]">
            <span class="px-3 py-1 rounded-full bg-rose-50 border border-rose-200 text-rose-700 font-semibold text-xs">
              {artikel.category}
            </span>
            <span>•</span>
            <span>{artikel.date}</span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Waktu baca: {artikel.readTime}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-[#101010] tracking-tight leading-tight mb-4">
            {artikel.title}
          </h1>

          <p class="text-sm sm:text-base text-[#6e6d68] leading-relaxed font-normal mb-6">
            {artikel.excerpt}
          </p>

          <!-- Author Info & Actions -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-[#d7d6cf]/50">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] flex items-center justify-center font-bold text-sm text-[#0000ff] shrink-0">
                {artikel.author ? artikel.author.slice(0, 2).toUpperCase() : 'EJ'}
              </div>
              <div>
                <strong class="text-sm font-semibold text-[#101010] block">{artikel.author}</strong>
                <span class="text-xs text-[#6e6d68]">{artikel.authorRole || 'Tim Redaksi Karier'}</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-share-career"
                class="min-h-[42px] px-4 py-2 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold flex items-center gap-1.5 transition"
              >
                <svg class="w-4 h-4 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                <span>Bagikan</span>
              </button>
              <button
                type="button"
                id="btn-bookmark-career"
                class="min-h-[42px] px-4 py-2 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold flex items-center gap-1.5 transition"
              >
                <svg class="w-4 h-4 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <span>Simpan</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Article Featured Image -->
        {artikel.image && (
          <div class="mt-8 rounded-2xl overflow-hidden border border-[#d7d6cf] max-h-[420px] bg-[#f4f3ee]">
            <img src={artikel.image} alt={artikel.title} class="w-full h-full object-cover" />
          </div>
        )}
      </div>
    </div>

    <!-- Main Content Layout (Left Content + Right Sidebar) -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Article Content -->
        <div class="lg:col-span-8 space-y-6">
          <article class="bg-white rounded-2xl border border-[#d7d6cf] p-6 sm:p-10 space-y-6">
            <!-- Table of Contents -->
            <div class="p-5 rounded-2xl bg-[#f4f3ee] border border-[#d7d6cf]">
              <h2 class="text-xs font-bold text-[#101010] uppercase tracking-wider mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-[#0000ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                Daftar Pembahasan
              </h2>
              <ul class="space-y-1.5 text-xs">
                <li>
                  <a href="#bagian-1" class="text-[#6e6d68] hover:text-[#0000ff] hover:underline font-medium">
                    1. Mengapa Kesalahan Ini Sering Terjadi
                  </a>
                </li>
                <li>
                  <a href="#bagian-2" class="text-[#6e6d68] hover:text-[#0000ff] hover:underline font-medium">
                    2. Strategi Praktis dan Solusi Terbukti
                  </a>
                </li>
                <li>
                  <a href="#bagian-3" class="text-[#6e6d68] hover:text-[#0000ff] hover:underline font-medium">
                    3. Langkah Aksi dan Rekomendasi Selanjutnya
                  </a>
                </li>
              </ul>
            </div>

            <!-- Main Text Paragraphs -->
            <div id="bagian-1" class="space-y-4 pt-2">
              <h3 class="text-lg sm:text-xl font-semibold text-[#101010]">
                Pentingnya Memahami Standar Seleksi Kerja Terkini
              </h3>
              {artikel.content.slice(0, 2).map((paragraph) => (
                <p class="text-sm sm:text-base text-[#101010] leading-relaxed font-normal">
                  {paragraph}
                </p>
              ))}
            </div>

            <!-- Key Takeaway Box -->
            <div class="p-5 rounded-2xl bg-[#f4f3ee] border-l-4 border-[#0000ff] text-[#101010]">
              <span class="text-xs font-bold text-[#0000ff] uppercase tracking-wider block mb-1">
                Poin Kunci untuk Pencari Kerja
              </span>
              <p class="text-xs sm:text-sm leading-relaxed text-[#101010]">
                Format dokumen lamaran yang bersih, ringkas, dan selaras dengan kata kunci kualifikasi posisi adalah faktor utama yang menentukan apakah berkas Anda lolos ke tahap interview HRD.
              </p>
            </div>

            <!-- In-Article Google Ads Space -->
            <AdSlot type="infeed" note="Rekomendasi materi pelatihan dan lowongan kerja terbaru." />

            <div id="bagian-2" class="space-y-4 pt-2">
              <h3 class="text-lg sm:text-xl font-semibold text-[#101010]">
                Langkah Perbaikan yang Direkomendasikan
              </h3>
              {artikel.content.slice(2).map((paragraph) => (
                <p class="text-sm sm:text-base text-[#101010] leading-relaxed font-normal">
                  {paragraph}
                </p>
              ))}
            </div>

            <div id="bagian-3" class="pt-6 border-t border-[#d7d6cf]/50">
              <div class="p-6 sm:p-8 rounded-2xl bg-[#101010] text-white flex flex-col sm:flex-row sm:items-center justify-between gap-5 border border-[#101010]">
                <div>
                  <div class="section-label section-label--inverse mb-2">
                    <i></i>
                    Employr Career Builder
                  </div>
                  <h4 class="text-base sm:text-lg font-semibold leading-snug">
                    Siapkan CV Standar ATS Kamu dalam Hitungan Menit
                  </h4>
                  <p class="text-xs text-[#d7d6cf] mt-1 max-w-md">
                    Gunakan template CV profesional yang telah disesuaikan dengan sistem rekrutmen perusahaan di Indonesia.
                  </p>
                </div>
                <a
                  href="http://localhost:3000/cv"
                  class="min-h-[42px] px-6 py-2.5 rounded-full bg-orange-500 hover:bg-orange-600 text-white font-semibold text-xs shrink-0 flex items-center justify-center transition shadow-md shadow-orange-500/20"
                >
                  Buat CV Saya
                </a>
              </div>
            </div>

            <!-- Tags -->
            {artikel.tags && artikel.tags.length > 0 && (
              <div class="flex items-center gap-2 flex-wrap pt-4 border-t border-[#d7d6cf]/50">
                <span class="text-xs text-[#6e6d68] font-medium">Topik Terkait:</span>
                {artikel.tags.map((t) => (
                  <span class="text-xs px-3 py-1 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#101010] font-medium">
                    #{t}
                  </span>
                ))}
              </div>
            )}
          </article>
        </div>

        <!-- Right: Sidebar Information & Ads -->
        <aside class="lg:col-span-4 space-y-6">
          <!-- Author Card -->
          <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-xs">
            <h3 class="text-sm font-semibold text-[#101010] mb-4 pb-2 border-b border-[#d7d6cf]/50">
              Tentang Penulis
            </h3>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-12 h-12 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] flex items-center justify-center font-bold text-base text-[#0000ff] shrink-0">
                {artikel.author ? artikel.author.slice(0, 2).toUpperCase() : 'EJ'}
              </div>
              <div>
                <strong class="text-sm font-semibold text-[#101010] block">{artikel.author}</strong>
                <span class="text-xs text-[#6e6d68]">{artikel.authorRole || 'Editor Tim Karier'}</span>
              </div>
            </div>
            <p class="text-xs text-[#6e6d68] leading-relaxed">
              Tim kurasi karier Employer Job yang mendedikasikan waktu untuk meneliti tren rekrutmen dan tips praktis bagi generasi muda Indonesia.
            </p>
          </div>

          <!-- Career Quick Advice -->
          <div class="bg-[#f4f3ee] rounded-2xl border border-[#d7d6cf] p-5">
            <h4 class="text-xs font-bold text-[#101010] uppercase tracking-wider mb-2">
              Kiat Cepat Karier
            </h4>
            <p class="text-xs text-[#6e6d68] leading-relaxed">
              Kirimkan lamaran kerja di jam kerja produktif (pukul 08.00 hingga 11.00 pagi) untuk meningkatkan peluang resume Anda langsung dilihat oleh tim rekruter.
            </p>
          </div>

          <!-- Google Ads: High-Viewability Sticky Sidebar Unit (300x600) -->
          <div class="sticky top-24">
            <AdSlot type="skyscraper" note="Jangkau ribuan pembaca aktif tips karier." />
          </div>
        </aside>
      </div>

      <!-- Google Ads: Leaderboard horizontal sebelum rekomendasi -->
      <AdSlot type="leaderboard" note="Rekomendasi peluang karier dan panduan lanjutan." />

      <!-- 5 Cross-Section Modules (Rekomendasi Lainnya) -->
      <DetailCrossSections
        currentType="career"
        currentSlug={artikel.slug}
        category={artikel.category}
      />
    </div>
  </main>

  <FooterPortal />
  <SearchModal />

  <!-- Script for Toast Feedback -->
  <script is:inline>
    const shareBtn = document.getElementById('btn-share-career');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } catch (err) {}
        } else {
          navigator.clipboard.writeText(window.location.href);
          alert('Tautan artikel berhasil disalin.');
        }
      });
    }

    const bookmarkBtn = document.getElementById('btn-bookmark-career');
    if (bookmarkBtn) {
      bookmarkBtn.addEventListener('click', () => {
        alert('Artikel telah disimpan ke daftar bacaan Anda.');
      });
    }
  </script>

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": artikel.title,
    "description": artikel.excerpt,
    "datePublished": "2026-08-15",
    "author": {
      "@type": "Person",
      "name": artikel.author
    },
    "publisher": {
      "@type": "Organization",
      "name": "Employer Job",
      "logo": {
        "@type": "ImageObject",
        "url": "http://localhost:3003/employer-job.svg"
      }
    },
    "url": canonical
  })} />
</BaseLayout>
