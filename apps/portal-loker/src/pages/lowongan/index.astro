---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterPortal from '../../components/FooterPortal.astro';
import AdSlot from '../../components/AdSlot.astro';
import SearchModal from '../../components/SearchModal.astro';
import PageHero from '../../components/common/PageHero.astro';
import SubsectionHeader from '../../components/common/SubsectionHeader.astro';
import OrganicCardSmall from '../../components/common/OrganicCardSmall.astro';
import {
  lowonganList,
  sertifikasiList,
  courseList,
  eventList,
  artikelList,
  ensureData,
} from '../../data/mock';
import { CV_BUILDER_URL, TRACKER_URL } from '../../lib/urls';

await ensureData();
const topSertifikasi = sertifikasiList.slice(0, 3);
const topCourses = courseList.slice(0, 3);
const topEvents = eventList.slice(0, 3);
const topArticles = artikelList.slice(0, 3);

const title = "Direktori Loker Terverifikasi | Employr";
const lowonganListSnapshot = [...lowonganList];
const description = "Temukan info lowongan kerja terverifikasi untuk fresh graduate, SMA/SMK, mahasiswa, dan profesional muda di seluruh Indonesia.";

// Hitung jumlah lowongan per kategori dari data database
const categoryMap: Record<string, number> = {};
for (const job of lowonganListSnapshot) {
  const cat = job.category || 'Umum';
  categoryMap[cat] = (categoryMap[cat] || 0) + 1;
}

// Map kategori ke label sidebar
const sidebarCategories = [
  { label: 'Teknologi & IT', key: 'IT' },
  { label: 'Perbankan & Finance', key: 'Finance' },
  { label: 'Marketing & Digital', key: 'Marketing' },
  { label: 'Operations & Logistik', key: 'Teknik & Produksi' },
  { label: 'Admin & Operasional', key: 'Admin & Operasional' },
  { label: 'Pendidikan', key: 'Pendidikan' },
  { label: 'Kesehatan', key: 'Kesehatan' },
  { label: 'Lainnya', key: 'Umum' },
].filter(c => (categoryMap[c.key] || 0) > 0);

// Agregasi perusahaan aktif merekrut dari data riil
const companyCountMap = new Map<string, { count: number; location: string; category: string }>();
for (const job of lowonganListSnapshot) {
  if (!job.company) continue;
  const cleanName = job.company.trim();
  if (!cleanName || cleanName.toLowerCase() === 'perusahaan') continue;
  const existing = companyCountMap.get(cleanName);
  if (existing) {
    existing.count += 1;
  } else {
    companyCountMap.set(cleanName, {
      count: 1,
      location: job.geo || job.location || 'Indonesia',
      category: job.category || 'Umum',
    });
  }
}

const topHiringCompanies = Array.from(companyCountMap.entries())
  .map(([name, data]) => ({
    name,
    jobsCount: data.count,
    location: data.location,
    category: data.category,
  }))
  .sort((a, b) => b.jobsCount - a.jobsCount)
  .slice(0, 5);

const rawQ = Astro.url.searchParams.get('q') || '';
const query = rawQ.trim().toLowerCase();
const geoFilter = (Astro.url.searchParams.get('geo') || Astro.url.searchParams.get('loc') || '').trim().toLowerCase();
const catFilter = (Astro.url.searchParams.get('cat') || '').trim().toLowerCase();
const typeFilter = (Astro.url.searchParams.get('type') || '').trim().toLowerCase();
const expFilter = (Astro.url.searchParams.get('exp') || '').trim().toLowerCase();

let filteredJobs = lowonganListSnapshot;

if (query) {
  filteredJobs = filteredJobs.filter((job) => {
    const titleMatch = (job.title || '').toLowerCase().includes(query);
    const companyMatch = (job.company || '').toLowerCase().includes(query);
    const descMatch = (job.description || '').toLowerCase().includes(query);
    const catMatch = (job.category || '').toLowerCase().includes(query);
    const locMatch = (job.location || job.geo || '').toLowerCase().includes(query);
    const typeMatch = (job.type || '').toLowerCase().includes(query);
    return titleMatch || companyMatch || descMatch || catMatch || locMatch || typeMatch;
  });
}

if (geoFilter) {
  filteredJobs = filteredJobs.filter((job) =>
    (job.location || job.geo || '').toLowerCase().includes(geoFilter)
  );
}

if (catFilter) {
  filteredJobs = filteredJobs.filter((job) =>
    (job.category || '').toLowerCase().includes(catFilter)
  );
}

if (typeFilter) {
  filteredJobs = filteredJobs.filter((job) =>
    (job.type || '').toLowerCase().includes(typeFilter)
  );
}

if (expFilter) {
  filteredJobs = filteredJobs.filter((job) =>
    (job.experience || '').toLowerCase().includes(expFilter) ||
    (job.title || '').toLowerCase().includes(expFilter)
  );
}

const isFiltered = Boolean(query || geoFilter || catFilter || typeFilter || expFilter);

// Pagination Logic (10 lowongan + 2 slot iklan = 12 slot per halaman dalam 3 kolom x 4 baris)
const JOBS_PER_PAGE = 10;
const totalFiltered = filteredJobs.length;
const totalPages = Math.max(1, Math.ceil(totalFiltered / JOBS_PER_PAGE));
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Number.isNaN(rawPage) ? 1 : Math.min(Math.max(1, rawPage), totalPages);
const startIndex = (currentPage - 1) * JOBS_PER_PAGE;
const endIndex = Math.min(startIndex + JOBS_PER_PAGE, totalFiltered);
const currentSlice = filteredJobs.slice(startIndex, endIndex);

// Jika hasil filter kurang dari 10, lengkapi dengan lowongan rekomendasi agar grid 3x4 selalu utuh 12 slot
const currentSlugs = new Set(currentSlice.map(j => j.slug));
const neededExtras = Math.max(0, 10 - currentSlice.length);
const supplementalJobs = neededExtras > 0
  ? lowonganListSnapshot.filter(j => !currentSlugs.has(j.slug)).slice(0, neededExtras)
  : [];
const gridJobs = [...currentSlice, ...supplementalJobs];

function buildPageUrl(pageNum: number): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  if (pageNum <= 1) {
    params.delete('page');
  } else {
    params.set('page', String(pageNum));
  }
  const qs = params.toString();
  return qs ? `/lowongan?${qs}#direktori-loker` : '/lowongan#direktori-loker';
}

// Buat nomor halaman dengan jendela sekitar halaman aktif
const pageNumbers: number[] = [];
const maxVisiblePages = 5;
let startPage = Math.max(1, currentPage - 2);
let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
if (endPage - startPage + 1 < maxVisiblePages) {
  startPage = Math.max(1, endPage - maxVisiblePages + 1);
}
for (let p = startPage; p <= endPage; p++) {
  pageNumbers.push(p);
}

const displayTitle = query
  ? `Hasil Pencarian: <em>"${rawQ}"</em>`
  : geoFilter
  ? `Lowongan Kerja di <em>${Astro.url.searchParams.get('geo') || Astro.url.searchParams.get('loc')}</em>`
  : catFilter
  ? `Lowongan Bidang <em>${Astro.url.searchParams.get('cat')}</em>`
  : "Lowongan Kerja Terbaru di <em>Indonesia</em>";

const displayBadge = `${totalFiltered} Lowongan Ditemukan`;
---

<BaseLayout title={title} description={description} canonicalUrl="http://localhost:3003/lowongan">
  <Navbar />

  <main class="bg-[#f4f3ee] min-h-screen pb-20">
    <!-- Page Hero -->
    <PageHero
      eyebrow="Direktori Karier Terkurasi"
      title={displayTitle}
      description={isFiltered ? `Menampilkan ${totalFiltered} lowongan yang sesuai kriteria pencarian kamu.` : "Peluang karier terverifikasi dari perusahaan rintisan, BUMN, hingga korporasi multinasional untuk fresh graduate dan talenta muda."}
      badge={{ text: displayBadge, bgColor: 'bg-blue-50', textColor: 'text-[#1738D1]', borderColor: 'border border-blue-200' }}
    >
      <nav slot="breadcrumb" class="flex items-center gap-2 text-xs text-[#52514c] mb-4 flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1738D1] font-medium py-1 transition focus-visible:outline-2 focus-visible:outline-[#1738D1]">Beranda</a>
        <span aria-hidden="true">/</span>
        <span class="text-[#101010] font-bold">Lowongan Kerja</span>
        {rawQ && <span>/ Pencarian: "{rawQ}"</span>}
      </nav>
    </PageHero>

    <!-- Main Container Layout -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-4">
      <!-- Top Leaderboard Ad Slot -->
      <AdSlot
        type="leaderboard"
        className="!px-0 !my-4"
        note="Rekomendasi program pelatihan kerja dan persiapan sertifikasi nasional."
      />

      <!-- 2-Column Balanced Grid: Layout 3x4 Grid di Sisi Kiri & Sisi Kanan Sejajar Penuh (lg:items-stretch) -->
      <div id="direktori-loker" class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-7 lg:items-stretch mt-6 scroll-mt-20">

        <!-- =====================================================================
             KOLOM KIRI (8 COLS): 3-KOLOM x 4-BARIS GRID (PERSIS GAYA BERANDA 3003)
             ===================================================================== -->
        <div class="lg:col-span-8 flex flex-col justify-between h-auto lg:h-full gap-4 sm:gap-5">
          <div class="space-y-4">
            <!-- Search Bar & Filter Panel -->
            <div class="bg-white rounded-2xl border border-[#d7d6cf] p-4 sm:p-5 shadow-xs space-y-3.5">
              <form action="/lowongan" method="GET" role="search" aria-label="Pencarian lowongan kerja" class="bg-[#f4f3ee] border border-[#c8c7be] focus-within:bg-white focus-within:border-[#1738D1] focus-within:ring-2 focus-within:ring-[#1738D1]/20 rounded-xl p-1.5 pl-3.5 flex items-center gap-2 transition">
                <label for="lowongan-search-input" class="sr-only">Cari posisi kerja, keahlian, atau nama perusahaan</label>
                <svg class="w-4 h-4 text-[#52514c] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input
                  id="lowongan-search-input"
                  type="search"
                  name="q"
                  value={rawQ}
                  placeholder="Cari posisi kerja, skill, atau nama perusahaan..."
                  class="min-w-0 flex-1 text-xs sm:text-sm text-[#101010] placeholder-[#52514c] bg-transparent font-medium py-2 focus:outline-none"
                />
                {isFiltered && (
                  <a
                    href="/lowongan#direktori-loker"
                    class="min-h-[44px] inline-flex items-center text-xs font-bold text-[#52514c] hover:text-[#101010] px-3 shrink-0 focus-visible:outline-2 focus-visible:outline-[#1738D1] rounded-lg"
                  >
                    Reset
                  </a>
                )}
                <button
                  type="submit"
                  class="min-h-[44px] px-5 py-2.5 rounded-lg bg-[#1738D1] hover:bg-[#132EA8] text-white font-bold text-xs shadow-xs transition cursor-pointer shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]"
                >
                  Cari Loker
                </button>
              </form>

              <!-- Filter Quick Pills -->
              <nav aria-label="Filter kategori cepat" class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
                <a
                  href="/lowongan#direktori-loker"
                  class={`min-h-[44px] inline-flex items-center px-4 py-2 rounded-full text-xs font-bold shrink-0 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1] ${!isFiltered ? 'bg-[#101010] text-white shadow-xs' : 'bg-[#f4f3ee] hover:bg-[#e5e3da] text-[#101010] border border-[#c8c7be]'}`}
                >
                  Semua Lowongan
                </a>
                <a
                  href="/lowongan?exp=fresh#direktori-loker"
                  class={`min-h-[44px] inline-flex items-center px-4 py-2 rounded-full text-xs font-bold shrink-0 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1] ${expFilter === 'fresh' ? 'bg-[#1738D1] text-white shadow-xs' : 'bg-[#f4f3ee] hover:bg-[#e5e3da] text-[#101010] border border-[#c8c7be]'}`}
                >
                  Fresh Graduate
                </a>
                <a
                  href="/lowongan?type=remote#direktori-loker"
                  class={`min-h-[44px] inline-flex items-center px-4 py-2 rounded-full text-xs font-bold shrink-0 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1] ${typeFilter === 'remote' ? 'bg-[#1738D1] text-white shadow-xs' : 'bg-[#f4f3ee] hover:bg-[#e5e3da] text-[#101010] border border-[#c8c7be]'}`}
                >
                  Kerja Remote
                </a>
                <a
                  href="/lowongan?type=magang#direktori-loker"
                  class={`min-h-[44px] inline-flex items-center px-4 py-2 rounded-full text-xs font-bold shrink-0 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1] ${typeFilter === 'magang' ? 'bg-[#1738D1] text-white shadow-xs' : 'bg-[#f4f3ee] hover:bg-[#e5e3da] text-[#101010] border border-[#c8c7be]'}`}
                >
                  Magang &amp; Internship
                </a>
                <a
                  href="/lowongan?cat=Finance#direktori-loker"
                  class={`min-h-[44px] inline-flex items-center px-4 py-2 rounded-full text-xs font-bold shrink-0 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1] ${catFilter === 'finance' ? 'bg-[#1738D1] text-white shadow-xs' : 'bg-[#f4f3ee] hover:bg-[#e5e3da] text-[#101010] border border-[#c8c7be]'}`}
                >
                  BUMN &amp; Perbankan
                </a>
                <a
                  href="/lowongan?cat=IT#direktori-loker"
                  class={`min-h-[44px] inline-flex items-center px-4 py-2 rounded-full text-xs font-bold shrink-0 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1] ${catFilter === 'it' ? 'bg-[#1738D1] text-white shadow-xs' : 'bg-[#f4f3ee] hover:bg-[#e5e3da] text-[#101010] border border-[#c8c7be]'}`}
                >
                  IT &amp; Software
                </a>
              </nav>
            </div>

            <!-- Header Info Baris Grid -->
            <div class="flex items-center justify-between pb-1">
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-[#101010]">Daftar Lowongan Terkurasi</h3>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-[#1738D1] border border-blue-200">
                  Terverifikasi HRD
                </span>
              </div>
              <span class="text-[11px] font-bold text-[#52514c]">
                {totalFiltered > 0
                  ? `Halaman ${currentPage} · Menampilkan ${startIndex + 1}–${endIndex} dari ${totalFiltered} loker`
                  : '0 Lowongan Ditemukan'}
              </span>
            </div>

            <!-- ===================================================================
                 3-KOLOM x 4-BARIS GRID (12 SLOT TOTAL: 10 LOKER + 2 IN-FEED ADS)
                 PERSIS DENGAN POLA KARTU BERANDA PORT 3003 (LowonganTerbaruGrid)
                 =================================================================== -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-3.5">
              {gridJobs.length === 0 ? (
                <div class="col-span-full text-center py-12 text-xs sm:text-sm text-[#52514c] bg-white rounded-2xl border border-[#d7d6cf] p-6 space-y-3">
                  <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-800 border border-amber-200 mx-auto flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                  </div>
                  <h4 class="font-bold text-[#101010] text-sm">Tidak ada lowongan yang sesuai kriteria pencarian</h4>
                  <p class="text-xs max-w-md mx-auto">
                    {rawQ ? `Tidak ditemukan lowongan dengan kata kunci "${rawQ}".` : 'Belum ada lowongan yang cocok dengan filter yang dipilih.'}
                  </p>
                  <div>
                    <a
                      href="/lowongan#direktori-loker"
                      class="min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white text-xs font-bold transition shadow-xs"
                    >
                      Tampilkan Semua Lowongan
                    </a>
                  </div>
                </div>
              ) : (
                <>
                  {/* BARIS 1 (Slot 1, 2, 3: 3 Lowongan) */}
                  {gridJobs.slice(0, 3).map((job) => (
                    <a
                      href={`/lowongan/${job.slug}`}
                      class="group bg-white rounded-xl border border-[#d7d6cf] p-3.5 flex flex-col justify-between hover:border-[#1738D1]/50 hover:shadow-[0_8px_20px_-4px_rgba(16,16,16,0.06)] hover:-translate-y-0.5 transition-all duration-200 relative overflow-hidden focus-visible:outline-2 focus-visible:outline-[#1738D1]"
                    >
                      <div>
                        <div class="flex items-center justify-between gap-1.5 mb-1.5">
                          <span class="text-[11px] font-bold text-[#52514c] uppercase tracking-wider truncate">
                            {job.company}
                          </span>
                          {job.badge ? (
                            <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${
                              job.badge === 'Hot' ? 'bg-amber-50 text-amber-800 border border-amber-200/80' : 'bg-blue-50 text-[#1738D1] border border-blue-100'
                            }`}>
                              {job.badge}
                            </span>
                          ) : null}
                        </div>
                        <h4 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center">
                          {job.title}
                        </h4>
                        <div class="flex items-center gap-1.5 text-[10.5px] text-[#52514c] font-medium mb-2.5 flex-wrap">
                          <span class="inline-flex items-center gap-1 text-[#101010] font-semibold">
                            <svg class="w-3 h-3 text-[#52514c]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            {job.location}
                          </span>
                          <span>·</span>
                          <span>{job.type}</span>
                        </div>
                      </div>
                      <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex flex-col gap-1.5 mt-auto">
                        <div class="flex items-center justify-between gap-1.5">
                          <span class="font-bold text-[#047857] text-xs truncate">{job.salary}</span>
                          <span class="text-[10px] font-semibold text-[#1738D1] group-hover:translate-x-0.5 transition-transform shrink-0 flex items-center gap-0.5">
                            Lihat
                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                            </svg>
                          </span>
                        </div>
                        <div class="flex items-center gap-1.5 text-[10px] text-[#52514c]">
                          <svg class="w-3 h-3 text-[#52514c] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          <span class="truncate">{job.postedAt}</span>
                        </div>
                      </div>
                    </a>
                  ))}

                  {/* BARIS 2: Slot 4 (Lowongan #4) */}
                  {gridJobs[3] && (
                    <a
                      href={`/lowongan/${gridJobs[3].slug}`}
                      class="group bg-white rounded-xl border border-[#d7d6cf] p-3.5 flex flex-col justify-between hover:border-[#1738D1]/50 hover:shadow-[0_8px_20px_-4px_rgba(16,16,16,0.06)] hover:-translate-y-0.5 transition-all duration-200 relative overflow-hidden focus-visible:outline-2 focus-visible:outline-[#1738D1]"
                    >
                      <div>
                        <div class="flex items-center justify-between gap-1.5 mb-1.5">
                          <span class="text-[11px] font-bold text-[#52514c] uppercase tracking-wider truncate">
                            {gridJobs[3].company}
                          </span>
                        </div>
                        <h4 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center">
                          {gridJobs[3].title}
                        </h4>
                        <div class="flex items-center gap-1.5 text-[10.5px] text-[#52514c] font-medium mb-2.5 flex-wrap">
                          <span class="inline-flex items-center gap-1 text-[#101010] font-semibold">
                            {gridJobs[3].location}
                          </span>
                          <span>·</span>
                          <span>{gridJobs[3].type}</span>
                        </div>
                      </div>
                      <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex flex-col gap-1.5 mt-auto">
                        <div class="flex items-center justify-between gap-1.5">
                          <span class="font-bold text-[#047857] text-xs truncate">{gridJobs[3].salary}</span>
                          <span class="text-[10px] font-semibold text-[#1738D1] group-hover:translate-x-0.5 transition-transform shrink-0 flex items-center gap-0.5">
                            Lihat ›
                          </span>
                        </div>
                        <span class="text-[10px] text-[#52514c] truncate">{gridJobs[3].postedAt}</span>
                      </div>
                    </a>
                  )}

                  {/* BARIS 2: Slot 5 -> IKLAN #1 DI SELA DAFTAR LOKER (Review CV ATS) */}
                  <div class="relative bg-white rounded-xl border border-dashed border-[#1738D1]/40 p-3.5 flex flex-col justify-between hover:border-[#1738D1] hover:shadow-[0_8px_20px_-4px_rgba(23,56,209,0.06)] transition-all duration-200 overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-br from-[#1738D1]/[0.03] via-transparent to-amber-500/[0.04] pointer-events-none"></div>
                    <div>
                      <div class="flex items-center justify-between gap-1.5 mb-1.5 relative z-10">
                        <div class="flex items-center gap-1">
                          <span class="px-1.5 py-0.5 rounded-full text-[8.5px] font-extrabold uppercase tracking-wider bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf]">
                            REKOMENDASI
                          </span>
                          <span class="text-[9px] font-bold text-[#1738D1]">PILIHAN</span>
                        </div>
                      </div>
                      <h4 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center relative z-10">
                        Uji Format Resume Standar HRD &amp; Lolos ATS
                      </h4>
                      <p class="text-[10px] text-[#52514c] leading-relaxed font-medium mb-2 relative z-10 line-clamp-2">
