                  <div class="flex flex-col gap-3 mt-3">
                    {page1Jobs.slice(4, 11).map((job) => (
                      <a
                        href={`/lowongan/${job.slug}`}
                        class="group bg-white rounded-xl border border-[#d7d6cf] p-3.5 flex flex-col justify-between hover:border-[#1738D1]/40 hover:shadow-[0_8px_20px_-4px_rgba(16,16,16,0.06)] transition-all duration-200 relative overflow-hidden"
