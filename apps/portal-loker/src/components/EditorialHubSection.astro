---
// EditorialHubSection.astro - Konsolidasi Wawasan Karier & Tips with Cult UI Cutout Cards (Harmonis dengan KursusSection)
import { artikelList, ensureData } from '../data/mock';
import OrganicCardSmall from './common/OrganicCardSmall.astro';
import CutoutCorner from './common/CutoutCorner.astro';

await ensureData();
const artikelSnapshot = [...artikelList];

// Seleksi artikel unggulan (featured) dan 3 sub-artikel (harmonis 5 cols + 7 cols seperti KursusSection)
const featured = artikelSnapshot[0];
const subArticles = artikelSnapshot.slice(1, 4);

const popularTags = [
  "BUMN 2026",
  "Interview ATS",
  "Gaji IT",
  "Remote Work",
  "Sertifikasi BNSP",
  "Fresh Graduate",
];
---

<section id="editorial-hub" class="py-8 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header (Harmonis dengan Kursus & Sertifikasi) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-10">
      <div>
        <div class="section-label mb-2.5">
          <span>05</span>
          <i></i>
          <span>EDITORIAL &amp; TIPS KARIER</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight">
          Pusat wawasan karier,<br class="hidden sm:inline" />
          <em>strategi lolos kerja.</em>
        </h2>
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-2 sm:mt-3.5 leading-relaxed font-medium max-w-xl">
          Kurasi artikel mendalam, strategi wawancara kerja, teknik lolos CV ATS, standar gaji industri, dan wawasan dunia profesional.
        </p>
      </div>

      <a
        href="/career"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start sm:self-auto group"
      >
        <span>Lihat Semua Artikel</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Unified Category Filter Tabs (Hanya ditampilkan jika artikel tersedia) -->
    {artikelSnapshot.length > 0 && (
      <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 sm:mb-8 no-scrollbar" id="editorial-tabs">
        <button
          type="button"
          data-cat="all"
          class="editorial-tab-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-[#1738D1] text-white text-xs font-semibold shrink-0 shadow-xs transition cursor-pointer"
        >
          Semua Topik
        </button>
        <button
          type="button"
          data-cat="tips"
          class="editorial-tab-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer"
        >
          Tips Karier
        </button>
        <button
          type="button"
          data-cat="cv"
          class="editorial-tab-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer"
        >
          CV &amp; Interview
        </button>
        <button
          type="button"
          data-cat="kerja"
          class="editorial-tab-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer"
        >
          Dunia Kerja
        </button>
        <button
          type="button"
          data-cat="gaji"
          class="editorial-tab-btn px-4 py-2 min-h-[38px] inline-flex items-center justify-center rounded-full bg-white hover:bg-[#eae8e0] text-[#101010] border border-[#d7d6cf] text-xs font-semibold shrink-0 transition cursor-pointer"
        >
          Gaji &amp; Negosiasi
        </button>
      </div>
    )}

    <!-- 4 Artikel Cards (Horizontal Snap Carousel di Mobile, Grid di Tablet/Desktop) -->
    <div class="flex overflow-x-auto snap-x snap-mandatory sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-7 pb-4 sm:pb-0 -mx-4 px-4 sm:mx-0 sm:px-0 no-scrollbar" id="articles-grid-container">
      {artikelSnapshot.length === 0 ? (
        <div class="col-span-full text-center py-12 text-sm text-[#6e6d68] bg-white rounded-[28px] border border-[#d7d6cf]">
          Belum ada artikel yang dipublikasikan saat ini. Kunjungi kembali secara berkala.
        </div>
      ) : (
        artikelSnapshot.slice(0, 4).map((art) => (
          <div class="article-item shrink-0 w-[275px] sm:w-auto snap-start" data-category={art.category.toLowerCase()}>
            <OrganicCardSmall
              category={art.category}
              date={art.date}
              title={art.title}
              href={`/career/${art.slug}`}
              description={art.excerpt}
              badge={art.readTime}
              actionText="Baca Artikel"
            />
          </div>
        ))
      )}
    </div>

    <!-- Career Utility Tools (Memenuhi Janji Subtitel: Teknik Lolos CV ATS & Standar Gaji Industri) -->
    <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-[#d7d6cf]/70">
      <div class="flex items-center justify-between mb-4 sm:mb-6">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#1738D1]"></span>
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#101010]">Toolkit Karier &amp; Standar Gaji Industri</h3>
        </div>
        <span class="text-[11px] font-medium text-[#6e6d68]">Akses Gratis &amp; Tanpa Batas</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 items-stretch">
        <!-- Toolset Card 1: Cek Skor CV ATS -->
        <div class="group/cutout bg-white rounded-[20px] sm:rounded-[24px] border border-[#d7d6cf]/90 p-5 sm:p-7 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)] relative overflow-hidden flex flex-col justify-between" data-slot="cutout-card">
          <!-- Pin Badge (Top-Right) -->
          <div class="absolute top-0 right-0 bg-[#1738D1] text-white rounded-bl-[14px] px-3.5 h-[26px] flex items-center text-[10px] font-bold shadow-xs ring-1 ring-white/20 z-10" data-slot="cutout-card-pin">
            <span class="leading-none">Standar ATS</span>
            <CutoutCorner class="text-[#1738D1] absolute top-0 -left-[13px] -rotate-90 pointer-events-none" size={14} />
            <CutoutCorner class="text-[#1738D1] absolute right-0 -bottom-[13px] -rotate-90 pointer-events-none" size={14} />
          </div>

          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-[9px] font-extrabold uppercase tracking-wider bg-blue-50 text-[#1738D1] border border-blue-200">
                Evaluasi Berkas
              </span>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-[#101010] leading-snug mb-1.5 sm:mb-2">
              Cek Skor &amp; Kata Kunci CV ATS
            </h4>
            <p class="text-xs sm:text-sm text-[#6e6d68] leading-relaxed mb-4 sm:mb-6 font-medium">
              Analisis kecocokan susunan berkas resume kamu dengan sistem tracker lamaran kerja modern agar peluang lolos verifikasi rekruter meningkat.
            </p>
          </div>

          <a
            href="/career#cek-ats"
            class="w-full min-h-[44px] py-2.5 sm:py-3 px-4 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white text-xs font-bold text-center transition-all duration-300 flex items-center justify-center gap-2 shadow-md shadow-[#1738D1]/20 active:scale-[0.98]"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Cek Skor CV</span>
          </a>
        </div>

        <!-- Toolset Card 2: Kalkulator Gaji -->
        <div class="group/cutout bg-white rounded-[20px] sm:rounded-[24px] border border-[#d7d6cf]/90 p-5 sm:p-7 shadow-[0px_1px_2px_-1px_rgba(16,16,16,0.06),0px_4px_8px_-2px_rgba(16,16,16,0.04)] relative overflow-hidden flex flex-col justify-between" data-slot="cutout-card">
          <!-- Pin Badge (Top-Right) -->
          <div class="absolute top-0 right-0 bg-emerald-600 text-white rounded-bl-[14px] px-3.5 h-[26px] flex items-center text-[10px] font-bold shadow-xs ring-1 ring-white/20 z-10" data-slot="cutout-card-pin">
            <span class="leading-none">Standar UMR 2026</span>
            <CutoutCorner class="text-emerald-600 absolute top-0 -left-[13px] -rotate-90 pointer-events-none" size={14} />
            <CutoutCorner class="text-emerald-600 absolute right-0 -bottom-[13px] -rotate-90 pointer-events-none" size={14} />
          </div>

          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full text-[9px] font-extrabold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200">
                Standar Upah Riil
              </span>
            </div>
            <h4 class="text-base sm:text-lg font-bold text-[#101010] leading-snug mb-1.5 sm:mb-2">
              Kalkulator Gaji &amp; Take-Home Pay
            </h4>
            <p class="text-xs sm:text-sm text-[#55544f] leading-relaxed mb-4 sm:mb-6 font-medium">
              Hitung estimasi pendapatan bersih bulanan, rincian potongan BPJS Ketenagakerjaan, BPJS Kesehatan, dan PPh 21 secara transparan.
            </p>
          </div>

          <a
            href="/kalkulator-gaji"
            class="w-full min-h-[44px] py-2.5 sm:py-3 px-4 rounded-full bg-[#101010] hover:bg-black text-white text-xs font-bold text-center transition-all duration-300 flex items-center justify-center gap-2 shadow-xs active:scale-[0.98]"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span>Hitung Gaji</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Popular Topics & Tag Cloud Row -->
    <div class="mt-6 sm:mt-8 pt-5 sm:pt-6 border-t border-[#d7d6cf]/50 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#1738D1] flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
        </div>
        <div>
          <span class="text-xs font-bold text-[#101010] block">Tag &amp; Topik Populer</span>
          <span class="text-[11px] text-[#6e6d68]">Pilih tema sesuai tahapan persiapan kariermu</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-xs">
        {popularTags.map((tag) => (
          <a
            href={"/career?tag=" + encodeURIComponent(tag)}
            class="px-3.5 py-1.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-blue-50 hover:border-[#1738D1]/30 hover:text-[#1738D1] text-[#101010] text-[11px] font-semibold transition flex items-center gap-1"
          >
            <span>#{tag}</span>
          </a>
        ))}
        <a href="/career?q=interview" class="px-3.5 py-1.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-[#f4f3ee] text-[#101010] text-[11px] font-medium transition">
          Interview
        </a>
        <a href="/career?q=cv" class="px-3.5 py-1.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-[#f4f3ee] text-[#101010] text-[11px] font-medium transition">
          CV ATS
        </a>
        <a href="/career?q=gaji" class="px-3.5 py-1.5 rounded-full border border-[#d7d6cf] bg-white hover:bg-[#f4f3ee] text-[#101010] text-[11px] font-medium transition">
          Standar Gaji
        </a>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  // Client-side tab filter for editorial articles
  const tabBtns = document.querySelectorAll('.editorial-tab-btn');
  const articles = document.querySelectorAll('#articles-grid-container .article-item');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');
      
      tabBtns.forEach((b) => {
        b.classList.remove('bg-[#1738D1]', 'text-white');
        b.classList.add('bg-white', 'text-[#101010]', 'border', 'border-[#d7d6cf]');
      });
      btn.classList.remove('bg-white', 'text-[#101010]', 'border', 'border-[#d7d6cf]');
      btn.classList.add('bg-[#1738D1]', 'text-white');

      articles.forEach((art) => {
        const itemCat = art.getAttribute('data-category') || '';
        if (cat === 'all') {
          art.style.display = '';
        } else if (cat === 'tips' && (itemCat.includes('tip') || itemCat.includes('karier'))) {
          art.style.display = '';
        } else if (cat === 'cv' && (itemCat.includes('cv') || itemCat.includes('interview'))) {
          art.style.display = '';
        } else if (cat === 'kerja' && (itemCat.includes('kerja') || itemCat.includes('industri'))) {
          art.style.display = '';
        } else if (cat === 'gaji' && (itemCat.includes('gaji') || itemCat.includes('negosiasi'))) {
          art.style.display = '';
        } else {
          art.style.display = 'none';
        }
      });
    });
  });
</script>
