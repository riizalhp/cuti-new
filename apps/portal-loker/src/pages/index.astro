---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import StickyAnchorBar from '../components/StickyAnchorBar.astro';
import HeroPortal from '../components/HeroPortal.astro';
import LowonganTerbaruGrid from '../components/LowonganTerbaruGrid.astro';
import StatsTicker from '../components/StatsTicker.astro';
import SertifikatSection from '../components/SertifikatSection.astro';
import KursusSection from '../components/KursusSection.astro';
import EventPortalSection from '../components/EventPortalSection.astro';
import EditorialHubSection from '../components/EditorialHubSection.astro';
import FooterPortal from '../components/FooterPortal.astro';
import SearchModal from '../components/SearchModal.astro';
import { ensureData, sertifikasiList, courseList, eventList } from '../data/mock';

// Muat data DB (jobs, sertifikasi, course, event, artikel) sebelum render section
await ensureData();
---

<BaseLayout
  title="Employr: Portal Informasi Loker, Sertifikasi & Karier"
  description="Media informasi dan kurasi loker, sertifikasi resmi, kursus skill digital, event job fair, dan tips karier untuk generasi muda Indonesia."
  canonicalUrl="http://localhost:3003/"
>
  <!-- 1. Global Navbar (Logo Terpadu + Menu Ringkas + Akses B2B & Masuk) -->
  <Navbar />

  <!-- Sub-Navigasi Lengket & Floating Back to Top (Mengatasi Scroll Fatigue) -->
  <StickyAnchorBar />

  <main class="bg-[#f4f3ee] min-h-screen overflow-x-hidden">
    <!-- 2. Hero Section (Value Proposition + Bilah Pencarian Tunggal Terpadu) -->
    <HeroPortal />

    <!-- 3. Core Utility: Lowongan Terbaru (Penyelesaian Kebutuhan Instan + In-Feed Promoted Card) -->
    <LowonganTerbaruGrid />

    <!-- 4. Kredibilitas & Bukti Sosial (Metrik Angka: 10.000+ Lowongan, dll.) -->
    <StatsTicker />

    <!-- 5. Pengembangan Diri: Sertifikasi & Course (Upskilling Modular + Native Partner Placement) -->
    {sertifikasiList.length > 0 && <SertifikatSection />}
    {courseList.length > 0 && <KursusSection />}

    <!-- 6. Agenda & Bursa Kerja: Event (Kalender Interaktif & Pendaftaran - Bebas Duplikasi) -->
    {eventList.length > 0 && <EventPortalSection />}

    <!-- 7. Editorial Hub: Artikel & Tips (Konsolidasi Tabbed Hub Terpadu) -->
    <EditorialHubSection />
  </main>

  <!-- 8. Footer Bersih (Navigasi Fungsional & Legal Tanpa Duplikasi Identitas) -->
  <FooterPortal />

  <!-- Global Search Modal -->
  <SearchModal />
</BaseLayout>

