---
import { getGoogleAuthUrl } from '../utils/env';

const googleAuthUrl = getGoogleAuthUrl();
---

<div id="register-modal" class="login-modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="register-modal-title">
  <div class="login-modal-backdrop" data-close-register></div>
  <div class="login-modal-card register-modal-card">
    <button type="button" class="login-modal-close" aria-label="Tutup modal" data-close-register>
      &times;
    </button>
    
    <div class="login-modal-header">
      <div class="brand-mark-wrapper">
        <img src="/logo.webp" alt="Employr" width="150" height="41" class="modal-logo" />
      </div>
      <h2 id="register-modal-title" class="login-modal-title">Daftar Akun <em>Employr</em></h2>
      <p class="login-modal-subtitle">Bergabung sekarang untuk membuka akses seluruh fitur kariermu.</p>
    </div>

    <!-- Success state -->
    <div id="modal-register-success-state" class="modal-success-box" style="display: none;">
      <div class="modal-success-icon">✓</div>
      <h3>Pendaftaran Berhasil!</h3>
      <p id="modal-register-success-msg">Akun kamu siap digunakan.</p>
      <a href="http://localhost:3000/onboarding" class="button submit-login-btn mt-2" style="width: 100%; justify-content: center; text-decoration: none;">
        <span>Lanjut ke Onboarding</span>
        <span class="btn-arrow">↗</span>
      </a>
    </div>

    <!-- Register Form inside Modal -->
    <form id="modal-register-form" class="modal-register-form" action="javascript:void(0);" onsubmit="return false;">
      <div id="modal-reg-err" class="modal-err-box" style="display: none;"></div>

      <div class="input-group">
        <label for="modal-reg-name" class="input-label">Nama Lengkap</label>
        <input 
          type="text" 
          id="modal-reg-name" 
          name="name" 
          placeholder="contoh: Budi Pratama" 
          class="modal-input" 
          required 
        />
      </div>

      <div class="input-group">
        <label for="modal-reg-email" class="input-label">Email</label>
        <input 
          type="email" 
          id="modal-reg-email" 
          name="email" 
          placeholder="contoh: budi@gmail.com" 
          class="modal-input" 
          required 
        />
      </div>

      <div class="input-group">
        <label for="modal-reg-password" class="input-label">Kata Sandi</label>
        <input 
          type="password" 
          id="modal-reg-password" 
          name="password" 
          placeholder="Min. 6 karakter" 
          class="modal-input" 
          minlength="6"
          required 
        />
      </div>

      <button type="submit" class="button submit-login-btn">
        <span>Daftar Akun Baru</span>
        <span class="btn-arrow">↗</span>
      </button>
    </form>

    <div class="divider-text">atau daftar dengan</div>

    <div class="login-action-container">
      <a href={googleAuthUrl} class="button google-auth-btn">
        <div class="btn-left">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.15C3.26 21.37 7.37 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.24C.45 8.15 0 9.97 0 12s.45 3.85 1.24 5.42l4.04-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.37 0 3.26 2.63 1.24 6.58l4.04 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          <span>Daftar dengan Google</span>
        </div>
        <span class="btn-arrow">↗</span>
      </a>
    </div>

    <div class="login-modal-footer">
      <p>Sudah punya akun? <a href="#" class="text-button" data-open-login>Masuk di sini ↗</a></p>
    </div>
  </div>
</div>

<style>
  .login-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .login-modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .login-modal-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 65%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .register-modal-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 420px;
    padding: 36px 30px 28px;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    transform: rotate(1deg) scale(0.96);
    transition: transform 0.3s cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .login-modal-overlay.is-active .register-modal-card {
    transform: rotate(1deg) scale(1);
  }

  .login-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .login-modal-close:hover {
    background: var(--cobalt);
    color: var(--paper);
    transform: rotate(90deg);
  }

  .login-modal-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .brand-mark-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 10px;
  }

  .modal-logo {
    width: auto;
    height: 38px;
    display: block;
  }

  .login-modal-title {
    margin: 0;
    font-family: var(--sans);
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .login-modal-title em {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    color: var(--cobalt);
  }

  .login-modal-subtitle {
    margin: 8px 0 0;
    font-size: 13px;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
    line-height: 1.4;
  }

  .modal-register-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 10px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .input-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .modal-input {
    width: 100%;
    height: 46px;
    padding: 0 16px;
    background: #ffffff;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .modal-input::placeholder {
    color: color-mix(in srgb, var(--ink) 45%, transparent);
    font-size: 13px;
  }

  .modal-input:focus {
    border-color: var(--cobalt);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .submit-login-btn {
    min-height: 48px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    color: #ffffff;
    background: var(--ink);
    font-family: var(--sans);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    margin-top: 2px;
    transition: transform 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .submit-login-btn:hover {
    transform: translateY(-2px);
    background: var(--cobalt);
    border-color: var(--cobalt);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .divider-text {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: color-mix(in srgb, var(--ink) 50%, transparent);
    margin: 10px 0 12px;
    position: relative;
  }

  .divider-text::before,
  .divider-text::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 28%;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .divider-text::before {
    left: 0;
  }

  .divider-text::after {
    right: 0;
  }

  .login-action-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 6px;
  }

  .google-auth-btn {
    min-height: 48px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    border: 1px solid var(--cobalt);
    border-radius: 999px;
    color: var(--paper);
    background: var(--cobalt);
    font-family: var(--sans);
    font-weight: 600;
    font-size: 14px;
    transition: transform 0.25s, color 0.25s, background 0.25s, box-shadow 0.25s;
  }

  .google-auth-btn:hover {
    transform: translateY(-2px);
    color: var(--cobalt);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .btn-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-left svg {
    background: #ffffff;
    border-radius: 50%;
    padding: 2.5px;
    box-sizing: content-box;
  }

  .btn-arrow {
    font-size: 18px;
    line-height: 1;
  }

  .modal-err-box {
    padding: 8px 12px;
    border-radius: 8px;
    background: #FEE2E2;
    border: 1.5px solid #EF4444;
    color: #991B1B;
    font-size: 12px;
    font-weight: 600;
  }

  .modal-success-box {
    padding: 20px 16px;
    background: #ECFDF5;
    border: 1.5px solid #10B981;
    border-radius: 10px;
    text-align: center;
    margin-bottom: 14px;
  }

  .modal-success-icon {
    width: 36px;
    height: 36px;
    margin: 0 auto 8px;
    background: #10B981;
    color: #ffffff;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 18px;
    font-weight: bold;
  }

  .modal-success-box h3 {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 700;
    color: #065F46;
  }

  .modal-success-box p {
    margin: 0 0 12px;
    font-size: 13px;
    color: #047857;
  }

  .login-modal-footer {
    margin-top: 18px;
    text-align: center;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .login-modal-footer p {
    margin: 0;
    font-size: 12.5px;
    color: color-mix(in srgb, var(--ink) 75%, transparent);
  }

  .text-button {
    background: transparent;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--cobalt);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .text-button:hover {
    color: var(--ink);
  }
</style>
