---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import FooterPortal from '../../components/FooterPortal.astro';
import AdSlot from '../../components/AdSlot.astro';
import SearchModal from '../../components/SearchModal.astro';
import DetailCrossSections from '../../components/DetailCrossSections.astro';
import { getPortalArticleBySlug } from '../../lib/data';
import { CV_BUILDER_URL } from '../../lib/urls';

const requestedSlug = Astro.params.slug || '';
const artikel = await getPortalArticleBySlug(requestedSlug);
if (!artikel) {
  return Astro.redirect('/career');
}
if (requestedSlug !== artikel.slug) {
  return Astro.redirect(`/career/${artikel.slug}`, 301);
}
const siteOrigin = Astro.url.origin || 'http://localhost:3003';
const canonical = `${siteOrigin}/career/${artikel.slug}`;
const title = `${artikel.title} | Tips Karier Employr`;
const description = artikel.excerpt;
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} ogImage={artikel.image} ogType="article">
  <Navbar />

  <main class="bg-[#f4f3ee] min-h-screen pb-20">
    <!-- Breadcrumbs Navigation -->
    <div class="bg-white border-b border-[#d7d6cf]">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 py-3.5 sm:py-4">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#6e6d68] flex-wrap">
          <a href="/" class="hover:text-[#1738D1] py-1 transition">Beranda</a>
          <span>/</span>
          <a href="/career" class="hover:text-[#1738D1] py-1 transition">Artikel & Tips Karier</a>
          <span>/</span>
          <span class="text-[#6e6d68] font-medium">{artikel.category}</span>
          <span>/</span>
          <span class="text-[#101010] font-semibold truncate max-w-[140px] sm:max-w-xs" aria-current="page">{artikel.title}</span>
        </nav>
      </div>
    </div>

    <!-- Article Hero Header -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-5 sm:pt-6">
      <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 sm:p-8 lg:p-10 shadow-xs">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 flex-wrap mb-3 text-xs text-[#6e6d68]">
            <span class="px-3 py-1 rounded-full bg-rose-50 border border-rose-200 text-rose-700 font-semibold text-xs">
              {artikel.category}
            </span>
            <span>•</span>
            <span>{artikel.date}</span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Waktu baca: {artikel.readTime}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-[#101010] tracking-tight leading-tight mb-4 break-words">
            {artikel.title}
          </h1>

          <p class="text-sm sm:text-base text-[#6e6d68] leading-relaxed font-normal mb-6">
            {artikel.excerpt}
          </p>

          <!-- Author Info & Actions -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-[#d7d6cf]/50">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] flex items-center justify-center font-bold text-sm text-[#1738D1] shrink-0">
                {artikel.author ? artikel.author.slice(0, 2).toUpperCase() : 'EJ'}
              </div>
              <div>
                <strong class="text-sm font-semibold text-[#101010] block">{artikel.author}</strong>
                <span class="text-xs text-[#6e6d68]">{artikel.authorRole || 'Tim Redaksi Karier'}</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-share-career"
                class="flex-1 sm:flex-initial min-h-[44px] px-4 py-2.5 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer active:scale-[0.98]"
              >
                <svg class="w-4 h-4 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
                <span>Bagikan</span>
              </button>
              <button
                type="button"
                id="btn-bookmark-career"
                class="flex-1 sm:flex-initial min-h-[44px] px-4 py-2.5 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer active:scale-[0.98]"
              >
                <svg class="w-4 h-4 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                <span>Simpan</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Article Featured Image -->
        {artikel.image && (
          <div class="mt-8 rounded-2xl overflow-hidden border border-[#d7d6cf] max-h-[420px] bg-[#f4f3ee]">
            <img src={artikel.image} alt={artikel.title} class="w-full h-full object-cover" />
          </div>
        )}
      </div>
    </div>

    <!-- Main Content Layout (Left Content + Right Sidebar) -->
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 pt-6 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Article Content -->
        <div class="lg:col-span-8 space-y-6">
          <article class="bg-white rounded-2xl border border-[#d7d6cf] p-5 sm:p-8 lg:p-10 space-y-6">
            <!-- Article Body Content -->
            <div class="article-body-content pt-2">
              <div
                class="prose prose-slate max-w-none text-[#101010] text-sm sm:text-base leading-relaxed font-normal space-y-4 [&>h2]:text-xl [&>h2]:font-bold [&>h2]:text-[#101010] [&>h2]:mt-7 [&>h2]:mb-3 [&>h3]:text-lg [&>h3]:font-bold [&>h3]:text-[#101010] [&>h3]:mt-6 [&>h3]:mb-2 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:my-3 [&>ul]:space-y-1.5 [&>ol]:list-decimal [&>ol]:pl-5 [&>ol]:my-3 [&>ol]:space-y-1.5 [&>li]:text-[#101010] [&>p]:leading-relaxed [&>p]:mb-4 [&>a]:text-[#1738D1] [&>a]:underline [&>a]:font-semibold hover:[&>a]:text-[#132EA8] [&>strong]:font-semibold [&>strong]:text-[#101010]"
                set:html={artikel.contentHtml}
              />
            </div>

            <!-- Key Takeaway Box -->
            <div class="p-5 rounded-2xl bg-[#f4f3ee] border-l-4 border-[#1738D1] text-[#101010] mt-6">
              <span class="text-xs font-bold text-[#1738D1] uppercase tracking-wider block mb-1">
                Poin Kunci Karier
              </span>
              <p class="text-xs sm:text-sm leading-relaxed text-[#101010]">
                {artikel.excerpt || "Kuasai informasi dan kualifikasi yang relevan untuk meningkatkan peluang lolos seleksi dan mempercepat perkembangan karier kamu."}
              </p>
            </div>

            <!-- In-Article Google Ads Space -->
            <AdSlot type="infeed" note="Rekomendasi materi pelatihan dan lowongan kerja terbaru." />

            <div id="bagian-3" class="pt-6 border-t border-[#d7d6cf]/50">
              <div class="p-6 sm:p-8 rounded-2xl bg-[#101010] text-white flex flex-col sm:flex-row sm:items-center justify-between gap-5 border border-[#101010]">
                <div>
                  <div class="section-label section-label--inverse mb-2">
                    <i></i>
                    Employr Career Builder
                  </div>
                  <h4 class="text-base sm:text-lg font-semibold leading-snug">
                    Siapkan CV Standar ATS Kamu dalam Hitungan Menit
                  </h4>
                  <p class="text-xs text-[#d7d6cf] mt-1 max-w-md">
                    Gunakan template CV profesional yang telah disesuaikan dengan sistem rekrutmen perusahaan di Indonesia.
                  </p>
                </div>
                <a
                  href={CV_BUILDER_URL}
                  class="min-h-[44px] px-6 py-2.5 rounded-full bg-orange-500 hover:bg-orange-600 text-white font-semibold text-xs shrink-0 flex items-center justify-center transition shadow-md shadow-orange-500/20"
                >
                  Buat CV Saya
                </a>
              </div>
            </div>

            <!-- Tags -->
            {artikel.tags && artikel.tags.length > 0 && (
              <div class="flex items-center gap-2 flex-wrap pt-4 border-t border-[#d7d6cf]/50">
                <span class="text-xs text-[#6e6d68] font-medium">Topik Terkait:</span>
                {artikel.tags.map((t) => (
                  <span class="text-xs px-3 py-1 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#101010] font-medium">
                    #{t}
                  </span>
                ))}
              </div>
            )}
          </article>
        </div>

        <!-- Right: Sidebar Information & Ads -->
        <aside class="lg:col-span-4 space-y-6">
          <!-- Author Card -->
          <div class="bg-white rounded-2xl border border-[#d7d6cf] p-5 shadow-xs">
            <h3 class="text-sm font-semibold text-[#101010] mb-4 pb-2 border-b border-[#d7d6cf]/50">
              Tentang Penulis
            </h3>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-12 h-12 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] flex items-center justify-center font-bold text-base text-[#1738D1] shrink-0">
                {artikel.author ? artikel.author.slice(0, 2).toUpperCase() : 'EJ'}
              </div>
              <div>
                <strong class="text-sm font-semibold text-[#101010] block">{artikel.author}</strong>
                <span class="text-xs text-[#6e6d68]">{artikel.authorRole || 'Editor Tim Karier'}</span>
              </div>
            </div>
            <p class="text-xs text-[#6e6d68] leading-relaxed">
              Tim kurasi karier Employr yang mendedikasikan waktu untuk meneliti tren rekrutmen dan tips praktis bagi generasi muda Indonesia.
            </p>
          </div>

          <!-- Career Quick Advice -->
          <div class="bg-[#f4f3ee] rounded-2xl border border-[#d7d6cf] p-5">
            <h4 class="text-xs font-bold text-[#101010] uppercase tracking-wider mb-2">
              Kiat Cepat Karier
            </h4>
            <p class="text-xs text-[#6e6d68] leading-relaxed">
              Kirimkan lamaran kerja di jam kerja produktif (pukul 08.00 hingga 11.00 pagi) untuk meningkatkan peluang resume kamu langsung dilihat oleh tim rekruter.
            </p>
          </div>

          <!-- Google Ads: High-Viewability Sticky Sidebar Unit (300x600) -->
          <div class="sticky top-24">
            <AdSlot type="skyscraper" note="Jangkau ribuan pembaca aktif tips karier." />
          </div>
        </aside>
      </div>

      <!-- Google Ads: Leaderboard horizontal sebelum rekomendasi -->
      <AdSlot type="leaderboard" note="Rekomendasi peluang karier dan panduan lanjutan." />

      <!-- 5 Cross-Section Modules (Rekomendasi Lainnya) -->
      <DetailCrossSections
        currentType="career"
        currentSlug={artikel.slug}
        category={artikel.category}
      />
    </div>
  </main>

  <!-- Non-blocking Native Toast for feedback -->
  <div id="detail-toast" role="status" aria-live="polite" class="fixed bottom-6 right-6 z-50 pointer-events-none opacity-0 translate-y-3 transition-all duration-300 ease-out bg-[#101010] text-white text-xs font-medium px-4 py-2.5 rounded-xl shadow-lg border border-white/10 flex items-center gap-2 max-w-sm">
    <span class="w-2 h-2 rounded-full bg-[#1738D1] shrink-0"></span>
    <span id="detail-toast-text">Tautan artikel berhasil disalin.</span>
  </div>

  <FooterPortal />
  <SearchModal />

  <!-- Script for Toast Feedback -->
  <script is:inline>
    function triggerToast(text) {
      const toast = document.getElementById('detail-toast');
      const toastText = document.getElementById('detail-toast-text');
      if (!toast || !toastText) return;
      toastText.textContent = text;
      toast.classList.remove('opacity-0', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-3');
      }, 3000);
    }

    const shareBtn = document.getElementById('btn-share-career');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } catch (err) {}
        } else {
          navigator.clipboard.writeText(window.location.href);
          triggerToast('Tautan artikel berhasil disalin ke clipboard.');
        }
      });
    }

    const bookmarkBtn = document.getElementById('btn-bookmark-career');
    if (bookmarkBtn) {
      bookmarkBtn.addEventListener('click', () => {
        triggerToast('Artikel telah disimpan ke daftar bacaan kamu.');
      });
    }
  </script>

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BlogPosting",
        "headline": artikel.title,
        "description": artikel.excerpt,
        "image": artikel.image.startsWith('http') ? artikel.image : `${siteOrigin}${artikel.image}`,
        "datePublished": artikel.publishedAtIso,
        "dateModified": artikel.publishedAtIso,
        "author": {
          "@type": "Person",
          "name": artikel.author
        },
        "publisher": {
          "@type": "Organization",
          "name": "Employr",
          "logo": {
            "@type": "ImageObject",
            "url": `${siteOrigin}/employer-job.svg`
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonical
        },
        "url": canonical
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${siteOrigin}/` },
          { "@type": "ListItem", "position": 2, "name": "Tips Karier", "item": `${siteOrigin}/career` },
          { "@type": "ListItem", "position": 3, "name": artikel.title, "item": canonical }
        ]
      }
    ]
  })} />
</BaseLayout>
