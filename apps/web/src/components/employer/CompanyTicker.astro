        <path d="M6 8H20L16 32H6V8Z" fill="#E30613"/>
        <text x="40" y="27" font-family="'DM Sans', 'Inter', sans-serif" font-size="18.5" font-weight="900" font-style="italic" fill="#005BAC" letter-spacing="-0.02em">Indofood</text>
      </g>
    </svg>`,
  },
  {
    name: 'Bukalapak',
    svg: `<svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="company-logo-svg">
      <g>
        <rect x="6" y="7" width="24" height="26" rx="5" fill="#E31F52"/>
        <text x="12" y="25" font-family="'DM Sans', 'Inter', sans-serif" font-size="17" font-weight="900" fill="#FFFFFF">b</text>
        <text x="36" y="26.5" font-family="'DM Sans', 'Inter', sans-serif" font-size="18" font-weight="800" fill="#E31F52" letter-spacing="-0.04em">bukalapak</text>
      </g>
    </svg>`,
  },
];
interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
---

<section class:list={['company-ticker', `company-ticker--${variant}`]} aria-label="Perusahaan tempat pengguna menyiapkan langkah karier berikutnya">
  <div class="editorial-frame company-ticker__header">
    <div class="company-ticker__title-wrapper">
      <span class="company-ticker__dot"></span>
      <p class="company-ticker__title">Dipakai untuk menyiapkan langkah berikutnya di</p>
      <span class="company-ticker__dot"></span>
    </div>
  </div>

  <div class="company-ticker__slider" tabindex="0" role="region" aria-label="Daftar logo perusahaan">
    <div class="company-ticker__track">
      <!-- Set 1 (Original) -->
      {companies.map((company) => (
        <div class="company-ticker__item" title={company.name} aria-label={company.name}>
          {company.src ? (
            <img src={company.src} alt={company.name} class="company-logo-img" />
          ) : (
            <Fragment set:html={company.svg} />
          )}
        </div>
      ))}
      <!-- Set 2 (Duplicate for smooth infinite seamless loop) -->
      {companies.map((company) => (
        <div class="company-ticker__item" title={company.name} aria-label={company.name} aria-hidden="true">
          {company.src ? (
            <img src={company.src} alt={company.name} class="company-logo-img" />
          ) : (
            <Fragment set:html={company.svg} />
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .company-ticker {
    padding: 24px 0 28px;
    position: relative;
    overflow: hidden;
    width: 100%;
    z-index: 5;
  }

  /* DARK VARIANT (Untuk di dalam Hero Card / background gelap) */
  .company-ticker--dark {
    background: rgba(12, 12, 14, 0.58);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .company-ticker--dark .company-ticker__title {
    color: rgba(255, 255, 255, 0.72);
  }

  .company-ticker--dark .company-ticker__dot {
    background: #5078ff;
    box-shadow: 0 0 8px rgba(80, 120, 255, 0.6);
  }

  .company-ticker--dark .company-ticker__item :global(svg) {
    filter: brightness(0) invert(1) opacity(0.48);
  }

  .company-ticker--dark .company-ticker__item:hover {
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .company-ticker--dark .company-ticker__item:hover :global(svg) {
    filter: none;
    opacity: 1;
  }

  /* LIGHT VARIANT (Untuk di background paper terang) */
  .company-ticker--light {
    background: var(--paper, #f4f3ee);
    padding: 32px 0 48px;
  }

  .company-ticker--light .company-ticker__title {
    color: #6b6a65;
  }

  .company-ticker--light .company-ticker__dot {
    background: var(--blue, #0000ff);
    opacity: 0.75;
  }

  .company-ticker--light .company-ticker__item :global(svg) {
    filter: grayscale(100%) contrast(0.85);
    opacity: 0.46;
  }

  .company-ticker--light .company-ticker__item:hover {
    background: rgba(255, 255, 255, 0.65);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .company-ticker--light .company-ticker__item:hover :global(svg) {
    filter: grayscale(0%) contrast(1);
    opacity: 1;
  }

  .company-ticker__header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
    text-align: center;
  }

  .company-ticker__title-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .company-ticker__dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 999px;
  }

  .company-ticker__title {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
  }

  .company-ticker__slider {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 6px 0;
    /* Efek fade transparan di sisi kiri & kanan */
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.8) 4%,
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0.8) 96%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.8) 4%,
      #000 12%,
      #000 88%,
      rgba(0, 0, 0, 0.8) 96%,
      transparent 100%
    );
  }

  .company-ticker__track {
    display: flex;
    align-items: center;
    gap: 48px;
    width: max-content;
    will-change: transform;
    animation: ticker-slide 34s linear infinite;
  }

  /* Saat kursor diarahkan ke slider, slider berhenti agar nyaman dilihat */
  .company-ticker__slider:hover .company-ticker__track {
    animation-play-state: paused;
  }

  .company-ticker__item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 40px;
    padding: 6px 12px;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    user-select: none;
    flex-shrink: 0;
    transition: transform 0.28s cubic-bezier(0.23, 1, 0.32, 1),
                background-color 0.28s ease;
  }

  /* Default: grayscale dan opacity lembut dengan aspect ratio standar 4:1 */
  .company-ticker__item :global(svg),
  .company-ticker__item :global(img) {
    display: block;
    max-height: 28px;
    max-width: 124px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(100%) contrast(0.85);
    opacity: 0.46;
    transition: filter 0.32s cubic-bezier(0.23, 1, 0.32, 1),
                opacity 0.32s cubic-bezier(0.23, 1, 0.32, 1),
                transform 0.32s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Saat kursor diarahkan (hover): kembali ke warna asli dan sedikit membesar */
  .company-ticker__item:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.65);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .company-ticker__item:hover :global(svg),
  .company-ticker__item:hover :global(img) {
    filter: grayscale(0%) contrast(1);
    opacity: 1;
    transform: scale(1.05);
  }

  @keyframes ticker-slide {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Bergerak tepat setengah panjang track (set 1) lalu loop tanpa jeda */
      transform: translateX(calc(-50% - 24px));
    }
  }

  @media (max-width: 700px) {
    .company-ticker {
      padding: 20px 0 48px;
    }
    .company-ticker__header {
      margin-bottom: 22px;
    }
    .company-ticker__title {
      font-size: 10px;
      letter-spacing: 0.1em;
    }
    .company-ticker__track {
      gap: 28px;
      animation-duration: 26s;
    }
    .company-ticker__item {
      padding: 6px 10px;
    }
    .company-ticker__item :global(svg) {
      max-height: 22px;
    }
    @keyframes ticker-slide {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-50% - 14px));
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-ticker__track {
      animation: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .company-ticker__item {
      scroll-snap-align: center;
    }
  }
</style>
