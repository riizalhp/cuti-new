  (function() {
    const tabs = document.querySelectorAll('.hero-tab-pill');
    const input = document.getElementById('hero-search-input');
    const searchBtn = document.getElementById('hero-search-btn');
    let currentTarget = '/lowongan';

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bg-[#101010]', 'text-white');
          t.classList.add('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        });
        tab.classList.remove('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        tab.classList.add('bg-[#101010]', 'text-white');

        const placeholder = tab.getAttribute('data-placeholder');
        if (input && placeholder) input.placeholder = placeholder;
        currentTarget = tab.getAttribute('data-target') || '/lowongan';

        const cat = tab.getAttribute('data-cat');
        if (searchBtn) {
          if (cat === 'career') searchBtn.textContent = 'Cari Artikel';
          else if (cat === 'sertifikasi') searchBtn.textContent = 'Cari Sertifikasi';
          else if (cat === 'course') searchBtn.textContent = 'Cari Pelatihan';
          else if (cat === 'event') searchBtn.textContent = 'Cari Event';
          else searchBtn.textContent = 'Cari Lowongan';
        }
      });
    });

    function executeSearch() {
      const q = input?.value?.trim() || '';
      const dest = currentTarget || '/lowongan';
      window.location.href = `${dest}${q ? '?q=' + encodeURIComponent(q) : ''}`;
    }

    searchBtn?.addEventListener('click', executeSearch);

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        executeSearch();
      }
    });
  })();
