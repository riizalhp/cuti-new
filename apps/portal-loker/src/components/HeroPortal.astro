---
// HeroPortal.astro - Hero Section Career Information Portal (Pixel-Matched to Reference 1)
---

<section class="relative bg-[#f4f3ee] pt-8 sm:pt-12 lg:pt-14 pb-14 sm:pb-20 overflow-hidden border-b border-[#d7d6cf]/80">
  <!-- Background Image & Washes -->
  <div class="absolute inset-0 z-0 pointer-events-none select-none">
    <img
      src="/images/hero-job.webp"
      alt="Portal Lowongan Kerja dan Karier"
      class="w-full h-full object-cover object-[80%_center] lg:object-right"
      loading="eager"
    />
    <!-- Gradient Overlays: Blends smoothly into warm paper #f4f3ee -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#f4f3ee] via-[#f4f3ee]/95 to-transparent w-full lg:w-3/5"></div>
    <div class="absolute inset-0 bg-[#f4f3ee]/80 sm:bg-transparent"></div>
  </div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start min-h-[400px] lg:min-h-[460px]">
      
      <!-- Left Column: Copy & Search -->
      <div class="lg:col-span-7 flex flex-col items-start pt-2 sm:pt-4">
        <!-- Kicker Badge with Signature Section Label -->
        <div class="section-label mb-3">
          <span>PORTAL INFORMASI KARIER</span>
          <i></i>
        </div>

        <!-- H1 Headline with Instrument Serif Italic Accent -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-[#101010] tracking-tight leading-[1.08] mb-4">
          Semua peluang kariermu,<br class="hidden sm:inline" />
          <em>di satu tempat terpadu.</em>
        </h1>

        <!-- Subtitle -->
        <p class="text-xs sm:text-sm md:text-base text-[#6e6d68] leading-relaxed max-w-xl mb-6 font-medium">
          Kurasi lowongan kerja resmi, beasiswa sertifikasi, pelatihan keterampilan digital, dan agenda event karier terpercaya di seluruh Indonesia.
        </p>

        <!-- Category Selector Pills (Menyelesaikan Ambigu Omnisearch) -->
        <div class="flex items-center gap-1.5 sm:gap-2 mb-3 flex-wrap text-xs" id="hero-category-tabs">
          <button
            type="button"
            class="hero-tab-pill px-3.5 py-1.5 rounded-full font-bold text-xs bg-[#101010] text-white shadow-xs transition-all cursor-pointer"
            data-cat="all"
            data-placeholder="Cari lowongan, artikel, sertifikasi, course, atau event..."
          >
            Semua Peluang
          </button>
          <button
            type="button"
            class="hero-tab-pill px-3.5 py-1.5 rounded-full font-bold text-xs bg-white hover:border-[#101010] border border-[#d7d6cf] text-[#6e6d68] hover:text-[#101010] transition-all cursor-pointer shadow-xs"
            data-cat="lowongan"
            data-target="/lowongan"
            data-placeholder="Cari posisi kerja (Admin, IT, Marketing, BUMN)..."
          >
            Lowongan Kerja
          </button>
          <button
            type="button"
            class="hero-tab-pill px-3.5 py-1.5 rounded-full font-bold text-xs bg-white hover:border-[#101010] border border-[#d7d6cf] text-[#6e6d68] hover:text-[#101010] transition-all cursor-pointer shadow-xs"
            data-cat="sertifikasi"
            data-target="/sertifikasi"
            data-placeholder="Cari skema sertifikasi resmi (BNSP, Google, AWS)..."
          >
            Sertifikasi Resmi
          </button>
          <button
            type="button"
            class="hero-tab-pill px-3.5 py-1.5 rounded-full font-bold text-xs bg-white hover:border-[#101010] border border-[#d7d6cf] text-[#6e6d68] hover:text-[#101010] transition-all cursor-pointer shadow-xs"
            data-cat="course"
            data-target="/course"
            data-placeholder="Cari kursus skill digital (UI/UX, Data, Python)..."
          >
            Pelatihan Skill
          </button>
          <button
            type="button"
            class="hero-tab-pill px-3.5 py-1.5 rounded-full font-bold text-xs bg-white hover:border-[#101010] border border-[#d7d6cf] text-[#6e6d68] hover:text-[#101010] transition-all cursor-pointer shadow-xs"
            data-cat="event"
            data-target="/event"
            data-placeholder="Cari job fair, webinar karier, walk-in interview..."
          >
            Agenda Event
          </button>
        </div>

        <!-- Big Search Bar (Pill Shape) -->
        <div class="w-full max-w-xl bg-white border border-[#d7d6cf] focus-within:border-[#0000ff] focus-within:ring-4 focus-within:ring-blue-500/10 rounded-full shadow-[0_4px_20px_-2px_rgba(16,16,16,0.06)] p-1.5 pl-4 flex items-center gap-2 transition-all mb-5">
          <div class="text-[#6e6d68] shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="hero-search-input"
            placeholder="Cari lowongan, artikel, sertifikasi, course, atau event..."
            class="flex-1 text-xs sm:text-sm text-[#101010] placeholder-[#a5a5a1] outline-none bg-transparent font-medium"
          />
          <button
            type="button"
            id="hero-search-btn"
            class="px-5 sm:px-6 py-2.5 rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white font-bold text-xs sm:text-sm shadow-[0_4px_14px_rgba(23,56,209,0.25)] transition-all hover:-translate-y-0.5 active:translate-y-0 cursor-pointer shrink-0"
          >
            Temukan Peluang →
          </button>
        </div>

        <!-- Popular Tags Row with Uniform Capsule Chips -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs">
          <span class="font-bold text-[#101010] mr-1 text-xs">Populer:</span>
          <a href="/lowongan?loc=jakarta" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Jakarta
          </a>
          <a href="/lowongan?type=remote" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Remote
          </a>
          <a href="/lowongan?exp=fresh" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Fresh Graduate
          </a>
          <a href="/lowongan?type=magang" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Magang
          </a>
          <a href="/job-fair" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Job Fair
          </a>
          <a href="/sertifikat?q=google" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Sertifikasi Google
          </a>
          <a href="/kursus?price=gratis" class="px-3.5 py-1 bg-white hover:border-[#101010] border border-[#d7d6cf] rounded-full font-bold text-xs text-[#6e6d68] hover:text-[#101010] transition shadow-xs">
            Course Gratis
          </a>
        </div>
      </div>

      <!-- Right Column: Natural Open Space for Hero Background Character -->
      <div class="hidden lg:flex lg:col-span-5 relative h-full min-h-[360px] items-start justify-start pointer-events-none">
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.hero-tab-pill');
    const input = document.getElementById('hero-search-input');
    const searchBtn = document.getElementById('hero-search-btn');
    let currentTarget = null;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('bg-[#101010]', 'text-white');
          t.classList.add('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        });
        tab.classList.remove('bg-white', 'text-[#6e6d68]', 'border-[#d7d6cf]');
        tab.classList.add('bg-[#101010]', 'text-white');

        const placeholder = tab.getAttribute('data-placeholder');
        if (input && placeholder) input.placeholder = placeholder;
        currentTarget = tab.getAttribute('data-target');
      });
    });

    function executeSearch() {
      const q = input?.value?.trim() || '';
      if (currentTarget) {
        window.location.href = `${currentTarget}${q ? '?q=' + encodeURIComponent(q) : ''}`;
      } else {
        const modal = document.getElementById('global-search-modal');
        const modalInput = document.getElementById('modal-search-input');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          if (modalInput) {
            modalInput.value = q;
            modalInput.focus();
          }
        }
      }
    }

    searchBtn?.addEventListener('click', (e) => {
      if (currentTarget) {
        e.stopImmediatePropagation();
        executeSearch();
      }
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && currentTarget) {
        e.stopImmediatePropagation();
        executeSearch();
      }
    });
  })();
</script>
