      (function() {
        var VISITOR_KEY = 'employr_visitor_id';
        var LEGACY_VISITOR_KEY = 'cuti_visitor_id';
        var SESSION_KEY = 'employr_session_id';
        var LEGACY_SESSION_KEY = 'cuti_session_id';
        var LAST_ACTIVE_KEY = 'employr_session_last_active';
        var TIMEOUT = 30 * 60 * 1000;

        function getCookie(name) {
          var m = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return m ? decodeURIComponent(m[2]) : null;
        }
        function setCookie(name, val, days) {
          var exp = new Date(Date.now() + (days || 365) * 864e5).toUTCString();
          document.cookie = name + '=' + encodeURIComponent(val) + '; expires=' + exp + '; path=/; SameSite=Lax';
        }

        var visId = localStorage.getItem(VISITOR_KEY) || getCookie(VISITOR_KEY) || localStorage.getItem(LEGACY_VISITOR_KEY) || getCookie(LEGACY_VISITOR_KEY);
        if (!visId) {
          visId = 'vis_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9);
        }
        localStorage.setItem(VISITOR_KEY, visId);
        setCookie(VISITOR_KEY, visId, 365);

        var now = Date.now();
        var lastActive = sessionStorage.getItem(LAST_ACTIVE_KEY) || sessionStorage.getItem('cuti_session_last_active');
        var sessId = sessionStorage.getItem(SESSION_KEY) || sessionStorage.getItem(LEGACY_SESSION_KEY);
        if (!sessId || !lastActive || (now - parseInt(lastActive, 10)) > TIMEOUT) {
          sessId = 'sess_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 9);
          sessionStorage.setItem(SESSION_KEY, sessId);
        }
        sessionStorage.setItem(LAST_ACTIVE_KEY, now.toString());

        var ua = navigator.userAgent;
        var device_type = 'Desktop';
        if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) device_type = 'Tablet';
        else if (/Mobile|Android|iP(hone|od)|IEMobile|BlackBerry/i.test(ua)) device_type = 'Mobile';

        var os = 'Unknown OS';
        if (/Windows/i.test(ua)) os = 'Windows';
        else if (/Macintosh|Mac OS X/i.test(ua)) os = 'macOS';
        else if (/iPhone|iPad|iPod/i.test(ua)) os = 'iOS';
        else if (/Android/i.test(ua)) os = 'Android';
        else if (/Linux/i.test(ua)) os = 'Linux';

        var browser = 'Browser';
        var browser_version = '';
        if (/Edg\/([0-9.]+)/i.test(ua)) { browser = 'Edge'; browser_version = RegExp.$1; }
        else if (/Chrome\/([0-9.]+)/i.test(ua)) { browser = 'Chrome'; browser_version = RegExp.$1; }
        else if (/Safari\/([0-9.]+)/i.test(ua) && !/Chrome/i.test(ua)) { browser = 'Safari'; browser_version = RegExp.$1; }
        else if (/Firefox\/([0-9.]+)/i.test(ua)) { browser = 'Firefox'; browser_version = RegExp.$1; }

        var ref = document.referrer || '';
        var params = new URLSearchParams(window.location.search);
        var utm_source = params.get('utm_source') || undefined;
        var utm_medium = params.get('utm_medium') || undefined;
        var utm_campaign = params.get('utm_campaign') || undefined;

        var source = 'Direct';
        if (utm_source) {
          source = 'Campaign (' + utm_source + (utm_medium ? ' / ' + utm_medium : '') + ')';
        } else if (ref) {
          try {
            var refHost = new URL(ref).hostname.toLowerCase();
            var currHost = window.location.hostname.toLowerCase();
            if (refHost === currHost || refHost.endsWith('.' + currHost) || (currHost.includes('employr.id') && refHost.includes('employr.id'))) {
              source = 'Internal Navigation';
            } else if (refHost.includes('google.')) {
              source = 'Google Organic';
            } else if (refHost.includes('bing.') || refHost.includes('yahoo.') || refHost.includes('duckduckgo.') || refHost.includes('ecosia.')) {
              source = 'Search Engine';
            } else if (refHost.includes('instagram.com') || refHost.includes('l.instagram.com')) {
              source = 'Instagram';
            } else if (refHost.includes('tiktok.com')) {
              source = 'TikTok';
            } else if (refHost.includes('threads.net')) {
              source = 'Threads';
            } else if (refHost.includes('facebook.com') || refHost.includes('fb.com')) {
              source = 'Facebook';
            } else if (refHost.includes('twitter.com') || refHost.includes('t.co') || refHost.includes('x.com')) {
              source = 'Twitter / X';
            } else if (refHost.includes('linkedin.com') || refHost.includes('lnkd.in')) {
              source = 'LinkedIn';
            } else if (refHost.includes('whatsapp.com') || refHost.includes('wa.me')) {
              source = 'WhatsApp';
            } else if (refHost.includes('youtube.com') || refHost.includes('youtu.be')) {
              source = 'YouTube';
            } else if (refHost.includes('telegram.org') || refHost.includes('t.me')) {
              source = 'Telegram';
            } else {
              source = 'Referral (' + refHost.replace(/^www\./, '') + ')';
            }
          } catch(e) {
            source = 'Referral (External)';
          }
        }

        var isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1' || /^(\d{1,3}\.){3}\d{1,3}$/.test(window.location.hostname);
        var trackEndpoint = isDev
          ? window.location.protocol + '//' + window.location.hostname + ':3002/api/track'
          : 'https://admin-employr-rahasia.employr.id/api/track';

        function send(action, dur) {
          var payload = {
            action: action,
            visitor_id: visId,
            session_id: sessId,
            url: window.location.href,
            path: window.location.pathname,
            title: document.title || 'Portal Loker Employr',
