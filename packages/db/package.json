{
  "name": "@cuti/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./src/logger.ts",
      "default": "./src/logger.ts"
    },
    "./api-logger": {
      "types": "./src/api-logger.ts",
      "import": "./src/api-logger.ts",
      "default": "./src/api-logger.ts"
    }
  },
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:templates": "ts-node prisma/seeds/templates.seed.ts",
    "db:seed:career": "ts-node prisma/seeds/career.seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
