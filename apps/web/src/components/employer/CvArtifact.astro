---
interface Props {
  variant?: 'default' | 'mini' | 'dark';
}

const { variant = 'default' } = Astro.props;
---

<article class:list={['cv-artifact', `cv-artifact--${variant}`]}>
  <div class="cv-artifact__topline">
    <div class="cv-artifact__identity">
      <span>MS</span>
      <div><b>Maria Syafira</b><small>Product Designer</small></div>
    </div>
    <div class="cv-artifact__meta">Employr<br />CV / 01</div>
  </div>
  <div class="cv-artifact__rule"></div>
  <div class="cv-artifact__columns">
    <div>
      <p class="cv-artifact__label">PROFIL</p>
      <p class="cv-artifact__copy">Merancang antarmuka digital yang nyaman dan mudah digunakan pengguna.</p>
      <p class="cv-artifact__label cv-artifact__label--spaced">PENGALAMAN</p>
      <div class="cv-artifact__role"><b>UI/UX Designer</b><small>Brightworks · 2023—sekarang</small><i></i></div>
      <div class="cv-artifact__role"><b>Visual Designer</b><small>Lepas (Freelance) · 2021—2023</small><i></i></div>
    </div>
    <div class="cv-artifact__skills">
      <p class="cv-artifact__label">KEAHLIAN UTAMA</p>
      <span>Product thinking</span><span>Interaction design</span><span>Figma</span><span>Prototyping</span>
    </div>
  </div>
</article>
