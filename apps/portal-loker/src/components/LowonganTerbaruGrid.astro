---
// LowonganTerbaruGrid.astro - Peluang Karier Terverifikasi (3x4 Grid di Sisi Kiri + Perusahaan Trending di Sisi Kanan)
import { lowonganList, ensureData } from '../data/mock';
import { getPortalTotalJobsCount } from '../lib/data';
import { CV_BUILDER_URL, TRACKER_URL } from '../lib/urls';
import CutoutCorner from './common/CutoutCorner.astro';

await ensureData();
const realTotalJobsCount = await getPortalTotalJobsCount();

interface JobCard {
  company: string;
  companyWebsite?: string;
  type: string;
  location: string;
  position: string;
  postedTime: string;
  salary?: string;
  experience?: string;
  badge?: string;
  isPromoted?: boolean;
  slug: string;
}

// Siapkan data untuk 2 halaman showcase di beranda (Halaman 1 & Halaman 2, masing-masing 11 loker)
const allRawJobs = [...lowonganList];
const totalJobsCount = realTotalJobsCount > 0 ? realTotalJobsCount : allRawJobs.length;

const formatJob = (j: any, idx: number, pageOffset: number): JobCard => ({
  company: j.company,
  companyWebsite: j.companyWebsite,
  type: j.type,
  location: j.geo || j.location || 'Indonesia',
  position: j.title,
  postedTime: j.postedAt,
  salary: j.salary,
  experience: j.experience,
  badge: idx === 1 ? 'Hot' : idx === 5 ? 'Baru' : j.badge,
  isPromoted: (idx === 2 && pageOffset === 0) || (idx === 1 && pageOffset === 11) ? true : j.isPromoted,
  slug: j.slug,
});

const page1Jobs: JobCard[] = allRawJobs.slice(0, 11).map((j, idx) => formatJob(j, idx, 0));

// Untuk Halaman 2, ambil data berikutnya. Jika data kurang dari 22, rotasikan sisa data agar pas 11 kartu.
const p2Slice = allRawJobs.slice(11, 22);
const p2Needed = 11 - p2Slice.length;
const page2Raw = p2Needed > 0 ? [...p2Slice, ...allRawJobs.slice(0, p2Needed)] : p2Slice;
const page2Jobs: JobCard[] = page2Raw.map((j, idx) => formatJob(j, idx, 11));

const jobs: JobCard[] = page1Jobs;

// Agregasi perusahaan trending dari lowongan aktif di database (tanpa placeholder 'perusahaan')
const companyCountMap = new Map<string, { count: number; location: string; category: string }>();
for (const job of lowonganList) {
  if (!job.company) continue;
  const cleanName = job.company.trim();
  if (cleanName.toLowerCase() === 'perusahaan') continue;
  const existing = companyCountMap.get(cleanName);
  if (existing) {
    existing.count += 1;
  } else {
    companyCountMap.set(cleanName, {
      count: 1,
      location: job.geo || job.location || 'Indonesia',
      category: job.category || 'Umum',
    });
  }
}

const calculatedTrending = Array.from(companyCountMap.entries())
  .map(([name, data]) => ({
    name,
    jobsCount: data.count,
    location: data.location,
    category: data.category,
  }))
  .sort((a, b) => b.jobsCount - a.jobsCount)
  .slice(0, 5);

const displayCompanies = calculatedTrending;

interface SpotlightItem {
  id: string;
  badge1: string;
  badge2: string;
  title: string;
  trackHighlight: string;
  trackAudience: string;
  description: string;
  ctaText: string;
  ctaLink: string;
}

const spotlightItems: SpotlightItem[] = [
  {
    id: 'bumn-swasta-2026',
    badge1: 'Mitra Pilihan',
    badge2: '100% Terverifikasi',
    title: 'Program Rekrutmen Terbuka BUMN & Swasta 2026',
    trackHighlight: 'Jalur Bebas Biaya',
    trackAudience: 'Fresh Graduate & SMK',
    description: 'Proses seleksi transparan langsung ke rekruter resmi tanpa perantara calo.',
    ctaText: 'Lihat Lowongan Ramah Pemula',
    ctaLink: '/lowongan?q=fresh+graduate',
  },
  {
    id: 'magang-bumn-2026',
    badge1: 'Magang Nasional',
    badge2: 'Uang Saku Resmi',
    title: 'Program Magang BUMN & Korporasi Strategis',
    trackHighlight: 'Sertifikat Industri',
    trackAudience: 'Mahasiswa & Lulusan Baru',
    description: 'Praktik kerja nyata di unit bisnis terkemuka dengan uang saku resmi dan bimbingan mentor profesional.',
    ctaText: 'Eksplor Program Magang',
    ctaLink: '/lowongan?q=magang',
  },
  {
    id: 'tech-accelerator-2026',
    badge1: 'Jalur Unggulan',
    badge2: 'Remote & On-site',
    title: 'Hiring Khusus Talenta Digital & Tech Starter',
    trackHighlight: 'Portofolio Diutamakan',
    trackAudience: 'IT, Desain, & Data',
    description: 'Akses langsung ke hiring manager tech company tanpa batasan almamater.',
    ctaText: 'Lihat Lowongan Tech Starter',
    ctaLink: '/lowongan?q=remote',
  },
];
---

<section id="lowongan" class="py-12 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7">
      <div>
        <div class="section-label mb-2">
          <span>01</span>
          <i></i>
          <span>LOWONGAN TERBARU</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#101010] tracking-tight">
          Peluang karier terverifikasi,<br class="hidden sm:inline" />
          <em>siap kamu lamar.</em>
        </h2>
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-2 leading-relaxed font-medium max-w-xl">
          Kurasi lowongan kerja aktif dari berbagai korporasi, BUMN, dan tech company terkemuka di Indonesia.
        </p>
      </div>

      <a
        href="/lowongan"
        class="inline-flex items-center gap-2 px-4.5 py-2 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start sm:self-auto group"
      >
        <span>Lihat Semua Lowongan</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Main Content: Sisi Kiri (3x4 Grid Lowongan & Iklan) & Sisi Kanan (Perusahaan Trending & Ads Unit) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-7">

      <!-- Sisi Kiri (8 cols): 3x4 Grid (3 Kolom x 4 Baris = 12 Slot: 11 Lowongan + 1 Iklan 1:1) -->
      <div class="lg:col-span-8 flex flex-col justify-between h-auto lg:h-full">
        <div class="flex items-center justify-between mb-3.5">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-[#101010]">Daftar Lowongan Terkurasi</h3>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-[#1738D1] border border-blue-200">
              Terverifikasi HRD
            </span>
          </div>
          <span class="text-[11px] font-medium text-[#6e6d68]">
            Menampilkan 12 dari 18.000+ loker aktif
          </span>
        </div>

        <!-- Panels Container (Halaman 1 & Halaman 2 In-Place Toggle) -->
        <div id="job-grid-panels" class="relative">
          {jobs.length === 0 ? (
            <div class="text-center py-10 text-xs sm:text-sm text-[#6e6d68] bg-white rounded-xl border border-[#d7d6cf]">
              Belum ada lowongan tersinkron. Data lowongan diperbarui secara berkala.
            </div>
          ) : (
            <>
              <!-- Panel Halaman 1 (11 Loker + 1 Iklan CV Builder) -->
              <div id="job-grid-page-1" data-job-page-panel="1" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-3.5">
                {/* 4 Loker Pertama (Slot 1, 2, 3, 4) */}
                {page1Jobs.slice(0, 4).map((job) => (
                  <a
                    href={`/lowongan/${job.slug}`}
                    class="group bg-white rounded-xl border border-[#d7d6cf] p-3.5 flex flex-col justify-between hover:border-[#1738D1]/40 hover:shadow-[0_8px_20px_-4px_rgba(16,16,16,0.06)] hover:-translate-y-0.5 transition-all duration-200 relative overflow-hidden"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1.5 mb-1.5">
                        <span class="text-[11px] font-bold text-[#6e6d68] uppercase tracking-wider truncate">
                          {job.company}
                        </span>
                        {job.badge ? (
                          <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${
                            job.badge === 'Hot' ? 'bg-amber-50 text-amber-800 border border-amber-200/80' : 'bg-blue-50 text-[#1738D1] border border-blue-100'
                          }`}>
                            {job.badge}
                          </span>
                        ) : null}
                      </div>
                      <h3 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center">
                        {job.position}
                      </h3>
                      <div class="flex items-center gap-1.5 text-[10.5px] text-[#6e6d68] font-medium mb-2.5 flex-wrap">
                        <span class="inline-flex items-center gap-1 text-[#101010] font-semibold">
                          <svg class="w-3 h-3 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          {job.location}
                        </span>
                        <span>·</span>
                        <span>{job.type}</span>
                      </div>
                    </div>
                    <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex flex-col gap-1.5 mt-auto">
                      <div class="flex items-center justify-between gap-1.5">
                        <span class="font-bold text-[#101010] text-xs truncate">{job.salary}</span>
                        <span class="text-[10px] font-semibold text-[#1738D1] group-hover:translate-x-0.5 transition-transform shrink-0 flex items-center gap-0.5">
                          Lihat
                          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                          </svg>
                        </span>
                      </div>
                      <div class="flex items-center gap-1.5 text-[10px] text-[#6e6d68]">
                        <svg class="w-3 h-3 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="truncate">{job.postedTime}</span>
                      </div>
                    </div>
                  </a>
                ))}

                {/* SLOT IKLAN 1:1 DI BARIS 2 KOLOM 2 (Halaman 1: CV Builder ATS) */}
                <div class="relative bg-white rounded-xl border border-dashed border-[#1738D1]/40 p-3.5 flex flex-col justify-between hover:border-[#1738D1] hover:shadow-[0_8px_20px_-4px_rgba(23,56,209,0.06)] transition-all duration-200 overflow-hidden group">
                  <div class="absolute inset-0 bg-gradient-to-br from-[#1738D1]/[0.03] via-transparent to-amber-500/[0.04] pointer-events-none"></div>
                  <div>
                    <div class="flex items-center justify-between gap-1.5 mb-1.5 relative z-10">
                      <div class="flex items-center gap-1">
                        <span class="px-1.5 py-0.5 rounded-full text-[8.5px] font-extrabold uppercase tracking-wider bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf]">
                          REKOMENDASI
                        </span>
                        <span class="text-[9px] font-bold text-[#1738D1]">PILIHAN</span>
                      </div>
                    </div>
                    <h3 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center relative z-10">
                      Uji Format Resume Standar HRD & Lolos Screening
                    </h3>
                    <p class="text-[10px] text-[#6e6d68] leading-relaxed font-medium mb-2 relative z-10 line-clamp-2">
                      Pastikan susunan CV kamu terbaca jelas oleh rekruter.
                    </p>
                  </div>
                  <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex flex-col gap-1.5 relative z-10 mt-auto">
                    <div class="flex items-center justify-between gap-1.5">
                      <span class="text-[10px] font-bold text-[#1738D1]">
                        Akses Gratis
                      </span>
                      <a
                        href={CV_BUILDER_URL}
                        class="px-2.5 py-1 rounded-full bg-[#1738D1] hover:bg-[#132EA8] active:scale-[0.98] text-white text-[10px] font-bold transition shadow-xs flex items-center gap-1"
                      >
                        <span>Coba</span>
                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                      </a>
                    </div>
                    <div class="flex items-center gap-1.5 text-[10px] text-[#6e6d68]">
                      <svg class="w-3 h-3 text-[#22c55e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="truncate">Format standar ATS rekruter</span>
                    </div>
                  </div>
                </div>

                {/* 7 Loker Berikutnya untuk Desktop (Slot 6 sampai 12) */}
                {page1Jobs.slice(4, 11).map((job) => (
                  <a
                    href={`/lowongan/${job.slug}`}
                    class="hidden sm:flex group bg-white rounded-xl border border-[#d7d6cf] p-3.5 flex-col justify-between hover:border-[#1738D1]/40 hover:shadow-[0_8px_20px_-4px_rgba(16,16,16,0.06)] hover:-translate-y-0.5 transition-all duration-200 relative overflow-hidden"
                  >
                    <div>
                      <div class="flex items-center justify-between gap-1.5 mb-1.5">
                        <span class="text-[11px] font-bold text-[#6e6d68] uppercase tracking-wider truncate">
                          {job.company}
                        </span>
                        {job.badge ? (
                          <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold shrink-0 ${
                            job.badge === 'Hot' ? 'bg-amber-50 text-amber-800 border border-amber-200/80' : 'bg-blue-50 text-[#1738D1] border border-blue-100'
                          }`}>
                            {job.badge}
                          </span>
                        ) : null}
                      </div>
                      <h3 class="text-xs sm:text-[13px] font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#1738D1] transition mb-1.5 min-h-[2rem] flex items-center">
                        {job.position}
                      </h3>
                      <div class="flex items-center gap-1.5 text-[10.5px] text-[#6e6d68] font-medium mb-2.5 flex-wrap">
                        <span class="inline-flex items-center gap-1 text-[#101010] font-semibold">
                          <svg class="w-3 h-3 text-[#6e6d68]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          {job.location}
                        </span>
                        <span>·</span>
                        <span>{job.type}</span>
                      </div>
                    </div>
                    <div class="pt-2.5 border-t border-[#d7d6cf]/60 flex flex-col gap-1.5 mt-auto">
                      <div class="flex items-center justify-between gap-1.5">
                        <span class="font-bold text-[#101010] text-xs truncate">{job.salary}</span>
                        <span class="text-[10px] font-semibold text-[#1738D1] group-hover:translate-x-0.5 transition-transform shrink-0 flex items-center gap-0.5">
                          Lihat
                          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                          </svg>
                        </span>
                      </div>
                      <div class="flex items-center gap-1.5 text-[10px] text-[#6e6d68]">
                        <svg class="w-3 h-3 text-[#6e6d68] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="truncate">{job.postedTime}</span>
                      </div>
                    </div>
                  </a>
                ))}

                {/* Progressive Disclosure untuk Mobile: Buka sisa loker hanya jika diminta */}
