---
// FooterPortal.astro - Comprehensive Portal Footer
import { CV_BUILDER_URL, TRACKER_URL, LOGIN_URL, FAQ_URL, PRIVACY_URL, TERMS_URL } from '../lib/urls';
---

<footer class="bg-[#101010] text-[#f4f3ee] border-t border-[#101010] pt-10 sm:pt-16 pb-8 sm:pb-12">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-10 pb-8 sm:pb-14 border-b border-white/10">
      <!-- Col 1: Brand & Bio (Full width on mobile, 4 cols on lg) -->
      <div class="col-span-2 lg:col-span-4 flex flex-col justify-between">
        <div>
          <!-- Brand Logo (Invert for Dark Background) -->
          <div class="mb-4 sm:mb-5">
            <a href="/" class="min-h-[44px] inline-flex items-center gap-2.5" aria-label="Beranda Employr Job Portal">
              <img
                src="/logo.webp"
                alt="Employr"
                class="h-8 sm:h-9 w-auto object-contain brightness-0 invert"
              />
            </a>
          </div>

          <p class="text-xs sm:text-sm text-[#a5a5a1] leading-relaxed max-w-sm mb-4 sm:mb-6">
            Portal informasi lowongan kerja, beasiswa sertifikasi, dan panduan karier untuk talenta muda Indonesia.
          </p>

          <!-- Social Icons -->
          <div class="flex items-center gap-2 text-[#a5a5a1] mb-2 sm:mb-0">
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-full bg-white/5 border border-white/10 flex items-center justify-center hover:text-white hover:bg-[#1738D1] hover:border-[#1738D1] transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-full bg-white/5 border border-white/10 flex items-center justify-center hover:text-white hover:bg-[#1738D1] hover:border-[#1738D1] transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-full bg-white/5 border border-white/10 flex items-center justify-center hover:text-white hover:bg-[#1738D1] hover:border-[#1738D1] transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Portal Menu (1 col on mobile, 2 cols on lg) -->
      <div class="col-span-1 lg:col-span-2">
        <div class="section-label section-label--inverse mb-3 sm:mb-4"><span>Portal</span><i></i></div>
        <ul class="space-y-2 text-xs sm:text-sm text-[#a5a5a1] font-medium">
          <li><a href="/lowongan" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Cari Loker</a></li>
          <li><a href="/career" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Tips Karier</a></li>
          <li><a href="/kalkulator-gaji" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Kalkulator Gaji</a></li>
          <li><a href="/sertifikasi" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Sertifikasi</a></li>
          <li><a href="/course" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Pelatihan</a></li>
          <li><a href="/event" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Event & Job Fair</a></li>
          <li><a href="/search" class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Pencarian</a></li>
        </ul>
      </div>

      <!-- Col 3: Alat Karier (1 col on mobile, 2 cols on lg) -->
      <div class="col-span-1 lg:col-span-2">
        <div class="section-label section-label--inverse mb-3 sm:mb-4"><span>Alat Karier</span><i></i></div>
        <ul class="space-y-2 text-xs sm:text-sm text-[#a5a5a1] font-medium">
          <li><a href={CV_BUILDER_URL} class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Buat CV ATS</a></li>
          <li><a href={TRACKER_URL} class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Tracker Lamaran</a></li>
          <li><a href={LOGIN_URL} class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Masuk ke Akun</a></li>
        </ul>
      </div>

      <!-- Col 4: Bantuan & Legal (1 col on mobile, 2 cols on lg) -->
      <div class="col-span-1 lg:col-span-2">
        <div class="section-label section-label--inverse mb-3 sm:mb-4"><span>Bantuan & Legal</span><i></i></div>
        <ul class="space-y-2 text-xs sm:text-sm text-[#a5a5a1] font-medium">
          <li><a href={FAQ_URL} class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Pusat Bantuan</a></li>
          <li><a href={PRIVACY_URL} class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Kebijakan Privasi</a></li>
          <li><a href={TERMS_URL} class="hover:text-white transition min-h-[44px] inline-flex items-center py-2">Syarat & Ketentuan</a></li>
        </ul>
      </div>

      <!-- Col 5: Kontak & Layanan (1 col on mobile, 2 cols on lg) -->
      <div class="col-span-1 lg:col-span-2">
        <div class="section-label section-label--inverse mb-3 sm:mb-4"><span>Kontak</span><i></i></div>
        <p class="text-xs text-[#a5a5a1] mb-2 sm:mb-3">Layanan bantuan &amp; kemitraan.</p>
        <div class="space-y-2 text-xs text-[#a5a5a1]">
          <div>
            <span class="text-[11px] font-bold block text-[#a5a5a1]">Email</span>
            <a href="mailto:halo@employr.id" class="text-white hover:underline font-medium">halo@employr.id</a>
          </div>
          <div class="pt-1">
            <span class="text-[11px] font-bold block text-[#a5a5a1]">Jam Operasional</span>
            <span class="text-white font-medium">Senin - Jumat<br />(09:00 - 18:00 WIB)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#a5a5a1]">
      <div>
        <p class="font-medium text-[#f4f3ee]">© 2026 Employr by PT. Hijrah Era Digital. Hak cipta dilindungi.</p>
        <p class="text-[11px] text-[#a5a5a1] mt-0.5">Employr adalah portal informasi kurasi lowongan kerja, beasiswa, dan panduan karier.</p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a href={PRIVACY_URL} class="min-h-[44px] inline-flex items-center hover:text-white transition">Kebijakan Privasi</a>
        <a href={TERMS_URL} class="min-h-[44px] inline-flex items-center hover:text-white transition">Syarat & Ketentuan</a>
        <a href={FAQ_URL} class="min-h-[44px] inline-flex items-center hover:text-white transition">Pusat Bantuan</a>
      </div>

      <!-- Language Selector Pill -->
      <div class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-white/10 bg-white/5 text-white">
        <svg class="w-3.5 h-3.5 text-[#a5a5a1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-semibold text-xs">Bahasa Indonesia</span>
      </div>
    </div>
  </div>
</footer>

