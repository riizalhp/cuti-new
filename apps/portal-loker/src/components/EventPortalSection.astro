            </div>
            <div class="text-[11px] text-[#6e6d68]">
              50+ Perusahaan BUMN & Multinational · Walk-in Interview
            </div>
          </div>

          <a
            href="/event/job-fair-jakarta-2025"
            class="w-full py-2.5 px-3 rounded-full bg-[#101010] hover:bg-[#000000] text-white text-xs font-bold text-center transition block shadow-xs"
          >
            Klaim Tiket Masuk Gratis →
          </a>
        </div>

      </div>

    </div>

    <!-- Bottom Banner -->
    <div class="mt-8 bg-white border border-[#d7d6cf] rounded-2xl p-5 sm:p-6 flex flex-col lg:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#0000ff] flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm sm:text-base font-semibold text-[#101010] leading-snug">
            Ingin Hadir ke Bursa Kerja atau Mempublikasikan Event Kampus?
          </h4>
          <p class="text-xs sm:text-sm text-[#6e6d68] mt-0.5">
            Jelajahi kalender job fair terlengkap atau daftarkan agenda institusimu ke 250.000+ talenta muda.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 shrink-0 w-full lg:w-auto justify-end">
        <a
          href="/tentang#mitra-event"
          class="px-4 py-2.5 rounded-full border border-[#d7d6cf] hover:bg-[#f4f3ee] text-[#101010] text-xs sm:text-sm font-semibold transition text-center"
        >
          Daftarkan Event Kampus
        </a>
        <a
          href="/event"
          class="px-5 py-2.5 rounded-full bg-[#0000ff] hover:bg-[#1738d1] text-white text-xs sm:text-sm font-semibold transition shadow-sm text-center"
        >
          Lihat Semua Event ({sortedEvents.length}) →
        </a>
      </div>
    </div>
  </div>
</section>
