---
import {
  lowonganList,
  sertifikasiList,
  courseList,
  eventList,
  artikelList,
  ensureData,
} from '../data/mock';
import OrganicCardSmall from './common/OrganicCardSmall.astro';

await ensureData();

interface Props {
  currentType?: 'lowongan' | 'sertifikasi' | 'course' | 'event' | 'career';
  currentSlug?: string;
  category?: string;
  geo?: string;
}

const { currentType, currentSlug, category, geo } = Astro.props;

// Filter out current item from its respective list and prioritize category/geo match
const relatedJobs = [...lowonganList]
  .filter((j) => (currentType === 'lowongan' ? j.slug !== currentSlug : true))
  .sort((a, _b) => ((geo && a.geo === geo) || (category && a.category === category) ? -1 : 1))
  .slice(0, 3);

const relatedSertifikasi = [...sertifikasiList]
  .filter((s) => (currentType === 'sertifikasi' ? s.slug !== currentSlug : true))
  .slice(0, 3);

const relatedEvents = [...eventList]
  .filter((e) => (currentType === 'event' ? e.slug !== currentSlug : true))
  .slice(0, 3);

const relatedCourses = [...courseList]
  .filter((c) => (currentType === 'course' ? c.slug !== currentSlug : true))
  .slice(0, 3);

const relatedArticles = [...artikelList]
  .filter((a) => (currentType === 'career' ? a.slug !== currentSlug : true))
  .slice(0, 3);
---

<div class="mt-12 space-y-12 border-t border-[#d7d6cf] pt-10">
  <!-- 1. Rekomendasi Lowongan Kerja Relevan -->
  <section aria-labelledby="heading-cross-jobs">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <div class="section-label mb-2"><span>PELUANG KARIER PILIHAN</span><i></i></div>
        <h2 id="heading-cross-jobs" class="text-xl sm:text-2xl font-semibold text-[#101010] tracking-tight">
          {currentType === 'lowongan' ? 'Lowongan Lain yang Relevan' : 'Lowongan Kerja yang Sedang Membuka Pendaftaran'}
        </h2>
      </div>
      <a href="/lowongan" class="text-xs font-semibold text-[#1738D1] hover:underline shrink-0">
        Lihat Semua Loker
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {relatedJobs.map((job) => (
        <article class="bg-white rounded-2xl p-5 border border-[#d7d6cf] hover:border-[#1738D1]/30 hover:shadow-[0_12px_30px_-4px_rgba(16,16,16,0.08)] hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
          <div>
            <div class="mb-2.5">
              <p class="text-xs font-bold text-[#52514c] uppercase tracking-wider truncate">{job.company}</p>
              <p class="text-[11px] text-[#52514c] mt-0.5">{job.location}</p>
            </div>
            <h3 class="text-sm font-semibold text-[#101010] hover:text-[#1738D1] transition line-clamp-2 leading-snug">
              <a href={`/lowongan/${job.slug}`}>{job.title}</a>
            </h3>
            <div class="flex items-center gap-1.5 flex-wrap mt-2.5">
              <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200 text-[#1738D1] font-semibold">{job.type}</span>
              <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-[#f4f3ee] border border-[#d7d6cf] text-[#52514c] font-medium">{job.experience}</span>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-[#d7d6cf]/50 flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-700">{job.salary}</span>
            <a href={`/lowongan/${job.slug}`} class="min-h-[44px] px-4 py-2 rounded-full bg-[#1738D1] text-white hover:bg-[#132EA8] text-xs font-semibold transition shadow-xs flex items-center justify-center focus-visible:outline-2 focus-visible:outline-[#1738D1]">
              Detail
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 2. Sertifikasi yang Sedang Buka -->
  <section aria-labelledby="heading-cross-sertifikasi">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <div class="section-label mb-2"><span>VALIDASI KOMPETENSI RESMI</span><i></i></div>
        <h2 id="heading-cross-sertifikasi" class="text-xl sm:text-2xl font-semibold text-[#101010] tracking-tight">
          {currentType === 'sertifikasi' ? 'Sertifikasi Terkait Lainnya' : 'Sertifikasi Terakreditasi yang Sedang Buka'}
        </h2>
      </div>
      <a href="/sertifikasi" class="text-xs font-semibold text-[#1738D1] hover:underline shrink-0">
        Lihat Semua Sertifikasi
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedSertifikasi.map((sert) => (
        <OrganicCardSmall
          image={sert.image}
          imageAlt={sert.title}
          category={sert.issuer}
          date={sert.duration}
          title={sert.title}
          href={`/sertifikasi/${sert.slug}`}
          description={sert.description}
          price={sert.price}
          badge={sert.level}
          actionText="Cek Syarat"
        />
      ))}
    </div>
  </section>

  <!-- 3. Event & Job Fair Terdekat -->
  <section aria-labelledby="heading-cross-events">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <div class="section-label mb-2"><span>NETWORKING &amp; BURSA KERJA</span><i></i></div>
        <h2 id="heading-cross-events" class="text-xl sm:text-2xl font-semibold text-[#101010] tracking-tight">
          {currentType === 'event' ? 'Event & Job Fair Lainnya' : 'Event & Job Fair Terdekat'}
        </h2>
      </div>
      <a href="/event" class="text-xs font-semibold text-[#1738D1] hover:underline shrink-0">
        Lihat Semua Event
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedEvents.map((evt) => (
        <OrganicCardSmall
          image={evt.image}
          imageAlt={evt.title}
          category={`${evt.format} · ${evt.type}`}
          date={`${evt.day} ${evt.month} 2026`}
          title={evt.title}
          href={`/event/${evt.slug}`}
          description={evt.description}
          location={evt.location}
          price={evt.price}
          actionText="Lihat Detail"
        />
      ))}
    </div>
  </section>

  <!-- 4. Pelatihan Skill Digital yang Sedang Buka -->
  <section aria-labelledby="heading-cross-courses">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <div class="section-label mb-2"><span>PENINGKATAN SKILL DIGITAL</span><i></i></div>
        <h2 id="heading-cross-courses" class="text-xl sm:text-2xl font-semibold text-[#101010] tracking-tight">
          {currentType === 'course' ? 'Pelatihan Terkait Lainnya' : 'Pelatihan Skill Digital yang Sedang Buka'}
        </h2>
      </div>
      <a href="/course" class="text-xs font-semibold text-[#1738D1] hover:underline shrink-0">
        Lihat Semua Pelatihan
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedCourses.map((crs) => (
        <OrganicCardSmall
          image={crs.image}
          imageAlt={crs.title}
          category={`${crs.level} · ${crs.provider}`}
          date={crs.duration}
          title={crs.title}
          href={`/course/${crs.slug}`}
          description={crs.description}
          price={crs.price}
          actionText="Detail Kelas"
        />
      ))}
    </div>
  </section>

  <!-- 5. Artikel & Tips Karier Terbaru -->
  <section aria-labelledby="heading-cross-articles">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6">
      <div>
        <div class="section-label mb-2"><span>WAWASAN &amp; PANDUAN LOLOS</span><i></i></div>
        <h2 id="heading-cross-articles" class="text-xl sm:text-2xl font-semibold text-[#101010] tracking-tight">
          {currentType === 'career' ? 'Artikel Karier Pilihan Lainnya' : 'Artikel & Tips Karier Terbaru'}
        </h2>
      </div>
      <a href="/career" class="text-xs font-semibold text-[#1738D1] hover:underline shrink-0">
        Lihat Semua Artikel
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relatedArticles.map((art) => (
        <OrganicCardSmall
          image={art.image}
          imageAlt={art.title}
          category={art.category}
          date={art.date ? `${art.date} · ${art.readTime}` : art.readTime}
          title={art.title}
          href={`/career/${art.slug}`}
          description={art.excerpt}
          actionText="Baca Artikel"
        />
      ))}
    </div>
  </section>
</div>
