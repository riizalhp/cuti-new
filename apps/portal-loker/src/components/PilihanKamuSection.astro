---
// PilihanKamuSection.astro - 4 Highlight Cards + 1 Google Ads Card
import { topPicks } from '../data/mock';
---

<section class="py-10 bg-white border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#1738d1]">Rekomendasi Terkurasi</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-slate-900 tracking-tight">Pilihan Untuk Kamu</h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1.5 leading-relaxed">Informasi terbaru, pelatihan populer, dan peluang terkurasi yang sedang banyak dicari.</p>
      </div>
      <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-full shrink-0 self-start sm:self-auto">
        Diperbarui Tiap Hari
      </span>
    </div>

    <!-- 5 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {topPicks.map((item) => (
        <a href={item.link} class="group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400 transition-all flex flex-col justify-between">
          <div>
            <!-- Thumbnail with category pill -->
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class={"absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider " + item.badgeColor + " shadow-sm"}>
                {item.type}
              </span>
            </div>

            <!-- Card Body -->
            <div class="p-3.5">
              <span class="text-[11px] font-medium text-slate-400 block mb-1">{item.date}</span>
              <h3 class="text-xs sm:text-sm font-semibold text-slate-900 group-hover:text-[#1738d1] transition-colors line-clamp-2 leading-snug">
                {item.title}
              </h3>
            </div>
          </div>

          <!-- Meta details -->
          <div class="px-3.5 pb-3.5">
            <div class="flex items-center justify-between text-[11px] text-slate-500 pt-2.5 border-t border-slate-100">
              <span class="flex items-center gap-1 truncate">
                <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                </svg>
                <span class="truncate">{item.meta1}</span>
              </span>
              <span class="flex items-center gap-1 shrink-0 font-medium text-[#1738d1]">
                {item.meta2}
              </span>
            </div>
          </div>
        </a>
      ))}

      <!-- Card 5: Native Google Ads / Partner Slot -->
      <div class="bg-gradient-to-br from-blue-50/70 via-indigo-50/40 to-white rounded-2xl border border-blue-200/80 p-4 flex flex-col justify-between relative shadow-sm">
        <!-- Google Ads Tag -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#4285F4]"></span>
            <span class="w-2 h-2 rounded-full bg-[#EA4335]"></span>
            <span class="w-2 h-2 rounded-full bg-[#FBBC05]"></span>
            <span class="w-2 h-2 rounded-full bg-[#34A853]"></span>
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider ml-0.5">Google Partner</span>
          </div>
          <span class="text-[9px] font-bold text-slate-500 bg-white/90 px-2 py-0.5 rounded-full border border-slate-200">Iklan</span>
        </div>

        <div class="my-3">
          <span class="text-[10px] font-bold text-[#1738d1] uppercase tracking-wider block mb-1">Peluang Beasiswa</span>
          <h3 class="text-xs sm:text-sm font-semibold text-slate-900 leading-snug mb-1">
            Program Fast-Track Karier Digital & Sertifikasi 2026
          </h3>
          <p class="text-[11px] text-slate-600 leading-relaxed line-clamp-2">
            Pelatihan intensif bersama mentor industri dengan jaminan penyaluran kerja.
          </p>
        </div>

        <a
          href="/course"
          class="w-full py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-semibold text-center transition flex items-center justify-center gap-1 shadow-xs"
        >
          <span>Pelajari Program</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Jangkau talent terbaik dan generasi muda Indonesia di sini.
          </p>
        </div>

        <a
          href="/tentang#iklan"
          class="w-full py-2.5 px-3 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-medium text-center shadow-sm shadow-blue-500/20 transition active:scale-[0.98] flex items-center justify-center gap-1"
        >
          <span>Pasang Iklan Sekarang</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
