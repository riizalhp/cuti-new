---
// KursusSection.astro - Course & Pelatihan Karier
import { courseList } from '../data/mock';
---

<section id="course" class="py-12 bg-slate-50/50 border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-[11px] font-medium uppercase tracking-wider text-[#1738d1]">Pelatihan & Skill</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-medium text-slate-900 tracking-tight">Course Pilihan</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Kuasai skill yang dibutuhkan industri langsung dari instruktur praktisi.
        </p>
      </div>

      <a href="/course" class="text-xs font-bold text-[#1738d1] hover:underline flex items-center gap-1 shrink-0">
        <span>Lihat Semua Course</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- 3 Course Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {courseList.map((course) => (
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-blue-400 transition flex flex-col justify-between group">
          <div>
            <!-- Image with Price Badge -->
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
              <img src={course.image} alt={course.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-lg text-xs font-medium bg-emerald-600 text-white shadow-sm">
                {course.price}
              </span>
            </div>

            <div class="p-5">
              <span class="text-xs font-bold text-slate-400 block mb-1">{course.provider}</span>
              <h3 class="text-base font-medium text-slate-900 group-hover:text-[#1738d1] transition leading-snug mb-2 line-clamp-2">
                <a href={"/course/" + course.slug}>{course.title}</a>
              </h3>
              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                {course.description}
              </p>

              <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-100">
                <span>⏱ {course.duration}</span>
                <span class="font-bold text-amber-500">★ {course.rating}</span>
                <span>{course.students}</span>
              </div>
            </div>
          </div>

          <div class="p-5 pt-0">
            <a
              href={"/course/" + course.slug}
              class="w-full py-2.5 rounded-xl bg-[#1738d1] hover:bg-[#122ca6] text-white text-xs font-bold text-center block transition shadow-sm"
            >
              Lihat Course →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
