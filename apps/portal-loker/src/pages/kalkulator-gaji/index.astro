<script is:inline>
  (function () {
    const searchInput = document.getElementById('umk-table-search');
    const provSelect = document.getElementById('umk-province-filter');
    const pageSizeSelect = document.getElementById('umk-page-size');
    const desktopRows = Array.from(document.querySelectorAll('.umk-region-row'));
    const mobileCards = Array.from(document.querySelectorAll('.umk-region-card'));
    const desktopContainer = document.getElementById('umk-desktop-container');
    const emptyState = document.getElementById('umk-empty-state');
    const paginationBar = document.getElementById('umk-pagination-bar');
    const paginationInfo = document.getElementById('umk-pagination-info');
    const pageNumbersContainer = document.getElementById('umk-page-numbers');
    const prevBtn = document.getElementById('umk-prev-page');
    const nextBtn = document.getElementById('umk-next-page');
    const resetBtn = document.getElementById('btn-reset-umk-search');
    const pickBtns = document.querySelectorAll('.btn-pick-region');

    let currentPage = 1;
    let pageSize = 10;
    let filteredIndices = [];

    function computeFilteredIndices() {
      const q = (searchInput ? searchInput.value : '').trim().toLowerCase();
      const prov = provSelect ? provSelect.value : '';
      filteredIndices = [];

      desktopRows.forEach((row, idx) => {
        const hay = row.getAttribute('data-search') || '';
        const rowProv = row.getAttribute('data-province') || '';
        const matchQ = !q || hay.includes(q);
        const matchProv = !prov || rowProv === prov;
        if (matchQ && matchProv) {
          filteredIndices.push(idx);
        }
      });
    }

    function buildPageButtons(totalPages) {
      if (!pageNumbersContainer) return;
      pageNumbersContainer.innerHTML = '';

      const pages = [];
      if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        pages.push(1);
        if (currentPage > 3) pages.push('...');
        const start = Math.max(2, currentPage - 1);
        const end = Math.min(totalPages - 1, currentPage + 1);
        for (let i = start; i <= end; i++) pages.push(i);
        if (currentPage < totalPages - 2) pages.push('...');
        pages.push(totalPages);
      }

      pages.forEach((p) => {
        if (p === '...') {
          const span = document.createElement('span');
          span.className = 'px-1.5 text-xs font-bold text-[#55544f] select-none';
          span.textContent = '...';
          pageNumbersContainer.appendChild(span);
          return;
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        const isActive = p === currentPage;
        btn.className = isActive
          ? 'min-w-[38px] min-h-[38px] px-2.5 rounded-xl bg-[#1738D1] text-white text-xs font-extrabold tabular-nums transition cursor-pointer'
          : 'min-w-[38px] min-h-[38px] px-2.5 rounded-xl bg-white hover:bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf] text-xs font-bold tabular-nums transition cursor-pointer';
        btn.textContent = String(p);
        btn.setAttribute('aria-label', 'Halaman ' + p);
        if (isActive) btn.setAttribute('aria-current', 'page');

        btn.addEventListener('click', () => {
          currentPage = p;
          renderPage(true);
        });
        pageNumbersContainer.appendChild(btn);
      });
    }

    function renderPage(scrollToSection) {
      const totalItems = filteredIndices.length;
      const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = Math.min(startIdx + pageSize, totalItems);
      const visibleSet = new Set(filteredIndices.slice(startIdx, endIdx));

      desktopRows.forEach((row, idx) => {
        row.style.display = visibleSet.has(idx) ? '' : 'none';
      });

      mobileCards.forEach((card, idx) => {
        card.style.display = visibleSet.has(idx) ? '' : 'none';
      });

      if (totalItems === 0) {
        emptyState?.classList.remove('hidden');
        paginationBar?.classList.add('hidden');
        desktopContainer?.classList.add('md:hidden');
      } else {
        emptyState?.classList.add('hidden');
        paginationBar?.classList.remove('hidden');
        desktopContainer?.classList.remove('md:hidden');

        if (paginationInfo) {
          paginationInfo.innerHTML =
            'Menampilkan <strong class="text-[#101010]">' +
            (startIdx + 1) +
            ' - ' +
            endIdx +
            '</strong> dari <strong class="text-[#101010]">' +
            totalItems +
            '</strong> Kabupaten/Kota';
        }

        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        buildPageButtons(totalPages);
      }

      if (scrollToSection) {
        const dirEl = document.getElementById('direktori-umk-2026');
        dirEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function applyFilterAndResetPage() {
      pageSize = parseInt(pageSizeSelect ? pageSizeSelect.value : '10', 10) || 10;
      currentPage = 1;
      computeFilteredIndices();
      renderPage(false);
    }

    searchInput?.addEventListener('input', applyFilterAndResetPage);
    provSelect?.addEventListener('change', applyFilterAndResetPage);
    pageSizeSelect?.addEventListener('change', applyFilterAndResetPage);

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage(true);
      }
    });

    nextBtn?.addEventListener('click', () => {
      const totalPages = Math.max(1, Math.ceil(filteredIndices.length / pageSize));
      if (currentPage < totalPages) {
        currentPage++;
        renderPage(true);
      }
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (provSelect) provSelect.value = '';
      applyFilterAndResetPage();
    });

    pickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const regId = btn.getAttribute('data-select-region');
        if (regId && typeof window.__employrSelectCalcRegion === 'function') {
          window.__employrSelectCalcRegion(regId);
          const url = new URL(window.location.href);
          url.searchParams.set('kota', regId);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    // Initial render & ?kota= parameter auto-select
    applyFilterAndResetPage();
    const initialKota = new URLSearchParams(window.location.search).get('kota');
    if (initialKota && typeof window.__employrSelectCalcRegion === 'function') {
      window.__employrSelectCalcRegion(initialKota);
    }
  })();
</script>
