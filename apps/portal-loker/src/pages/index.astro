---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroPortal from '../components/HeroPortal.astro';
import LowonganTerbaruGrid from '../components/LowonganTerbaruGrid.astro';
import PilihanKamuSection from '../components/PilihanKamuSection.astro';
import StatsTicker from '../components/StatsTicker.astro';
import TrendingSection from '../components/TrendingSection.astro';
import CareerTipsSection from '../components/CareerTipsSection.astro';
import EventPortalSection from '../components/EventPortalSection.astro';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import FooterPortal from '../components/FooterPortal.astro';
import SearchModal from '../components/SearchModal.astro';
---

<BaseLayout
  title="Employer Job: Portal Informasi Lowongan Kerja, Sertifikasi & Karier Terlengkap"
  description="Media informasi dan kurasi lowongan kerja, sertifikasi resmi, kursus skill digital, event job fair, dan tips karier terpercaya untuk generasi muda Indonesia."
  canonicalUrl="http://localhost:3003/"
>
  <!-- 1. Header & Navigation (Image 1) -->
  <Navbar />

  <main class="bg-white min-h-screen">
    <!-- 2. Hero Section with Big Search & Stats Highlights (Image 1) -->
    <HeroPortal />

    <!-- 3. Lowongan Kerja Terbaru (4 Cards Grid) -->
    <LowonganTerbaruGrid />

    <!-- 4. Pilihan Untuk Kamu (4 Pilar + Google Ads Card) (Image 1) -->
    <PilihanKamuSection />

    <!-- 4. Stats Ticker Bar (Image 1) -->
    <StatsTicker />

    <!-- 5. Career News & Paling Banyak Dibaca (Trending) (Image 4) -->
    <TrendingSection />

    <!-- 6. Career Tips & Articles (Employer Job Insight) (Image 5) -->
    <CareerTipsSection />

    <!-- 7. Event & Job Fair dengan Kalender Interaktif (Image 2) -->
    <EventPortalSection />

    <!-- 8. Newsletter Banner Full Width + 4 Value Pills (Image 3) -->
    <NewsletterBanner />
  </main>

  <!-- 9. Comprehensive 4-Column Footer (Image 3) -->
  <FooterPortal />

  <!-- 10. Global Search Modal -->
  <SearchModal />
</BaseLayout>
