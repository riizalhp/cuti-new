---
// SertifikatSection.astro - Sertifikasi Profesional Database Listing
import { sertifikasiList, ensureData } from '../data/mock';

await ensureData();
const topSertifikasi = [...sertifikasiList].slice(0, 4);
---

<section id="sertifikasi" class="py-12 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="section-label mb-2.5">
          <span>02</span>
          <i></i>
          <span>SERTIFIKASI RESMI</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight">
          Validasi keahlianmu,<br class="hidden sm:inline" />
          <em>dengan sertifikasi kredibel.</em>
        </h2>
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-2 leading-relaxed font-medium max-w-2xl">
          Tingkatkan bobot profil kariermu dengan sertifikasi resmi standar nasional BNSP dan global (Google, AWS, Microsoft).
        </p>
      </div>

      <a
        href="/sertifikasi"
        class="inline-flex items-center gap-2 px-4.5 py-2 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start sm:self-auto group"
      >
        <span>Lihat Semua Sertifikasi ({sertifikasiList.length})</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 4 Sertifikasi Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4.5">
      {topSertifikasi.map((cert) => (
        <div class="bg-white rounded-2xl border border-[#d7d6cf] overflow-hidden shadow-paper hover:shadow-[0_12px_30px_-4px_rgba(16,16,16,0.08)] hover:border-[#0000ff]/30 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between group">
          <div>
            <!-- Image with Provider Pill -->
            <div class="relative aspect-[16/10] overflow-hidden bg-[#f4f3ee]">
              <img src={cert.image} alt={cert.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              <span class="absolute top-3 left-3 px-3 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-[#101010] text-white shadow-xs">
                {cert.category}
              </span>
              <span class="absolute top-3 right-3 px-3 py-0.5 rounded-full text-[9px] font-bold bg-white/95 text-[#101010] border border-[#d7d6cf] shadow-xs">
                {cert.issuer}
              </span>
            </div>

            <!-- Content -->
            <div class="p-5">
              <div class="flex items-center gap-2 text-[10px] text-[#6e6d68] mb-2 font-bold">
                <span class="text-[#0000ff] bg-blue-50 px-2 py-0.5 rounded-full border border-blue-100">{cert.level}</span>
                <span>·</span>
                <span>{cert.format}</span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-[#101010] group-hover:text-[#0000ff] transition leading-snug mb-2 line-clamp-2">
                <a href={"/sertifikasi/" + cert.slug}>{cert.title}</a>
              </h3>
              <p class="text-xs text-[#6e6d68] line-clamp-2 leading-relaxed mb-4 font-medium">
                {cert.description}
              </p>

              <!-- Meta Format & Duration -->
              <div class="flex items-center justify-between text-xs pt-3 border-t border-[#101010]/8">
                <span class="text-[#6e6d68] font-medium">{cert.duration}</span>
                <span class="font-bold text-[#101010]">{cert.price}</span>
              </div>
            </div>
          </div>

          <!-- Bottom Button -->
          <div class="p-5 pt-0">
            <a
              href={"/sertifikasi/" + cert.slug}
              class="w-full py-2.5 rounded-full bg-[#f4f3ee] hover:bg-[#0000ff] text-[#101010] hover:text-white text-xs font-bold text-center block transition border border-[#d7d6cf] hover:border-[#0000ff] shadow-xs"
            >
              Lihat Detail & Persyaratan →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

