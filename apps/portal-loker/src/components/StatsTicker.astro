---
// StatsTicker.astro - Verified platform pillars in a single-row infinite auto-slider (Marquee)
const pillars = [
  {
    title: "Loker Terverifikasi",
    subtitle: "Bebas Pungutan",
    iconD: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    title: "Sertifikasi Resmi",
    subtitle: "BNSP & Global",
    iconD: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  },
  {
    title: "Pelatihan Skill",
    subtitle: "Keahlian Industri",
    iconD: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  },
  {
    title: "Agenda Event",
    subtitle: "Job Fair & Webinar",
    iconD: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    title: "Panduan Karier",
    subtitle: "Tips CV ATS & Gaji",
    iconD: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];

// Duplikasi 2 set untuk infinite looping yang mulus tanpa jeda
const allPillars = [...pillars, ...pillars];
---

<section class="bg-[#f4f3ee] border-b border-[#d7d6cf]/80 py-3.5 sm:py-4 overflow-hidden relative select-none">
  <!-- Gradient mask di kiri dan kanan agar transisi slider halus -->
  <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-10 sm:w-20 bg-gradient-to-r from-[#f4f3ee] to-transparent z-10"></div>
  <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-10 sm:w-20 bg-gradient-to-l from-[#f4f3ee] to-transparent z-10"></div>

  <!-- 1-Row Infinite Auto Slider -->
  <div class="stats-ticker-track flex items-center gap-8 sm:gap-12 whitespace-nowrap">
    {allPillars.map((p, idx) => (
      <div class="inline-flex items-center gap-3 shrink-0 py-1">
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border border-[#d7d6cf] text-[#1738D1] flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.iconD}></path>
          </svg>
        </div>
        <div class="text-left">
          <div class="text-xs sm:text-sm font-bold text-[#101010] leading-snug">{p.title}</div>
          <div class="text-[10px] text-[#6e6d68] font-medium">{p.subtitle}</div>
        </div>
        <!-- Dot separator antara item -->
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#d7d6cf] ml-5 sm:ml-8 shrink-0" aria-hidden="true"></span>
      </div>
    ))}
  </div>
</section>

<style>
  @keyframes statsTickerSlide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .stats-ticker-track {
    display: flex;
    width: max-content;
    animation: statsTickerSlide 25s linear infinite;
    will-change: transform;
  }

  .stats-ticker-track:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-ticker-track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>
