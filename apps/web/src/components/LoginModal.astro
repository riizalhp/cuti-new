---
import { getGoogleAuthUrl } from '../utils/env';

const googleAuthUrl = getGoogleAuthUrl();
---

<div id="login-modal" class="login-modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="login-modal-title">
  <div class="login-modal-backdrop" data-close-login></div>
  <div class="login-modal-card">
    <button type="button" class="login-modal-close" aria-label="Tutup modal" data-close-login>
      &times;
    </button>
    
    <div class="login-modal-header">
      <div class="brand-mark-wrapper">
        <img src="/logo.webp" alt="Employr" width="150" height="41" class="modal-logo" />
      </div>
      <h2 id="login-modal-title" class="login-modal-title">Masuk ke <em>Employr</em></h2>
      <p class="login-modal-subtitle">Akses cepat dan aman untuk mengelola CV, lamaran, serta misimu.</p>
    </div>

    <form id="dummy-login-form" class="login-form space-y-3" action="javascript:void(0);" onsubmit="return false;">
      <div id="login-error-alert" class="modal-err-box" style="display: none; padding: 8px 12px; border-radius: 8px; background: #FEE2E2; border: 1px solid #EF4444; color: #991B1B; font-size: 12px; font-weight: 600;"></div>

      <div class="input-group">
        <label for="login-username" class="input-label">Email atau Username</label>
        <input 
          type="text" 
          id="login-username" 
          name="username" 
          placeholder="contoh: user@employr.id" 
          class="modal-input" 
          required 
        />
      </div>

      <div class="input-group">
        <label for="login-password" class="input-label">Kata Sandi</label>
        <input 
          type="password" 
          id="login-password" 
          name="password" 
          placeholder="••••••••" 
          class="modal-input" 
          required 
        />
      </div>

      <button type="submit" class="button submit-login-btn">
        <span>Masuk ke Beranda</span>
        <span class="btn-arrow">↗</span>
      </button>
    </form>

    <div class="divider-text">atau</div>

    <div class="login-action-container">
      <a href={googleAuthUrl} class="button google-auth-btn">
        <div class="btn-left">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.15C3.26 21.37 7.37 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.24C.45 8.15 0 9.97 0 12s.45 3.85 1.24 5.42l4.04-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.37 0 3.26 2.63 1.24 6.58l4.04 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          <span>Masuk dengan Google</span>
        </div>
        <span class="btn-arrow">↗</span>
      </a>
    </div>

    <div class="login-modal-footer">
      <p>Belum punya akun? <a href="/register" class="text-button" data-open-register>Daftar Akun Baru ↗</a></p>
    </div>
  </div>
</div>

<style>
  .login-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .login-modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .login-modal-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 65%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .login-modal-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 420px;
    padding: 40px 32px 32px;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    transform: rotate(-1deg) scale(0.96);
    transition: transform 0.3s cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .login-modal-overlay.is-active .login-modal-card {
    transform: rotate(-1deg) scale(1);
  }

  .login-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .login-modal-close:hover {
    background: var(--cobalt);
    color: var(--paper);
    transform: rotate(90deg);
  }

  .login-modal-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .brand-mark-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
  }

  .modal-logo {
    width: auto;
    height: 38px;
    display: block;
  }

  .login-modal-title {
    margin: 0;
    font-family: var(--sans);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .login-modal-title em {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    color: var(--cobalt);
  }

  .login-modal-subtitle {
    margin: 10px 0 0;
    font-size: 14px;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
    line-height: 1.45;
  }

  .login-action-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 8px;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 16px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .modal-input {
    width: 100%;
    height: 46px;
    padding: 0 16px;
    background: #ffffff;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .modal-input:focus {
    border-color: var(--cobalt);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cobalt) 20%, transparent);
  }

  .submit-login-btn {
    min-height: 48px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    color: #ffffff;
    background: var(--ink);
    font-family: var(--sans);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
  }

  .submit-login-btn:hover {
    transform: translateY(-2px);
    background: var(--cobalt);
  }

  .divider-text {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: color-mix(in srgb, var(--ink) 50%, transparent);
    margin: 8px 0 14px;
    position: relative;
  }

  .divider-text::before,
  .divider-text::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 38%;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .divider-text::before {
    left: 0;
  }

  .divider-text::after {
    right: 0;
  }

  .google-auth-btn {
    min-height: 50px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 22px;
    border: 1px solid var(--cobalt);
    border-radius: 999px;
    color: var(--paper);
    background: var(--cobalt);
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
    transition: transform 0.25s, color 0.25s, background 0.25s;
  }

  .google-auth-btn:hover {
    transform: translateY(-3px);
    color: var(--cobalt);
    background: var(--paper);
  }

  .btn-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-left svg {
    background: #ffffff;
    border-radius: 50%;
    padding: 3px;
    box-sizing: content-box;
  }

  .btn-arrow {
    font-size: 20px;
    line-height: 1;
  }

  .login-modal-footer {
    margin-top: 24px;
    text-align: center;
    padding-top: 18px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .login-modal-footer p {
    margin: 0;
    font-size: 13px;
    color: color-mix(in srgb, var(--ink) 75%, transparent);
  }

  .text-button {
    background: transparent;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--cobalt);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .text-button:hover {
    color: var(--ink);
  }
</style>

<script is:inline>
  (() => {
    function initAuthModals() {
      const loginModal = document.getElementById('login-modal');
      const registerModal = document.getElementById('register-modal');

      function openLogin() {
        if (registerModal) {
          registerModal.classList.remove('is-active');
          registerModal.setAttribute('aria-hidden', 'true');
        }
        if (loginModal) {
          loginModal.classList.add('is-active');
          loginModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          const userInput = loginModal.querySelector('#login-username');
          if (userInput) userInput.focus();
        }
      }

      function closeLogin() {
        if (loginModal) {
          loginModal.classList.remove('is-active');
          loginModal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }

      function openRegister() {
        if (loginModal) {
          loginModal.classList.remove('is-active');
          loginModal.setAttribute('aria-hidden', 'true');
        }
        if (registerModal) {
          registerModal.classList.add('is-active');
          registerModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          const nameInput = registerModal.querySelector('#modal-reg-name');
          if (nameInput) nameInput.focus();
        } else {
          window.location.href = '/register';
        }
      }

      function closeRegister() {
        if (registerModal) {
          registerModal.classList.remove('is-active');
          registerModal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }

      // Delegate all click events for opening/closing modals
      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!target) return;

        if (target.closest('[data-open-login]')) {
          e.preventDefault();
          openLogin();
          return;
        }

        if (target.closest('[data-close-login]')) {
          e.preventDefault();
          closeLogin();
          return;
        }

        if (target.closest('[data-open-register]')) {
          e.preventDefault();
          openRegister();
          return;
        }

        if (target.closest('[data-close-register]')) {
          e.preventDefault();
          closeRegister();
          return;
        }
      });

      // Escape key closes modals
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeLogin();
          closeRegister();
        }
      });

      // 1. Handle Login Form Submit
      if (loginModal) {
        const loginForm = loginModal.querySelector('#dummy-login-form');
        const loginErr = loginModal.querySelector('#login-error-alert');

        if (loginForm) {
          loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (loginErr) loginErr.style.display = 'none';

            const submitBtn = loginForm.querySelector('.submit-login-btn span');
            if (submitBtn) submitBtn.innerText = 'Memeriksa...';

            const usernameInput = loginModal.querySelector('#login-username');
            const passwordInput = loginModal.querySelector('#login-password');

            const emailOrUser = usernameInput ? usernameInput.value.trim() : '';
            const password = passwordInput ? passwordInput.value : '';

            try {
              const res = await fetch('http://localhost:3000/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: emailOrUser, password }),
              });

              const result = await res.json();

              if (!res.ok || !result.success) {
                if (loginErr) {
                  loginErr.innerText = result.message || 'Email atau kata sandi tidak valid.';
                  loginErr.style.display = 'block';
                }
                if (submitBtn) submitBtn.innerText = 'Masuk ke Beranda';
                return;
              }

              const sessionData = {
                id: result.data.id,
                name: result.data.name,
                email: result.data.email,
                role: result.data.role,
              };
              localStorage.setItem('cuti_user_session', JSON.stringify(sessionData));
              document.cookie = `cuti_user_session=${encodeURIComponent(JSON.stringify(sessionData))}; max-age=${30 * 24 * 60 * 60}; path=/; SameSite=Lax`;

              window.location.href = 'http://localhost:3000/beranda';
            } catch (err) {
              console.error('Login error:', err);
              if (loginErr) {
                loginErr.innerText = 'Tidak dapat terhubung ke server database. Silakan coba lagi.';
                loginErr.style.display = 'block';
              }
              if (submitBtn) submitBtn.innerText = 'Masuk ke Beranda';
            }
          });
        }

        // Login Google Auth Button
        loginModal.querySelectorAll('.google-auth-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const textSpan = btn.querySelector('span');
            if (textSpan) textSpan.innerText = 'Memproses...';
            const googleUser = {
              name: 'Google User',
              email: 'user@gmail.com',
              role: 'USER',
              provider: 'google',
            };
            localStorage.setItem('cuti_user_session', JSON.stringify(googleUser));
            document.cookie = `cuti_user_session=${encodeURIComponent(JSON.stringify(googleUser))}; max-age=${30 * 24 * 60 * 60}; path=/; SameSite=Lax`;
            window.location.href = 'http://localhost:3000/beranda';
          });
        });
      }

      // 2. Handle Register Modal Form Submit
      if (registerModal) {
        const regForm = registerModal.querySelector('#modal-register-form');
        const regErr = registerModal.querySelector('#modal-reg-err');

        if (regForm) {
          regForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (regErr) regErr.style.display = 'none';

            const nameInput = registerModal.querySelector('#modal-reg-name');
            const emailInput = registerModal.querySelector('#modal-reg-email');
            const passInput = registerModal.querySelector('#modal-reg-password');

            const name = nameInput ? nameInput.value.trim() : '';
            const email = emailInput ? emailInput.value.trim() : '';
            const pass = passInput ? passInput.value : '';

            if (!name || !email || !pass) {
              if (regErr) {
                regErr.innerText = 'Semua field wajib diisi.';
                regErr.style.display = 'block';
              }
              return;
            }

            if (pass.length < 6) {
              if (regErr) {
                regErr.innerText = 'Kata sandi minimal 6 karakter.';
                regErr.style.display = 'block';
              }
              return;
            }

            const submitBtn = regForm.querySelector('.submit-login-btn span');
            if (submitBtn) submitBtn.innerText = 'Menyimpan ke Database...';

            try {
              const res = await fetch('http://localhost:3000/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, email, password: pass }),
              });

              const result = await res.json();

              if (!res.ok || !result.success) {
                if (regErr) {
                  regErr.innerText = result.message || 'Gagal mendaftar. Silakan coba lagi.';
                  regErr.style.display = 'block';
                }
                if (submitBtn) submitBtn.innerText = 'Daftar Akun Baru';
                return;
              }

              const newUserData = {
                id: result.data.id,
                name: result.data.name,
                email: result.data.email,
                role: result.data.role,
                registeredAt: new Date().toISOString(),
              };
              localStorage.setItem('cuti_user_session', JSON.stringify(newUserData));
              document.cookie = `cuti_user_session=${encodeURIComponent(JSON.stringify(newUserData))}; max-age=${30 * 24 * 60 * 60}; path=/; SameSite=Lax`;

              if (submitBtn) submitBtn.innerText = 'Pendaftaran Berhasil! Menuju Onboarding...';

              setTimeout(() => {
                window.location.href = 'http://localhost:3000/onboarding';
              }, 300);
            } catch (err) {
              console.error('Register error:', err);
              if (regErr) {
                regErr.innerText = 'Tidak dapat terhubung ke server database (localhost:3000).';
                regErr.style.display = 'block';
              }
              if (submitBtn) submitBtn.innerText = 'Daftar Akun Baru';
            }
          });
        }

        // Register Modal Google Auth Button
        registerModal.querySelectorAll('.google-auth-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const textSpan = btn.querySelector('span');
            if (textSpan) textSpan.innerText = 'Memproses Pendaftaran...';
            try {
              const googleUser = {
                name: 'Google User',
                email: 'user@gmail.com',
                role: 'USER',
                provider: 'google',
              };
              localStorage.setItem('cuti_user_session', JSON.stringify(googleUser));
              document.cookie = `cuti_user_session=${encodeURIComponent(JSON.stringify(googleUser))}; max-age=${30 * 24 * 60 * 60}; path=/; SameSite=Lax`;
            } catch (err) {}
            window.location.href = 'http://localhost:3000/onboarding';
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAuthModals);
    } else {
      initAuthModals();
    }
  })();
</script>
