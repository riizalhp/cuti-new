---
// Navbar.astro - Header Editorial Career Information Portal (Port 4321 Style)
import { LOGIN_URL, APP_URL } from '../lib/urls';
import { getPortalCounts } from '../lib/data';

const counts = await getPortalCounts();
const pathname = Astro.url.pathname;

const isLinkActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---

<header
  id="portal-header"
  class="sticky top-0 z-40 bg-[#f4f3ee]/95 backdrop-blur-md border-b border-[#101010]/8 transition-transform duration-300 ease-in-out will-change-transform"
>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-[72px] flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="min-h-[44px] inline-flex items-center gap-2 sm:gap-2.5 group py-1" aria-label="Beranda Employr Job Portal">
      <img
        src="/logo.webp"
        alt="Employr"
        class="h-7 sm:h-8 w-auto object-contain transition-transform group-hover:scale-[1.02]"
      />
      
    </a>

    <!-- Desktop Horizontal Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-[13px] font-bold text-[#101010]">
      <a
        href="/lowongan"
        class:list={[
          "px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-full transition-all",
          isLinkActive('/lowongan')
            ? "bg-[#1738D1] text-white shadow-xs"
            : "text-[#101010] hover:bg-[#101010]/5"
        ]}
        aria-current={isLinkActive('/lowongan') ? "page" : undefined}
      >
        Loker
      </a>
      <a
        href="/career"
        class:list={[
          "px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-full transition-all",
          isLinkActive('/career')
            ? "bg-[#1738D1] text-white shadow-xs"
            : "text-[#101010] hover:bg-[#101010]/5"
        ]}
        aria-current={isLinkActive('/career') ? "page" : undefined}
      >
        Tips Karier
      </a>
      <a
        href="/kalkulator-gaji"
        class:list={[
          "px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-full transition-all",
          isLinkActive('/kalkulator-gaji')
            ? "bg-[#1738D1] text-white shadow-xs"
            : "text-[#101010] hover:bg-[#101010]/5"
        ]}
        aria-current={isLinkActive('/kalkulator-gaji') ? "page" : undefined}
      >
        Kalkulator Gaji
      </a>
      {counts.certs > 0 && (
        <a
          href="/sertifikasi"
          class:list={[
            "px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-full transition-all",
            isLinkActive('/sertifikasi')
              ? "bg-[#1738D1] text-white shadow-xs"
              : "text-[#101010] hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/sertifikasi') ? "page" : undefined}
        >
          Sertifikasi
        </a>
      )}
      {counts.courses > 0 && (
        <a
          href="/course"
          class:list={[
            "px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-full transition-all",
            isLinkActive('/course')
              ? "bg-[#1738D1] text-white shadow-xs"
              : "text-[#101010] hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/course') ? "page" : undefined}
        >
          Pelatihan
        </a>
      )}
      {counts.events > 0 && (
        <a
          href="/event"
          class:list={[
            "px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-full transition-all",
            isLinkActive('/event')
              ? "bg-[#1738D1] text-white shadow-xs"
              : "text-[#101010] hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/event') ? "page" : undefined}
        >
          Event
        </a>
      )}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      <!-- Search Button Trigger -->
      <button
        type="button"
        id="open-search-btn"
        aria-label="Cari info lowongan, sertifikasi, dan event"
        class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-full flex items-center justify-center text-[#101010] bg-white border border-[#d7d6cf]/80 hover:border-[#101010] hover:bg-white transition-all cursor-pointer shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>


      <!-- Masuk Button: Pill Cobalt (Enhanced with Session Detection) -->
      <a
        id="nav-auth-btn"
        href={LOGIN_URL}
        data-dashboard-url={APP_URL}
        class="inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2 min-h-[44px] rounded-full bg-[#1738D1] hover:bg-[#132EA8] text-white text-[11px] sm:text-xs font-bold tracking-wide shadow-[0_4px_14px_rgba(23,56,209,0.25)] hover:shadow-[0_6px_20px_rgba(23,56,209,0.35)] transition-all hover:-translate-y-0.5 active:translate-y-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]"
      >
        <span id="nav-auth-btn-label">Masuk</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="md:hidden w-11 h-11 min-w-[44px] min-h-[44px] rounded-full flex items-center justify-center text-[#101010] bg-white border border-[#d7d6cf] hover:bg-[#101010]/5 transition-colors shrink-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

  <!-- Mobile Drawer Backdrop & Panel -->
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-50 hidden transition-opacity"></div>
  <div
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu Navigasi"
    class="fixed top-0 right-0 bottom-0 w-[280px] bg-[#f4f3ee] z-50 border-l border-[#d7d6cf] shadow-2xl p-6 flex flex-col justify-between translate-x-full transition-transform duration-300"
  >
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-[#101010]/8">
        <div class="flex items-center gap-2">
          <img src="/logo.webp" alt="Employr" class="h-6 w-auto object-contain" />
          
        </div>
        <button id="mobile-drawer-close" aria-label="Tutup menu" class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-full flex items-center justify-center text-[#101010] hover:bg-[#101010]/5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1738D1]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <nav class="flex flex-col gap-1.5 pt-6 text-sm font-bold text-[#101010]">
        <a
          href="/search"
          class:list={[
            "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center justify-between",
            isLinkActive('/search') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/search') ? "page" : undefined}
        >
          <span>Pencarian Terpadu</span>
          <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </a>
        <a
          href="/lowongan"
          class:list={[
            "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center",
            isLinkActive('/lowongan') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/lowongan') ? "page" : undefined}
        >
          Loker
        </a>
        <a
          href="/career"
          class:list={[
            "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center",
            isLinkActive('/career') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/career') ? "page" : undefined}
        >
          Tips Karier
        </a>
        <a
          href="/kalkulator-gaji"
          class:list={[
            "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center",
            isLinkActive('/kalkulator-gaji') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
          ]}
          aria-current={isLinkActive('/kalkulator-gaji') ? "page" : undefined}
        >
          Kalkulator Gaji
        </a>
        {counts.certs > 0 && (
          <a
            href="/sertifikasi"
            class:list={[
              "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center",
              isLinkActive('/sertifikasi') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
            ]}
            aria-current={isLinkActive('/sertifikasi') ? "page" : undefined}
          >
            Sertifikasi
          </a>
        )}
        {counts.courses > 0 && (
          <a
            href="/course"
            class:list={[
              "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center",
              isLinkActive('/course') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
            ]}
            aria-current={isLinkActive('/course') ? "page" : undefined}
          >
            Pelatihan
          </a>
        )}
        {counts.events > 0 && (
          <a
            href="/event"
            class:list={[
              "min-h-[44px] px-4 py-2.5 rounded-xl transition-colors flex items-center",
              isLinkActive('/event') ? "bg-[#1738D1] text-white" : "hover:bg-[#101010]/5"
            ]}
            aria-current={isLinkActive('/event') ? "page" : undefined}
          >
            Event
          </a>
        )}
      </nav>
    </div>

    <div class="pt-6 border-t border-[#101010]/8 flex flex-col gap-3">
      <a
        id="mobile-nav-auth-btn"
        href={LOGIN_URL}
        data-dashboard-url={APP_URL}
        class="min-h-[44px] flex items-center justify-center px-4 py-2.5 rounded-full bg-[#1738D1] text-white text-xs font-bold shadow-md shadow-blue-500/20"
      >
        Masuk Akun
      </a>
    </div>
  </div>

<script is:inline>
  (function() {
    // 1. Mobile Drawer Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const closeBtn = document.getElementById('mobile-drawer-close');

    function openDrawer() {
      drawer?.classList.remove('translate-x-full');
      backdrop?.classList.remove('hidden');
      mobileBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer?.classList.add('translate-x-full');
      backdrop?.classList.add('hidden');
      mobileBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    mobileBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Tutup drawer saat tombol Escape ditekan
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && !drawer.classList.contains('translate-x-full')) {
        closeDrawer();
      }
    });

    // Tutup drawer otomatis saat link di dalam drawer diklik
    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

  // 2. Smart Reveal Header (GPU-Accelerated, zero-overhead)
  const header = document.getElementById('portal-header');
  let lastScrollY = window.scrollY;
  let ticking = false;
  const SCROLL_THRESHOLD = 12; // minimal delta scroll untuk memicu perubahan
  const HIDE_OFFSET = 80; // tetap tampil di area paling atas (80px)

  function updateHeader() {
    const currentScrollY = window.scrollY;
    const delta = currentScrollY - lastScrollY;

    if (currentScrollY <= HIDE_OFFSET) {
      // Area puncak: selalu tampil
      header?.classList.remove('-translate-y-full');
    } else if (delta > SCROLL_THRESHOLD) {
      // Scroll ke bawah: sembunyikan header agar viewport luas
      header?.classList.add('-translate-y-full');
    } else if (delta < -SCROLL_THRESHOLD) {
      // Scroll ke atas (flick up): munculkan kembali instan
      header?.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  // 3. Progressive Session Awareness via Better Auth Cookie
  try {
    const hasSession = document.cookie.split('; ').some(row =>
      row.startsWith('better-auth.session_token=') ||
      row.startsWith('__Secure-better-auth.session_token=')
    );
    if (hasSession) {
      const authBtn = document.getElementById('nav-auth-btn');
      const authLabel = document.getElementById('nav-auth-btn-label');
      const mobileAuthBtn = document.getElementById('mobile-nav-auth-btn');
      const dashUrl = authBtn?.getAttribute('data-dashboard-url') || 'http://localhost:3000';

      if (authBtn) {
        authBtn.setAttribute('href', dashUrl);
        if (authLabel) authLabel.textContent = 'Dashboard';
      }
      if (mobileAuthBtn) {
        mobileAuthBtn.setAttribute('href', dashUrl);
        mobileAuthBtn.textContent = 'Buka Dashboard';
      }
    }
  } catch (_) {}
  })();
</script>
