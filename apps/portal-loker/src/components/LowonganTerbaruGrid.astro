---
// LowonganTerbaruGrid.astro - Kartu Lowongan Terbaru dari DATABASE
import { lowonganList, ensureData } from '../data/mock';
import CompanyLogo from './CompanyLogo.astro';

await ensureData();

interface JobCard {
  company: string;
  companyLogo?: string;
  companyWebsite?: string;
  type: string;
  location: string;
  position: string;
  postedTime: string;
  salary?: string;
  experience?: string;
  badge?: string;
  isPromoted?: boolean;
  slug: string;
}

// Ambil 8 lowongan terbaru dari DB (fallback list kosong jika DB gagal)
const dbJobs: JobCard[] = [...lowonganList].slice(0, 8).map((j) => ({
  company: j.company,
  companyLogo: j.companyLogo,
  companyWebsite: j.companyWebsite,
  type: j.type,
  location: j.geo,
  position: j.title,
  postedTime: j.postedAt,
  salary: j.salary,
  experience: j.experience,
  badge: j.badge,
  slug: j.slug,
}));

const jobs: JobCard[] = dbJobs.length ? dbJobs : [];
---

<section id="lowongan" class="py-12 sm:py-16 bg-[#f4f3ee] border-b border-[#d7d6cf]/80 scroll-mt-24">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="section-label mb-2.5">
          <span>01</span>
          <i></i>
          <span>LOWONGAN TERBARU</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#101010] tracking-tight">
          Peluang karier terverifikasi,<br class="hidden sm:inline" />
          <em>siap kamu lamar.</em>
        </h2>
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-2 leading-relaxed font-medium">
          Daftar lowongan kerja aktif dari korporasi terpercaya, BUMN, dan tech company terkemuka di Indonesia.
        </p>
      </div>
      <a
        href="/lowongan"
        class="inline-flex items-center gap-2 px-4.5 py-2 rounded-full border border-[#d7d6cf] bg-white hover:bg-white hover:border-[#101010] text-xs font-bold text-[#101010] shadow-xs transition-all shrink-0 self-start sm:self-auto group"
      >
        <span>Lihat Semua Lowongan</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- 4 Cards Grid with Rich Consistent Metadata -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4.5">
      {jobs.length === 0 ? (
        <div class="col-span-full text-center py-12 text-sm text-[#6e6d68]">
          Belum ada lowongan tersinkron. Data diperbarui otomatis setiap malam jam 01.00 WIB.
        </div>
      ) : (
        jobs.map((job) => (
          <a
            href={`/lowongan/${job.slug}`}
            class="group bg-white rounded-2xl border border-[#d7d6cf] p-5 flex flex-col justify-between hover:border-[#0000ff]/30 hover:shadow-[0_12px_30px_-4px_rgba(16,16,16,0.08)] hover:-translate-y-1 transition-all duration-200 relative overflow-hidden"
          >
            <div>
              <!-- Top Row: Logo Placeholder + Badge -->
              <div class="flex items-start justify-between gap-3 mb-3.5">
                <CompanyLogo name={job.company} logoUrl={job.companyLogo} website={job.companyWebsite} size="md" />

                {job.isPromoted ? (
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200/80 flex items-center gap-1 shadow-2xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    Promoted
                  </span>
                ) : job.badge ? (
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-[#0000ff] border border-blue-100">
                    {job.badge}
                  </span>
                ) : null}
              </div>

              <!-- Company Name -->
              <p class="text-xs font-bold text-[#6e6d68] truncate mb-1">
                {job.company}
              </p>

              <!-- Position / Job Title -->
              <h3 class="text-sm sm:text-base font-bold text-[#101010] leading-snug line-clamp-2 group-hover:text-[#0000ff] transition mb-3">
                {job.position}
              </h3>

              <!-- Location & Type Pills -->
              <div class="flex items-center gap-1.5 mb-4 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf]/60">
                  {job.type}
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf]/60">
                  {job.location}
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#f4f3ee] text-[#101010] border border-[#d7d6cf]/60">
                  {job.experience}
                </span>
              </div>
            </div>

            <!-- Bottom Row: Salary & Posted Time -->
            <div class="pt-3 border-t border-[#101010]/8 flex items-center justify-between text-xs">
              <span class="font-bold text-[#101010] bg-[#f4f3ee] px-2.5 py-0.5 rounded-full border border-[#d7d6cf]/60">
                {job.salary}
              </span>
              <span class="text-[11px] font-medium text-[#a5a5a1]">
                {job.postedTime}
              </span>
            </div>
          </a>
        ))
      )}
    </div>
  </div>
</section>
