---
import '../styles/global.css';
import '../styles/employer.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  faqSchema?: Record<string, any>;
}

const {
  title,
  description,
  ogImage = 'https://employr.id/images/cuti-hero.png',
  ogType = 'website',
  canonicalUrl = 'https://employr.id/',
  faqSchema,
} = Astro.props;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Employr',
  alternateName: 'Employr',
  url: 'https://employr.id/',
  description: 'Ruang kerja karier untuk langkah berikutnya — bangun CV, temukan kecocokan, dan sesuaikan pengalamanmu untuk setiap peran.',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  publisher: {
    '@type': 'Organization',
    name: 'Employr',
    url: 'https://employr.id/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://employr.id/images/cuti-hero.png',
    },
  },
};
---

<!doctype html>
<html lang="id" class="site-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#101010" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Employr" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect & Google Fonts (DM Sans · Instrument Sans · Instrument Serif · Inter Tight · Manrope) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..800;1,9..40,300..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&family=Inter+Tight:ital,wght@0,300..900;1,300..900&family=Manrope:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body>
    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // ---------- Header scroll-state (smooth morph & hysteresis) ----------
      const header = document.querySelector('.site-header');
      if (header) {
        let isSolid = window.scrollY > 50;
        if (isSolid) header.classList.add('site-header--solid');

        ScrollTrigger.create({
          start: 'top -50px',
          onEnter: () => {
            if (isSolid) return;
            isSolid = true;
            header.classList.add('site-header--solid');
            gsap.fromTo(
              header,
              { opacity: 0, y: -20 },
              { opacity: 1, y: 0, duration: 0.35, ease: 'power3.out' }
            );
          },
          onLeaveBack: () => {
            if (!isSolid) return;
            isSolid = false;
            header.classList.remove('site-header--solid');
            gsap.set(header, { clearProps: 'all' });
            gsap.fromTo(
              header,
              { opacity: 0, y: -10 },
              { opacity: 1, y: 0, duration: 0.25, ease: 'power2.out', clearProps: 'all' }
            );
          },
        });
      }

      // ---------- Motion (hormati prefers-reduced-motion) ----------
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        // Parallax halus hanya pada foto & artefak visual (bukan teks utama)
        const parallaxLayers: Array<[string, number]> = [
          ['.hero__product', -13],
          ['.builder__visual', -9],
          ['.career-observation__image img', 8],
          ['.pricing__scene img', 7],
          ['.versions__stage', 9],
          ['.pivot__photo img', 10],
          ['.final-cta > img', -8],
        ];

        parallaxLayers.forEach(([selector, yPercent]) => {
          const el = document.querySelector(selector);
          if (!el) return;
          gsap.to(el, {
            yPercent,
            ease: 'none',
            scrollTrigger: {
              trigger: el.closest('section') ?? el,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 0.85,
            },
          });
        });

        // Horizontal job rail — dipin di desktop, native scroll di mobile
        const jobs = document.querySelector<HTMLElement>('.jobs');
        const rail = document.querySelector<HTMLElement>('.job-rail');
        const desktopMotion = window.matchMedia('(min-width: 701px)');

        if (jobs && rail && desktopMotion.matches) {
          const getDistance = () => Math.max(0, rail.scrollWidth - window.innerWidth + 92);
          gsap.to(rail, {
            x: () => -getDistance(),
            ease: 'none',
            scrollTrigger: {
              trigger: jobs,
              start: 'top top+=90',
              end: () => `+=${getDistance()}`,
              pin: true,
              pinSpacing: true,
              scrub: 0.9,
              invalidateOnRefresh: true,
            },
          });
        }

        ScrollTrigger.refresh();
      }
    </script>
  </body>
</html>
