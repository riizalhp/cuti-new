---
/**
 * CompanyTicker.astro
 * Ticker marquee logo perusahaan yang bergerak otomatis, looping tanpa jeda,
 * grayscale secara default dan berubah ke warna asli saat kursor diarahkan (hover).
 */

interface CompanyLogo {
  name: string;
  svg?: string;
  src?: string; // Bisa gunakan file gambar langsung misal '/logos/tokopedia.svg'
