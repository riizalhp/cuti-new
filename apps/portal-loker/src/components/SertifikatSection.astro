---
// SertifikatSection.astro - Sertifikasi Profesional Database Listing
import { sertifikasiList } from '../data/mock';
---

<section id="sertifikasi" class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-[#1738d1]"></span>
          <span class="text-[11px] font-medium uppercase tracking-wider text-[#1738d1]">Sertifikasi & Kredensial</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-medium text-slate-900 tracking-tight">Sertifikasi Terbaru</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Tingkatkan nilai tawar kariermu dengan sertifikasi resmi dari Google, Microsoft, AWS, dan BNSP.
        </p>
      </div>

      <a href="/sertifikasi" class="text-xs font-bold text-[#1738d1] hover:underline flex items-center gap-1 shrink-0">
        <span>Lihat Semua Sertifikasi</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- 4 Sertifikasi Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {sertifikasiList.map((cert) => (
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-amber-400 transition flex flex-col justify-between group">
          <div>
            <!-- Image with Provider Pill -->
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
              <img src={cert.image} alt={cert.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-md text-[10px] font-medium uppercase tracking-wider bg-amber-500 text-white shadow-sm">
                {cert.category}
              </span>
            </div>

            <!-- Content -->
            <div class="p-4">
              <span class="text-[11px] font-bold text-slate-400 block mb-1">{cert.provider}</span>
              <h3 class="text-sm font-medium text-slate-900 group-hover:text-[#1738d1] transition leading-snug mb-2 line-clamp-2">
                <a href={"/sertifikasi/" + cert.slug}>{cert.title}</a>
              </h3>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-3">
                {cert.description}
              </p>

              <!-- Meta Format & Duration -->
              <div class="flex items-center gap-2 text-[11px] text-slate-500">
                <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-semibold">{cert.level}</span>
                <span>·</span>
                <span>{cert.format}</span>
              </div>
            </div>
          </div>

          <!-- Bottom Button -->
          <div class="p-4 pt-0">
            <a
              href={"/sertifikasi/" + cert.slug}
              class="w-full py-2.5 rounded-xl bg-slate-50 hover:bg-[#1738d1] text-slate-700 hover:text-white text-xs font-bold text-center block transition border border-slate-200 hover:border-blue-600"
            >
              Lihat Detail Sertifikasi →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
