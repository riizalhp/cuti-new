---
// PageHero.astro - Consistent page hero component for listing pages
// Design System: h1 level page titles with eyebrow label and description

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  badge?: {
    text: string;
    bgColor?: string;
    textColor?: string;
    borderColor?: string;
  };
}

const {
  eyebrow,
  title,
  description,
  badge
} = Astro.props;
---

<div class="bg-[#f4f3ee] border-b border-[#d7d6cf]/80 py-8 sm:py-10">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    <!-- Breadcrumb Slot -->
    <slot name="breadcrumb" />

    <!-- Hero Content -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="section-label mb-2.5">
          <span>{eyebrow}</span>
          <i></i>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#101010] tracking-tight leading-[1.1]" set:html={title} />
        <p class="text-xs sm:text-sm text-[#6e6d68] mt-2 max-w-2xl leading-relaxed font-medium">
          {description}
        </p>
      </div>
      {badge && (
        <span class="px-4 py-1.5 rounded-full text-xs font-bold bg-white text-[#101010] border border-[#d7d6cf] shadow-xs shrink-0 self-start md:self-auto">
          {badge.text}
        </span>
      )}
    </div>
  </div>
</div>
