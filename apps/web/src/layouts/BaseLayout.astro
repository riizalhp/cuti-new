---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  faqSchema?: Record<string, any>;
}

const {
  title,
  description,
  ogImage = 'https://employr.id/images/cuti-hero.png',
  ogType = 'website',
  canonicalUrl = 'https://employr.id/',
  faqSchema,
} = Astro.props;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'CUTI',
  alternateName: 'Employr',
  url: 'https://employr.id/',
  description: 'Career Operating System untuk siswa SMA/SMK, mahasiswa, dan fresh graduate Indonesia.',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '99000',
    priceCurrency: 'IDR',
    priceValidUntil: '2030-12-31',
    availability: 'https://schema.org/InStock',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Employr',
    url: 'https://employr.id/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://employr.id/images/cuti-hero.png',
    },
  },
};
---

<!doctype html>
<html lang="id" class="site-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#1738D1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="CUTI" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect & Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body>
    <slot />
    <script is:inline>
      const menuButton = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-menu]');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('is-open');
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        menu.classList.remove('is-open');
      }));
    </script>
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        // 1. Hero Entrance Animation (Timeline)
        const heroCopyEls = document.querySelectorAll('.hero-copy > *');
        if (heroCopyEls.length > 0) {
          gsap.fromTo(
            heroCopyEls,
            { autoAlpha: 0, y: 35 },
            { autoAlpha: 1, y: 0, duration: 0.85, stagger: 0.12, ease: 'power3.out' }
          );
        }

        const heroVisual = document.querySelector('.hero-visual');
        if (heroVisual) {
          gsap.fromTo(
            heroVisual,
            { autoAlpha: 0, scale: 0.94 },
            { autoAlpha: 1, scale: 1, duration: 1.1, ease: 'power3.out', delay: 0.2 }
          );
        }

        const heroStickers = document.querySelectorAll('.hero-sticker');
        if (heroStickers.length > 0) {
          gsap.fromTo(
            heroStickers,
            { autoAlpha: 0, scale: 0.7, y: 25 },
            { autoAlpha: 1, scale: 1, y: 0, duration: 0.75, stagger: 0.15, ease: 'back.out(1.7)', delay: 0.5 }
          );
        }

        // 2. Feature Cards ScrollTrigger (Stagger Reveal)
        const featureCards = document.querySelectorAll('.feature-card');
        if (featureCards.length > 0) {
          gsap.fromTo(
            featureCards,
            { autoAlpha: 0, y: 50 },
            {
              scrollTrigger: {
                trigger: '.feature-grid',
                start: 'top 80%',
              },
              autoAlpha: 1,
              y: 0,
              duration: 0.8,
              stagger: 0.15,
              ease: 'power2.out',
            }
          );
        }

        // 3. Section Headings ScrollTrigger
        const headings = document.querySelectorAll('.section-heading');
        headings.forEach((heading) => {
          gsap.fromTo(
            heading,
            { autoAlpha: 0, y: 30 },
            {
              scrollTrigger: {
                trigger: heading,
                start: 'top 85%',
              },
              autoAlpha: 1,
              y: 0,
              duration: 0.8,
              ease: 'power2.out',
            }
          );
        });

        // 4. Steps ScrollTrigger
        const stepItems = document.querySelectorAll('.steps li');
        if (stepItems.length > 0) {
          gsap.fromTo(
            stepItems,
            { autoAlpha: 0, x: -40 },
            {
              scrollTrigger: {
                trigger: '.steps',
                start: 'top 80%',
              },
              autoAlpha: 1,
              x: 0,
              duration: 0.7,
              stagger: 0.12,
              ease: 'power2.out',
            }
          );
        }

        // 5. Access Section & Price Card
        const accessCopy = document.querySelector('.access-copy');
        const priceCard = document.querySelector('.price-card');
        if (accessCopy && priceCard) {
          gsap.fromTo(
            accessCopy,
            { autoAlpha: 0, x: -50 },
            {
              scrollTrigger: {
                trigger: '.access-section',
                start: 'top 75%',
              },
              autoAlpha: 1,
              x: 0,
              duration: 0.9,
              ease: 'power3.out',
            }
          );

          gsap.fromTo(
            priceCard,
            { autoAlpha: 0, x: 50, scale: 0.92 },
            {
              scrollTrigger: {
                trigger: '.access-section',
                start: 'top 75%',
              },
              autoAlpha: 1,
              x: 0,
              scale: 1,
              duration: 0.9,
              ease: 'power3.out',
            }
          );
        }

        // 6. FAQ Details Reveal
        const faqItems = document.querySelectorAll('.faq-list details');
        if (faqItems.length > 0) {
          gsap.fromTo(
            faqItems,
            { autoAlpha: 0, y: 25 },
            {
              scrollTrigger: {
                trigger: '.faq-list',
                start: 'top 85%',
              },
              autoAlpha: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: 'power2.out',
            }
          );
        }

        // 7. Company Cards ScrollTrigger (User Distribution)
        const companyCards = document.querySelectorAll('.company-card');
        if (companyCards.length > 0) {
          gsap.fromTo(
            companyCards,
            { autoAlpha: 0, y: 30 },
            {
              scrollTrigger: {
                trigger: '.category-tabs-container',
                start: 'top 80%',
              },
              autoAlpha: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.08,
              ease: 'power2.out',
            }
          );
        }
      }
    </script>
  </body>
</html>
